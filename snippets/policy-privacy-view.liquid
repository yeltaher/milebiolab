{% comment %}
  MILEBIOLAB - SNIPPET POLICY PRIVACY VIEW (HAUTE COUTURE LUSH DESIGN)
  Informativa Generale sul Trattamento dei Dati Personali (Privacy Policy GDPR).
  Pienamente conforme al Regolamento Europeo UE 2016/679 (GDPR) e al D.Lgs. 196/2003 s.m.i.
  Titolare: Mile Dermocosmesi di Milena Tacchella • Lebestetik Beauty & Spa, Via Torricelle 2c, Verona.
  Completamente personalizzabile dal Theme Editor di Shopify in tempo reale.
  Supporta priorità assoluta di page.content e blocchi custom OS 2.0.
  Palette Splendor & Dr. Joseph: #F5F2EB, #FAF8F5, #1A1A1A, #5C6B56, #C8A878, #E5E0D8, #DDD7CE.
{% endcomment %}

{%- liquid
  assign settings = section.settings | default: settings
  assign blocks = section.blocks | default: blocks
  assign eyebrow = settings.eyebrow | default: eyebrow | default: 'PRIVACY & TRASPARENZA GDPR • REG. UE 2016/679'
  assign title = settings.title | default: title | default: 'Informativa sul Trattamento dei Dati Personali (Privacy Policy)'
  assign subtitle = settings.subtitle | default: subtitle | default: "Informativa resa ai sensi dell'art. 13 del Regolamento Europeo 2016/679 (GDPR) per i visitatori e clienti del negozio online Mile Dermocosmesi e dell'istituto dermo-specialistico Lebestetik Beauty & Spa a Verona."
  assign last_updated = settings.last_updated | default: 'Ultimo aggiornamento: 21 Ottobre 2026'
  assign badge_location = settings.badge_location | default: 'Lebestetik Beauty & Spa • Verona'
  assign badge_normative = settings.badge_normative | default: 'Conformità GDPR Reg. UE 2016/679'

  assign card1_badge = settings.card1_badge | default: 'Protezione Rigorosa'
  assign card1_title = settings.card1_title | default: 'Dati Protetti e Crittografati'
  assign card1_desc = settings.card1_desc | default: 'I tuoi dati non vengono mai ceduti, venduti o affittati a terzi. Protocolli SSL/TLS a 256 bit e server sicuri europei garantiscono la massima riservatezza.'
  assign card1_footer = settings.card1_footer | default: '✓ Standard PCI-DSS Livello 1'

  assign card2_badge = settings.card2_badge | default: 'Trasparenza Totale'
  assign card2_title = settings.card2_title | default: 'Finalità Chiare e Limitate'
  assign card2_desc = settings.card2_desc | default: 'Trattiamo solo i dati strettamente necessari per gestire gli ordini, recapitare le formule botaniche ed erogare consulenze dermo-estetiche su misura.'
  assign card2_footer = settings.card2_footer | default: '✓ Zero Sorprese o Spam'

  assign card3_badge = settings.card3_badge | default: 'Controllo Utente'
  assign card3_title = settings.card3_title | default: 'I Tuoi Diritti GDPR'
  assign card3_desc = settings.card3_desc | default: "Puoi richiedere l'accesso, la rettifica, la cancellazione immediata (diritto all'oblio) o revocare il consenso in qualsiasi momento con un semplice messaggio."
  assign card3_footer = settings.card3_footer | default: '✓ Risposta Rapida in 24-48 Ore'

  assign sec1_tag = settings.sec1_tag | default: 'Identificazione Giuridica'
  assign sec1_title = settings.sec1_title | default: 'Titolare del Trattamento dei Dati Personali'
  assign sec1_content = settings.sec1_content | default: "Ai sensi dell'art. 4, n. 7 e dell'art. 13 del Regolamento UE 2016/679 (General Data Protection Regulation - GDPR), il Titolare del trattamento dei dati personali raccolti tramite il presente sito e presso la boutique dermo-specialistica è:"
  assign titolare_name = settings.titolare_name | default: 'Mile Dermocosmesi di Milena Tacchella'
  assign titolare_address = settings.titolare_address | default: 'Via Torricelle, 2c • 37128 Verona (VR) in Lebestetik Beauty & Spa'
  assign titolare_email = settings.titolare_email | default: 'info@miledermocosmesi.it'
  assign titolare_phone = settings.titolare_phone | default: '+39 045 8301811 • WhatsApp +39 342 1647585'

  assign sec2_tag = settings.sec2_tag | default: 'Dati Trattati'
  assign sec2_title = settings.sec2_title | default: 'Categorie di Dati Personali Raccolti'
  assign sec2_content = settings.sec2_content | default: "In base alle interazioni dell'utente con la piattaforma online e con la nostra sede fisica a Verona, Mile Dermocosmesi può raccogliere e trattare le seguenti tipologie di dati personali:"
  assign sec2_bullet1 = settings.sec2_bullet1 | default: 'Dati identificativi e di contatto: Nome, cognome, indirizzo di spedizione, indirizzo di fatturazione, codice fiscale/P.IVA (se richiesta fattura), indirizzo email e recapito telefonico/cellulare;'
  assign sec2_bullet2 = settings.sec2_bullet2 | default: 'Dati di pagamento e transazione: Le informazioni relative agli strumenti di pagamento (carte di credito o debito, PayPal, Apple Pay, Klarna) sono gestite e cifrate direttamente dai gateway di pagamento certificati (Shopify Payments, Stripe, PayPal) con crittografia PCI-DSS Level 1. Il Titolare non memorizza né ha accesso ai numeri completi di carta o codici CVV;'
  assign sec2_bullet3 = settings.sec2_bullet3 | default: "Dati di acquisto e storico ordini: Prodotti e rituali acquistati, frequenza d'ordine, metodo di spedizione o opzione di ritiro in sede a Verona prescelta;"
  assign sec2_bullet4 = settings.sec2_bullet4 | default: 'Dati di navigazione e tecnici: Indirizzo IP anonimizzato, log di sistema, tipo di browser, orari di accesso e parametri di connessione (come descritto nella Cookie Policy);'
  assign sec2_bullet5 = settings.sec2_bullet5 | default: "Dati forniti volontariamente per dermo-consulenze: Informazioni sulla tipologia cutanea o preferenze cosmetiche comunicate spontaneamente dall'utente tramite form o contatto WhatsApp al fine di ottenere indicazioni su misura per protocolli Team Dr. Joseph o Burro UNICHO 21."

  assign sec3_tag = settings.sec3_tag | default: 'Finalità & Basi Legali'
  assign sec3_title = settings.sec3_title | default: 'Finalità del Trattamento e Basi Giuridiche'
  assign sec3_intro = settings.sec3_intro | default: 'I dati personali sono trattati esclusivamente per scopi determinati, espliciti e legittimi, nel rispetto dei principi di correttezza e minimizzazione (art. 5 GDPR):'
  assign sec3_p1_title = settings.sec3_p1_title | default: 'Evasione Ordini e Logistica'
  assign sec3_p1_desc = settings.sec3_p1_desc | default: 'Gestione del carrello, ricezione del pagamento, allestimento delle confezioni isotermiche, spedizione con corriere espresso o ritiro in sede a Verona, gestione di resi e assistenza clienti. Base giuridica: Esecuzione del contratto di vendita (art. 6.1.b GDPR).'
  assign sec3_p2_title = settings.sec3_p2_title | default: 'Obblighi Amministrativi e Fiscali'
  assign sec3_p2_desc = settings.sec3_p2_desc | default: 'Emissione delle ricevute e fatture commerciali, adempimenti contabili e fiscali previsti dalle leggi italiane ed europee. Base giuridica: Adempimento di un obbligo legale (art. 6.1.c GDPR).'
  assign sec3_p3_title = settings.sec3_p3_title | default: 'Consulenza Dermo-Estetica Personalizzata'
  assign sec3_p3_desc = settings.sec3_p3_desc | default: "Risposta a richieste specifiche di orientamento cosmetico e allestimento rituali personalizzati pervenute via email, chat o telefono. Base giuridica: Esecuzione di misure precontrattuali su richiesta dell'interessato (art. 6.1.b GDPR)."
  assign sec3_p4_title = settings.sec3_p4_title | default: 'Newsletter e Comunicazioni Botaniche'
  assign sec3_p4_desc = settings.sec3_p4_desc | default: 'Invio di anteprime esclusive, inviti a eventi speciali presso Lebestetik Verona e novità di formulazione. Base giuridica: Consenso esplicito, facoltativo e revocabile in qualsiasi istante (art. 6.1.a GDPR).'

  assign sec4_tag = settings.sec4_tag | default: 'Misure di Tutela'
  assign sec4_title = settings.sec4_title | default: 'Modalità di Trattamento e Sicurezza dei Dati'
  assign sec4_content = settings.sec4_content | default: "Il trattamento dei dati personali avviene mediante strumenti informatici, telematici e, in via residuale per gli archivi d'istituto, cartacei, con logiche strettamente correlate alle finalità sopra indicate. Mile Dermocosmesi adotta idonee misure tecniche e organizzative di sicurezza ai sensi dell'art. 32 del GDPR per proteggere i dati da accessi non autorizzati, divulgazione, alterazione o distruzione:"
  assign sec4_box1_title = settings.sec4_box1_title | default: 'Crittografia SSL/TLS e Protezione Server'
  assign sec4_box1_desc = settings.sec4_box1_desc | default: "L'intera navigazione e il checkout sul sito Mile Dermocosmesi avvengono su canale cifrato con certificato SSL a 256 bit su infrastruttura Shopify conforme agli standard di sicurezza internazionali più stringenti."
  assign sec4_box2_title = settings.sec4_box2_title | default: 'Controllo degli Accessi e Riservatezza'
  assign sec4_box2_desc = settings.sec4_box2_desc | default: "L'accesso ai database è consentito esclusivamente alla titolare Milena Tacchella e agli incaricati formati, tramite credenziali individuali complesse e autenticazione a due fattori."

  assign sec5_tag = settings.sec5_tag | default: 'Condivisione Dati'
  assign sec5_title = settings.sec5_title | default: 'Destinatari e Comunicazione dei Dati a Terzi'
  assign sec5_content = settings.sec5_content | default: "I dati personali dell'utente non saranno mai venduti, noleggiati o ceduti a fini di lucro a terze parti estranee. Per adempiere alle obbligazioni contrattuali e legali, i dati potranno essere comunicati unicamente a:"
  assign sec5_bullet1 = settings.sec5_bullet1 | default: 'Corrieri e vettori logistici convenzionati (GLS, BRT, DHL Express) per la presa in carico, il trasporto e la consegna a domicilio del pacco;'
  assign sec5_bullet2 = settings.sec5_bullet2 | default: "Fornitori di servizi di pagamento elettronico (Shopify Payments, Stripe, PayPal) per la transazione sicura dell'ordine;"
  assign sec5_bullet3 = settings.sec5_bullet3 | default: "Laboratori partner dermo-cosmetici europei (es. Selfnamed) nei soli limiti tecnici indispensabili all'allestimento on-demand e spedizione delle formulazioni personalizzate;"
  assign sec5_bullet4 = settings.sec5_bullet4 | default: 'Consulenti contabili, commercialisti e consulenti legali per gli adempimenti fiscali di legge o per la tutela dei diritti contrattuali del Titolare.'

  assign sec6_tag = settings.sec6_tag | default: 'Confini Geografici'
  assign sec6_title = settings.sec6_title | default: 'Trasferimento dei Dati Extra-UE'
  assign sec6_content = settings.sec6_content | default: "La gestione operativa e l'infrastruttura di hosting della piattaforma Mile Dermocosmesi poggiano sui server di Shopify Inc. Qualora alcuni dati siano temporaneamente conservati o instradati verso server collocati al di fuori dello Spazio Economico Europeo (es. Stati Uniti o Canada), tale trasferimento avviene nel rigoroso rispetto del Capo V del GDPR, mediante l'adozione delle Clausole Contrattuali Standard (Standard Contractual Clauses - SCC) approvate dalla Commissione Europea e in conformità all'EU-US Data Privacy Framework."

  assign sec7_tag = settings.sec7_tag | default: 'Tempi di Conservazione'
  assign sec7_title = settings.sec7_title | default: 'Periodo di Conservazione dei Dati (Data Retention)'
  assign sec7_content = settings.sec7_content | default: 'I dati personali vengono conservati per il tempo strettamente necessario a conseguire le finalità per cui sono stati raccolti, conformemente alle previsioni di legge:'
  assign sec7_ret1_title = settings.sec7_ret1_title | default: 'Dati di Fatturazione e Fiscopuro'
  assign sec7_ret1_desc = settings.sec7_ret1_desc | default: "Conservati per 10 anni dalla data dell'acquisto, in conformità agli obblighi contabili e civilistici ex art. 2220 c.c."
  assign sec7_ret2_title = settings.sec7_ret2_title | default: 'Dati di Account e Ordini'
  assign sec7_ret2_desc = settings.sec7_ret2_desc | default: "Conservati per tutta la durata del rapporto commerciale o fino all'eventuale richiesta di cancellazione da parte del cliente."
  assign sec7_ret3_title = settings.sec7_ret3_title | default: 'Dati per Finalità di Marketing'
  assign sec7_ret3_desc = settings.sec7_ret3_desc | default: "Conservati fino alla revoca del consenso (disiscrizione autonoma con link presente in ogni email) o per un massimo di 24 mesi dall'ultima interazione."

  assign sec8_tag = settings.sec8_tag | default: 'Esercizio Diritti'
  assign sec8_title = settings.sec8_title | default: "Diritti dell'Interessato (Artt. 15-22 del GDPR)"
  assign sec8_content = settings.sec8_content | default: 'In qualità di interessato, il cliente ha il pieno diritto di esercitare in ogni momento le facoltà previste dagli articoli da 15 a 22 del Regolamento UE 2016/679:'
  assign sec8_garante_note = settings.sec8_garante_note | default: "Qualora l'interessato ritenga che il trattamento dei propri dati personali avvenga in violazione del GDPR, ha il diritto di proporre reclamo all'Autorità Garante per la Protezione dei Dati Personali (Piazza Venezia 11, 00187 Roma - www.garanteprivacy.it) o di adire le opportune sedi giudiziarie."

  assign sec9_tag = settings.sec9_tag | default: 'Tutela Minori'
  assign sec9_title = settings.sec9_title | default: 'Trattamento dei Dati dei Minori di Anni 18'
  assign sec9_content = settings.sec9_content | default: 'I servizi e i prodotti cosmetici offerti sul sito web Mile Dermocosmesi sono riservati a persone maggiorenni. Mile Dermocosmesi non raccoglie consapevolmente dati personali relativi a minori di 18 anni. Nel caso in cui dovesse essere riscontrata la registrazione involontaria di dati di un minore, tali informazioni saranno tempestivamente cancellate dai nostri sistemi.'

  assign sec10_tag = settings.sec10_tag | default: 'Revisione Normativa'
  assign sec10_title = settings.sec10_title | default: "Modifiche e Aggiornamenti dell'Informativa"
  assign sec10_content = settings.sec10_content | default: 'Il Titolare si riserva il diritto di modificare o aggiornare la presente Informativa sulla Privacy in qualsiasi momento, anche in conseguenza di variazioni legislative o regolamentari intervenute. La versione aggiornata sarà sempre consultabile con indicazione della data di ultima revisione.'

  assign help_title = settings.help_title | default: 'Assistenza Privacy & Contatto Diretto'
  assign help_desc = settings.help_desc | default: 'Per esercitare i tuoi diritti privacy, richiedere la rettifica o la cancellazione dei tuoi dati o per qualunque chiarimento relativo alla tutela della riservatezza, contatta direttamente il nostro referente:'
  assign help_whatsapp_text = settings.help_whatsapp_text | default: 'WhatsApp Diretto 3421647585'
  assign help_whatsapp_url = settings.help_whatsapp_url | default: 'https://wa.me/393421647585'
  assign help_email_text = settings.help_email_text | default: 'Scrivici'
  assign help_email_address = settings.help_email_address | default: 'info@miledermocosmesi.it'
-%}

<div class="policy-privacy-wrapper bg-[#F5F2EB] text-[#1A1A1A] py-10 sm:py-16 lg:py-20 font-sans selection:bg-[#C8A878] selection:text-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">

    <!-- BREADCRUMBS -->
    <nav class="flex items-center gap-2 text-[11px] sm:text-xs font-mono uppercase tracking-widest text-[#7A7265] border-b border-[#E5E0D8] pb-4" aria-label="Percorso di navigazione">
      <a href="{{ routes.root_url }}" class="hover:text-[#1A1A1A] transition-colors">Home</a>
      <span class="text-[#DDD7CE]">/</span>
      <span class="text-[#7A7265]">Informative</span>
      <span class="text-[#DDD7CE]">/</span>
      <span class="text-[#1A1A1A] font-semibold">Privacy Policy</span>
    </nav>

    <!-- HEADER HAUTE COUTURE -->
    <header class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-[#FAF8F5] border border-[#C8A878]/40 text-[#C8A878] text-[10px] sm:text-[11px] font-mono tracking-[0.2em] uppercase font-semibold shadow-xs">
        <span class="text-xs">🔒</span>
        <span>{{ eyebrow }}</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#1A1A1A] font-normal leading-tight tracking-tight">
        {{ title }}
      </h1>

      <p class="text-sm sm:text-base text-[#7A7265] font-light leading-relaxed max-w-2xl mx-auto">
        {{ subtitle }}
      </p>

      <div class="pt-2 flex flex-wrap items-center justify-center gap-3 text-xs text-[#5C6B56] font-mono">
        {%- if last_updated != blank -%}
          <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1 border border-[#E5E0D8] text-[#7A7265]">
            <span>🕒</span>
            {{ last_updated }}
          </span>
        {%- endif -%}
        {%- if badge_location != blank -%}
          <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1 border border-[#E5E0D8]">
            <span>📍</span>
            {{ badge_location }}
          </span>
        {%- endif -%}
        {%- if badge_normative != blank -%}
          <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1 border border-[#E5E0D8] text-[#5C6B56]">
            <span>🛡️</span>
            {{ badge_normative }}
          </span>
        {%- endif -%}
      </div>
    </header>

    <!-- CONTENUTO PAGINA SHOPIFY ADMIN (IN EVIDENZA PRIORITARIA) -->
    {%- if page.content != blank -%}
      <div class="bg-white border border-[#DDD7CE] p-6 sm:p-10 lg:p-12 shadow-xs relative" style="border: 3px double #EDE5DB;">
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-[#F5F2EB] text-[#C8A878] font-mono text-xs uppercase tracking-widest font-semibold">
          <span>🔒</span>
          <span>Informativa Privacy Personalizzata da Admin</span>
        </div>
        <div class="rte prose max-w-none text-sm sm:text-base text-[#1A1A1A] leading-relaxed font-light space-y-4">
          {{ page.content }}
        </div>
      </div>
    {%- endif -%}

    {%- unless settings.show_only_page_content and page.content != blank -%}
      <!-- HIGHLIGHT SUMMARY CARDS -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- Card 1 -->
        <div class="bg-white border border-[#E5E0D8] p-6 shadow-xs flex flex-col justify-between relative overflow-hidden" style="border-top: 3px solid #5C6B56;">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-mono uppercase tracking-widest text-[#5C6B56] font-semibold">{{ card1_badge }}</span>
              <span class="text-xs">🔐</span>
            </div>
            <h3 class="font-serif text-lg text-[#1A1A1A] mb-2">{{ card1_title }}</h3>
            <div class="text-xs text-[#7A7265] leading-relaxed font-light">
              {{ card1_desc }}
            </div>
          </div>
          {%- if card1_footer != blank -%}
            <div class="mt-4 pt-3 border-t border-[#F5F2EB] text-[11px] font-mono text-[#5C6B56] flex items-center gap-1.5">
              {{ card1_footer }}
            </div>
          {%- endif -%}
        </div>

        <!-- Card 2 -->
        <div class="bg-white border border-[#E5E0D8] p-6 shadow-xs flex flex-col justify-between relative overflow-hidden" style="border-top: 3px solid #C8A878;">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-mono uppercase tracking-widest text-[#C8A878] font-semibold">{{ card2_badge }}</span>
              <span class="text-xs">📜</span>
            </div>
            <h3 class="font-serif text-lg text-[#1A1A1A] mb-2">{{ card2_title }}</h3>
            <div class="text-xs text-[#7A7265] leading-relaxed font-light">
              {{ card2_desc }}
            </div>
          </div>
          {%- if card2_footer != blank -%}
            <div class="mt-4 pt-3 border-t border-[#F5F2EB] text-[11px] font-mono text-[#C8A878] flex items-center gap-1.5">
              {{ card2_footer }}
            </div>
          {%- endif -%}
        </div>

        <!-- Card 3 -->
        <div class="bg-white border border-[#E5E0D8] p-6 shadow-xs flex flex-col justify-between relative overflow-hidden" style="border-top: 3px solid #1A1A1A;">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-mono uppercase tracking-widest text-[#1A1A1A] font-semibold">{{ card3_badge }}</span>
              <span class="text-xs">⚖️</span>
            </div>
            <h3 class="font-serif text-lg text-[#1A1A1A] mb-2">{{ card3_title }}</h3>
            <div class="text-xs text-[#7A7265] leading-relaxed font-light">
              {{ card3_desc }}
            </div>
          </div>
          {%- if card3_footer != blank -%}
            <div class="mt-4 pt-3 border-t border-[#F5F2EB] text-[11px] font-mono text-[#5C6B56] flex items-center gap-1.5">
              {{ card3_footer }}
            </div>
          {%- endif -%}
        </div>

      </div>

      <!-- INDICE RAPIDO (TOC) -->
      <div class="bg-[#FAF8F5] border border-[#DDD7CE] p-6 sm:p-8">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-2 h-2 rounded-full bg-[#C8A878]"></span>
          <h2 class="font-serif text-lg text-[#1A1A1A] font-medium tracking-wide">Indice Sintetico dei Capitoli</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-2 text-xs font-mono text-[#7A7265]">
          <a href="#priv-1" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">01.</span> {{ sec1_title }}
          </a>
          <a href="#priv-2" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">02.</span> {{ sec2_title }}
          </a>
          <a href="#priv-3" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">03.</span> {{ sec3_title }}
          </a>
          <a href="#priv-4" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">04.</span> {{ sec4_title }}
          </a>
          <a href="#priv-5" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">05.</span> {{ sec5_title }}
          </a>
          <a href="#priv-6" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">06.</span> {{ sec6_title }}
          </a>
          <a href="#priv-7" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">07.</span> {{ sec7_title }}
          </a>
          <a href="#priv-8" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">08.</span> {{ sec8_title }}
          </a>
          <a href="#priv-9" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">09.</span> {{ sec9_title }}
          </a>
          <a href="#priv-10" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">10.</span> {{ sec10_title }}
          </a>
        </div>
      </div>

      <!-- SEZIONI NORMATIVE DETTAGLIATE -->
