        {%- if help_email_address != blank -%}
          <a href="mailto:{{ help_email_address }}" class="px-5 py-2.5 bg-white border border-[#DDD7CE] hover:border-[#1A1A1A] text-[#1A1A1A] transition-colors uppercase tracking-wider font-semibold inline-flex items-center gap-2">
            <span>✉️</span> {{ help_email_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
    {%- endunless -%}

  </div>
</div>