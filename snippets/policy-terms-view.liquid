{% comment %}
  MILEBIOLAB - SNIPPET POLICY TERMS VIEW (HAUTE COUTURE LUSH DESIGN)
  Informativa Termini e Condizioni Generali di Vendita e di Servizio.
  Completamente personalizzabile dal Theme Editor di Shopify in tempo reale.
  Supporta blocchi personalizzati OS 2.0 e visualizzazione di page.content.
  Palette Splendor & Dr. Joseph: #F5F2EB, #FAF8F5, #1A1A1A, #5C6B56, #C8A878, #E5E0D8, #DDD7CE.
{% endcomment %}

{%- liquid
  assign settings = section.settings | default: settings
  assign blocks = section.blocks | default: blocks
  assign eyebrow = settings.eyebrow | default: eyebrow | default: 'DOCUMENTO UFFICIALE • CONTRATTO DI VENDITA'
  assign title = settings.title | default: title | default: 'Termini e Condizioni Generali di Vendita e di Servizio'
  assign subtitle = settings.subtitle | default: "Regolamento contrattuale applicabile all'acquisto dei prodotti cosmetici biomimetici, protocolli di longevità cutanea e servizi boutique erogati da Mile Dermocosmesi."
  assign last_updated = settings.last_updated | default: 'Ultimo aggiornamento: 21 Ottobre 2026'
  assign badge_location = settings.badge_location | default: 'Lebestetik Beauty & Spa • Verona'

  assign card1_badge = settings.card1_badge | default: 'Sicurezza Contrattuale'
  assign card1_title = settings.card1_title | default: 'Trasparenza & Prezzi IVA Inclusa'
  assign card1_desc = settings.card1_desc | default: 'Tutti i prezzi sono espressi in Euro (€) con IVA 22% inclusa. Transazioni crittografate SSL a 256 bit e conformità rigorosa al Codice del Consumo (D.Lgs. 206/2005).'
  assign card1_footer = settings.card1_footer | default: '✓ Pagamenti 3D Secure 2.0'

  assign card2_badge = settings.card2_badge | default: 'Modello Integrato'
  assign card2_title = settings.card2_title | default: 'Mile Dermocosmesi'
  assign card2_desc = settings.card2_desc | default: "Le eccellenze d'istituto viaggiano dalla nostra sede di Verona e dai laboratori certificati Europei, per questo ci possono essere ordini misti senza costi aggiuntivi."
  assign card2_footer = settings.card2_footer | default: '✓ Garanzia & Assistenza Unificate'

  assign card3_badge = settings.card3_badge | default: 'Tutela della Salute'
  assign card3_title = settings.card3_title | default: 'Clausola Cosmetica Art. 59'
  assign card3_desc = settings.card3_desc | default: 'Recesso di 14 giorni per prodotti sigillati. Per motivi igienico-sanitari e a salvaguardia della pelle, il recesso è escluso su cosmetici aperti o usati.'
  assign card3_footer = settings.card3_footer | default: '✓ Confezioni Sigillate a Norma'

  assign show_toc = true
  if settings.show_toc == false
    assign show_toc = false
  endif
  assign toc_title = settings.toc_title | default: 'Indice delle Clausole Contrattuali'

  assign art1_title = settings.art1_title | default: 'Informazioni Generali e Dati Societari'
  assign art1_content = settings.art1_content | default: 'Il presente sito web (di seguito denominato la "Piattaforma" o il "Sito") è di proprietà ed è gestito da Mile Dermocosmesi di Milena Tacchella, ditta individuale operante con sede legale e operativa presso la prestigiosa sede e flagship boutique:'
  assign company_name = settings.company_name | default: 'Mile Dermocosmesi di Milena Tacchella'
  assign company_address = settings.company_address | default: 'Via Torricelle, 2c • 37128 Verona (VR) in Lebestetik Beauty & Spa'
  assign company_email = settings.company_email | default: 'info@miledermocosmesi.it'
  assign company_concierge_email = settings.company_concierge_email | default: 'info@miledermocosmesi.it'
  assign company_phone = settings.company_phone | default: '+39 045 8301811 • WhatsApp +39 342 1647585'
  assign company_whatsapp = settings.company_whatsapp | default: '+39 342 1647585'
  assign art1_note = settings.art1_note | default: "I presenti Termini e Condizioni Generali regolano l'offerta, l'inoltro e l'accettazione di ordini d'acquisto di prodotti cosmetici e correlati servizi di bellezza effettuati a distanza tramite la piattaforma telematica tra il Venditore e qualsiasi persona fisica che agisca per scopi estranei all'attività imprenditoriale o professionale (di seguito il Cliente o Consumatore ai sensi del D.Lgs. 206/2005)."

  assign art2_title = settings.art2_title | default: 'Oggetto del Servizio e Natura dei Prodotti Cosmetici'
  assign art2_content = settings.art2_content | default: "Mile Dermocosmesi commercializza prodotti cosmetici e nutrizionali naturali di altissima gamma con percentuali di origine naturale comprese tra il 98%, 99% e 100%, fito-estratti botanici puri, protocolli rigenerativi Team Dr. Joseph, linee di longevità cutanea e creazioni iconiche della Maestra d'Arte Mile quali la linea e il Burro Primordiale UNICHO 21, oltre a voucher per trattamenti cabina presso l'istituto di Verona."
  assign art2_box_title = settings.art2_box_title | default: "Finalità e Destinazione d'Uso (Regolamento CE 1223/2009):"
  assign art2_box_content = settings.art2_box_content | default: "Tutti i prodotti offerti sono destinati esclusivamente ad uso topico ed esterno per la cura, protezione e benessere dell'epidermide, in piena rispondenza al Regolamento (CE) n. 1223/2009 sui prodotti cosmetici. Non costituiscono dispositivi medici né farmaci e non hanno proprietà terapeutiche o curative di affezioni patologiche. Le immagini e le descrizioni presenti nelle schede prodotto riproducono fedelmente le formulazioni, le consistenze olfattive e sensoriali. Trattandosi di materie prime naturali di origine botanica, lievi variazioni di colore o profumazione da un lotto all'altro testimoniano l'autenticità e la purezza della lavorazione."

  assign art3_title = settings.art3_title | default: 'Modello di Produzione ed Evasione Ibrido Mile Dermocosmesi (Verona & Laboratori Europei)'
  assign art3_content = settings.art3_content | default: "A garanzia della massima freschezza cosmetica e trasparenza verso la clientela, Mile Dermocosmesi adotta un innovativo modello dermo-produttivo ed evasivo articolato su due filiere d'eccellenza:"
  assign art3_polo_a_title = settings.art3_polo_a_title | default: 'A) Sede e Flagship Verona'
  assign art3_polo_a_desc = settings.art3_polo_a_desc | default: "Le formulazioni proprietarie d'istituto (tra cui il Burro UNICHO 21 e i protocolli Team Dr. Joseph) vengono custodite, confezionate ed evase direttamente dalla sede di Lebestetik Beauty & Spa a Verona."
  assign art3_polo_b_title = settings.art3_polo_b_title | default: 'B) Laboratori On-Demand Certificati'
  assign art3_polo_b_desc = settings.art3_polo_b_desc | default: 'Le formule on-demand personalizzate vengono realizzate ed evase fresche in partnership certificata con i laboratori europei (conformità ISO 22716, standard Cosmos Natural / ECOCERT).'
  assign art3_guarantee_title = settings.art3_guarantee_title | default: '🌟 Clausola di Garanzia Unificata e Spedizione Senza Raddoppio di Spese:'
  assign art3_guarantee_text = settings.art3_guarantee_text | default: "Qualora un ordine contenga congiuntamente referenze a marchio Mile Dermocosmesi e formule allestite tramite laboratori partner europei, l'ordine è processato come un'unica transazione. Al Cliente viene addebitata una sola spesa di spedizione unificata (o azzerata se supera la soglia di gratuità). Nel caso in cui per motivi di salvaguardia della freschezza l'ordine venga recapitato mediante due colli separati con differenti codici di tracciamento, non vi sarà alcun costo aggiuntivo a carico del Cliente. La titolarità del contratto, la fatturazione, la garanzia legale di conformità e il servizio clienti rimangono accentrati unicamente in capo a Mile Dermocosmesi di Milena Tacchella."

  assign art4_title = settings.art4_title | default: 'Prezzi, Valuta e Modalità di Pagamento Sicure'
  assign art4_content = settings.art4_content | default: "Tutti i prezzi di vendita esposti sul Sito sono espressi in Euro (€) e si intendono comprensivi dell'Imposta sul Valore Aggiunto (IVA al 22%) e di ogni altra imposta applicabile. Le spese di spedizione, ove dovute, sono chiaramente calcolate ed evidenziate nella pagina di riepilogo del carrello prima dell'invio definitivo dell'ordine. Mile Dermocosmesi si avvale dei più avanzati gateway di pagamento telematico dotati di crittografia end-to-end e standard PCI-DSS Livello 1: Carte di credito/debito (Visa, Mastercard, Maestro, American Express), Apple Pay, Google Pay, Shop Pay, PayPal con protezione acquisti e pagamento in contanti o POS presso la nostra boutique di Verona in caso di selezione 'Ritiro Gratuito in Sede'. I dati sensibili della carta di pagamento transitano direttamente sui server sicuri del gestore bancario con protocollo 3D Secure 2.0; in nessun momento Mile Dermocosmesi accede né archivia i dati finanziari o il codice CVV del Cliente."

  assign art5_title = settings.art5_title | default: "Conclusione del Contratto e Accettazione dell'Ordine"
  assign art5_content = settings.art5_content | default: "L'invio dell'ordine tramite il modulo telematico costituisce proposta contrattuale d'acquisto a titolo oneroso. Il contratto di compravendita si intende perfezionato e vincolante nel momento in cui Mile Dermocosmesi trasmette al Cliente, all'indirizzo email comunicato, la Conferma d'Ordine Ufficiale contenente il riepilogo dettagliato dei prodotti acquistati, il corrispettivo pagato, l'indirizzo di spedizione prescelto e i riferimenti di assistenza. Qualora eccezionalmente uno dei prodotti ordinati non risulti disponibile o presenti un lotto in preparazione, il nostro Servizio Assistenza contatterà tempestivamente il Cliente offrendo l'attesa del lotto fresco, la sostituzione con formula equivalente o il rimborso integrale e immediato dell'importo corrisposto."

  assign art6_title = settings.art6_title | default: 'Spedizioni, Consegna e Ritiro in Sede a Verona'
  assign art6_content = settings.art6_content | default: "Mile Dermocosmesi effettua spedizioni su tutto il territorio italiano (comprese isole maggiori, minori e laguna veneta) e a livello internazionale nell'Unione Europea ed Extra-UE:"

  assign art7_title = settings.art7_title | default: 'Diritto di Recesso e Politica di Reso (Tutela Igienico-Sanitaria)'
  assign art7_content = settings.art7_content | default: 'Ai sensi degli articoli 52 e seguenti del D.Lgs. 6 settembre 2005, n. 206 (Codice del Consumo), il Cliente Consumatore ha diritto di recedere dal contratto di acquisto, senza alcuna penalità e senza specificarne il motivo, entro il termine di 14 (quattordici) giorni di calendario a decorrere dalla data di materiale ricezione dei prodotti.'
  assign art7_warning_title = settings.art7_warning_title | default: '⚠️ Eccezione Igienico-Sanitaria ex Art. 59, comma 1, lett. e, Codice del Consumo'
  assign art7_warning_quote = settings.art7_warning_quote | default: '«Il diritto di recesso è espressamente ESCLUSO per la fornitura di beni sigillati che non si prestano ad essere restituiti per motivi igienici o connessi alla protezione della salute e che sono stati aperti o dissigillati dopo la consegna.»'
  assign art7_warning_desc = settings.art7_warning_desc | default: "Pertanto, il recesso può essere esercitato esclusivamente per prodotti perfettamente intatti, non dissigillati, non aperti, non provati e con il sigillo di garanzia o la pellicola protettiva completamente intonsa, conservati nell'imballaggio originario provvisto di tutti gli accessori, bugiardini o campioncini abbinati."
  assign art7_steps_title = settings.art7_steps_title | default: 'Procedura Operativa per il Reso:'
  assign art7_step1 = settings.art7_step1 | default: "Inviare entro 14 giorni dalla consegna una comunicazione scritta a info@miledermocosmesi.it indicando numero d'ordine, referenze da restituire e conferma che il sigillo igienico è intatto."
  assign art7_step2 = settings.art7_step2 | default: "Ricevere l'autorizzazione formale al rientro (Codice RMA) dal Servizio Clienti Mile Dermocosmesi."
  assign art7_step3 = settings.art7_step3 | default: 'Imballare i prodotti con la massima cura e spedirli a proprie spese con corriere tracciato presso la sede: Mile Dermocosmesi c/o Lebestetik Beauty & Spa, Via Torricelle, 2c • 37128 Verona (VR).'
  assign art7_step4 = settings.art7_step4 | default: "A seguito della verifica peritale dell'integrità del packaging e dei sigilli di sicurezza da parte del laboratorio, Mile Dermocosmesi provvederà al rimborso dell'importo entro 14 giorni con lo stesso metodo di pagamento."

  assign art8_title = settings.art8_title | default: 'Garanzia Legale di Conformità e Tollerabilità Cutanea'
  assign art8_content = settings.art8_content | default: "Tutti i prodotti commercializzati da Mile Dermocosmesi beneficiano della Garanzia Legale di Conformità di 24 mesi prevista dagli artt. 128-135 del Codice del Consumo a tutela di eventuali difetti di conformità originari (es. difetto del meccanismo dispenser, flacone fallato all'origine)."
  assign art8_box_title = settings.art8_box_title | default: "Consigli d'Uso, Conservazione e Test di Tollerabilità:"
  assign art8_box_desc = settings.art8_box_desc | default: "Per preservare intatte le proprietà biomimetiche degli attivi vegetali puri, i prodotti devono essere conservati in un ambiente fresco e asciutto, lontano dalla luce solare diretta e da fonti di calore. Invitiamo sempre i soggetti con pelli particolarmente reattive o con allergie note a verificare con attenzione l'INCI (lista ingredienti) riportato sulla scheda prodotto e a svolgere un preliminare patch test cutaneo (applicando una piccola goccia di prodotto sulla piega interna del gomito) 24 ore prima dell'applicazione continuativa."

  assign art9_title = settings.art9_title | default: 'Programma Fedeltà Beauty Club Mile (Regole Punti e Sconti)'
  assign art9_content = settings.art9_content | default: "L'iscrizione gratuita al programma fedeltà Beauty Club Mile consente agli utenti registrati di accumulare Beauty Punti secondo il rapporto base di 1 € speso = 1 Beauty Punto (oltre a punti speciali per compleanno e recensioni verificate). Ogni 100 Beauty Punti accumulati danno diritto a un buono sconto immediato di € 5,00 convertibile direttamente in fase di checkout. I punti hanno natura promozionale, sono strettamente personali, non sono cedibili a terzi né convertibili in denaro liquido. Per il regolamento dettagliato, si rinvia alla pagina ufficiale Beauty Club Mile."

  assign art10_title = settings.art10_title | default: 'Proprietà Intellettuale, Marchi e Diritti Riservati'
  assign art10_content = settings.art10_content | default: "Tutti i contenuti presenti sul Sito, inclusi a titolo esemplificativo marchi figurativi e denominativi (Mile Dermocosmesi, Lebestetik, UNICHO 21), testi descrittivi, fotografie, rendering estetici, layout grafici, codice sorgente e video tutorial, sono di proprietà esclusiva di Milena Tacchella o dei rispettivi partner licenziatari e sono tutelati dalle leggi in materia di diritto d'autore e proprietà industriale."

  assign art11_title = settings.art11_title | default: 'Legge Applicabile, Risoluzione Controversie e Foro Competente'
  assign art11_content = settings.art11_content | default: 'I presenti Termini e Condizioni e i relativi contratti di compravendita sono integralmente regolati e interpretati in conformità alla Legge della Repubblica Italiana. Per qualsiasi controversia tra Mile Dermocosmesi e il Cliente Consumatore residente o domiciliato nella UE, la competenza inderogabile spetta al Giudice del consumatore (art. 66-bis D.Lgs. 206/2005). Per acquisti B2B, è convenuto il Foro di Verona.'
  assign art11_odr_title = settings.art11_odr_title | default: 'Risoluzione Alternativa delle Controversie Online (ODR):'
  assign art11_odr_text = settings.art11_odr_text | default: "Ai sensi del Regolamento UE n. 524/2013, il Consumatore residente nella UE può promuovere la risoluzione extragiudiziale delle controversie attraverso la piattaforma europea ODR accessibile all'indirizzo: https://ec.europa.eu/consumers/odr."

  assign help_badge = settings.help_badge | default: 'Assistenza Diretta'
  assign help_title = settings.help_title | default: 'Hai domande sui termini o sul tuo ordine?'
  assign help_desc = settings.help_desc | default: 'Siamo a tua completa disposizione presso la sede di Verona per chiarimenti legali, assistenza pre-acquisto e supporto su ogni spedizione.'
  assign help_whatsapp_text = settings.help_whatsapp_text | default: 'WhatsApp Diretto 3421647585'
  assign help_whatsapp_url = settings.help_whatsapp_url | default: 'https://wa.me/393421647585'
  assign help_email_text = settings.help_email_text | default: 'Scrivici'
  assign help_email_address = settings.help_email_address | default: 'info@miledermocosmesi.it'
-%}

<div class="policy-terms-wrapper bg-[#F5F2EB] text-[#1A1A1A] py-10 sm:py-16 lg:py-20 font-sans selection:bg-[#C8A878] selection:text-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">

    <!-- BREADCRUMBS -->
    <nav class="flex items-center gap-2 text-[11px] sm:text-xs font-mono uppercase tracking-widest text-[#7A7265] border-b border-[#E5E0D8] pb-4" aria-label="Percorso di navigazione">
      <a href="{{ routes.root_url }}" class="hover:text-[#1A1A1A] transition-colors">Home</a>
      <span class="text-[#DDD7CE]">/</span>
      <span class="text-[#7A7265]">Informative</span>
      <span class="text-[#DDD7CE]">/</span>
      <span class="text-[#1A1A1A] font-semibold">Termini e Condizioni</span>
    </nav>

    <!-- HEADER HAUTE COUTURE -->
    <header class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-[#FAF8F5] border border-[#C8A878]/40 text-[#C8A878] text-[10px] sm:text-[11px] font-mono tracking-[0.2em] uppercase font-semibold shadow-xs">
        <span class="text-xs">📜</span>
        <span>{{ eyebrow }}</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#1A1A1A] font-normal leading-tight tracking-tight">
        {{ title }}
      </h1>

      <p class="text-sm sm:text-base text-[#7A7265] font-light leading-relaxed max-w-2xl mx-auto">
        {{ subtitle }}
      </p>

      <div class="pt-2 flex flex-wrap items-center justify-center gap-3 text-xs text-[#5C6B56] font-mono">
        {%- if last_updated != blank -%}
          <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1 border border-[#E5E0D8]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#5C6B56]"></span>
            {{ last_updated }}
          </span>
        {%- endif -%}
        {%- if badge_location != blank -%}
          <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1 border border-[#E5E0D8]">
            <span>📍</span>
            {{ badge_location }}
          </span>
        {%- endif -%}
      </div>
    </header>

        <!-- CONTENUTO PAGINA SHOPIFY ADMIN (IN EVIDENZA PRIORITARIA) -->
    {%- if page.content != blank -%}
      <div class="bg-white border border-[#DDD7CE] p-6 sm:p-10 lg:p-12 shadow-xs relative" style="border: 3px double #EDE5DB;">
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-[#F5F2EB] text-[#C8A878] font-mono text-xs uppercase tracking-widest font-semibold">
          <span>📜</span>
          <span>Termini Contrattuali Personalizzati da Admin</span>
        </div>
        <div class="rte prose max-w-none text-sm sm:text-base text-[#1A1A1A] leading-relaxed font-light space-y-4">
          {{ page.content }}
        </div>
      </div>
    {%- endif -%}

    {%- unless settings.show_only_page_content and page.content != blank -%}
<!-- HIGHLIGHT SUMMARY CARDS -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Card 1 -->
      <div class="bg-white border border-[#E5E0D8] p-6 shadow-xs flex flex-col justify-between relative overflow-hidden" style="border-top: 3px solid #C8A878;">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-[#C8A878] font-semibold block mb-2">{{ card1_badge }}</span>
          <h3 class="font-serif text-lg text-[#1A1A1A] mb-2">{{ card1_title }}</h3>
          <div class="text-xs text-[#7A7265] leading-relaxed font-light">
            {{ card1_desc }}
          </div>
        </div>
        {%- if card1_footer != blank -%}
          <div class="mt-4 pt-3 border-t border-[#F5F2EB] text-[11px] font-mono text-[#5C6B56]">
            {{ card1_footer }}
          </div>
        {%- endif -%}
      </div>

      <!-- Card 2 -->
      <div class="bg-white border border-[#E5E0D8] p-6 shadow-xs flex flex-col justify-between relative overflow-hidden" style="border-top: 3px solid #5C6B56;">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-[#5C6B56] font-semibold block mb-2">{{ card2_badge }}</span>
          <h3 class="font-serif text-lg text-[#1A1A1A] mb-2">{{ card2_title }}</h3>
          <div class="text-xs text-[#7A7265] leading-relaxed font-light">
            {{ card2_desc }}
          </div>
        </div>
        {%- if card2_footer != blank -%}
          <div class="mt-4 pt-3 border-t border-[#F5F2EB] text-[11px] font-mono text-[#5C6B56]">
            {{ card2_footer }}
          </div>
        {%- endif -%}
      </div>

      <!-- Card 3 -->
      <div class="bg-white border border-[#E5E0D8] p-6 shadow-xs flex flex-col justify-between relative overflow-hidden" style="border-top: 3px solid #1A1A1A;">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-[#1A1A1A] font-semibold block mb-2">{{ card3_badge }}</span>
          <h3 class="font-serif text-lg text-[#1A1A1A] mb-2">{{ card3_title }}</h3>
          <div class="text-xs text-[#7A7265] leading-relaxed font-light">
            {{ card3_desc }}
          </div>
        </div>
        {%- if card3_footer != blank -%}
          <div class="mt-4 pt-3 border-t border-[#F5F2EB] text-[11px] font-mono text-[#5C6B56]">
            {{ card3_footer }}
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- INDICE RAPIDO (TOC) -->
    {%- if show_toc -%}
      <div class="bg-[#FAF8F5] border border-[#DDD7CE] p-6 sm:p-8">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-2 h-2 rounded-full bg-[#C8A878]"></span>
          <h2 class="font-serif text-lg text-[#1A1A1A] font-medium tracking-wide">{{ toc_title }}</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-2 text-xs font-mono text-[#7A7265]">
          <a href="#art-1" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">01.</span> {{ art1_title }}
          </a>
          <a href="#art-2" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">02.</span> {{ art2_title }}
          </a>
          <a href="#art-3" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">03.</span> {{ art3_title }}
          </a>
          <a href="#art-4" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">04.</span> {{ art4_title }}
          </a>
          <a href="#art-5" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
            <span class="text-[#C8A878] font-bold">05.</span> {{ art5_title }}
          </a>
          <a href="#art-6" class="hover:text-[#C8A878] transition-colors py-1 flex items-center gap-2">
