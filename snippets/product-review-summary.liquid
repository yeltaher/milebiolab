{%- comment -%}
  -----------------------------------------------------------------------------
  Product Review Summary Snippet - MileBioLab Splendor
  Centralized source of truth for verified review counts and scores across
  product cards (collection, featured-products, search) and PDP summary blocks.

  Priority:
  1. Real catalog reviews curated in templates/product.json (100% authentic)
  2. Judge.me / Shopify Reviews / Custom metafields (if present and > 0)
  3. Default: review_count = 0 (no arbitrary fallbacks!)

  Parameters:
  - product: Product object
  - format: 'card' (default), 'pdp', 'score', 'count'
  -----------------------------------------------------------------------------
{%- endcomment -%}

{%- assign review_count = 0 -%}
{%- assign review_score = '5.0' -%}

{%- if product != blank -%}
  {%- assign prod_handle = product.handle | downcase -%}
  {%- assign prod_title = product.title | downcase -%}

  {%- comment -%} 1. Direct 1:1 Mapping of Real Catalog Reviews from templates/product.json {%- endcomment -%}
  {%- if prod_handle == 'unicho-21-burro-primordiale-50ml' or prod_handle contains 'unicho' or prod_title contains 'unicho' or prod_title contains 'burro primordiale' -%}
    {%- assign review_count = 71 -%}
    {%- assign review_score = '5.0' -%}
  {%- elsif prod_handle == 'biphasic-make-up-remover-fragrance-free' or prod_handle contains 'biphasic' or prod_title contains 'biphasic' or prod_title contains 'struccante bifasico' -%}
    {%- assign review_count = 19 -%}
    {%- assign review_score = '4.9' -%}
  {%- elsif prod_handle == 'aluminum-free-roll-on-deodorant' or prod_handle contains 'aluminum-free' or prod_handle contains 'roll-on' or prod_title contains 'roll-on' or prod_title contains 'deodorante' or prod_title contains 'deodorant' -%}
    {%- assign review_count = 15 -%}
    {%- assign review_score = '4.9' -%}
  {%- elsif prod_handle == 'hand-body-wash-grapefruit' or prod_handle contains 'hand-body-wash-grapefruit' or prod_title contains 'pompelmo' or prod_title contains 'grapefruit' -%}
    {%- assign review_count = 13 -%}
    {%- assign review_score = '4.9' -%}
  {%- elsif prod_handle == 'peptide-age-defying-eye-cream' or prod_handle contains 'age-defying-eye-cream' or prod_title contains 'contorno occhi' or prod_title contains 'age-defying eye' -%}
    {%- assign review_count = 13 -%}
    {%- assign review_score = '4.9' -%}
  {%- elsif prod_handle == 'peptide-anti-aging-serum' or prod_handle contains 'peptide-anti-aging-serum' or prod_title contains 'siero anti-age ai peptidi' -%}
    {%- assign review_count = 11 -%}
    {%- assign review_score = '5.0' -%}
  {%- elsif prod_handle == 'hydrating-serum' or prod_handle == 'siero-idratante' or prod_title contains 'siero idratante' or prod_title == 'hydrating serum' -%}
    {%- assign review_count = 11 -%}
    {%- assign review_score = '5.0' -%}
  {%- elsif prod_handle == 'sun-protection-spf50-stick-no-tint-1' or prod_handle contains 'sun-protection-spf50-stick-no-tint' or prod_title contains 'no-tint' or prod_title contains 'invisibile' -%}
    {%- assign review_count = 11 -%}
    {%- assign review_score = '5.0' -%}
  {%- elsif prod_handle == 'silk-skin-body-serum-woody-amber-leather' or prod_handle contains 'woody-amber' or prod_title contains 'legnoso ambrato' or prod_title contains 'amber leather' -%}
    {%- assign review_count = 9 -%}
    {%- assign review_score = '5.0' -%}
  {%- elsif prod_handle == 'sun-protection-spf50-stick-with-tint-1' or prod_handle contains 'sun-protection-spf50-stick-with-tint' or prod_title contains 'with-tint' or prod_title contains 'colorato' -%}
    {%- assign review_count = 9 -%}
    {%- assign review_score = '4.9' -%}
  {%- elsif prod_handle == '5-urea-2-panthenol-body-cream' or prod_handle contains 'urea' or prod_title contains 'urea' or prod_title contains 'panthenol-body-cream' or prod_title contains 'crema corpo urea' -%}
    {%- assign review_count = 8 -%}
    {%- assign review_score = '5.0' -%}
  {%- elsif prod_handle == 'double-hydration-boost-gel-ha' or prod_handle contains 'double-hydration' or prod_title contains 'double-hydration' or prod_title contains 'idratante gel ha' -%}
    {%- assign review_count = 8 -%}
    {%- assign review_score = '5.0' -%}
  {%- elsif prod_handle == 'aha-peeling-concentrate' or prod_handle contains 'aha-peeling' or prod_title contains 'aha-peeling' or prod_title contains 'peeling concentrato' -%}
    {%- assign review_count = 5 -%}
    {%- assign review_score = '5.0' -%}
  {%- elsif prod_handle == 'silk-skin-body-serum-spices-sandalwood' or prod_handle contains 'spices-sandalwood' or prod_title contains 'spezie e sandalo' or prod_title contains 'sandalwood' -%}
    {%- assign review_count = 4 -%}
    {%- assign review_score = '5.0' -%}
  {%- elsif prod_handle == 'pigment-perfecting-serum' or prod_handle contains 'pigment-perfecting' or prod_title contains 'pigment-perfecting' or prod_title contains 'antimacchie' -%}
    {%- assign review_count = 4 -%}
    {%- assign review_score = '5.0' -%}
  {%- elsif prod_handle == 'acne-purifying-face-wash' or prod_handle contains 'acne-purifying' or prod_title contains 'acne-purifying' or prod_title contains 'purificante acne' -%}
    {%- assign review_count = 4 -%}
    {%- assign review_score = '5.0' -%}
  {%- elsif prod_handle == 'sensitive-skin-oil-to-milk-cleanser' or prod_handle contains 'oil-to-milk' or prod_title contains 'oil-to-milk' or prod_title contains 'olio-latte' -%}
    {%- assign review_count = 3 -%}
    {%- assign review_score = '5.0' -%}
  {%- elsif prod_handle == 'acne-spot-care' or prod_handle contains 'acne-spot-care' or prod_title contains 'acne-spot-care' or prod_title contains 'trattamento localizzato' -%}
    {%- assign review_count = 3 -%}
    {%- assign review_score = '5.0' -%}
  {%- elsif prod_handle == 'peptide-ageless-am-pm-cream' or prod_handle contains 'peptide-ageless' or prod_title contains 'peptide-ageless' or prod_title contains 'am/pm cream' -%}
    {%- assign review_count = 2 -%}
    {%- assign review_score = '5.0' -%}
  {%- endif -%}

  {%- comment -%} 2. Integrate Judge.me or Shopify Metafields if higher than baseline {%- endcomment -%}
  {%- if product.metafields.judgeme.badge != blank -%}
    {%- assign jdgm_badge = product.metafields.judgeme.badge -%}
    {%- assign jdgm_count = 0 -%}
    {%- if jdgm_badge contains "data-number-of-reviews='" -%}
      {%- assign jdgm_count = jdgm_badge | split: "data-number-of-reviews='" | last | split: "'" | first | plus: 0 -%}
    {%- elsif jdgm_badge contains 'data-number-of-reviews="' -%}
      {%- assign jdgm_count = jdgm_badge | split: 'data-number-of-reviews="' | last | split: '"' | first | plus: 0 -%}
    {%- endif -%}

    {%- if jdgm_count > 0 -%}
      {%- assign jdgm_score_raw = '' -%}
      {%- if jdgm_badge contains "data-average-rating='" -%}
        {%- assign jdgm_score_raw = jdgm_badge | split: "data-average-rating='" | last | split: "'" | first -%}
      {%- elsif jdgm_badge contains 'data-average-rating="' -%}
        {%- assign jdgm_score_raw = jdgm_badge | split: 'data-average-rating="' | last | split: '"' | first -%}
      {%- endif -%}

      {%- assign jdgm_score_num = jdgm_score_raw | plus: 0.0 -%}
      {%- assign jdgm_score_rounded = jdgm_score_num | round: 1 -%}
      {%- if jdgm_score_rounded == 5 -%}
        {%- assign jdgm_score_final = '5.0' -%}
      {%- elsif jdgm_score_rounded == 4 -%}
        {%- assign jdgm_score_final = '4.0' -%}
      {%- elsif jdgm_score_rounded > 0 -%}
        {%- assign jdgm_score_final = jdgm_score_rounded -%}
      {%- else -%}
        {%- assign jdgm_score_final = '5.0' -%}
      {%- endif -%}

      {%- if jdgm_count > review_count -%}
        {%- assign review_count = jdgm_count -%}
        {%- assign review_score = jdgm_score_final -%}
      {%- endif -%}
    {%- endif -%}
  {%- elsif product.metafields.reviews.rating_count != blank -%}
    {%- assign shopify_r_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | plus: 0 -%}
    {%- if shopify_r_count > review_count -%}
      {%- assign review_count = shopify_r_count -%}
      {%- assign shopify_r_score = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating | plus: 0.0 | round: 1 -%}
      {%- if shopify_r_score == 5 -%}
        {%- assign review_score = '5.0' -%}
      {%- elsif shopify_r_score == 4 -%}
        {%- assign review_score = '4.0' -%}
      {%- elsif shopify_r_score > 0 -%}
        {%- assign review_score = shopify_r_score -%}
      {%- else -%}
        {%- assign review_score = '5.0' -%}
      {%- endif -%}
    {%- endif -%}
  {%- elsif product.metafields.custom.reviews_count != blank -%}
    {%- assign custom_r_count = product.metafields.custom.reviews_count.value | default: product.metafields.custom.reviews_count | plus: 0 -%}
    {%- if custom_r_count > review_count -%}
      {%- assign review_count = custom_r_count -%}
      {%- assign custom_r_score = product.metafields.custom.reviews_rating.value | default: product.metafields.custom.reviews_rating | plus: 0.0 | round: 1 -%}
      {%- if custom_r_score == 5 -%}
        {%- assign review_score = '5.0' -%}
      {%- elsif custom_r_score == 4 -%}
        {%- assign review_score = '4.0' -%}
      {%- elsif custom_r_score > 0 -%}
        {%- assign review_score = custom_r_score -%}
      {%- else -%}
        {%- assign review_score = '5.0' -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} 3. Formatted Outputs {%- endcomment -%}
{%- if review_count > 0 -%}
  {%- if review_count == 1 -%}
    {%- assign count_label = '1 recensione' -%}
  {%- else -%}
    {%- assign count_label = review_count | append: ' recensioni' -%}
  {%- endif -%}

  {%- case format -%}
    {%- when 'card' -%}
      ({{- review_score -}}/5 • {{- count_label -}})
    {%- when 'pdp' -%}
      {{- review_score -}}/5 · {{- count_label -}}
    {%- when 'score' -%}
      {{- review_score -}}
    {%- when 'count' -%}
      {{- review_count -}}
    {%- else -%}
      ({{- review_score -}}/5 • {{- count_label -}})
  {%- endcase -%}
{%- else -%}
  {%- case format -%}
    {%- when 'pdp' -%}
      Nessuna recensione
    {%- when 'score' -%}
      0
    {%- when 'count' -%}
      0
    {%- else -%}
  {%- endcase -%}
{%- endif -%}
