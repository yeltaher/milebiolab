<!-- MILE LUXURY ACCOUNT DRAWER -->
<div id="account-drawer-overlay" class="drawer-overlay" aria-hidden="true" onclick="closeAccountDrawer()"></div>

<aside id="account-drawer" class="account-drawer" role="dialog" aria-modal="true" aria-label="Area Riservata Club Mile" aria-hidden="true">
  <!-- Header -->
  <div class="account-drawer-header">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-[#5C6B56]"></span>
      <h3 class="account-drawer-title font-serif text-xl tracking-wide text-[#1A1A1A]">
        Club Mile &bull; <span class="italic text-[#5C6B56]">Spazio Riservato</span>
      </h3>
    </div>
    <button type="button" class="btn-drawer-close text-2xl text-[#7A7265] hover:text-[#1A1A1A] transition-colors bg-transparent border-0 cursor-pointer p-1 leading-none" onclick="closeAccountDrawer()" aria-label="Chiudi area account">&times;</button>
  </div>

  {% if customer %}
    <!-- STATE A: CUSTOMER ALREADY LOGGED IN -->
    <div class="flex-1 overflow-y-auto p-6 sm:p-8 flex flex-col justify-between">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#FAF8F5] border border-[#E5E0D8] text-[11px] font-mono tracking-wider uppercase text-[#5C6B56] mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#5C6B56]"></span>
          Membro Attivo Club Mile
        </div>
        <h4 class="font-serif text-2xl text-[#1A1A1A] mb-1 font-normal">
          Bentornato, <span class="italic text-[#5C6B56]">{{ customer.first_name | default: 'Membro Club' }}</span>
        </h4>
        <p class="text-xs text-[#7A7265] mb-6">{{ customer.email }}</p>

        <!-- Quick Info Box -->
        <div class="bg-[#FAF8F5] border border-[#E5E0D8] p-4 mb-6 space-y-2 text-xs text-[#1A1A1A]">
          <div class="flex justify-between items-center pb-2 border-b border-[#E5E0D8]">
            <span class="text-[#7A7265]">Ordini Effettuati:</span>
            <strong class="font-mono text-sm">{{ customer.orders_count | default: 0 }}</strong>
          </div>
          <div class="flex justify-between items-center pb-2 border-b border-[#E5E0D8]">
            <span class="text-[#7A7265]">Privilegio Fedeltà:</span>
            <span class="text-[#5C6B56] font-semibold">10% Riservato &bull; Campioni Deluxe</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-[#7A7265]">Sede di Ritiro:</span>
            <span class="font-medium">Corso Cavour 18, Verona</span>
          </div>
        </div>

        <!-- Links to Full Account -->
        <div class="space-y-2.5">
          <a href="{{ routes.account_url }}" class="block w-full py-3.5 px-4 bg-[#1A1A1A] hover:bg-[#5C6B56] text-white text-xs uppercase tracking-widest font-semibold text-center transition-colors">
            Accedi alla Dashboard Completa &rarr;
          </a>
          <a href="{{ routes.account_addresses_url }}" class="block w-full py-2.5 px-4 border border-[#1A1A1A] text-[#1A1A1A] hover:bg-[#FAF8F5] text-xs uppercase tracking-widest font-semibold text-center transition-colors">
            Gestisci Indirizzi di Consegna
          </a>
          <a href="/pages/ritiro-verona" onclick="if(window.openVeronaModal){openVeronaModal(); return false;}" class="block w-full py-2.5 px-4 border border-[#E5E0D8] text-[#5C6B56] hover:border-[#5C6B56] text-xs uppercase tracking-widest font-semibold text-center transition-colors">
            Info Ritiro in Sede a Verona (2 Ore)
          </a>
        </div>
      </div>

      <div class="pt-6 border-t border-[#E5E0D8] mt-8">
        <a href="{{ routes.account_logout_url }}" class="block w-full py-2 text-center text-xs uppercase tracking-widest text-[#7A7265] hover:text-[#9E2A2B] transition-colors underline underline-offset-4">
          Disconnettiti dal Profilo
        </a>
      </div>
    </div>

  {% else %}
    <!-- STATE B: GUEST - 2 TABS (ACCEDI / REGISTRATI) -->
    
    <!-- Privilege Strip -->
    <div class="bg-[#FAF8F5] border-b border-[#E5E0D8] px-6 py-2.5 flex items-center justify-between text-[11px] text-[#7A7265]">
      <span class="flex items-center gap-1.5 font-medium text-[#1A1A1A]">
        <span class="text-[#C8A878] font-bold">★</span> 10% Sconto Immediato
      </span>
      <span class="text-[#5C6B56] font-medium flex items-center gap-1">
        <span>📍</span> Ritiro 2h a Verona
      </span>
    </div>

    <!-- Tab Bar -->
    <div class="flex border-b border-[#E5E0D8] bg-white sticky top-0 z-10">
      <button
        type="button"
        id="account-tab-btn-login"
        class="flex-1 py-3.5 text-xs uppercase tracking-widest font-semibold transition-all border-b-2 border-[#1A1A1A] text-[#1A1A1A] bg-white cursor-pointer"
        onclick="switchAccountDrawerTab('login')"
      >
        Accedi
      </button>
      <button
        type="button"
        id="account-tab-btn-register"
        class="flex-1 py-3.5 text-xs uppercase tracking-widest font-semibold transition-all border-b-2 border-transparent text-[#7A7265] hover:text-[#1A1A1A] bg-[#FAF8F5]/60 cursor-pointer"
        onclick="switchAccountDrawerTab('register')"
      >
        Registrati <span class="text-[#C8A878] font-semibold ml-0.5">(-10%)</span>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto p-6 sm:p-7">
      
      <!-- ============================================ -->
      <!-- TAB PANE 1: ACCEDI                           -->
      <!-- ============================================ -->
      <div id="account-drawer-pane-login" class="space-y-6">
        
        <!-- Standard Login View -->
        <div id="DrawerLoginFormView">
          <div class="mb-5">
            <span class="text-[10px] font-mono tracking-widest uppercase text-[#7A7265] block mb-1">Bentornato nel Club</span>
            <h4 class="font-serif text-2xl text-[#1A1A1A] font-normal leading-snug">
              Accedi al Tuo Profilo
            </h4>
            <p class="text-xs text-[#7A7265] mt-1 leading-relaxed">
              Inserisci email e password per gestire i tuoi ordini e rituali viso personalizzati.
            </p>
          </div>

          {% form 'customer_login', id: 'DrawerCustomerLoginForm', class: 'space-y-4', novalidate: 'novalidate' %}
            {% if form.errors %}
              <div class="p-3 bg-[#FFF5F5] border border-[#E5A8A8] text-[#9E2A2B] text-xs">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div>
              <label for="DrawerLoginEmail" class="block text-[11px] uppercase tracking-wider font-semibold text-[#1A1A1A] mb-1">
                Indirizzo Email <span class="text-[#5C6B56]">*</span>
              </label>
              <input
                type="email"
                name="customer[email]"
                id="DrawerLoginEmail"
                autocomplete="email"
                required
                placeholder="es. maria.rossi@email.com"
                class="w-full px-3.5 py-2.5 bg-[#FAF8F5] border border-[#E5E0D8] text-xs sm:text-sm text-[#1A1A1A] placeholder-[#7A7265]/50 focus:bg-white focus:border-[#5C6B56] focus:outline-none transition-colors"
              >
            </div>

            <div>
              <div class="flex items-center justify-between mb-1">
                <label for="DrawerLoginPassword" class="block text-[11px] uppercase tracking-wider font-semibold text-[#1A1A1A]">
                  Password <span class="text-[#5C6B56]">*</span>
                </label>
                <button
                  type="button"
                  onclick="toggleDrawerRecover(true)"
                  class="text-[11px] text-[#7A7265] hover:text-[#C8A878] transition-colors underline underline-offset-2 cursor-pointer bg-transparent border-0 p-0"
                >
                  Password dimenticata?
                </button>
              </div>
              <input
                type="password"
                name="customer[password]"
                id="DrawerLoginPassword"
                autocomplete="current-password"
                required
                placeholder="••••••••••••"
                class="w-full px-3.5 py-2.5 bg-[#FAF8F5] border border-[#E5E0D8] text-xs sm:text-sm text-[#1A1A1A] placeholder-[#7A7265]/50 focus:bg-white focus:border-[#5C6B56] focus:outline-none transition-colors"
              >
            </div>

            <div class="pt-2">
              <button
                type="submit"
                class="w-full bg-[#1A1A1A] hover:bg-[#5C6B56] text-white py-3.5 px-4 text-xs uppercase tracking-widest font-semibold transition-all duration-300 cursor-pointer flex items-center justify-center gap-2"
              >
                <span>Accedi al Club Mile</span>
                <span class="text-[#C8A878]">&rarr;</span>
              </button>
            </div>
          {% endform %}

          <div class="mt-6 pt-5 border-t border-[#E5E0D8] text-center">
            <p class="text-xs text-[#7A7265] mb-2.5">Non possiedi ancora un account Club Mile?</p>
            <button
              type="button"
              onclick="switchAccountDrawerTab('register')"
              class="w-full py-2.5 border border-[#1A1A1A] text-[#1A1A1A] hover:bg-[#FAF8F5] text-xs uppercase tracking-widest font-semibold transition-colors cursor-pointer"
            >
              Registrati &bull; Ricevi il 10% Subito
            </button>
          </div>
        </div>

        <!-- In-Drawer Recover Password View -->
        <div id="DrawerRecoverFormView" class="hidden">
          <div class="mb-5">
            <span class="text-[10px] font-mono tracking-widest uppercase text-[#C8A878] block mb-1">Recupero Credenziali</span>
            <h4 class="font-serif text-2xl text-[#1A1A1A] font-normal leading-snug">
              Reimposta Password
            </h4>
            <p class="text-xs text-[#7A7265] mt-1 leading-relaxed">
              Inserisci la tua email. Ti invieremo un link sicuro per impostare una nuova password.
            </p>
          </div>

          {% form 'recover_customer_password', id: 'DrawerRecoverCustomerPasswordForm', class: 'space-y-4', novalidate: 'novalidate' %}
            <div>
              <label for="DrawerRecoverEmail" class="block text-[11px] uppercase tracking-wider font-semibold text-[#1A1A1A] mb-1">
                La Tua Email <span class="text-[#5C6B56]">*</span>
              </label>
              <input
                type="email"
                name="email"
                id="DrawerRecoverEmail"
                required
                placeholder="es. maria.rossi@email.com"
                class="w-full px-3.5 py-2.5 bg-[#FAF8F5] border border-[#E5E0D8] text-xs sm:text-sm text-[#1A1A1A] placeholder-[#7A7265]/50 focus:bg-white focus:border-[#5C6B56] focus:outline-none transition-colors"
              >
            </div>

            <div class="pt-2 space-y-2.5">
              <button
                type="submit"
                class="w-full bg-[#1A1A1A] hover:bg-[#5C6B56] text-white py-3.5 px-4 text-xs uppercase tracking-widest font-semibold transition-all duration-300 cursor-pointer flex items-center justify-center gap-2"
              >
                <span>Invia Link di Reimpostazione</span>
                <span class="text-[#C8A878]">&rarr;</span>
              </button>

              <button
                type="button"
                onclick="toggleDrawerRecover(false)"
                class="w-full py-2 text-xs uppercase tracking-widest text-[#7A7265] hover:text-[#1A1A1A] transition-colors cursor-pointer text-center bg-transparent border-0"
              >
                &larr; Torna ad Accedi
              </button>
            </div>
          {% endform %}
        </div>

      </div>

      <!-- ============================================ -->
      <!-- TAB PANE 2: REGISTRATI (UNISCITI AL CLUB)    -->
      <!-- ============================================ -->
      <div id="account-drawer-pane-register" class="hidden space-y-5">
        
        <!-- Privilege Highlight Card -->
        <div class="bg-[#FAF8F5] border border-[#E5E0D8] p-4 relative overflow-hidden">
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 bg-white border border-[#E5E0D8] text-[10px] font-mono tracking-wider uppercase text-[#C8A878] mb-2 font-semibold">
            Privilegi Immediati Club Mile
          </div>
          <h4 class="font-serif text-xl text-[#1A1A1A] font-normal leading-tight">
            10% di Sconto Immediato
          </h4>
          <p class="text-xs text-[#7A7265] mt-1 leading-relaxed">
            Codice di benvenuto valido subito sul 1° ordine + Ritiro prioritario in 2h nella nostra sede di Corso Cavour 18, Verona con campioni deluxe in omaggio.
          </p>
        </div>

        {% form 'create_customer', id: 'RegisterDrawerForm', class: 'space-y-3.5', novalidate: 'novalidate' %}
          <input type="hidden" name="customer[tags]" value="club_mile, welcome_10">

          {% if form.errors %}
            <div class="p-3 bg-[#FFF5F5] border border-[#E5A8A8] text-[#9E2A2B] text-xs">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="DrawerRegisterFirstName" class="block text-[11px] uppercase tracking-wider font-semibold text-[#1A1A1A] mb-1">
                Nome <span class="text-[#5C6B56]">*</span>
              </label>
              <input
                type="text"
                name="customer[first_name]"
                id="DrawerRegisterFirstName"
                required
                placeholder="Maria"
                class="w-full px-3 py-2.5 bg-[#FAF8F5] border border-[#E5E0D8] text-xs text-[#1A1A1A] focus:bg-white focus:border-[#5C6B56] focus:outline-none transition-colors"
              >
            </div>
            <div>
              <label for="DrawerRegisterLastName" class="block text-[11px] uppercase tracking-wider font-semibold text-[#1A1A1A] mb-1">
                Cognome <span class="text-[#5C6B56]">*</span>
              </label>
              <input
                type="text"
                name="customer[last_name]"
                id="DrawerRegisterLastName"
                required
                placeholder="Rossi"
                class="w-full px-3 py-2.5 bg-[#FAF8F5] border border-[#E5E0D8] text-xs text-[#1A1A1A] focus:bg-white focus:border-[#5C6B56] focus:outline-none transition-colors"
              >
            </div>
          </div>

          <div>
            <label for="DrawerRegisterEmail" class="block text-[11px] uppercase tracking-wider font-semibold text-[#1A1A1A] mb-1">
              Email <span class="text-[#5C6B56]">*</span>
            </label>
            <input
              type="email"
              name="customer[email]"
              id="DrawerRegisterEmail"
              required
              placeholder="es. maria.rossi@email.com"
              class="w-full px-3 py-2.5 bg-[#FAF8F5] border border-[#E5E0D8] text-xs text-[#1A1A1A] focus:bg-white focus:border-[#5C6B56] focus:outline-none transition-colors"
            >
          </div>

          <div>
            <label for="DrawerRegisterPassword" class="block text-[11px] uppercase tracking-wider font-semibold text-[#1A1A1A] mb-1">
              Password <span class="text-[#5C6B56]">*</span>
            </label>
            <input
              type="password"
              name="customer[password]"
              id="DrawerRegisterPassword"
              required
              placeholder="Minimo 6 caratteri"
              class="w-full px-3 py-2.5 bg-[#FAF8F5] border border-[#E5E0D8] text-xs text-[#1A1A1A] focus:bg-white focus:border-[#5C6B56] focus:outline-none transition-colors"
            >
          </div>

          <div class="pt-1">
            <label class="flex items-start gap-2 text-[11px] text-[#7A7265] cursor-pointer">
              <input type="checkbox" required checked class="mt-0.5 accent-[#5C6B56] cursor-pointer">
              <span>Desidero iscrivermi al Club Mile, ricevere il 10% di sconto e acconsento al trattamento dei dati personali secondo la <a href="/pages/privacy-policy" class="underline text-[#1A1A1A]">Privacy Policy</a>.</span>
            </label>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              class="w-full bg-[#1A1A1A] hover:bg-[#5C6B56] text-white py-3.5 px-4 text-xs uppercase tracking-widest font-semibold transition-all duration-300 cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Unisciti al Club Mile (-10%)</span>
              <span class="text-[#C8A878]">&rarr;</span>
            </button>
          </div>
        {% endform %}

        <div class="mt-4 pt-4 border-t border-[#E5E0D8] text-center">
          <p class="text-xs text-[#7A7265] mb-2">Hai già un account attivo?</p>
          <button
            type="button"
            onclick="switchAccountDrawerTab('login')"
            class="text-xs uppercase tracking-widest font-semibold text-[#1A1A1A] hover:text-[#C8A878] transition-colors underline underline-offset-4 cursor-pointer bg-transparent border-0"
          >
            Accedi con le tue credenziali &rarr;
          </button>
        </div>

      </div>

    </div>
  {% endif %}
</aside>

<style>
  .account-drawer {
    position: fixed;
    top: 0;
    right: -520px;
    width: 100%;
    max-width: 460px;
    height: 100vh;
    background: #FFFFFF;
    z-index: 1250;
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    transition: right 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .account-drawer.active {
    right: 0;
  }
  .account-drawer-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #E5E0D8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #FFFFFF;
  }
</style>

<script>
  function openAccountDrawer() {
    const drawer = document.getElementById('account-drawer');
    const overlay = document.getElementById('account-drawer-overlay');
    if (drawer && overlay) {
      drawer.classList.add('active');
      overlay.classList.add('active');
      drawer.setAttribute('aria-hidden', 'false');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeAccountDrawer() {
    const drawer = document.getElementById('account-drawer');
    const overlay = document.getElementById('account-drawer-overlay');
    if (drawer && overlay) {
      drawer.classList.remove('active');
      overlay.classList.remove('active');
      drawer.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }

  function switchAccountDrawerTab(tab) {
    const loginTabBtn = document.getElementById('account-tab-btn-login');
    const registerTabBtn = document.getElementById('account-tab-btn-register');
    const loginPane = document.getElementById('account-drawer-pane-login');
    const registerPane = document.getElementById('account-drawer-pane-register');
    
    if (!loginTabBtn || !registerTabBtn || !loginPane || !registerPane) return;

    if (tab === 'login') {
      loginTabBtn.classList.add('border-[#1A1A1A]', 'text-[#1A1A1A]', 'bg-white');
      loginTabBtn.classList.remove('border-transparent', 'text-[#7A7265]', 'bg-[#FAF8F5]/60');

      registerTabBtn.classList.remove('border-[#1A1A1A]', 'text-[#1A1A1A]', 'bg-white');
      registerTabBtn.classList.add('border-transparent', 'text-[#7A7265]', 'bg-[#FAF8F5]/60');

      loginPane.classList.remove('hidden');
      registerPane.classList.add('hidden');
      toggleDrawerRecover(false);
    } else {
      registerTabBtn.classList.add('border-[#1A1A1A]', 'text-[#1A1A1A]', 'bg-white');
      registerTabBtn.classList.remove('border-transparent', 'text-[#7A7265]', 'bg-[#FAF8F5]/60');

      loginTabBtn.classList.remove('border-[#1A1A1A]', 'text-[#1A1A1A]', 'bg-white');
      loginTabBtn.classList.add('border-transparent', 'text-[#7A7265]', 'bg-[#FAF8F5]/60');

      registerPane.classList.remove('hidden');
      loginPane.classList.add('hidden');
    }
  }

  function toggleDrawerRecover(showRecover) {
    const loginView = document.getElementById('DrawerLoginFormView');
    const recoverView = document.getElementById('DrawerRecoverFormView');
    if (loginView && recoverView) {
      if (showRecover) {
        loginView.classList.add('hidden');
        recoverView.classList.remove('hidden');
        const emailInput = document.getElementById('DrawerRecoverEmail');
        if (emailInput) emailInput.focus();
      } else {
        recoverView.classList.add('hidden');
        loginView.classList.remove('hidden');
      }
    }
  }

  // Keyboard accessibility
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const drawer = document.getElementById('account-drawer');
      if (drawer && drawer.classList.contains('active')) {
        closeAccountDrawer();
      }
    }
  });

  // Global exposure
  window.openAccountDrawer = openAccountDrawer;
  window.closeAccountDrawer = closeAccountDrawer;
  window.switchAccountDrawerTab = switchAccountDrawerTab;
  window.toggleDrawerRecover = toggleDrawerRecover;
</script>
