{%- comment -%}
  MILEBIOLAB - Verbatim Product Title Output
  Restituisce esattamente il titolo originale definito nel catalogo prodotti di Shopify.
{%- endcomment -%}
{%- assign raw_title = title | default: product.title | default: default | default: '' | strip -%}
{%- if escape -%}
  {{- raw_title | escape -}}
{%- else -%}
  {{- raw_title -}}
{%- endif -%}
