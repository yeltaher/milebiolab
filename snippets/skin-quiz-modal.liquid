<!-- MILE MULTI-STEP SKIN QUIZ MODAL -->
<div id="skin-quiz-overlay" class="modal-overlay" aria-hidden="true" onclick="closeSkinQuiz()"></div>

<div id="skin-quiz-modal" class="modal-overlay" style="display: none; z-index: 1060;" role="dialog" aria-modal="true" aria-labelledby="quiz-modal-main-title">
  <div class="quiz-modal-card" onclick="event.stopPropagation()">
    
    <button type="button" class="modal-close-btn" onclick="closeSkinQuiz()" aria-label="Chiudi quiz">&times;</button>
    
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
      <span class="protocol-tag">DIAGNOSI DIGITALE SARTORIALE</span>
      <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-accent-olive); font-weight: 700;">2 MINUTI</span>
    </div>
    
    <h3 id="quiz-modal-main-title" style="font-size: 1.6rem; margin-bottom: 0.5rem;">Trova il Tuo Rituale su Misura</h3>
    
    <!-- Progress Indicator Track -->
    <div style="width: 100%; height: 4px; background: var(--color-border); margin-bottom: 1.5rem;">
      <div id="quiz-progress-bar" style="height: 100%; width: 25%; background: var(--color-accent-olive); transition: width 0.3s ease;"></div>
    </div>

    <!-- STEP 1: SKIN TYPE -->
    <div id="quiz-step-1" class="quiz-step-box">
      <h4 style="font-size: 1.15rem; margin-bottom: 0.5rem;">Passo 1 di 3: Come definiresti la tua pelle?</h4>
      <p style="font-size: 0.85rem; color: var(--color-text-secondary);">Seleziona la condizione prevalente della tua cute durante la giornata.</p>
      
      <div class="quiz-options-grid">
        <button type="button" class="quiz-option-btn active" onclick="selectQuizAnswer('skinType', 'secca', this)">
          <strong>Pelle Secca</strong>
          <span style="font-size: 0.75rem; color: var(--color-text-secondary); display: block; margin-top: 2px;">Tende a tirare, desquamazione, rugosità.</span>
        </button>
        <button type="button" class="quiz-option-btn" onclick="selectQuizAnswer('skinType', 'sensibile', this)">
          <strong>Pelle Sensibile & Reattiva</strong>
          <span style="font-size: 0.75rem; color: var(--color-text-secondary); display: block; margin-top: 2px;">Soggetta a rossori, calore, intolleranza.</span>
        </button>
        <button type="button" class="quiz-option-btn" onclick="selectQuizAnswer('skinType', 'mista', this)">
          <strong>Pelle Mista o Impura</strong>
          <span style="font-size: 0.75rem; color: var(--color-text-secondary); display: block; margin-top: 2px;">Zona T lucida, pori visibili, guance normali.</span>
        </button>
        <button type="button" class="quiz-option-btn" onclick="selectQuizAnswer('skinType', 'matura', this)">
          <strong>Pelle Matura</strong>
          <span style="font-size: 0.75rem; color: var(--color-text-secondary); display: block; margin-top: 2px;">Perdita di densità, tono e rughe d'espressione.</span>
        </button>
      </div>

      <div style="text-align: right; margin-top: 1.5rem;">
        <button type="button" class="btn-primary" onclick="nextQuizStep(1)">Continua &rarr;</button>
      </div>
    </div>

    <!-- STEP 2: PRIMARY CONCERN -->
    <div id="quiz-step-2" class="quiz-step-box" style="display: none;">
      <h4 style="font-size: 1.15rem; margin-bottom: 0.5rem;">Passo 2 di 3: Qual è il tuo obiettivo principale?</h4>
      <p style="font-size: 0.85rem; color: var(--color-text-secondary);">Cosa vorresti migliorare maggiormente nei prossimi 28 giorni?</p>
      
      <div class="quiz-options-grid">
        <button type="button" class="quiz-option-btn active" onclick="selectQuizAnswer('concern', 'antiage', this)">
          <strong>Longevità & Anti-Età</strong>
          <span style="font-size: 0.75rem; color: var(--color-text-secondary); display: block; margin-top: 2px;">Distensione rughe e stimolazione procollagene.</span>
        </button>
        <button type="button" class="quiz-option-btn" onclick="selectQuizAnswer('concern', 'idratazione', this)">
          <strong>Idratazione Profonda 72h</strong>
          <span style="font-size: 0.75rem; color: var(--color-text-secondary); display: block; margin-top: 2px;">Rimpolpare le riserve idriche cutanee.</span>
        </button>
        <button type="button" class="quiz-option-btn" onclick="selectQuizAnswer('concern', 'barriera', this)">
          <strong>Riparazione della Barriera</strong>
          <span style="font-size: 0.75rem; color: var(--color-text-secondary); display: block; margin-top: 2px;">Calmare infiammazioni e rossori persistenti.</span>
        </button>
        <button type="button" class="quiz-option-btn" onclick="selectQuizAnswer('concern', 'luminosita', this)">
          <strong>Luminosità & Colorito</strong>
          <span style="font-size: 0.75rem; color: var(--color-text-secondary); display: block; margin-top: 2px;">Uniformare la grana e schiarire macchie.</span>
        </button>
      </div>

      <div style="display: flex; justify-content: space-between; margin-top: 1.5rem;">
        <button type="button" class="btn-secondary" onclick="setQuizStep(1)">&larr; Indietro</button>
        <button type="button" class="btn-primary" onclick="nextQuizStep(2)">Continua &rarr;</button>
      </div>
    </div>

    <!-- STEP 3: PREFERRED TEXTURE -->
    <div id="quiz-step-3" class="quiz-step-box" style="display: none;">
      <h4 style="font-size: 1.15rem; margin-bottom: 0.5rem;">Passo 3 di 3: Quale sensazione cerchi sulla pelle?</h4>
      <p style="font-size: 0.85rem; color: var(--color-text-secondary);">La sensorialità è fondamentale per la costanza nel rituale quotidiano.</p>
      
      <div class="quiz-options-grid">
        <button type="button" class="quiz-option-btn active" onclick="selectQuizAnswer('texture', 'vellutata', this)">
          <strong>Ricca & Vellutata</strong>
          <span style="font-size: 0.75rem; color: var(--color-text-secondary); display: block; margin-top: 2px;">Avvolgente, dona comfort immediato e morbidezza.</span>
        </button>
        <button type="button" class="quiz-option-btn" onclick="selectQuizAnswer('texture', 'fluida', this)">
          <strong>Fluida & Leggera</strong>
          <span style="font-size: 0.75rem; color: var(--color-text-secondary); display: block; margin-top: 2px;">Assorbimento rapido istantaneo, finish matte naturale.</span>
        </button>
      </div>

      <div style="display: flex; justify-content: space-between; margin-top: 1.5rem;">
        <button type="button" class="btn-secondary" onclick="setQuizStep(2)">&larr; Indietro</button>
        <button type="button" class="btn-primary" onclick="nextQuizStep(3)">Elabora Prescrizione &rarr;</button>
      </div>
    </div>

    <!-- STEP 4: RESULT SCREEN & DISCOUNT -->
    <div id="quiz-step-4" class="quiz-step-box" style="display: none;">
      <div style="text-align: center; margin-bottom: 1.5rem;">
        <span class="magnetic-glow-pulse-badge">PRESCRIZIONE SU MISURA</span>
        <h4 id="quiz-result-title" style="font-size: 1.6rem; margin-top: 0.5rem;">Protocollo Rigenerante Barriera</h4>
        <p id="quiz-result-desc" style="font-size: 0.88rem; color: var(--color-text-secondary); max-width: 500px; margin: 0.4rem auto 0 auto;">
          Calibrato sulle esigenze della tua pelle con sconto di benvenuto -15%.
        </p>
      </div>

      <!-- Prescribed 3-item Mini Stack -->
      <div style="background: var(--color-bg-primary); border: var(--border-splendor); padding: 1.25rem; display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
          <span>01. Daily Cleansing Milk & Soothing Tonic (200ml)</span>
          <strong style="font-family: var(--font-mono);">€ 32,30</strong>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
          <span>02. Intense Hyaluronic Power Serum (30ml)</span>
          <strong style="font-family: var(--font-mono);">€ 73,10</strong>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
          <span>03. Supreme Moisture & Cellular Repair Cream (50ml)</span>
          <strong style="font-family: var(--font-mono);">€ 71,40</strong>
        </div>
        <div style="border-top: 1px solid var(--color-border); padding-top: 8px; display: flex; justify-content: space-between; align-items: center; font-size: 1rem; font-weight: 700;">
          <span>Totale Routine Personalizzata (-15% Applicato):</span>
          <span style="font-family: var(--font-mono); color: var(--color-accent-olive);">€ 176,80</span>
        </div>
      </div>

      <div style="background: #FAF8F5; border: 1px dashed var(--color-accent-gold); padding: 10px 14px; text-align: center; margin-bottom: 1.5rem;">
        <span style="font-size: 0.78rem;">Codice Coupon Riservato: <strong style="font-family: var(--font-mono); color: var(--color-accent-gold);">MILE15</strong> (applicato al checkout)</span>
      </div>

      <button type="button" class="btn-primary btn-atc-olive" style="width: 100%; padding: 1.1rem; justify-content: center; font-size: 0.88rem;" onclick="addQuizBundleToCart()">
        Aggiungi la Routine Personalizzata al Carrello (-15%) &rarr;
      </button>
    </div>

  </div>
</div>
