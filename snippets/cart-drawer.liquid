<!-- MILE LUXURY CART DRAWER SLIDE-OVER -->
<div id="cart-drawer-overlay" class="drawer-overlay" aria-hidden="true" onclick="closeCartDrawer()" style="cursor: pointer;"></div>

<aside id="cart-drawer" class="cart-drawer" role="dialog" aria-modal="true" aria-label="Carrello dei Rituali Milebiolab" aria-hidden="true">

  <!-- Header -->
  <div class="cart-drawer-header">
    <h3 class="cart-drawer-title">Il Tuo Rituale di <em>Bellezza</em></h3>
    <button type="button" class="btn-drawer-close" onclick="closeCartDrawer()" aria-label="Chiudi carrello">&times;</button>
  </div>

  <!-- Free Shipping & 3 Samples Progress Bar (Threshold: €120) -->
  {% unless settings.show_drawer_shipping_bar == false %}
  <div class="shipping-bar-container" id="drawer-shipping-bar" data-shipping-bar-container>
    <div id="cart-progress-text" style="line-height: 1.4;">
      🌿 Aggiungi ancora per sbloccare la Spedizione Gratuita e i 3 Campioncini Omaggio!
    </div>
    <div class="shipping-progress-track">
      <div class="shipping-progress-fill" id="cart-progress-fill" style="width: 70%;"></div>
    </div>
  </div>

  <script>
    (function() {
      try {
        if (localStorage.getItem('mile_hide_shipping_bar') === 'true' || (typeof window !== 'undefined' && window.mileHideShippingBar === true)) {
          var bar = document.getElementById('drawer-shipping-bar');
          if (bar) bar.style.display = 'none';
        }
      } catch(e) {}
    })();
  </script>
  {% endunless %}



  <!-- Cart Dynamic Items List -->
  <div class="cart-drawer-items" id="cart-drawer-items-list">
    <!-- Populated dynamically via MilebiolabState.cart in theme.js -->
  </div>



  <!-- Footer with Subtotal & Checkout Button -->
  <div class="cart-drawer-footer">
    <!-- BEAUTY CLUB MILE LOYALTY WIDGET -->
    <div class="loyalty-cart-widget p-3 mb-3 bg-[#FAF8F5] border border-[#E5E0D8] text-xs">
      <div class="flex items-center justify-between gap-2 mb-1.5">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#C8A878] font-semibold flex items-center gap-1.5">
          <span>💖</span> Beauty Club Mile
        </span>
        <a href="/pages/programma-fedelta" class="text-[10px] text-[#7A7265] underline hover:text-[#1A1A1A]">Regolamento</a>
      </div>

      {% if customer %}
        {% assign customer_points = customer.total_spent | divided_by: 100 | plus: 20 %}
        <div class="flex items-center justify-between text-xs text-[#1A1A1A] font-medium">
          <span>Il tuo saldo punti:</span>
          <span class="font-bold text-[#5C6B56] font-mono">{{ customer_points }} Beauty Punti</span>
        </div>

        {% if customer_points >= 100 %}
          <div class="mt-2 pt-2 border-t border-[#E5E0D8]/60 space-y-1.5">
            <p class="text-[11px] text-[#5C6B56] leading-tight">
              🎉 <strong>Hai sbloccato 5 € di sconto!</strong> Puoi riscattare 100 punti subito.
            </p>
            <a href="/checkout?discount=BEAUTYCLUB5" class="w-full py-2 px-3 bg-[#5C6B56] hover:bg-[#1A1A1A] text-white text-[11px] uppercase tracking-wider font-semibold text-center block transition-colors shadow-xs">
              Usa i Miei Punti (-5 € al Checkout)
            </a>
          </div>
        {% else %}
          {% assign points_needed = 100 | minus: customer_points %}
          <div class="mt-2 space-y-1">
            <div class="flex justify-between text-[10px] text-[#7A7265]">
              <span>Soglia riscatto 5 € (100 pt)</span>
              <span>Mancano {{ points_needed }} pt</span>
            </div>
            <div class="w-full h-1.5 bg-[#E5E0D8] rounded-full overflow-hidden">
              <div class="h-full bg-[#C8A878] rounded-full transition-all duration-500" style="width: {{ customer_points }}%;"></div>
            </div>
            <p class="text-[10px] text-[#7A7265] leading-tight">
              Ti mancano <strong>{{ points_needed }} punti</strong> per sbloccare 5 € di sconto.
            </p>
          </div>
        {% endif %}
      {% else %}
        <div class="text-[11px] text-[#1A1A1A] leading-relaxed">
          <p>
            ✨ Con questo ordine accumulerai <strong class="text-[#5C6B56] font-mono">+{{ cart.total_price | divided_by: 100 }} Beauty Punti</strong>.
          </p>
          <p class="mt-1 text-[#7A7265]">
            <a href="/pages/accedi#register" class="text-[#1A1A1A] underline font-semibold hover:text-[#C8A878]">Accedi o Registrati</a> per ricevere <strong>20 punti di benvenuto subito</strong>!
          </p>
        </div>
      {% endif %}
    </div>
    <div class="cart-subtotal-row">
      <span>Subtotale</span>
      <span class="subtotal-val" id="cart-subtotal-val">€ 170,00</span>
    </div>
    <p style="font-size: 0.74rem; color: var(--color-text-secondary); margin-bottom: 0.85rem;">
      IVA inclusa. Spedizione sicura e tracciata in tutta Italia.
    </p>

    <a href="{{ routes.cart_url }}/checkout" id="cart-drawer-checkout-btn" onclick="window.location.href='/checkout';" class="btn-primary" style="width: 100%; justify-content: center; font-size: 0.84rem; padding: 1rem; cursor: pointer; position: relative; z-index: 10;">
      <span>Procedi al Checkout Sicuro</span>
      <span>&bull;</span>
      <span id="cart-checkout-price">€ 110,00</span>
    </a>

    <a href="{{ routes.cart_url }}" id="cart-drawer-view-cart-btn" class="btn-secondary" style="width: 100%; justify-content: center; font-size: 0.8rem; padding: 0.85rem; margin-top: 0.65rem; cursor: pointer; text-decoration: none; position: relative; z-index: 10;">
      <span>Visualizza Carrello Completo</span>
      <span>&rarr;</span>
    </a>

    <button type="button" onclick="closeCartDrawer()" class="text-xs uppercase tracking-widest text-[#7A7265] hover:text-[#1A1A1A] transition-colors mt-3 text-center block w-full bg-transparent border-0 cursor-pointer font-medium py-1">
      &larr; Continua lo Shopping
    </button>

    <div style="display: flex; justify-content: center; gap: 14px; margin-top: 0.75rem; font-size: 0.72rem; color: #8C867D;">
      <span>🔒 Checkout 256-bit</span>
      <span>•</span>
      <span>🌿 100% Imballo Riciclabile</span>
      <span>•</span>
      <span>⏱️ Reso Gratuito 30gg</span>
    </div>
  </div>

</aside>
