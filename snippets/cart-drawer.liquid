<!-- MILE LUXURY CART DRAWER SLIDE-OVER -->
<div id="cart-drawer-overlay" class="drawer-overlay" aria-hidden="true"></div>

<aside id="cart-drawer" class="cart-drawer" role="dialog" aria-modal="true" aria-label="Carrello dei Rituali Milebiolab" aria-hidden="true">
  
  <!-- Header -->
  <div class="cart-drawer-header">
    <h3 class="cart-drawer-title">Il Tuo Rituale di <em>Bellezza</em></h3>
    <button type="button" class="btn-drawer-close" onclick="closeCartDrawer()" aria-label="Chiudi carrello">&times;</button>
  </div>
  
  <!-- Free Shipping & 3 Samples Progress Bar (Threshold: €120) -->
  <div class="shipping-bar-container">
    <div id="cart-progress-text" style="line-height: 1.4;">
      🌿 Aggiungi ancora per sbloccare la Spedizione Gratuita e i 3 Campioncini Omaggio!
    </div>
    <div class="shipping-progress-track">
      <div class="shipping-progress-fill" id="cart-progress-fill" style="width: 70%;"></div>
    </div>
  </div>



  <!-- Cart Dynamic Items List -->
  <div class="cart-drawer-items" id="cart-drawer-items-list">
    <!-- Populated dynamically via MilebiolabState.cart in theme.js -->
  </div>



  <!-- Footer with Subtotal & Checkout Button -->
  <div class="cart-drawer-footer">
    <div class="cart-subtotal-row">
      <span>Subtotale</span>
      <span class="subtotal-val" id="cart-subtotal-val">€ 170,00</span>
    </div>
    <p style="font-size: 0.74rem; color: var(--color-text-secondary); margin-bottom: 0.85rem;">
      IVA inclusa. Spedizione gratuita o ritiro rapido oggi a Verona in 2 ore.
    </p>

    <a href="{{ routes.cart_url }}/checkout" class="btn-primary" style="width: 100%; justify-content: center; font-size: 0.84rem; padding: 1rem;">
      <span>Procedi al Checkout Sicuro</span>
      <span>&bull;</span>
      <span id="cart-checkout-price">€ 170,00</span>
    </a>

    <div style="display: flex; justify-content: center; gap: 14px; margin-top: 0.75rem; font-size: 0.72rem; color: #8C867D;">
      <span>🔒 Checkout 256-bit</span>
      <span>•</span>
      <span>🌿 100% Imballo Riciclabile</span>
      <span>•</span>
      <span>⏱️ Reso Gratuito 30gg</span>
    </div>
  </div>

</aside>
