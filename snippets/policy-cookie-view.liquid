      <!-- SEZIONE 6: DIRITTI DELL'UTENTE GDPR -->
      <section class="bg-white border border-[#E5E0D8] p-6 sm:p-10 shadow-xs relative">
        <div class="flex items-start gap-4 mb-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[#FAF8F5] border border-[#C8A878] text-[#C8A878] font-mono text-xs font-bold flex items-center justify-center">06</span>
