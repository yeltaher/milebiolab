{%- assign routine_title = section.settings.title | replace: 'semplificata', '<em>semplificata</em>' | replace: 'Simplified', '<em>Simplified</em>' -%}

<section class="routine-steps-section" id="routine-steps">
  <div class="section-container">
    
    <div style="text-align: center; max-width: 780px; margin: 0 auto;">
      {%- if section.settings.tag != blank -%}
        <span class="protocol-tag">{{ section.settings.tag }}</span>
      {%- endif -%}
      <h2 style="font-size: 2.6rem; margin-top: 0.5rem;">{{ routine_title }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p style="font-size: 1rem; color: var(--color-text-secondary); margin-top: 0.75rem;">
          {{ section.settings.subtitle }}
        </p>
      {%- endif -%}
    </div>

    <!-- 3-Column Routine Steps Grid -->
    <div class="routine-grid-3">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          <div class="routine-step-card" {{ block.shopify_attributes }}>
            <span class="giant-step-number">0{{ forloop.index }}</span>
            <div>
              {%- if block.settings.tag != blank -%}
                <span class="protocol-tag">{{ block.settings.tag }}</span>
              {%- endif -%}
              <h3 style="font-size: 1.6rem; margin: 0.4rem 0;">{{ block.settings.title }}</h3>
              {%- if block.settings.description != blank -%}
                <p style="font-size: 0.88rem; color: var(--color-text-secondary);">
                  {{ block.settings.description }}
                </p>
              {%- endif -%}
            </div>

            {%- if product != blank -%}
              {%- assign card_photo = block.settings.custom_image | default: product.featured_image -%}
              {%- assign card_subtitle = block.settings.product_subtitle | default: product.metafields.custom.subtitle | default: 'Trattamento Biomimetico' -%}
              
              {%- if card_photo != blank -%}
                {%- assign card_photo_url = card_photo | image_url: width: 600 -%}
                {%- assign cart_item_img = card_photo | image_url: width: 300 -%}
              {%- else -%}
                {%- assign card_photo_url = 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80' -%}
                {%- assign cart_item_img = card_photo_url -%}
              {%- endif -%}

              <img 
                src="{{ card_photo_url }}" 
                alt="{{ product.title | escape }}" 
                class="routine-card-photo" loading="lazy">

              <div>
                <h4 style="font-size: 1.1rem; margin-bottom: 0.2rem;">{{ product.title }}</h4>
                <span style="font-size: 0.78rem; color: var(--color-accent-olive); display: block; margin-bottom: 0.8rem;">
                  {{ card_subtitle }}
                </span>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <strong style="font-family: var(--font-mono); font-size: 1.15rem;">{{ product.price | money }}</strong>
                  {%- if product.available -%}
                    <button 
                      type="button" 
                      class="btn-primary" 
                      style="padding: 0.55rem 0.9rem; font-size: 0.72rem;" 
                      onclick="if(window.addShopifyCartItem){window.addShopifyCartItem('{{ product.selected_or_first_available_variant.id }}', 1, {id: '{{ product.selected_or_first_available_variant.id }}', title: '{{ product.title | escape }}', price: {{ product.price | divided_by: 100.0 }}, volume: 'Standard', qty: 1, image: '{{ cart_item_img }}'});} else if(window.addToCart){addToCart({id: '{{ product.selected_or_first_available_variant.id }}', title: '{{ product.title | escape }}', price: {{ product.price | divided_by: 100.0 }}, volume: 'Standard', qty: 1, image: '{{ cart_item_img }}'});}">
                      + Carrello
                    </button>
                  {%- else -%}
                    <button 
                      type="button" 
                      class="btn-primary" 
                      disabled
                      style="padding: 0.55rem 0.9rem; font-size: 0.72rem; opacity: 0.5; cursor: not-allowed;">
                      Esaurito
                    </button>
                  {%- endif -%}
                </div>
              </div>
            {%- else -%}
              {%- case forloop.index -%}
                {%- when 1 -%}
                  {%- assign fallback_title = "Daily Cleansing Milk (200ml)" -%}
                  {%- assign fallback_sub = "Camomilla Bio & Fieno Greco" -%}
                  {%- assign fallback_price = "€ 38,00" -%}
                  {%- assign fallback_price_num = 38.00 -%}
                  {%- assign fallback_vol = "200 ml" -%}
                  {%- assign fallback_img = "https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=600&q=80" -%}
                {%- when 2 -%}
                  {%- assign fallback_title = "Intense Hyaluronic Serum (30ml)" -%}
                  {%- assign fallback_sub = "5 Pesi Molecolari & Mirtillo Biofermentato" -%}
                  {%- assign fallback_price = "€ 86,00" -%}
                  {%- assign fallback_price_num = 86.00 -%}
                  {%- assign fallback_vol = "30 ml" -%}
                  {%- assign fallback_img = "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=600&q=80" -%}
                {%- else -%}
                  {%- assign fallback_title = "Supreme Moisture Cream (50ml)" -%}
                  {%- assign fallback_sub = "Staminali Stella Alpina & Jojoba Bio" -%}
                  {%- assign fallback_price = "€ 84,00" -%}
                  {%- assign fallback_price_num = 84.00 -%}
                  {%- assign fallback_vol = "50 ml" -%}
                  {%- assign fallback_img = "https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80" -%}
              {%- endcase -%}

              {%- assign card_subtitle = block.settings.product_subtitle | default: fallback_sub | default: 'Trattamento Biomimetico' -%}

              {%- if block.settings.custom_image != blank -%}
                {%- assign current_card_img = block.settings.custom_image | image_url: width: 600 -%}
                {%- assign mock_cart_img = block.settings.custom_image | image_url: width: 300 -%}
              {%- else -%}
                {%- assign current_card_img = fallback_img -%}
                {%- assign mock_cart_img = fallback_img -%}
              {%- endif -%}

              <img 
                src="{{ current_card_img }}" 
                alt="{{ block.settings.title | default: fallback_title | escape }}" 
                class="routine-card-photo" loading="lazy"
                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'">

              <div>
                <h4 style="font-size: 1.1rem; margin-bottom: 0.2rem;">{{ fallback_title }}</h4>
                <span style="font-size: 0.78rem; color: var(--color-accent-olive); display: block; margin-bottom: 0.8rem;">
                  {{ card_subtitle }}
                </span>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <strong style="font-family: var(--font-mono); font-size: 1.15rem;">{{ fallback_price }}</strong>
                  <button 
                    type="button" 
                    class="btn-primary" 
                    style="padding: 0.55rem 0.9rem; font-size: 0.72rem;" 
                    onclick="addToCartMock('{{ fallback_title }}', {{ fallback_price_num }}, '{{ mock_cart_img }}', '{{ fallback_vol }}', '0{{ forloop.index }} {{ block.settings.title | escape }}')">
                    + Carrello
                  </button>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- HARDCODED FALLBACK ORIGINALE -->
        <!-- Step 01: RESET -->
        <div class="routine-step-card">
          <span class="giant-step-number">01</span>
          <div>
            <span class="protocol-tag">FASE 1 • PURIFICAZIONE</span>
            <h3 style="font-size: 1.6rem; margin: 0.4rem 0;">RESET</h3>
            <p style="font-size: 0.88rem; color: var(--color-text-secondary);">
              Detersione e riequilibrio del pH fisiologico. Rimuove tossine e residui atmosferici preparando la cute alla penetrazione dei sieri attivi.
            </p>
          </div>

          <img 
            src="https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=600&q=80" 
            alt="Daily Cleansing Milk" 
            class="routine-card-photo" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'">

          <div>
            <h4 style="font-size: 1.1rem; margin-bottom: 0.2rem;">Daily Cleansing Milk (200ml)</h4>
            <span style="font-size: 0.78rem; color: var(--color-accent-olive); display: block; margin-bottom: 0.8rem;">Camomilla Bio & Fieno Greco</span>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <strong style="font-family: var(--font-mono); font-size: 1.15rem;">€ 38,00</strong>
              <button type="button" class="btn-primary" style="padding: 0.55rem 0.9rem; font-size: 0.72rem;" onclick="addToCartMock('Daily Cleansing Milk', 38.00, 'https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=200&q=80', '200 ml', '01 RESET')">
                + Carrello
              </button>
            </div>
          </div>
        </div>

        <!-- Step 02: CONCENTRATE -->
        <div class="routine-step-card">
          <span class="giant-step-number">02</span>
          <div>
            <span class="protocol-tag">FASE 2 • NUTRIZIONE PROFONDA</span>
            <h3 style="font-size: 1.6rem; margin: 0.4rem 0;">CONCENTRATE</h3>
            <p style="font-size: 0.88rem; color: var(--color-text-secondary);">
              Infusione di acido ialuronico multi-molecolare e fitonutrienti alpini. Stimola la sintesi fibroblastica negli strati basali dell'epidermide.
            </p>
          </div>

          <img 
            src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=600&q=80" 
            alt="Intense Hyaluronic Serum" 
            class="routine-card-photo" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'">

          <div>
            <h4 style="font-size: 1.1rem; margin-bottom: 0.2rem;">Intense Hyaluronic Serum (30ml)</h4>
            <span style="font-size: 0.78rem; color: var(--color-accent-olive); display: block; margin-bottom: 0.8rem;">5 Pesi Molecolari & Mirtillo Biofermentato</span>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <strong style="font-family: var(--font-mono); font-size: 1.15rem;">€ 86,00</strong>
              <button type="button" class="btn-primary" style="padding: 0.55rem 0.9rem; font-size: 0.72rem;" onclick="addToCartMock('Intense Hyaluronic Serum', 86.00, 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=200&q=80', '30 ml', '02 CONCENTRATE')">
                + Carrello
              </button>
            </div>
          </div>
        </div>

        <!-- Step 03: HYDRATE -->
        <div class="routine-step-card">
          <span class="giant-step-number">03</span>
          <div>
            <span class="protocol-tag">FASE 3 • SCUDO PROTETTIVO</span>
            <h3 style="font-size: 1.6rem; margin: 0.4rem 0;">HYDRATE</h3>
            <p style="font-size: 0.88rem; color: var(--color-text-secondary);">
              Sigillatura vellutata della barriera lipidica. Le cellule staminali di Stella Alpina proteggono dai radicali liberi e mantengono l'idratazione 72h.
            </p>
          </div>

          <img 
            src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80" 
            alt="Supreme Moisture Cream" 
            class="routine-card-photo" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'">

          <div>
            <h4 style="font-size: 1.1rem; margin-bottom: 0.2rem;">Supreme Moisture Cream (50ml)</h4>
            <span style="font-size: 0.78rem; color: var(--color-accent-olive); display: block; margin-bottom: 0.8rem;">Staminali Stella Alpina & Jojoba Bio</span>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <strong style="font-family: var(--font-mono); font-size: 1.15rem;">€ 84,00</strong>
              <button type="button" class="btn-primary" style="padding: 0.55rem 0.9rem; font-size: 0.72rem;" onclick="addToCartMock('Supreme Moisture Cream', 84.00, 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=200&q=80', '50 ml', '03 HYDRATE')">
                + Carrello
              </button>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- Bundle Offer Bar with Discount -->
    {%- if section.settings.show_bundle -%}
      {%- assign bundle_prod = section.settings.bundle_product -%}
      {%- assign has_bundle_prod = false -%}
      {%- if bundle_prod != blank and bundle_prod.selected_or_first_available_variant -%}
        {%- assign has_bundle_prod = true -%}
      {%- endif -%}

      {%- assign display_compare_price = section.settings.bundle_compare_price -%}
      {%- if display_compare_price == blank and has_bundle_prod and bundle_prod.compare_at_price > bundle_prod.price -%}
        {%- assign display_compare_price = bundle_prod.compare_at_price | money -%}
      {%- endif -%}

      {%- assign display_price = section.settings.bundle_price -%}
      {%- if display_price == blank and has_bundle_prod -%}
        {%- assign display_price = bundle_prod.price | money -%}
      {%- endif -%}

      {%- assign step_variants_json = '' -%}
      {%- assign step_items_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.product != blank and block.settings.product.selected_or_first_available_variant -%}
          {%- assign p = block.settings.product -%}
          {%- assign v = p.selected_or_first_available_variant -%}
          {%- assign p_img = block.settings.custom_image | default: p.featured_image -%}
          {%- if p_img != blank -%}
            {%- assign p_img_url = p_img | image_url: width: 300 -%}
          {%- else -%}
            {%- assign p_img_url = 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=300&q=80' -%}
          {%- endif -%}
          {%- capture item_json -%}{"id":"{{ v.id }}","title":{{ p.title | json }},"price":{{ p.price | divided_by: 100.0 }},"volume":{{ block.settings.product_subtitle | default: 'Trattamento Biomimetico' | json }},"qty":1,"image":"{{ p_img_url }}","step":"0{{ forloop.index }} {{ block.settings.title | escape }}"}{%- endcapture -%}
          {%- if step_variants_json == '' -%}
            {%- assign step_variants_json = item_json -%}
          {%- else -%}
            {%- assign step_variants_json = step_variants_json | append: ',' | append: item_json -%}
          {%- endif -%}
          {%- assign step_items_count = step_items_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- assign bundle_formatted_title = section.settings.bundle_title | replace: 'Sconto 15% Immediato', '<em>Sconto 15% Immediato</em>' | replace: '•', '&bull;' -%}
      <div class="routine-bundle-cta-box">
        <div>
          {%- if section.settings.bundle_badge != blank -%}
            <span class="magnetic-glow-pulse-badge">{{ section.settings.bundle_badge }}</span>
          {%- endif -%}
          <h3 style="font-size: 1.45rem; margin: 0.5rem 0 0.25rem 0;">{{ bundle_formatted_title }}</h3>
          {%- if section.settings.bundle_desc != blank -%}
            <p style="font-size: 0.88rem; color: var(--color-text-secondary);">
              {{ section.settings.bundle_desc }}
            </p>
          {%- endif -%}
        </div>

        <div style="display: flex; align-items: center; gap: 18px; flex-wrap: wrap;">
          <div style="text-align: right;">
            {%- if display_compare_price != blank -%}
              <div style="font-family: var(--font-mono); font-size: 0.85rem; color: #9E9382; text-decoration: line-through;">{{ display_compare_price }}</div>
            {%- endif -%}
            {%- if display_price != blank -%}
              <div style="font-family: var(--font-mono); font-size: 1.7rem; font-weight: 700; color: var(--color-text-primary);">{{ display_price }}</div>
            {%- endif -%}
          </div>

          {%- if has_bundle_prod -%}
            {%- assign bundle_variant = bundle_prod.selected_or_first_available_variant -%}
            {%- assign bundle_img = bundle_prod.featured_image | image_url: width: 300 -%}
            <button 
              type="button" 
              class="btn-primary btn-atc-olive" 
              style="padding: 1.1rem 2rem;"
              {%- if bundle_variant.available == false -%}
                disabled style="padding: 1.1rem 2rem; opacity: 0.5; cursor: not-allowed;"
              {%- endif -%}
              onclick="if(window.addShopifyCartItem){window.addShopifyCartItem('{{ bundle_variant.id }}', 1, {id: '{{ bundle_variant.id }}', title: {{ bundle_prod.title | json }}, price: {{ bundle_prod.price | divided_by: 100.0 }}, volume: 'Set Routine', qty: 1, image: '{{ bundle_img }}'});} else if(window.addToCart){addToCart({id: '{{ bundle_variant.id }}', title: {{ bundle_prod.title | json }}, price: {{ bundle_prod.price | divided_by: 100.0 }}, volume: 'Set Routine', qty: 1, image: '{{ bundle_img }}'});} else if(window.addRoutineBundleToCart){addRoutineBundleToCart();}">
              {%- if bundle_variant.available == false -%}
                Esaurito
              {%- else -%}
                {{ section.settings.bundle_btn_text | default: 'Aggiungi la Routine Completa al Carrello (-15%) &rarr;' }}
              {%- endif -%}
            </button>
          {%- elsif step_items_count > 0 -%}
            <button 
              type="button" 
              class="btn-primary btn-atc-olive" 
              style="padding: 1.1rem 2rem;" 
              onclick="addRoutineStepsToCart_{{ section.id | replace: '-', '_' }}()">
              {{ section.settings.bundle_btn_text | default: 'Aggiungi la Routine Completa al Carrello (-15%) &rarr;' }}
            </button>
            <script>
              async function addRoutineStepsToCart_{{ section.id | replace: '-', '_' }}() {
                var items = [{{ step_variants_json }}];
                if (!items || items.length === 0) {
                  if (typeof addRoutineBundleToCart === 'function') addRoutineBundleToCart();
                  return;
                }
                var addUrl = (window.routes && window.routes.cart_add_url) ? window.routes.cart_add_url : '/cart/add.js';
                try {
                  var payload = {
                    items: items.map(function(item) {
                      return { id: item.id, quantity: 1 };
                    })
                  };
                  var res = await fetch(addUrl, {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/json',
                      'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                  });
                  if (!res.ok) throw new Error('Cart API ' + res.status);
                  if (typeof fetchShopifyCart === 'function') {
                    await fetchShopifyCart();
                  }
                  if (typeof openCartDrawer === 'function') {
                    openCartDrawer();
                  }
                } catch (e) {
                  if (typeof addToCart === 'function') {
                    items.forEach(function(item) {
                      addToCart(item);
                    });
                  } else if (typeof addRoutineBundleToCart === 'function') {
                    addRoutineBundleToCart();
                  }
                }
              }
            </script>
          {%- else -%}
            <button 
              type="button" 
              class="btn-primary btn-atc-olive" 
              style="padding: 1.1rem 2rem;" 
              onclick="addRoutineBundleToCart()">
              {{ section.settings.bundle_btn_text | default: 'Aggiungi la Routine Completa al Carrello (-15%) &rarr;' }}
            </button>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Routine Semplificata",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Etichetta Sezione",
      "default": "IL PROTOCOLLO ESSENZIALE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo Sezione",
      "default": "La tua routine, semplificata"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sottotitolo Sezione",
      "default": "Tre gesti essenziali in perfetta sequenza biomimetica. Attivi botanici puri calibrati per risvegliare, rimpolpare e sigillare la barriera cutanea."
    },
    {
      "type": "header",
      "content": "Offerta Bundle Completo"
    },
    {
      "type": "checkbox",
      "id": "show_bundle",
      "label": "Mostra Box Offerta Set Completo",
      "default": true
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Prodotto Bundle Shopify (Opzionale: seleziona il prodotto set/cofanetto)"
    },
    {
      "type": "text",
      "id": "bundle_badge",
      "label": "Badge Superiore",
      "default": "OFFERTA SET ESCLUSIVO"
    },
    {
      "type": "text",
      "id": "bundle_title",
      "label": "Titolo Offerta",
      "default": "Acquista i 3 Step Insieme • Sconto 15% Immediato"
    },
    {
      "type": "textarea",
      "id": "bundle_desc",
      "label": "Descrizione e Omaggi",
      "default": "Include Cofanetto Regalo Milebiolab FSC, 3 Campioncini Omaggio e Check-up della pelle gratuito in Istituto a Verona."
    },
    {
      "type": "text",
      "id": "bundle_compare_price",
      "label": "Prezzo di Listino Barrato",
      "default": "€ 208,00"
    },
    {
      "type": "text",
      "id": "bundle_price",
      "label": "Prezzo Finale Scontato",
      "default": "€ 176,80"
    },
    {
      "type": "text",
      "id": "bundle_btn_text",
      "label": "Testo Pulsante Carrello",
      "default": "Aggiungi la Routine Completa al Carrello (-15%) →"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step Routine",
      "limit": 3,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Seleziona Prodotto Shopify"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Etichetta Fase (es. FASE 1 • PURIFICAZIONE)",
          "default": "FASE 1 • PURIFICAZIONE"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titolo Fase (es. RESET)",
          "default": "RESET"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descrizione Benefici",
          "default": "Detersione e riequilibrio del pH fisiologico. Rimuove tossine e residui atmosferici preparando la cute alla penetrazione dei sieri attivi."
        },
        {
          "type": "text",
          "id": "product_subtitle",
          "label": "Sottotitolo / Ingredienti Prodotto",
          "default": "Camomilla Bio & Fieno Greco"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Immagine Alternativa (Opzionale, altrimenti usa foto prodotto)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "La tua routine, semplificata",
