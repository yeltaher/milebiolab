{%- comment -%}
  MileBioLab - Modal Ritiro Esclusivo in Sede Flagship Verona
  OS 2.0 Section - Totalmente personalizzabile da Theme Editor
{%- endcomment -%}

{%- if section.settings.enable_modal or section.settings.enable_modal == nil or request.design_mode -%}
<div
  id="verona-modal-overlay"
  class="modal-overlay"
  aria-hidden="true"
  onclick="closeVeronaModal()"
  {{ section.shopify_attributes }}
>
  <div
    class="verona-modal-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-verona-title"
    style="background: #FFFFFF; border: var(--border-splendor); max-width: 580px; width: 92%; padding: 2.5rem; position: relative; box-shadow: 0 20px 60px rgba(0,0,0,0.2);"
    onclick="event.stopPropagation()"
  >
    <button
      type="button"
      class="modal-close-btn"
      onclick="closeVeronaModal()"
      aria-label="Chiudi finestra"
      style="position: absolute; top: 1.25rem; right: 1.25rem; background: transparent; border: none; font-size: 1.5rem; line-height: 1; cursor: pointer; color: var(--color-text-secondary); padding: 0.25rem;"
    >
      &times;
    </button>

    <span class="protocol-tag">
      {{ section.settings.eyebrow | default: 'ISTITUTO MILEBIOLAB • VERONA FLAGSHIP' }}
    </span>

    <h3
      id="modal-verona-title"
      style="font-size: 1.7rem; margin: 0.4rem 0 0.8rem 0;"
    >
      {{ section.settings.title | default: 'Ritiro Esclusivo in Sede a Verona' }}
    </h3>

    <p style="font-size: 0.88rem; color: var(--color-text-secondary); margin-bottom: 1.5rem; line-height: 1.5;">
      {{ section.settings.description | default: "Ordina comodamente online e ritira il tuo ordine presso il nostro istituto Lebestetik in Via Torricelle, 2c a Verona. Riceverai un'accoglienza personalizzata e un buono sconto del 10% per i trattamenti benessere in Spa." | newline_to_br }}
    </p>

    <div style="background: var(--color-bg-alt); border: 1px solid var(--color-border); padding: 1.25rem; display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.84rem; margin-bottom: 1.5rem;">
      <div>
        📍 <strong>{{ section.settings.label_address | default: 'Indirizzo:' }}</strong> {{ section.settings.detail_address | default: 'Via Torricelle, 2c • 37128 Verona (VR) in Lebestetik Beauty & Spa' }}
      </div>
      <div>
        ⏱️ <strong>{{ section.settings.label_time | default: 'Tempo di preparazione:' }}</strong> {{ section.settings.detail_time | default: 'Pronto entro 48 ore lavorative (notifica via WhatsApp / SMS)' }}
      </div>
      <div>
        🎁 <strong>{{ section.settings.label_gift | default: 'Omaggio Esclusivo:' }}</strong> {{ section.settings.detail_gift | default: 'Buono sconto 10% per trattamenti benessere Lebestetik & consulenza' }}
      </div>
      <div>
        🕒 <strong>{{ section.settings.label_hours | default: 'Orari Ritiro:' }}</strong> {{ section.settings.detail_hours | default: 'Lunedì – Sabato: 09:30 – 19:30 (SU APPUNTAMENTO - chiuso il mercoledì)' }}
      </div>
      <div>
        📞 <strong>{{ section.settings.label_phone | default: 'Contatti:' }}</strong> {{ section.settings.detail_phone | default: '+39 045 8301811 • WhatsApp +39 342 1647585' }}
      </div>
    </div>

    <button
      type="button"
      class="btn-primary"
      style="width: 100%; justify-content: center;"
      onclick="closeVeronaModal(); setDeliveryChoice('pickup'); openCartDrawer();"
    >
      {{ section.settings.cta_btn_text | default: 'Seleziona Ritiro a Verona per il Tuo Ordine →' }}
    </button>
  </div>
</div>

<script>
  (function() {
    {% if request.design_mode %}
      document.addEventListener('shopify:section:select', function(event) {
        if (event.detail && event.detail.sectionId === '{{ section.id }}') {
          if (typeof openVeronaModal === 'function') openVeronaModal();
        }
      });
      document.addEventListener('shopify:section:deselect', function(event) {
        if (event.detail && event.detail.sectionId === '{{ section.id }}') {
          if (typeof closeVeronaModal === 'function') closeVeronaModal();
        }
      });
    {% endif %}
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Modal Ritiro in Sede (VR)",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_modal",
      "label": "Abilita Modal Ritiro in Sede",
      "default": true
    },
    {
      "type": "header",
      "content": "Intestazione & Messaggio"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Tagline superiore",
      "default": "ISTITUTO MILEBIOLAB • VERONA FLAGSHIP"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo principale",
      "default": "Ritiro Esclusivo in Sede a Verona"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrizione",
      "default": "Ordina comodamente online e ritira il tuo ordine presso il nostro istituto Lebestetik in Via Torricelle, 2c a Verona. Riceverai un'accoglienza personalizzata e un buono sconto del 10% per i trattamenti benessere in Spa."
    },
    {
      "type": "header",
      "content": "Dettagli Ritiro in Sede"
    },
    {
      "type": "text",
      "id": "label_address",
      "label": "Etichetta Indirizzo",
      "default": "Indirizzo:"
    },
    {
      "type": "text",
      "id": "detail_address",
      "label": "Valore Indirizzo",
      "default": "Via Torricelle, 2c • 37128 Verona (VR) in Lebestetik Beauty & Spa"
    },
    {
      "type": "text",
      "id": "label_time",
      "label": "Etichetta Tempo di Preparazione",
      "default": "Tempo di preparazione:"
    },
    {
      "type": "text",
      "id": "detail_time",
      "label": "Valore Tempo di Preparazione",
      "default": "Pronto entro 48 ore lavorative (notifica via WhatsApp / SMS)"
    },
    {
      "type": "text",
      "id": "label_gift",
      "label": "Etichetta Omaggio Cabina",
      "default": "Omaggio Cabina:"
    },
    {
      "type": "textarea",
      "id": "detail_gift",
      "label": "Valore Omaggio Esclusivo",
      "default": "Buono sconto 10% per trattamenti benessere Lebestetik & consulenza"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "Etichetta Orari Ritiro",
      "default": "Orari Ritiro:"
    },
    {
      "type": "text",
      "id": "detail_hours",
      "label": "Valore Orari Ritiro",
      "default": "Lunedì – Sabato: 09:30 – 19:30 (SU APPUNTAMENTO - chiuso il mercoledì)"
    },
    {
      "type": "header",
      "content": "Pulsante Azione Finale"
    },
    {
      "type": "text",
      "id": "cta_btn_text",
      "label": "Testo pulsante di selezione",
      "default": "Seleziona Ritiro a Verona per il Tuo Ordine →"
    },
    {
      "type": "text",
      "id": "label_phone",
      "label": "Etichetta Contatti",
      "default": "Contatti:"
    },
    {
      "type": "text",
      "id": "detail_phone",
      "label": "Valore Recapito Telefonico",
      "default": "+39 045 8301811 • WhatsApp +39 342 1647585"
    }
  ],
  "presets": [
    {
      "name": "Modal Ritiro in Sede (Verona)"
    }
  ]
}
{% endschema %}
