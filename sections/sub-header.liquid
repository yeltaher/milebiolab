<div class="bg-[#F5F2EB] border-b border-[#E5E0D8] py-2 px-6 lg:px-12 hidden lg:flex justify-center items-center gap-6 overflow-x-auto whitespace-nowrap text-xs uppercase tracking-widest text-[#1A1A1A]">
  {% assign sub_menu = linklists[section.settings.sub_menu] %}
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}
      <a href="{{ block.settings.url | default: '#' }}" class="hover:text-[#C8A878] transition-colors" {{ block.shopify_attributes }}>{{ block.settings.title }}</a>
    {% endfor %}
  {% elsif sub_menu.links.size > 0 %}
    {% for link in sub_menu.links %}
      <a href="{{ link.url }}" class="hover:text-[#C8A878] transition-colors">{{ link.title }}</a>
    {% endfor %}
  {% else %}
    <a href="/collections/all" class="hover:text-[#C8A878] transition-colors">CORPO / PURE PERFORMANCE</a>
    <a href="/collections/all" class="hover:text-[#C8A878] transition-colors">PRESERVAGE</a>
    <a href="/collections/all" class="hover:text-[#C8A878] transition-colors">PROTEZIONE SOLARE</a>
    <a href="/collections/all" class="hover:text-[#C8A878] transition-colors">UNICHO 21</a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Sub-Header Categorie",
  "settings": [
    {
      "type": "link_list",
      "id": "sub_menu",
      "label": "Menu Categorie (Fallback)",
      "default": "main-menu"
    }
  ],
  "blocks": [
    {
      "type": "category_link",
      "name": "Voce Categoria",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titolo / Nome Categoria",
          "default": "Categoria"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link / Collezione",
          "default": "/collections/all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sub-Header Categorie",
      "blocks": [
        {
          "type": "category_link",
          "settings": {
            "title": "CORPO / PURE PERFORMANCE",
            "url": "/collections/all"
          }
        },
        {
          "type": "category_link",
          "settings": {
            "title": "PRESERVAGE",
            "url": "/collections/all"
          }
        },
        {
          "type": "category_link",
          "settings": {
            "title": "PROTEZIONE SOLARE",
            "url": "/collections/all"
          }
        },
        {
          "type": "category_link",
          "settings": {
            "title": "UNICHO 21",
            "url": "/collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
