<div class="py-12 sm:py-16 lg:py-20 bg-[#F5F2EB] text-[#1A1A1A]">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-widest text-[#7A7265] mb-8" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="hover:text-[#1A1A1A] transition-colors">Home</a>
      <span class="text-[#DDD7CE]">/</span>
      <span class="text-[#1A1A1A] font-semibold">{{ blog.title }}</span>
    </nav>

    <!-- Blog Header -->
    <header class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="inline-block text-[#C8A878] font-mono text-xs tracking-widest uppercase font-semibold mb-3">
        {{ section.settings.eyebrow | default: 'Il Giornale Botanico MileBioLab' }}
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-[#1A1A1A] tracking-tight leading-tight">
        {{ blog.title }}
      </h1>
      <p class="text-xs sm:text-sm text-[#7A7265] mt-4 leading-relaxed font-light">
        {{ section.settings.subheading | default: 'Approfondimenti scientifici su fitoterapia alpina, dermocosmesi biomimetica e rituali di longevità cutanea.' }}
      </p>
      <div class="w-16 h-0.5 bg-[#C8A878] mx-auto mt-6"></div>
    </header>

    <!-- Tag Filter Pills (if any) -->
    {% if blog.all_tags.size > 0 %}
      <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
        <a
          href="{{ blog.url }}"
          class="px-4 py-1.5 text-[11px] font-mono uppercase tracking-wider border transition-colors {% unless current_tags %}bg-[#1A1A1A] text-white border-[#1A1A1A]{% else %}bg-white text-[#7A7265] border-[#DDD7CE] hover:border-[#1A1A1A]{% endunless %}"
        >
          Tutti gli articoli
        </a>
        {% for tag in blog.all_tags %}
          {% if current_tags contains tag %}
            <span class="px-4 py-1.5 text-[11px] font-mono uppercase tracking-wider bg-[#1A1A1A] text-white border border-[#1A1A1A]">
              {{ tag }}
            </span>
          {% else %}
            <a
              href="{{ blog.url }}/tagged/{{ tag | handle }}"
              class="px-4 py-1.5 text-[11px] font-mono uppercase tracking-wider bg-white text-[#7A7265] border border-[#DDD7CE] hover:border-[#1A1A1A] hover:text-[#1A1A1A] transition-colors"
            >
              {{ tag }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <!-- Article Listing Grid -->
    {% paginate blog.articles by section.settings.articles_per_page %}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10">
        {% for article in blog.articles %}
          <article class="bg-white border border-[#DDD7CE] overflow-hidden group shadow-xs hover:shadow-md transition-all flex flex-col justify-between" style="border: 3px double #EDE5DB;">
            
            {% if section.settings.show_image and article.image %}
              <a href="{{ article.url }}" class="block relative aspect-[16/10] overflow-hidden bg-[#FAF8F5]">
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-700 ease-out"
                >
                {% if article.tags.first %}
                  <span class="absolute top-3 left-3 bg-[#1A1A1A]/85 backdrop-blur-xs text-white text-[10px] font-mono tracking-widest uppercase px-2.5 py-1">
                    {{ article.tags.first }}
                  </span>
                {% endif %}
              </a>
            {% endif %}

            <div class="p-6 sm:p-7 flex flex-col flex-1 justify-between bg-white">
              <div>
                <!-- Metadata -->
                <div class="flex items-center gap-3 text-[10px] font-mono uppercase tracking-wider text-[#7A7265] mb-2">
                  {% if section.settings.show_date %}
                    <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                      {{ article.published_at | date: '%d %B %Y' }}
                    </time>
                  {% endif %}
                  {% if section.settings.show_author and section.settings.show_date %}
                    <span class="text-[#DDD7CE]">&bull;</span>
                  {% endif %}
                  {% if section.settings.show_author %}
                    <span>{{ article.author }}</span>
                  {% endif %}
                </div>

                <!-- Title -->
                <h2 class="font-serif text-xl sm:text-2xl text-[#1A1A1A] group-hover:text-[#5C6B56] transition-colors leading-snug">
                  <a href="{{ article.url }}">
                    {{ article.title }}
                  </a>
                </h2>

                <!-- Excerpt -->
                {% if section.settings.show_excerpt %}
                  <p class="text-xs text-[#7A7265] mt-3 line-clamp-3 leading-relaxed font-light">
                    {{ article.excerpt_or_content | strip_html | truncatewords: 24 }}
                  </p>
                {% endif %}
              </div>

              <!-- Read More CTA -->
              <div class="mt-6 pt-4 border-t border-[#F5F2EB] flex items-center justify-between">
                <a href="{{ article.url }}" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#1A1A1A] group-hover:text-[#C8A878] uppercase tracking-wider transition-colors">
                  <span>Leggi l'Articolo</span>
                  <span class="transform group-hover:translate-x-1 transition-transform">&rarr;</span>
                </a>
              </div>
            </div>

          </article>
        {% else %}
          <div class="col-span-full text-center py-12 bg-white border border-[#DDD7CE] p-8">
            <p class="font-serif text-xl text-[#1A1A1A]">Nessun articolo pubblicato al momento.</p>
            <p class="text-xs text-[#7A7265] mt-2">Torna presto per scoprire le nuove pubblicazioni scientifiche e botaniche.</p>
          </div>
        {% endfor %}
      </div>

      <!-- Pagination -->
      {% if paginate.pages > 1 %}
        <div class="mt-14 flex items-center justify-center gap-2 font-mono text-xs">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="px-4 py-2 border border-[#DDD7CE] bg-white hover:bg-[#1A1A1A] hover:text-white transition-colors uppercase">
              &larr; Precedente
            </a>
          {% endif %}

          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="px-3.5 py-2 border border-[#DDD7CE] bg-white hover:bg-[#1A1A1A] hover:text-white transition-colors">
                {{ part.title }}
              </a>
            {% else %}
              {% if part.title == paginate.current_page %}
                <span class="px-3.5 py-2 border border-[#1A1A1A] bg-[#1A1A1A] text-white font-bold">
                  {{ part.title }}
                </span>
              {% else %}
                <span class="px-3.5 py-2 text-[#7A7265]">{{ part.title }}</span>
              {% endif %}
            {% endif %}
          {% endfor %}

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="px-4 py-2 border border-[#DDD7CE] bg-white hover:bg-[#1A1A1A] hover:text-white transition-colors uppercase">
              Successiva &rarr;
            </a>
          {% endif %}
        </div>
      {% endif %}

    {% endpaginate %}

  </div>
</div>

{% schema %}
{
  "name": "Main Blog Mile",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Sopratitolo",
      "default": "Il Giornale Botanico MileBioLab"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sottotitolo Blog",
      "default": "Approfondimenti scientifici su fitoterapia alpina, dermocosmesi biomimetica e rituali di longevità cutanea."
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 3,
      "max": 18,
      "step": 3,
      "label": "Articoli per pagina",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Mostra immagine di copertina",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Mostra data pubblicazione",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Mostra autore",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Mostra estratto",
      "default": true
    }
  ]
}
{% endschema %}
