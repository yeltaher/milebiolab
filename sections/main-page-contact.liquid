{% comment %}
  MILEBIOLAB - SECTION MAIN PAGE CONTACT
  Sezione Pagina Contatti Haute Couture conforme all'estetica Splendor & Dr. Joseph.
  Layout a due colonne con Boutique & Concierge Verona e Modulo Ufficiale Shopify.
  Completamente autonoma e personalizzabile dal Theme Editor Shopify in tempo reale.
{% endcomment %}

{%- liquid
  assign show_header = section.settings.show_header
  assign eyebrow = section.settings.eyebrow | default: "Ritiro a • VERONA"
  assign title = section.settings.title | default: "Entra in Contatto con Mile BioLab"
  assign subtitle = section.settings.subtitle | default: "Desideri informazioni particolari?\nContattaci siamo a tua disposizione"

  assign show_boutique_card = section.settings.show_boutique_card
  assign boutique_tag = section.settings.boutique_tag | default: "Per RITIRI IN ISTITUTO a VERONA"
  assign boutique_title = section.settings.boutique_title | default: "Lebestetik Beauty & Spa"
  assign boutique_address_label = section.settings.boutique_address_label | default: "SedeLebestetik"
  assign boutique_address = section.settings.boutique_address | default: "Verona, Via Torricelle 2c in Lebestetik Beauty & Spa"
  assign show_pickup_guide = section.settings.show_pickup_guide
  assign boutique_pickup_text = section.settings.boutique_pickup_text | default: "Dettagli Ritiro in Sede & Guida"
  assign boutique_hours_label = section.settings.boutique_hours_label | default: "Orari di Apertura"
  assign boutique_hours = section.settings.boutique_hours | default: "SU APPUNTAMENTO Lunedì – Sabato: 09:30 – 19:30 (chiuso il mercoledì)"
  assign boutique_phone_label = section.settings.boutique_phone_label | default: "Messaggi Whatsapp Per Appuntamento"
  assign phone = section.settings.phone | default: "+39 045 8301811"
  assign boutique_email_label = section.settings.boutique_email_label | default: "info@beautyespatorricelle.it"
  assign email = section.settings.email | default: "info@beautyespatorricelle.it"

  assign show_whatsapp_btn = section.settings.show_whatsapp_btn
  assign whatsapp_text = section.settings.whatsapp_text | default: "Scrivici su WhatsApp Diretto"
  assign whatsapp_url = section.settings.whatsapp_url
  if whatsapp_url == blank
    assign whatsapp_url = "https://wa.me/393421647585"
  endif

  assign show_consultation_card = section.settings.show_consultation_card
  assign consultation_title = section.settings.consultation_title | default: "Consulenza e sconto speciale"
  assign consultation_desc = section.settings.consultation_desc | default: "Ritirando presso il nostro istituto di Verona riceverai un trattamento privilegiato"
  assign consultation_badge = section.settings.consultation_badge | default: "Sconto riservato del 10% per un trattamento benessere in istituto"

  assign form_title = section.settings.form_title | default: "Scrivi al Nostro Servizio MILE"
  assign form_subtitle = section.settings.form_subtitle | default: "Rispondiamo entro 24 ore lavorative"
  assign label_name = section.settings.label_name | default: "Nome e Cognome"
  assign placeholder_name = section.settings.placeholder_name | default: "Es. Maria Rossi"
  assign label_email = section.settings.label_email | default: "Indirizzo Email"
  assign placeholder_email = section.settings.placeholder_email | default: "nome@esempio.it"
  assign label_phone = section.settings.label_phone | default: "Telefono (opzionale)"
  assign placeholder_phone = section.settings.placeholder_phone | default: "+39 333 1234567"
  assign label_reason = section.settings.label_reason | default: "Motivo del Contatto"
  assign raw_reason_str = section.settings.reason_options | default: "Consulenza Dermocosmetica Personalizzata\nInformazioni Ordini & Spedizioni\nPrenotazione Trattamento a Verona\nAltro"
  assign label_message = section.settings.label_message | default: "Messaggio"
  assign placeholder_message = section.settings.placeholder_message | default: "Descrivi la tua richiesta, esigenze cutanee o informazioni desiderate..."
  assign privacy_text = section.settings.privacy_text | default: "Ho letto e accetto l'Informativa sulla Privacy per il trattamento dei dati personali."
  assign submit_label = section.settings.submit_label | default: "Invia Messaggio al Concierge →"
  assign success_title = section.settings.success_title | default: "Messaggio Inviato con Successo"
  assign success_desc = section.settings.success_desc | default: "Grazie per aver contattato il Concierge MileBioLab. Abbiamo ricevuto la tua richiesta e ti risponderemo con la massima cura entro 24 ore lavorative."

  assign show_sidebar = true
  if show_boutique_card == false and show_consultation_card != true
    assign show_sidebar = false
  endif
-%}

<div class="py-12 md:py-20 px-4 sm:px-6 lg:px-8 bg-[#F5F2EB] text-[#1A1A1A] font-sans" id="contact-page-container">
  <div class="max-w-6xl mx-auto space-y-12 lg:space-y-16">

    <!-- BREADCRUMBS -->
    <nav class="flex items-center gap-2 text-xs uppercase tracking-widest text-[#7A7265] border-b border-[#E5E0D8] pb-4" aria-label="Percorso di navigazione">
      <a href="{{ routes.root_url }}" class="hover:text-[#1A1A1A] transition-colors">Home</a>
      <span class="text-[#E5E0D8]">/</span>
      <span class="text-[#1A1A1A] font-semibold">Contatti</span>
    </nav>

    <!-- HEADER PAGINA -->
    {% unless show_header == false %}
    <header class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-block px-3.5 py-1 text-[11px] uppercase tracking-[0.2em] font-medium bg-[#FAF8F5] text-[#5C6B56] border border-[#C8A878]/30 shadow-sm">
        {{ eyebrow }}
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#1A1A1A] font-normal leading-tight">
        {{ title }}
      </h1>
      <p class="text-sm sm:text-base text-[#7A7265] font-light leading-relaxed max-w-2xl mx-auto">
        {{ subtitle }}
      </p>
    </header>
    {% endunless %}

    <!-- LAYOUT A 2 COLONNE / COLONNA CENTRATA -->
    <div class="grid grid-cols-1 {% if show_sidebar %}lg:grid-cols-12{% endif %} gap-10 lg:gap-12 items-start">

      {% if show_sidebar %}
      <!-- COLONNA 1: INFO BOUTIQUE VERONA (5 Colonne) -->
      <div class="lg:col-span-5 space-y-6">

        <!-- Card Boutique -->
        {% unless show_boutique_card == false %}
        <div class="bg-[#FAF8F5] border border-[#E5E0D8] p-6 sm:p-8 shadow-sm space-y-6">
          <div class="border-b border-[#E5E0D8] pb-5">
            <span class="text-[10px] uppercase tracking-[0.25em] font-semibold text-[#5C6B56] block mb-1">
              {{ boutique_tag }}
            </span>
            <h2 class="font-serif text-2xl text-[#1A1A1A] font-normal">
              {{ boutique_title }}
            </h2>
          </div>

          <!-- Dettagli Boutique -->
          <ul class="space-y-4 text-xs text-[#3A3530]">
            <!-- Indirizzo con link al modal Verona -->
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 text-[#5C6B56] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <div class="space-y-1">
                <span class="font-semibold text-[#1A1A1A] block uppercase tracking-wider text-[11px]">{{ boutique_address_label }}</span>
                <p class="leading-relaxed text-[#7A7265]">{{ boutique_address }}</p>
                {% unless show_pickup_guide == false %}
                <button
                  type="button"
                  onclick="if(window.openVeronaModal) openVeronaModal();"
                  class="inline-flex items-center gap-1.5 text-[11px] uppercase tracking-wider text-[#5C6B56] hover:text-[#C8A878] font-semibold transition-colors bg-transparent border-0 p-0 cursor-pointer pt-1"
                >
                  <span>{{ boutique_pickup_text }}</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
                {% endunless %}
              </div>
            </li>

            <!-- Orari -->
            <li class="flex items-start gap-3 pt-3 border-t border-[#E5E0D8]/60">
              <svg class="w-4 h-4 text-[#5C6B56] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div class="space-y-0.5">
                <span class="font-semibold text-[#1A1A1A] block uppercase tracking-wider text-[11px]">{{ boutique_hours_label }}</span>
                <p class="text-[#7A7265] leading-relaxed">{{ boutique_hours }}</p>
              </div>
            </li>

            <!-- Telefono -->
            <li class="flex items-start gap-3 pt-3 border-t border-[#E5E0D8]/60">
              <svg class="w-4 h-4 text-[#5C6B56] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <div class="space-y-0.5">
                <span class="font-semibold text-[#1A1A1A] block uppercase tracking-wider text-[11px]">{{ boutique_phone_label }}</span>
                <a href="tel:{{ phone | remove: ' ' }}" class="text-[#1A1A1A] hover:text-[#C8A878] transition-colors font-medium">
                  {{ phone }}
                </a>
              </div>
            </li>

            <!-- Email -->
            <li class="flex items-start gap-3 pt-3 border-t border-[#E5E0D8]/60">
              <svg class="w-4 h-4 text-[#5C6B56] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              <div class="space-y-0.5">
                <span class="font-semibold text-[#1A1A1A] block uppercase tracking-wider text-[11px]">{{ boutique_email_label }}</span>
                <a href="mailto:{{ email }}" class="text-[#1A1A1A] hover:text-[#C8A878] transition-colors font-medium">
                  {{ email }}
                </a>
              </div>
            </li>
          </ul>

          <!-- Pulsante WhatsApp Diretto -->
          {% unless show_whatsapp_btn == false %}
          <div class="pt-2">
            <a
              href="{{ whatsapp_url }}"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2.5 bg-[#5C6B56] hover:bg-[#4A5745] text-white py-3.5 px-6 text-xs uppercase tracking-[0.2em] font-semibold transition-all shadow-sm luxury-interactive group"
            >
              <svg class="w-4 h-4 text-[#C8A878] group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.99.54 1.785.83 2.796.83 3.183 0 5.769-2.586 5.769-5.766.001-3.182-2.585-5.617-5.769-5.617zm0-2.172c4.387 0 7.947 3.56 7.947 7.947 0 4.386-3.56 7.946-7.947 7.946-1.393 0-2.697-.361-3.83-1l-4.201 1.1 1.121-4.093c-.727-1.196-1.137-2.585-1.137-4.043 0-4.387 3.56-7.947 7.947-7.947zm3.896 11.233c-.214.602-1.246 1.154-1.721 1.218-.465.063-1.071.092-3.111-.75-2.607-1.077-4.288-3.729-4.418-3.902-.13-.173-1.057-1.408-1.057-2.684 0-1.277.669-1.905.908-2.164.238-.26.52-.325.694-.325.174 0 .347.002.499.01.162.008.38-.061.595.455.228.547.781 1.906.848 2.047.067.141.112.308.018.495-.094.187-.142.304-.282.47-.14.166-.296.371-.423.498-.141.141-.288.293-.124.574.164.281.729 1.202 1.564 1.947 1.075.957 1.981 1.254 2.263 1.394.282.141.447.118.613-.074.165-.192.706-.821.894-1.103.188-.282.376-.235.635-.141.259.094 1.644.775 1.926.916.282.141.47.212.541.33.071.118.071.684-.143 1.286z"/>
              </svg>
              <span>{{ whatsapp_text }}</span>
            </a>
          </div>
          {% endunless %}
        </div>
        {% endunless %}

        <!-- Box Informativo Consulenza Personalizzata -->
        {% if show_consultation_card %}
        <div class="bg-white border border-[#E5E0D8] p-6 shadow-sm space-y-3">
          <div class="flex items-center gap-2.5 text-[#5C6B56]">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
            <h3 class="text-xs uppercase tracking-[0.18em] font-bold text-[#1A1A1A]">
              {{ consultation_title }}
            </h3>
          </div>
          <p class="text-xs text-[#7A7265] leading-relaxed">
            {{ consultation_desc }}
          </p>
          {% if consultation_badge != blank %}
          <div class="pt-1 text-[11px] text-[#5C6B56] font-medium flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#5C6B56]"></span>
            <span>{{ consultation_badge }}</span>
          </div>
          {% endif %}
        </div>
        {% endif %}

      </div>
      {% endif %}

      <!-- COLONNA 2: MODULO DI CONTATTO UFFICIALE SHOPIFY -->
      <div class="{% if show_sidebar %}lg:col-span-7{% else %}lg:col-span-12 max-w-2xl mx-auto w-full{% endif %}">
        <div class="bg-white border border-[#EDE5DB] p-6 sm:p-10 shadow-sm space-y-6">

          <!-- Header Form -->
          <div class="border-b border-[#E5E0D8] pb-5">
            <h2 class="font-serif text-2xl sm:text-3xl text-[#1A1A1A] font-normal mb-1">
              {{ form_title }}
            </h2>
            <p class="text-xs text-[#7A7265] uppercase tracking-wider">
              {{ form_subtitle }}
            </p>
          </div>

          <!-- Modulo Liquid Shopify Ufficiale -->
          {% form 'contact', id: 'ContactForm', class: 'space-y-5' %}

            <!-- Messaggio di Successo Botanico -->
            {% if form.posted_successfully? %}
              <div class="p-5 bg-[#FAF8F5] border border-[#5C6B56] text-[#5C6B56] text-xs uppercase tracking-widest flex items-start gap-3 shadow-sm" role="status">
                <svg class="w-5 h-5 flex-shrink-0 text-[#5C6B56]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <div class="space-y-1">
                  <strong class="font-semibold block text-sm text-[#1A1A1A] normal-case tracking-normal">
                    {{ success_title }}
                  </strong>
                  <p class="normal-case tracking-normal text-xs text-[#5C6B56] leading-relaxed">
                    {{ success_desc }}
                  </p>
                </div>
              </div>
            {% endif %}

            <!-- Messaggio di Errore -->
            {% if form.errors %}
              <div class="p-4 bg-red-50 border border-red-200 text-red-800 text-xs shadow-sm" role="alert">
                <div class="font-semibold uppercase tracking-wider mb-1 flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <span>Si prega di verificare i seguenti campi:</span>
                </div>
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <!-- RIGA 1: NOME & COGNOME + EMAIL -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="space-y-1.5">
                <label for="ContactFormName" class="block text-[11px] uppercase tracking-wider font-medium text-[#1A1A1A]">
                  {{ label_name }} <span class="text-[#5C6B56]">*</span>
                </label>
                <input
                  type="text"
                  name="contact[name]"
                  id="ContactFormName"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  placeholder="{{ placeholder_name }}"
                  required
                  class="w-full px-4 py-3 bg-[#FAF8F5] border border-[#DDD7CE] text-xs text-[#1A1A1A] placeholder-[#9C9488] focus:outline-none focus:border-[#C8A878] focus:bg-white transition-colors"
                >
              </div>

              <div class="space-y-1.5">
                <label for="ContactFormEmail" class="block text-[11px] uppercase tracking-wider font-medium text-[#1A1A1A]">
                  {{ label_email }} <span class="text-[#5C6B56]">*</span>
                </label>
                <input
                  type="email"
                  name="contact[email]"
                  id="ContactFormEmail"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  placeholder="{{ placeholder_email }}"
                  spellcheck="false"
                  autocomplete="email"
                  autocapitalize="off"
                  required
                  class="w-full px-4 py-3 bg-[#FAF8F5] border border-[#DDD7CE] text-xs text-[#1A1A1A] placeholder-[#9C9488] focus:outline-none focus:border-[#C8A878] focus:bg-white transition-colors"
                >
              </div>
            </div>

            <!-- RIGA 2: TELEFONO + MOTIVO DEL CONTATTO -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="space-y-1.5">
                <label for="ContactFormPhone" class="block text-[11px] uppercase tracking-wider font-medium text-[#1A1A1A]">
                  {{ label_phone }}
                </label>
                <input
                  type="tel"
                  name="contact[phone]"
                  id="ContactFormPhone"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  placeholder="{{ placeholder_phone }}"
                  pattern="[0-9\-+#\s]*"
                  class="w-full px-4 py-3 bg-[#FAF8F5] border border-[#DDD7CE] text-xs text-[#1A1A1A] placeholder-[#9C9488] focus:outline-none focus:border-[#C8A878] focus:bg-white transition-colors"
                >
              </div>

              <div class="space-y-1.5">
                <label for="ContactFormMotivo" class="block text-[11px] uppercase tracking-wider font-medium text-[#1A1A1A]">
                  {{ label_reason }} <span class="text-[#5C6B56]">*</span>
                </label>
                <div class="relative">
                  <select
                    name="contact[motivo]"
                    id="ContactFormMotivo"
                    class="w-full px-4 py-3 bg-[#FAF8F5] border border-[#DDD7CE] text-xs text-[#1A1A1A] focus:outline-none focus:border-[#C8A878] focus:bg-white transition-colors appearance-none cursor-pointer pr-10"
                  >
                    {%- assign raw_options = raw_reason_str | newline_to_br | replace: '<br />', '<br>' | split: '<br>' -%}
                    {%- for opt in raw_options -%}
                      {%- assign clean_opt = opt | strip -%}
                      {%- if clean_opt != blank -%}
                        <option value="{{ clean_opt | escape }}">{{ clean_opt }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-[#7A7265]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 9l-7 7-7-7"></path></svg>
                  </div>
                </div>
              </div>
            </div>

            <!-- RIGA 3: MESSAGGIO -->
            <div class="space-y-1.5">
              <label for="ContactFormMessage" class="block text-[11px] uppercase tracking-wider font-medium text-[#1A1A1A]">
                {{ label_message }} <span class="text-[#5C6B56]">*</span>
              </label>
              <textarea
                name="contact[body]"
                id="ContactFormMessage"
                rows="5"
                placeholder="{{ placeholder_message }}"
                required
                class="w-full px-4 py-3 bg-[#FAF8F5] border border-[#DDD7CE] text-xs text-[#1A1A1A] placeholder-[#9C9488] focus:outline-none focus:border-[#C8A878] focus:bg-white transition-colors resize-y leading-relaxed"
              >{% if form.body %}{{ form.body }}{% endif %}</textarea>
            </div>

            <!-- CHECKBOX CONSENSO PRIVACY -->
            <div class="flex items-start gap-3 pt-1">
              <input
                type="checkbox"
                name="contact[privacy]"
                id="ContactFormPrivacy"
                required
                class="mt-0.5 h-4 w-4 rounded border-[#DDD7CE] text-[#5C6B56] focus:ring-[#C8A878] accent-[#5C6B56] cursor-pointer"
              >
              <label for="ContactFormPrivacy" class="text-[11px] text-[#7A7265] leading-relaxed cursor-pointer select-none">
                {{ privacy_text }}
              </label>
            </div>

            <!-- PULSANTE SUBMIT -->
            <div class="pt-3">
              <button
                type="submit"
                class="w-full bg-[#1A1A1A] hover:bg-[#5C6B56] text-white py-3.5 px-6 text-xs uppercase tracking-[0.2em] font-semibold transition-colors luxury-interactive cursor-pointer shadow-sm"
              >
                {{ submit_label }}
              </button>
            </div>

          {% endform %}

        </div>
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Pagina Contatti Haute",
  "settings": [
    {
      "type": "header",
      "content": "Intestazione Pagina"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Mostra Intestazione",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Sopratitolo",
      "default": "Ritiro a • VERONA"
    },
    {
      "type": "text",
      "id": "title",
