<!-- COLLECTIONS LIST - 5 PILL CARDS VERTICALI AD ARCO (ROUNDED-T-FULL) -->
<section id="collezioni" class="py-20 lg:py-28 bg-[#F5F2EB] border-b border-[#E5E0D8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-16">
    
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-16">
      <span class="text-xs uppercase tracking-[0.25em] text-[#5C6B56] font-semibold block mb-2">{{ section.settings.tag | default: 'ESPLORA LE COLLEZIONI' }}</span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-[#1A1A1A]">{{ section.settings.title | default: "L'Architettura della Bellezza" }}</h2>
      <p class="text-[#7A7265] text-xs sm:text-sm mt-2 sm:mt-3 font-light">{{ section.settings.subtitle | default: 'Cinque universi sartoriali dedicati al benessere integrale del derma.' }}</p>
    </div>

    <!-- 5 Pill Cards Sagomate ad Arco in Cima (rounded-t-full) con Sfondo #EFECE6 -->
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 sm:gap-6">
      
      <!-- Pill 1: Cura della pelle -->
      <a href="/collections/all" class="pill-card group flex flex-col justify-between bg-[#EFECE6] border border-[#E5E0D8] rounded-t-full p-3.5 sm:p-5 text-center hover:border-[#1A1A1A] hover:shadow-xl transition-all">
        <div class="aspect-[3/4] w-full flex items-center justify-center p-2.5 sm:p-3 mb-3 sm:mb-4 overflow-hidden rounded-t-full bg-[#E5E0D8]/40">
          <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=400&q=80" 
               onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
               alt="Cura della pelle" class="w-full h-full object-cover transition-transform duration-500 rounded-t-full">
        </div>
        <div>
          <h3 class="font-serif text-base sm:text-lg font-semibold text-[#1A1A1A] group-hover:text-[#C8A878] transition-colors mb-1">Cura della pelle</h3>
          <p class="text-[11px] sm:text-xs text-[#7A7265] leading-relaxed font-light line-clamp-2 sm:line-clamp-none">Formule avanzate per nutrire, proteggere e rivitalizzare il derma.</p>
          <span class="inline-block mt-2 sm:mt-3 text-[9px] sm:text-[10px] uppercase tracking-widest font-semibold text-[#1A1A1A] border-b border-[#1A1A1A]/30 group-hover:border-[#1A1A1A] group-hover:text-[#C8A878] transition-all">Scopri &rarr;</span>
        </div>
      </a>

      <!-- Pill 2: Trucco -->
      <a href="/collections/all" class="pill-card group flex flex-col justify-between bg-[#EFECE6] border border-[#E5E0D8] rounded-t-full p-3.5 sm:p-5 text-center hover:border-[#1A1A1A] hover:shadow-xl transition-all">
        <div class="aspect-[3/4] w-full flex items-center justify-center p-2.5 sm:p-3 mb-3 sm:mb-4 overflow-hidden rounded-t-full bg-[#E5E0D8]/40">
          <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=400&q=80" 
               onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
               alt="Trucco" class="w-full h-full object-cover transition-transform duration-500 rounded-t-full">
        </div>
        <div>
          <h3 class="font-serif text-base sm:text-lg font-semibold text-[#1A1A1A] group-hover:text-[#C8A878] transition-colors mb-1">Trucco</h3>
          <p class="text-[11px] sm:text-xs text-[#7A7265] leading-relaxed font-light line-clamp-2 sm:line-clamp-none">Texture biomimetiche per esaltare la bellezza naturale con finish seta.</p>
          <span class="inline-block mt-2 sm:mt-3 text-[9px] sm:text-[10px] uppercase tracking-widest font-semibold text-[#1A1A1A] border-b border-[#1A1A1A]/30 group-hover:border-[#1A1A1A] group-hover:text-[#C8A878] transition-all">Scopri &rarr;</span>
        </div>
      </a>

      <!-- Pill 3: Cura dei capelli -->
      <a href="/collections/all" class="pill-card group flex flex-col justify-between bg-[#EFECE6] border border-[#E5E0D8] rounded-t-full p-3.5 sm:p-5 text-center hover:border-[#1A1A1A] hover:shadow-xl transition-all">
        <div class="aspect-[3/4] w-full flex items-center justify-center p-2.5 sm:p-3 mb-3 sm:mb-4 overflow-hidden rounded-t-full bg-[#E5E0D8]/40">
          <img src="https://images.unsplash.com/photo-1535585209827-a15fcdbc4c2d?auto=format&fit=crop&w=400&q=80" 
               onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
               alt="Cura dei capelli" class="w-full h-full object-cover transition-transform duration-500 rounded-t-full">
        </div>
        <div>
          <h3 class="font-serif text-base sm:text-lg font-semibold text-[#1A1A1A] group-hover:text-[#C8A878] transition-colors mb-1">Cura dei capelli</h3>
          <p class="text-[11px] sm:text-xs text-[#7A7265] leading-relaxed font-light line-clamp-2 sm:line-clamp-none">Trattamenti botanici mirati per la cute e per donare corpo e luminosità.</p>
          <span class="inline-block mt-2 sm:mt-3 text-[9px] sm:text-[10px] uppercase tracking-widest font-semibold text-[#1A1A1A] border-b border-[#1A1A1A]/30 group-hover:border-[#1A1A1A] group-hover:text-[#C8A878] transition-all">Scopri &rarr;</span>
        </div>
      </a>

      <!-- Pill 4: Cura del corpo -->
      <a href="/collections/all" class="pill-card group flex flex-col justify-between bg-[#EFECE6] border border-[#E5E0D8] rounded-t-full p-3.5 sm:p-5 text-center hover:border-[#1A1A1A] hover:shadow-xl transition-all">
        <div class="aspect-[3/4] w-full flex items-center justify-center p-2.5 sm:p-3 mb-3 sm:mb-4 overflow-hidden rounded-t-full bg-[#E5E0D8]/40">
          <img src="https://images.unsplash.com/photo-1526947425960-945c6e72858f?auto=format&fit=crop&w=400&q=80" 
               onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
               alt="Cura del corpo" class="w-full h-full object-cover transition-transform duration-500 rounded-t-full">
        </div>
        <div>
          <h3 class="font-serif text-base sm:text-lg font-semibold text-[#1A1A1A] group-hover:text-[#C8A878] transition-colors mb-1">Cura del corpo</h3>
          <p class="text-[11px] sm:text-xs text-[#7A7265] leading-relaxed font-light line-clamp-2 sm:line-clamp-none">Balsami e oli trasformativi per una sensorialità da spa quotidiana.</p>
          <span class="inline-block mt-2 sm:mt-3 text-[9px] sm:text-[10px] uppercase tracking-widest font-semibold text-[#1A1A1A] border-b border-[#1A1A1A]/30 group-hover:border-[#1A1A1A] group-hover:text-[#C8A878] transition-all">Scopri &rarr;</span>
        </div>
      </a>

      <!-- Pill 5: Strumenti & Cabina -->
      <a href="/collections/all" class="pill-card group col-span-2 sm:col-span-1 lg:col-span-1 max-w-[240px] sm:max-w-none mx-auto w-full flex flex-col justify-between bg-[#EFECE6] border border-[#E5E0D8] rounded-t-full p-3.5 sm:p-5 text-center hover:border-[#1A1A1A] hover:shadow-xl transition-all">
        <div class="aspect-[3/4] w-full flex items-center justify-center p-2.5 sm:p-3 mb-3 sm:mb-4 overflow-hidden rounded-t-full bg-[#E5E0D8]/40">
          <img src="https://images.unsplash.com/photo-1616683693504-3ea7e9ad6fec?auto=format&fit=crop&w=400&q=80" 
               onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
               alt="Strumenti" class="w-full h-full object-cover transition-transform duration-500 rounded-t-full">
        </div>
        <div>
          <h3 class="font-serif text-base sm:text-lg font-semibold text-[#1A1A1A] group-hover:text-[#C8A878] transition-colors mb-1">Strumenti</h3>
          <p class="text-[11px] sm:text-xs text-[#7A7265] leading-relaxed font-light line-clamp-2 sm:line-clamp-none">Accessori di precisione per massaggio facciale e applicazione professionale.</p>
          <span class="inline-block mt-2 sm:mt-3 text-[9px] sm:text-[10px] uppercase tracking-widest font-semibold text-[#1A1A1A] border-b border-[#1A1A1A]/30 group-hover:border-[#1A1A1A] group-hover:text-[#C8A878] transition-all">Scopri &rarr;</span>
        </div>
      </a>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections List Mile",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "ESPLORA LE COLLEZIONI"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo",
      "default": "L'Architettura della Bellezza"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sottotitolo",
      "default": "Cinque universi sartoriali dedicati al benessere integrale del derma."
    }
  ],
  "presets": [
    {
      "name": "Collections List Mile",
      "category": "Collections"
    }
  ]
}
{% endschema %}
