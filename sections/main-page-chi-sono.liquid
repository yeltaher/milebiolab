{% comment %}
  MILEBIOLAB - SECTION MAIN PAGE CHI SONO (HAUTE COUTURE LUSH DESIGN)
  Implementazione 100% INLINE senza dipendenze da render 'chi-sono-view'.
  Elimina qualsiasi errore di Theme Check e garantisce la piena editabilità OS 2.0 nel Theme Editor.
{% endcomment %}

{%- liquid
  assign eyebrow = section.settings.eyebrow | default: "FONDATRICE & BEAUTY SPECIALIST • VERONA"
  assign title = section.settings.title | default: "L'Amore per la Natura e la Passione per la Cura della Pelle"
  assign quote_text = section.settings.quote_text | default: "L'amore per la natura e prendermi cura del benessere delle persone che si affidano a me ogni giorno è una passione che arricchisce la vita, lo fa in modi profondi ed inaspettati... tutto questo non è solo un piacere personale, ma una forza motrice per gli altri."
  assign quote_author = section.settings.quote_author | default: "Mile • Maestra d'Arte ed Estetista Fondatrice"
  
  assign portrait_url = section.settings.portrait_url | default: "https://static.wixstatic.com/media/e3d7d4_f4f1817e09bd4ca688132f9832d1172f~mv2.jpg"
  assign path_title = section.settings.path_title | default: "Il Percorso Professionale: 20 Anni di Eccellenza Beauty"
  assign path_subtitle = section.settings.path_subtitle | default: "Una vita dedicata alla dermocosmetica autentica, alla ricerca della purezza botanica e al benessere profondo."
  
  assign stat1_num = section.settings.stat1_num | default: "20+"
  assign stat1_label = section.settings.stat1_label | default: "Anni di Esperienza Dermocosmetica"
  assign stat2_num = section.settings.stat2_num | default: "1000s"
  assign stat2_label = section.settings.stat2_label | default: "Trattamenti Rigeneranti Eseguiti"
  assign stat3_num = section.settings.stat3_num | default: "2012"
  assign stat3_label = section.settings.stat3_label | default: "Anno di Nascita di UNICHO21"
  assign stat4_num = section.settings.stat4_num | default: "100%"
  assign stat4_label = section.settings.stat4_label | default: "Purezza Botanica Primordiale"

  assign awareness_title = section.settings.awareness_title | default: "La Consapevolezza Dermocosmetica: Perché Rischiare?"
  assign awareness_subtitle = section.settings.awareness_title_sub | default: "La storica intuizione nata 20 anni fa davanti al quesito fondamentale sulla chimica nei cosmetici."
  
  assign unicho_title = section.settings.unicho_title | default: "La Creazione Iconica: UNICHO21 (2012)"
  assign unicho_subtitle = section.settings.unicho_subtitle | default: "\"Il mio segreto diventa anche il tuo...\""
  
  assign flagship_title = section.settings.flagship_title | default: "Lebestetik Beauty & Spa • Flagship Verona"
  assign flagship_address = section.settings.flagship_address | default: "Corso Cavour 18, 37121 Verona (VR)"
  assign flagship_hours = section.settings.flagship_hours | default: "Lunedì – Sabato: 09:30 – 19:30"
  assign flagship_whatsapp = section.settings.flagship_whatsapp | default: "https://wa.me/390458001234"
-%}

<div class="min-h-[75vh] py-12 md:py-20 px-4 sm:px-6 lg:px-8 bg-[#F5F2EB] text-[#1A1A1A] font-sans" id="chi-sono-container">
  <div class="max-w-6xl mx-auto space-y-16 lg:space-y-24">

    <!-- BREADCRUMB & TOP NAV -->
    <nav class="flex items-center gap-2 text-xs uppercase tracking-widest text-[#7A7265] border-b border-[#E5E0D8] pb-4">
      <a href="{{ routes.root_url }}" class="hover:text-[#1A1A1A] transition-colors">Home</a>
      <span class="text-[#E5E0D8]">/</span>
      <span class="text-[#1A1A1A] font-semibold">Chi Sono &bull; MileBioLab</span>
    </nav>

    <!-- HERO & GRANDE CITAZIONE D'APERTURA -->
    <section class="text-center max-w-4xl mx-auto space-y-6">
      <div class="inline-block px-3 py-1 text-[11px] uppercase tracking-[0.2em] font-medium bg-[#FAF8F5] text-[#5C6B56] border border-[#C8A878]/30 shadow-sm">
        {{ eyebrow }}
      </div>
      
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-[#1A1A1A] font-normal leading-tight">
        {{ title }}
      </h1>

      <div class="relative bg-[#FAF8F5] border-y border-[#C8A878]/40 py-8 px-6 sm:px-12 my-8 shadow-sm">
        <span class="absolute -top-4 left-1/2 -translate-x-1/2 bg-[#F5F2EB] px-4 font-serif text-4xl text-[#C8A878]">“</span>
        <p class="font-serif italic text-lg sm:text-xl md:text-2xl text-[#3A3530] leading-relaxed">
          {{ quote_text }}
        </p>
        <div class="mt-4 text-xs font-sans tracking-widest uppercase text-[#5C6B56] font-semibold">
          — {{ quote_author }}
        </div>
      </div>
    </section>

    <!-- SEZIONE IL MIO PERCORSO (GRIGLIA A 2 COLONNE) -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      
      <!-- Colonna Sinistra: Ritratto & Cornice Dorata -->
      <div class="lg:col-span-5 relative">
        <div class="absolute inset-0 border-2 border-[#C8A878] translate-x-3 translate-y-3 pointer-events-none"></div>
        <div class="relative bg-white p-2 shadow-lg border border-[#E5E0D8]">
          <img 
            src="{{ portrait_url }}" 
            alt="Mile - Fondatrice MileBioLab" 
            class="w-full h-auto object-cover aspect-[4/5] filter brightness-[0.98] contrast-[1.02]"
            loading="lazy"
          >
          <div class="absolute bottom-6 left-6 right-6 bg-[#1A1A1A]/90 backdrop-blur-md text-[#FAF8F5] p-4 text-center border border-[#C8A878]/40">
            <span class="block font-serif text-lg text-[#C8A878]">20 Anni</span>
            <span class="text-[11px] uppercase tracking-widest text-[#E5E0D8]">Di Esperienza Sul Campo</span>
          </div>
        </div>
      </div>

      <!-- Colonna Destra: Biografia & Qualifiche -->
      <div class="lg:col-span-7 space-y-6">
        <div class="space-y-2">
          <span class="text-xs uppercase tracking-widest text-[#5C6B56] font-semibold">Eccellenza & Dedizione</span>
          <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl text-[#1A1A1A] font-normal">
            {{ path_title }}
          </h2>
        </div>

        <p class="text-base text-[#4A4540] leading-relaxed">
          {{ path_subtitle }}
        </p>

        <!-- Badge Qualifiche -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          <div class="flex items-start gap-3 p-3 bg-white border border-[#E5E0D8]">
            <span class="w-2 h-2 rounded-full bg-[#C8A878] mt-1.5 shrink-0"></span>
            <span class="text-xs uppercase tracking-wider font-semibold text-[#1A1A1A]">Maestra d'Arte & Estetista Qualificata</span>
          </div>
          <div class="flex items-start gap-3 p-3 bg-white border border-[#E5E0D8]">
            <span class="w-2 h-2 rounded-full bg-[#C8A878] mt-1.5 shrink-0"></span>
            <span class="text-xs uppercase tracking-wider font-semibold text-[#1A1A1A]">Massaggiatrice Professionista & Beauty Specialist</span>
          </div>
          <div class="flex items-start gap-3 p-3 bg-white border border-[#E5E0D8]">
            <span class="w-2 h-2 rounded-full bg-[#C8A878] mt-1.5 shrink-0"></span>
            <span class="text-xs uppercase tracking-wider font-semibold text-[#1A1A1A]">Dermopigmentista Avanzata</span>
          </div>
          <div class="flex items-start gap-3 p-3 bg-white border border-[#E5E0D8]">
            <span class="w-2 h-2 rounded-full bg-[#C8A878] mt-1.5 shrink-0"></span>
            <span class="text-xs uppercase tracking-wider font-semibold text-[#1A1A1A]">Ideatrice Centro Lebestetik Beauty & Spa</span>
          </div>
        </div>

        <p class="text-sm text-[#6A6255] leading-relaxed pt-2">
          Nel corso di due decenni, ho trattato migliaia di persone di ogni età, stile di vita e tipo di pelle. Ogni incontro è stato un viaggio di ascolto e cura, con un unico, immutabile obiettivo: risvegliare il benessere e la bellezza autentica, rispettando profondamente la fisiologia cutanea.
        </p>
      </div>
    </section>

    <!-- STATISTICHE LUXURY BAR -->
    <section class="bg-white border border-[#E5E0D8] p-8 sm:p-12 shadow-sm">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-[#E5E0D8]">
        <div class="space-y-2 pt-4 md:pt-0">
          <div class="font-serif text-3xl sm:text-4xl text-[#C8A878] font-medium">{{ stat1_num }}</div>
          <div class="text-xs uppercase tracking-widest text-[#7A7265]">{{ stat1_label }}</div>
        </div>
        <div class="space-y-2 pt-4 md:pt-0">
          <div class="font-serif text-3xl sm:text-4xl text-[#C8A878] font-medium">{{ stat2_num }}</div>
          <div class="text-xs uppercase tracking-widest text-[#7A7265]">{{ stat2_label }}</div>
        </div>
        <div class="space-y-2 pt-4 md:pt-0">
          <div class="font-serif text-3xl sm:text-4xl text-[#C8A878] font-medium">{{ stat3_num }}</div>
          <div class="text-xs uppercase tracking-widest text-[#7A7265]">{{ stat3_label }}</div>
        </div>
        <div class="space-y-2 pt-4 md:pt-0">
          <div class="font-serif text-3xl sm:text-4xl text-[#C8A878] font-medium">{{ stat4_num }}</div>
          <div class="text-xs uppercase tracking-widest text-[#7A7265]">{{ stat4_label }}</div>
        </div>
      </div>
    </section>

    <!-- SEZIONE LA CONSAPEVOLEZZA DERMOCOSMETICA -->
    <section class="bg-[#FAF8F5] border border-[#C8A878]/30 p-8 sm:p-12 space-y-8">
      <div class="max-w-3xl mx-auto text-center space-y-4">
        <span class="text-xs uppercase tracking-widest text-[#5C6B56] font-semibold">La Svolta Etica</span>
        <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl text-[#1A1A1A] font-normal">
          {{ awareness_title }}
        </h2>
        <p class="text-base text-[#5A5248] leading-relaxed">
          {{ awareness_subtitle }}
        </p>
      </div>

      <!-- Aneddoto storico -->
      <div class="bg-white border-l-4 border-[#C8A878] p-6 sm:p-8 italic font-serif text-[#3A3530] text-base sm:text-lg shadow-sm">
        "Vent'anni fa, la domanda che ha cambiato la mia vita professionale a un produttore: 
        <strong class="not-italic text-[#1A1A1A] underline decoration-[#C8A878]">&laquo;Ma perché devo lavare i capelli con lo stesso identico ingrediente chimico con cui si sgrassano le ruote dell'auto?&raquo;</strong> 
        Da quel momento ho compreso che la cosmetica tradizionale stava tradendo la pelle."
      </div>

      <!-- I 3 Pilastri / Rifiuti -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
        <div class="bg-white p-6 border border-[#E5E0D8] space-y-3">
          <span class="inline-block px-2.5 py-1 text-[10px] uppercase font-bold tracking-widest bg-[#9E2A2B]/10 text-[#9E2A2B]">Rischio 01</span>
          <h3 class="font-serif text-lg text-[#1A1A1A]">Formule che non fanno nulla</h3>
          <p class="text-xs text-[#7A7265] leading-relaxed">Prodotti commerciali annacquati che offrono solo un'illusione temporanea senza alcuna efficacia biologica reale.</p>
        </div>

        <div class="bg-white p-6 border border-[#E5E0D8] space-y-3">
          <span class="inline-block px-2.5 py-1 text-[10px] uppercase font-bold tracking-widest bg-[#C8A878]/20 text-[#1A1A1A]">Rischio 02</span>
          <h3 class="font-serif text-lg text-[#1A1A1A]">Beneficio Fittizio</h3>
          <p class="text-xs text-[#7A7265] leading-relaxed">Siliconi e petrolati che creano un film occlusivo artificiale, soffocando la cute e impedendole di respirare liberamente.</p>
        </div>

        <div class="bg-white p-6 border border-[#E5E0D8] space-y-3">
          <span class="inline-block px-2.5 py-1 text-[10px] uppercase font-bold tracking-widest bg-[#5C6B56]/15 text-[#5C6B56]">Rischio 03</span>
          <h3 class="font-serif text-lg text-[#1A1A1A]">Danni alla Barriera Cutanea</h3>
          <p class="text-xs text-[#7A7265] leading-relaxed">Agenti chimici aggressivi che compromettono il microbioma e accelerano l'invecchiamento precoce dei tessuti.</p>
        </div>
      </div>

      <div class="text-center pt-2">
        <p class="font-serif italic text-sm text-[#5C6B56]">
          La scelta radicale: tornare alla purezza botanica incontaminata di fiori, piante, frutti e semi primordiali.
        </p>
      </div>
    </section>

    <!-- SEZIONE LA NASCITA DI UNICHO21 -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center bg-white border border-[#E5E0D8] p-8 sm:p-12 shadow-sm">
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-block px-3 py-1 text-[11px] uppercase tracking-[0.2em] font-medium bg-[#FAF8F5] text-[#C8A878] border border-[#C8A878]/30">
          Innovazione del 2012
        </div>
        
        <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl text-[#1A1A1A] font-normal">
          {{ unicho_title }}
        </h2>

        <p class="font-serif italic text-lg text-[#5C6B56]">
          {{ unicho_subtitle }}
        </p>

        <p class="text-sm text-[#4A4540] leading-relaxed">
          Nato nel 2012 durante la mia prima gravidanza, UNICHO21 è il frutto della necessità più pura: proteggere, elasticizzare e nutrire profondamente la cute con formule 100% naturali. Non trovando sul mercato un prodotto che rispecchiasse i miei rigorosi standard di sicurezza e naturalità... ho deciso di crearlo.
        </p>

        <div class="pt-4 flex flex-wrap gap-4">
          <a href="/collections/all" class="inline-flex items-center justify-center px-6 py-3.5 bg-[#1A1A1A] text-[#FAF8F5] text-xs uppercase tracking-widest font-semibold hover:bg-[#5C6B56] transition-colors shadow-sm">
            Scopri la Collezione UNICHO21 →
          </a>
          <a href="/pages/skin-quiz" class="inline-flex items-center justify-center px-6 py-3.5 bg-transparent text-[#1A1A1A] border border-[#1A1A1A] text-xs uppercase tracking-widest font-semibold hover:bg-[#FAF8F5] transition-colors">
            Fai il Check-up Cutaneo
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 bg-[#FAF8F5] p-8 border border-[#C8A878]/30 text-center space-y-6">
        <span class="font-serif text-5xl text-[#C8A878]">✦</span>
        <h3 class="font-serif text-xl text-[#1A1A1A]">Il Burro Primordiale</h3>
        <p class="text-xs text-[#7A7265] leading-relaxed">
          Una texture ricca e vellutata che si fonde con la pelle, offrendo un trattamento d'elezione per mamme, pelli sensibili e chi cerca la massima protezione botanica senza compromessi.
        </p>
        <div class="pt-2 border-t border-[#E5E0D8]">
          <span class="text-[10px] uppercase tracking-widest text-[#5C6B56] font-bold">100% Biologico & Artigianale</span>
        </div>
      </div>
    </section>

    <!-- BOX FLAGSHIP & ISTITUTO VERONA -->
    <section class="bg-[#1A1A1A] text-[#FAF8F5] p-8 sm:p-12 relative overflow-hidden">
      <div class="absolute right-0 bottom-0 w-96 h-96 bg-[#C8A878]/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 max-w-3xl mx-auto text-center space-y-6">
        <span class="text-xs uppercase tracking-[0.3em] text-[#C8A878] font-semibold">Flagship & Istituto</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#FAF8F5]">
          {{ flagship_title }}
        </h2>
        
        <p class="text-sm text-[#E5E0D8] leading-relaxed">
          Vieni a scoprire di persona la consulenza cutanea personalizzata con lampada Wood e il ritiro rapido degli ordini online in sole 2 ore nel nostro istituto di Verona.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 pt-4 text-xs tracking-wider uppercase text-[#C8A878]">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#C8A878]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span>{{ flagship_address }}</span>
          </div>
          <div class="hidden sm:inline text-[#7A7265]">&bull;</div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#C8A878]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>{{ flagship_hours }}</span>
          </div>
        </div>

        <div class="pt-6">
          <a href="{{ flagship_whatsapp }}" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-8 py-4 bg-[#C8A878] text-[#1A1A1A] text-xs uppercase tracking-widest font-bold hover:bg-[#b59567] transition-colors shadow-lg">
            <span>Contatta il Concierge su WhatsApp</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
      </div>
    </section>

  </div>
</div>

{% schema %}
{
  "name": "Chi Sono (MileBioLab)",
  "tag": "section",
  "class": "section-chi-sono",
  "settings": [
    {
      "type": "header",
      "content": "Hero & Citazione d'Apertura"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Sopra Titolo",
      "default": "FONDATRICE & BEAUTY SPECIALIST • VERONA"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo Principale",
      "default": "L'Amore per la Natura e la Passione per la Cura della Pelle"
    },
    {
      "type": "textarea",
      "id": "quote_text",
