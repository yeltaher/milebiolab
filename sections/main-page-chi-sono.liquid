    },
    {
      "type": "text",
      "id": "stat4_num",
      "label": "Stat 4 Valore",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat4_label",
      "label": "Stat 4 Etichetta",
      "default": "Purezza Botanica Primordiale"
    },
    {
      "type": "header",
      "content": "Consapevolezza & UNICHO21"
    },
    {
      "type": "text",
      "id": "awareness_title",
      "label": "Titolo Consapevolezza",
      "default": "La Consapevolezza Dermocosmetica: Perché Rischiare?"
    },
    {
