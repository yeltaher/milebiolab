      "default": "La Creazione Iconica: UNICHO21 (2012)"
    },
    {
      "type": "text",
      "id": "unicho_subtitle",
      "label": "Sottotitolo UNICHO21",
      "default": "\"Il mio segreto diventa anche il tuo...\""
    },
    {
      "type": "header",
      "content": "Flagship Verona"
    },
    {
      "type": "text",
      "id": "flagship_title",
