{% schema %}
{
  "name": "Main Search Splendor",
  "settings": []
}
{% endschema %}

<div class="bg-[#F5F2EB] text-[#1A1A1A] py-16">
  <main class="max-w-5xl mx-auto px-4 sm:px-8 space-y-8">
    <div class="text-center max-w-xl mx-auto space-y-3">
      <span class="text-xs uppercase tracking-[0.25em] text-[#5C6B56] font-bold">MOTORE DI RICERCA DERMOBOTANICA</span>
      <h1 class="font-serif text-4xl sm:text-5xl text-[#1A1A1A] font-normal">Cerca nel Mondo Splendor</h1>
      <p class="text-[#7A7265] text-xs sm:text-sm font-light">Inserisci un attivo (es. Edelweiss, Bakuchiol), una formula o un servizio cabina.</p>
    </div>

    <!-- Live Search Input Form -->
    <div class="max-w-2xl mx-auto space-y-3">
      <form action="{{ routes.search_url }}" method="get" class="relative shadow-md">
        <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="Digita per cercare formule, attivi alpini, trattamenti, articoli..." class="w-full bg-white border border-[#E5E0D8] py-4 pl-12 pr-12 text-sm text-[#1A1A1A] focus:outline-none focus:border-[#1A1A1A]">
        <svg class="w-5 h-5 text-[#7A7265] absolute left-4 top-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </form>
      
      <!-- Quick Search Pill Tags -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-1 text-xs">
        <span class="text-[11px] uppercase tracking-wider text-[#7A7265] font-medium mr-1">Ricerche Frequenti:</span>
        <a href="{{ routes.search_url }}?q=Edelweiss" class="px-3 py-1 bg-white border border-[#E5E0D8] text-[#7A7265] hover:border-[#1A1A1A] hover:text-[#1A1A1A] transition-all text-xs">Edelweiss</a>
        <a href="{{ routes.search_url }}?q=Bakuchiol" class="px-3 py-1 bg-white border border-[#E5E0D8] text-[#7A7265] hover:border-[#1A1A1A] hover:text-[#1A1A1A] transition-all text-xs">Bakuchiol</a>
        <a href="{{ routes.search_url }}?q=Golden+Glow" class="px-3 py-1 bg-white border border-[#E5E0D8] text-[#7A7265] hover:border-[#1A1A1A] hover:text-[#1A1A1A] transition-all text-xs">Golden Glow</a>
        <a href="{{ routes.search_url }}?q=Acido+Ialuronico" class="px-3 py-1 bg-white border border-[#E5E0D8] text-[#7A7265] hover:border-[#1A1A1A] hover:text-[#1A1A1A] transition-all text-xs">Acido Ialuronico</a>
        <a href="{{ routes.search_url }}?q=Verona" class="px-3 py-1 bg-white border border-[#E5E0D8] text-[#7A7265] hover:border-[#1A1A1A] hover:text-[#1A1A1A] transition-all text-xs">Cabina Verona</a>
      </div>
    </div>

    <!-- Search Results Grid -->
    <div class="pt-8">
      {% if search.performed %}
        <div class="text-xs uppercase tracking-widest text-[#7A7265] mb-6">
          Risultati per: <strong class="text-[#1A1A1A]">"{{ search.terms }}"</strong> ({{ search.results_count }} trovati)
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {% for item in search.results %}
            <div class="bg-white border border-[#E5E0D8] p-4 flex flex-col justify-between">
              <div>
                <a href="{{ item.url }}" class="aspect-square bg-[#F5F2EB] border border-[#E5E0D8] mb-3 p-3 flex items-center justify-center block overflow-hidden">
                  <img src="{{ item.featured_image | image_url: width: 300 }}" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=400&q=80'" alt="{{ item.title | escape }}" class="h-full object-contain">
                </a>
                <span class="text-[9px] uppercase tracking-widest text-[#5C6B56] font-bold">Risultato</span>
                <a href="{{ item.url }}" class="font-serif text-base text-[#1A1A1A] font-medium hover:text-[#C8A878] transition-colors block">{{ item.title }}</a>
              </div>
              <div class="mt-4 pt-3 border-t border-[#E5E0D8] flex items-center justify-between">
                <span class="font-serif text-base font-semibold text-[#555E6B]">{{ item.price | money }}</span>
                <a href="{{ item.url }}" class="bg-[#1A1A1A] text-white px-3 py-1.5 text-[9px] uppercase tracking-widest font-semibold hover:bg-[#5C6B56] transition-colors">Vedi</a>
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <!-- Featured Discoveries -->
        <div class="text-center py-8">
          <span class="text-xs uppercase tracking-widest text-[#7A7265]">Inizia a digitare o seleziona una delle parole chiave per scoprire i nostri fitocosmetici.</span>
        </div>
      {% endif %}
    </div>
  </main>
</div>
