{% schema %}
{
  "name": "Trust & Icon Feature Bar",
  "settings": [
    {
      "type": "text",
      "id": "item_1_title",
      "label": "Voce 1 Titolo",
      "default": "Difesa Cellulare Biomimetica"
    },
    {
      "type": "text",
      "id": "item_1_sub",
      "label": "Voce 1 Sottotitolo",
      "default": "Formule ad alta penetrazione epidermica"
    },
    {
      "type": "text",
      "id": "item_2_title",
      "label": "Voce 2 Titolo",
      "default": "Idratazione 72h a Lunga Durata"
    },
    {
      "type": "text",
      "id": "item_2_sub",
      "label": "Voce 2 Sottotitolo",
      "default": "Test clinici strumentali comprovati"
    },
    {
      "type": "text",
      "id": "item_3_title",
      "label": "Voce 3 Titolo",
      "default": "100% Attivi Alpini Puri"
    },
    {
      "type": "text",
      "id": "item_3_sub",
      "label": "Voce 3 Sottotitolo",
      "default": "Estratti da coltura biologica certificata"
    },
    {
      "type": "text",
      "id": "item_4_title",
      "label": "Voce 4 Titolo",
      "default": "Zero Siliconi & Microplastiche"
    },
    {
      "type": "text",
      "id": "item_4_sub",
      "label": "Voce 4 Sottotitolo",
      "default": "Packaging in vetro Miron riciclabile"
    }
  ],
  "presets": [
    {
      "name": "Trust & Icon Feature Bar",
      "category": "Trust"
    }
  ]
}
{% endschema %}

<section class="trust-icon-bar-section" id="section-trust-bar">
  <div class="section-container">
    <div class="trust-bar-grid">
      
      <!-- Icon 1: Difesa Cellulare Biomimetica -->
      <div class="trust-bar-item">
        <div class="trust-icon-box">
          <svg class="trust-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M12 8v8"/>
            <path d="M8 12h8"/>
          </svg>
        </div>
        <div class="trust-item-text">
          <h4 class="trust-item-title">{{ section.settings.item_1_title }}</h4>
          <p class="trust-item-sub">{{ section.settings.item_1_sub }}</p>
        </div>
      </div>

      <!-- Icon 2: Idratazione 72h a Lunga Durata -->
      <div class="trust-bar-item">
        <div class="trust-icon-box">
          <svg class="trust-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
            <circle cx="12" cy="14" r="3"/>
          </svg>
        </div>
        <div class="trust-item-text">
          <h4 class="trust-item-title">{{ section.settings.item_2_title }}</h4>
          <p class="trust-item-sub">{{ section.settings.item_2_sub }}</p>
        </div>
      </div>

      <!-- Icon 3: 100% Attivi Alpini Puri -->
      <div class="trust-bar-item">
        <div class="trust-icon-box">
          <svg class="trust-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L8 9h8l-4-7z"/>
            <path d="M12 9l-6 10h12l-6-10z"/>
            <path d="M12 19v3"/>
          </svg>
        </div>
        <div class="trust-item-text">
          <h4 class="trust-item-title">{{ section.settings.item_3_title }}</h4>
          <p class="trust-item-sub">{{ section.settings.item_3_sub }}</p>
        </div>
      </div>

      <!-- Icon 4: Zero Siliconi & Microplastiche -->
      <div class="trust-bar-item">
        <div class="trust-icon-box">
          <svg class="trust-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="7" y="2" width="10" height="20" rx="2" ry="2"/>
            <path d="M10 2v4"/>
            <path d="M14 2v4"/>
            <path d="M7 10h10"/>
            <circle cx="12" cy="15" r="1.5"/>
          </svg>
        </div>
        <div class="trust-item-text">
          <h4 class="trust-item-title">{{ section.settings.item_4_title }}</h4>
          <p class="trust-item-sub">{{ section.settings.item_4_sub }}</p>
        </div>
      </div>

    </div>
  </div>
</section>
