<section class="trust-icon-bar-section bg-[#F5F2EB] py-10 border-b border-[#E5E0D8]" id="section-trust-bar">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      
      <!-- Icon 1: Difesa Cellulare Biomimetica -->
      <div class="flex items-center gap-4 bg-white/70 p-4 border border-[#E5E0D8]">
        <div class="w-12 h-12 rounded-full bg-[#F5F2EB] border border-[#DDD7CE] flex items-center justify-center flex-shrink-0 text-[#1A1A1A]">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M12 8v8"/>
            <path d="M8 12h8"/>
          </svg>
        </div>
        <div>
          <h4 class="font-serif text-sm font-semibold text-[#1A1A1A] leading-snug">{{ section.settings.item_1_title | default: 'Difesa Cellulare Biomimetica' }}</h4>
          <p class="text-xs text-[#7A7265] mt-0.5 font-light">{{ section.settings.item_1_sub | default: 'Formule ad alta penetrazione epidermica' }}</p>
        </div>
      </div>

      <!-- Icon 2: Idratazione 72h a Lunga Durata -->
      <div class="flex items-center gap-4 bg-white/70 p-4 border border-[#E5E0D8]">
        <div class="w-12 h-12 rounded-full bg-[#F5F2EB] border border-[#DDD7CE] flex items-center justify-center flex-shrink-0 text-[#1A1A1A]">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
            <circle cx="12" cy="14" r="3"/>
          </svg>
        </div>
        <div>
          <h4 class="font-serif text-sm font-semibold text-[#1A1A1A] leading-snug">{{ section.settings.item_2_title | default: 'Idratazione 72h a Lunga Durata' }}</h4>
          <p class="text-xs text-[#7A7265] mt-0.5 font-light">{{ section.settings.item_2_sub | default: 'Test clinici strumentali comprovati' }}</p>
        </div>
      </div>

      <!-- Icon 3: 100% Attivi Alpini Puri -->
      <div class="flex items-center gap-4 bg-white/70 p-4 border border-[#E5E0D8]">
        <div class="w-12 h-12 rounded-full bg-[#F5F2EB] border border-[#DDD7CE] flex items-center justify-center flex-shrink-0 text-[#1A1A1A]">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L8 9h8l-4-7z"/>
            <path d="M12 9l-6 10h12l-6-10z"/>
            <path d="M12 19v3"/>
          </svg>
        </div>
        <div>
          <h4 class="font-serif text-sm font-semibold text-[#1A1A1A] leading-snug">{{ section.settings.item_3_title | default: '100% Attivi Alpini Puri' }}</h4>
          <p class="text-xs text-[#7A7265] mt-0.5 font-light">{{ section.settings.item_3_sub | default: 'Estratti da coltura biologica certificata' }}</p>
        </div>
      </div>

      <!-- Icon 4: Zero Siliconi & Microplastiche -->
      <div class="flex items-center gap-4 bg-white/70 p-4 border border-[#E5E0D8]">
        <div class="w-12 h-12 rounded-full bg-[#F5F2EB] border border-[#DDD7CE] flex items-center justify-center flex-shrink-0 text-[#1A1A1A]">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="7" y="2" width="10" height="20" rx="2" ry="2"/>
            <path d="M10 2v4"/>
            <path d="M14 2v4"/>
            <path d="M7 10h10"/>
            <circle cx="12" cy="15" r="1.5"/>
          </svg>
        </div>
        <div>
          <h4 class="font-serif text-sm font-semibold text-[#1A1A1A] leading-snug">{{ section.settings.item_4_title | default: 'Zero Siliconi & Microplastiche' }}</h4>
          <p class="text-xs text-[#7A7265] mt-0.5 font-light">{{ section.settings.item_4_sub | default: 'Packaging in vetro Miron riciclabile' }}</p>
        </div>
      </div>

    </div>
  </div>
</section>

