<div class="py-12 sm:py-16 lg:py-20 bg-[#F5F2EB] text-[#1A1A1A]">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-widest text-[#7A7265] mb-8" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="hover:text-[#1A1A1A] transition-colors">Home</a>
      <span class="text-[#DDD7CE]">/</span>
      <span class="text-[#1A1A1A] font-semibold">Tutte le Collezioni</span>
    </nav>

    <!-- Header -->
    <header class="text-center max-w-3xl mx-auto mb-14">
      <span class="inline-block text-[#C8A878] font-mono text-xs tracking-widest uppercase font-semibold mb-3">
        {{ section.settings.eyebrow | default: 'Compendio Botanico Team Dr Joseph' }}
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-[#1A1A1A] tracking-tight leading-tight">
        {{ section.settings.title | default: 'Le Collezioni Dermocosmetiche' }}
      </h1>
      <p class="text-xs sm:text-sm text-[#7A7265] mt-4 leading-relaxed font-light">
        {{ section.settings.description | default: 'Esplora i rituali di bellezza formulati con fitocomplessi puri e attivi clinici biomimetici per ogni specifica esigenza cutanea.' }}
      </p>
      <div class="w-16 h-0.5 bg-[#C8A878] mx-auto mt-6"></div>
    </header>

    {%- paginate collections by section.settings.collections_per_page -%}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {%- for collection in collections -%}
          {%- unless collection.handle == 'frontpage' -%}
            <article class="bg-white border border-[#DDD7CE] overflow-hidden group shadow-xs hover:shadow-md transition-all flex flex-col justify-between" style="border: 3px double #EDE5DB;">
              
              <!-- Image Container -->
              <a href="{{ collection.url }}" class="block relative aspect-[4/3] overflow-hidden bg-[#FAF8F5]">
                {%- if collection.featured_image -%}
                  <img
                    src="{{ collection.featured_image | image_url: width: 800 }}"
                    alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-700 ease-out"
                  >
                {%- elsif collection.products.first.featured_image -%}
                  <img
                    src="{{ collection.products.first.featured_image | image_url: width: 800 }}"
                    alt="{{ collection.title | escape }}"
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-700 ease-out"
                  >
                {%- else -%}
                  <div class="w-full h-full flex items-center justify-center bg-[#FAF8F5] text-[#DDD7CE] font-serif text-3xl">
                    {{ collection.title | slice: 0, 1 }}
                  </div>
                {%- endif -%}

                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity"></div>

                <span class="absolute bottom-3 left-3 bg-[#1A1A1A]/85 backdrop-blur-xs text-white text-[10px] font-mono tracking-widest uppercase px-2.5 py-1">
                  {{ collection.all_products_count }} {{ collection.all_products_count | pluralize: 'Formula', 'Formule' }}
                </span>
              </a>

              <!-- Card Body -->
              <div class="p-6 flex flex-col flex-1 justify-between bg-white">
                <div>
                  <span class="text-[10px] font-mono uppercase tracking-widest text-[#C8A878] font-semibold block mb-1">
                    Protocollo Viso & Corpo
                  </span>
                  <h2 class="font-serif text-xl sm:text-2xl text-[#1A1A1A] group-hover:text-[#5C6B56] transition-colors leading-snug">
                    <a href="{{ collection.url }}">
                      {{ collection.title }}
                    </a>
                  </h2>
                  {%- if collection.description != blank -%}
                    <p class="text-xs text-[#7A7265] mt-2 line-clamp-2 leading-relaxed font-light">
                      {{ collection.description | strip_html | truncatewords: 18 }}
                    </p>
                  {%- endif -%}
                </div>

                <div class="mt-6 pt-4 border-t border-[#F5F2EB] flex items-center justify-between">
                  <a href="{{ collection.url }}" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#1A1A1A] group-hover:text-[#C8A878] uppercase tracking-wider transition-colors">
                    <span>Esplora Collezione</span>
                    <span class="transform group-hover:translate-x-1 transition-transform">&rarr;</span>
                  </a>
                </div>
              </div>

            </article>
          {%- endunless -%}
        {%- endfor -%}
      </div>

      <!-- Pagination -->
      {%- if paginate.pages > 1 -%}
        <div class="mt-14 flex items-center justify-center gap-2 font-mono text-xs">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="px-4 py-2 border border-[#DDD7CE] bg-white hover:bg-[#1A1A1A] hover:text-white transition-colors uppercase">
              &larr; Precedente
            </a>
          {%- endif -%}

          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="px-3.5 py-2 border border-[#DDD7CE] bg-white hover:bg-[#1A1A1A] hover:text-white transition-colors">
                {{ part.title }}
              </a>
            {%- else -%}
              {%- if part.title == paginate.current_page -%}
                <span class="px-3.5 py-2 border border-[#1A1A1A] bg-[#1A1A1A] text-white font-bold">
                  {{ part.title }}
                </span>
              {%- else -%}
                <span class="px-3.5 py-2 text-[#7A7265]">{{ part.title }}</span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="px-4 py-2 border border-[#DDD7CE] bg-white hover:bg-[#1A1A1A] hover:text-white transition-colors uppercase">
              Successiva &rarr;
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

    {%- endpaginate -%}

  </div>
</div>

{% schema %}
{
  "name": "List Collections Mile",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Sopratitolo",
      "default": "Compendio Botanico Team Dr Joseph"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo",
      "default": "Le Collezioni Dermocosmetiche"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrizione",
      "default": "Esplora i rituali di bellezza formulati con fitocomplessi puri e attivi clinici biomimetici per ogni specifica esigenza cutanea."
    },
    {
      "type": "range",
      "id": "collections_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "label": "Collezioni per pagina",
      "default": 12
    }
  ]
}
{% endschema %}
