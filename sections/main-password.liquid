<div class="min-h-screen flex flex-col justify-between py-12 px-4 sm:px-8 bg-[#F5F2EB] text-[#1A1A1A]">
  <!-- Top Brand Navigation / Announcement -->
  <header class="max-w-4xl mx-auto w-full text-center mb-8">
    <div class="inline-flex items-center gap-2 border border-[#DDD7CE] bg-[#FAF8F5] px-4 py-1.5 text-[11px] font-mono tracking-widest text-[#7A7265] uppercase">
      <span>{{ section.settings.announcement | default: 'ISTITUTO MILEBIOLAB • FLAGSHIP STORE VERONA' }}</span>
    </div>
    
    <div class="mt-8">
      <a href="{{ routes.root_url }}" class="inline-block">
        <span class="font-serif text-3xl sm:text-4xl tracking-[0.22em] text-[#1A1A1A] uppercase font-light">MILE</span>
      </a>
      <p class="text-[10px] tracking-[0.3em] uppercase text-[#C8A878] mt-1 font-medium">Botanical Haute Couture &bull; Team Dr Joseph</p>
    </div>
  </header>

  <!-- Main Hero & Password Access Card -->
  <main class="max-w-xl mx-auto w-full my-auto">
    <div class="bg-white border border-[#DDD7CE] p-8 sm:p-12 shadow-sm text-center relative overflow-hidden" style="border: 3px double #EDE5DB;">
      
      <span class="inline-block text-[#C8A878] font-mono text-[11px] tracking-widest uppercase font-semibold mb-3">
        Accesso Riservato &bull; Private Preview
      </span>

      <h1 class="text-3xl sm:text-4xl font-serif text-[#1A1A1A] tracking-tight leading-tight mb-4">
        {{ section.settings.heading | default: 'Il Santuario Botanico apre a breve' }}
      </h1>

      <p class="text-xs sm:text-sm text-[#7A7265] leading-relaxed font-light mb-8 max-w-md mx-auto">
        {{ section.settings.subheading | default: "Stiamo perfezionando l'atelier digitale dedicato all'alta dermocosmesi biologica Team Dr Joseph. Inserisci la parola d'ordine riservata per esplorare il catalogo in anteprima." }}
      </p>

      <!-- Storefront Password Form -->
      {% form 'storefront_password', class: 'password-form max-w-md mx-auto' %}
        {%- if form.errors -%}
          <div class="password-error-box p-3 bg-red-50 border border-red-200 text-red-700 text-xs mb-4 text-left">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="flex flex-col sm:flex-row gap-2">
          <input
            type="password"
            name="password"
            id="Password"
            class="password-input flex-1 px-4 py-3 bg-[#FAF8F5] border border-[#DDD7CE] text-xs text-[#1A1A1A] placeholder-[#7A7265]/70 focus:outline-none focus:border-[#C8A878] focus:bg-white transition-all font-mono"
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t | default: "Inserisci la parola d'ordine..." }}"
            autocomplete="current-password"
            aria-label="Password del negozio"
            required
          >
          <button
            type="submit"
            name="commit"
            class="btn-primary px-6 py-3 bg-[#1A1A1A] hover:bg-[#5C6B56] text-white text-xs uppercase tracking-widest font-semibold transition-colors flex items-center justify-center gap-2 cursor-pointer shadow-xs"
          >
            <span>{{ 'general.password_page.login_form_submit' | t | default: 'Entra' }}</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </div>
      {% endform %}

      <!-- Flagship Boutique Info Box -->
      <div class="mt-8 pt-6 border-t border-[#F5F2EB] flex flex-col sm:flex-row items-center justify-center gap-4 text-[11px] text-[#7A7265]">
        <div class="flex items-center gap-1.5">
          <span>📍</span>
          <span>Corso Cavour 18, Verona</span>
        </div>
        <span class="hidden sm:inline text-[#DDD7CE]">&bull;</span>
        <div class="flex items-center gap-1.5">
          <span>🌿</span>
          <span>Ritiro in Sede & Consulenza Visia</span>
        </div>
      </div>

    </div>

    <!-- Newsletter Pre-Launch Signup Form -->
    {% if section.settings.show_newsletter %}
      <div class="mt-8 text-center bg-[#FAF8F5] border border-[#DDD7CE] p-6 max-w-md mx-auto">
        <h3 class="text-sm font-serif text-[#1A1A1A] uppercase tracking-wider mb-1">
          Desideri l'invito al vernissage?
        </h3>
        <p class="text-[11px] text-[#7A7265] mb-4 font-light">
          Lascia la tua email per ricevere l'invito esclusivo e 2 campioncini deluxe omaggio sul primo ordine.
        </p>

        {% form 'customer', class: 'newsletter-form' %}
          {% if form.posted_successfully? %}
            <p class="text-xs text-[#5C6B56] font-medium">✨ Grazie! Il tuo invito esclusivo ti verrà inviato all'apertura.</p>
          {% else %}
            <div class="flex gap-2">
              <input type="hidden" name="contact[tags]" value="newsletter,prospect_password">
              <input
                type="email"
                name="contact[email]"
                class="flex-1 px-3 py-2 bg-white border border-[#DDD7CE] text-xs text-[#1A1A1A] placeholder-[#7A7265]/70 focus:outline-none focus:border-[#C8A878]"
                placeholder="La tua email..."
                required
              >
              <button type="submit" class="px-4 py-2 bg-[#5C6B56] hover:bg-[#4A5340] text-white text-[11px] uppercase tracking-wider font-semibold transition-colors">
                Iscriviti
              </button>
            </div>
          {% endif %}
        {% endform %}
      </div>
    {% endif %}
  </main>

  <!-- Footer Admin Link & Legal -->
  <footer class="max-w-4xl mx-auto w-full text-center mt-8 pt-6 border-t border-[#DDD7CE]/60 text-xs text-[#7A7265]">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px]">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Formule Biologiche Team Dr Joseph.
      </div>
      <div>
        <a href="/admin" class="hover:text-[#1A1A1A] underline transition-colors">
          {{ 'general.password_page.admin_link_html' | t | default: 'Sei il proprietario del negozio? Accedi qui' }}
        </a>
      </div>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "Main Password Mile",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "Badge Superiore",
      "default": "ISTITUTO MILEBIOLAB • FLAGSHIP STORE VERONA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo Principale",
      "default": "Il Santuario Botanico apre a breve"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Descrizione",
      "default": "Stiamo perfezionando l'atelier digitale dedicato all'alta dermocosmesi biologica Team Dr Joseph. Inserisci la parola d'ordine riservata per esplorare il catalogo in anteprima."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Mostra form iscrizione anteprima",
      "default": true
    }
  ]
}
{% endschema %}
