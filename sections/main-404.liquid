<div id="standard-404-view">
<div class="py-20 lg:py-28 bg-[#F5F2EB] text-[#1A1A1A]">
  <main class="max-w-7xl mx-auto px-4 sm:px-8 text-center">
    <div class="max-w-2xl mx-auto">
      <span class="text-[#C8A878] font-mono text-sm tracking-widest uppercase font-semibold">{{ section.settings.eyebrow | default: "Errore 404 • Pagina Non Trovata" }}</span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif text-[#1A1A1A] tracking-tight mt-3 leading-tight">
        {{ section.settings.heading | default: "Un sentiero inesplorato tra le erbe alpine" }}
      </h1>
      <p class="text-sm text-[#7A7265] mt-4 leading-relaxed font-light">
        {{ section.settings.subheading | default: "La pagina o il trattamento che stai cercando potrebbe essere stato spostato o riformulato per un'esperienza ancora più sublime." }}
      </p>

      <!-- Search Field -->
      <form action="{{ routes.search_url }}" method="get" class="mt-8 max-w-md mx-auto flex items-center border border-[#DDD7CE] bg-white rounded-none overflow-hidden shadow-xs focus-within:border-[#C8A878] transition-colors">
        <input type="text" name="q" placeholder="{{ section.settings.search_placeholder | default: 'Cerca un ingrediente, formula o trattamento...' }}" class="flex-1 px-4 py-3 text-xs text-[#1A1A1A] placeholder-[#7A7265]/60 focus:outline-none bg-transparent">
        <button type="submit" class="px-5 py-3 bg-[#1A1A1A] hover:bg-[#C8A878] text-white text-xs uppercase tracking-wider font-semibold transition-colors">
          {{ section.settings.search_btn_text | default: "Cerca" }}
        </button>
      </form>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-xs">
        <a href="{{ section.settings.btn1_url | default: routes.root_url }}" class="px-6 py-2.5 bg-[#1A1A1A] text-white hover:bg-[#5C6B56] transition-colors uppercase tracking-wider font-medium">
          {{ section.settings.btn1_text | default: "Torna alla Home" }}
        </a>
        <a href="{{ section.settings.btn2_url | default: '/collections/all' }}" class="px-6 py-2.5 bg-white border border-[#DDD7CE] text-[#1A1A1A] hover:border-[#1A1A1A] transition-colors uppercase tracking-wider font-medium">
          {{ section.settings.btn2_text | default: "Esplora il Catalogo" }}
        </a>
        <a href="{{ section.settings.btn3_url | default: '#istituto-verona' }}" onclick="if(window.openVeronaModal) openVeronaModal();" class="px-6 py-2.5 bg-[#F5F2EB] border border-[#DDD7CE] text-[#1A1A1A] hover:text-[#C8A878] transition-colors uppercase tracking-wider font-medium">
          {{ section.settings.btn3_text | default: "Ritiro a Verona" }}
        </a>
      </div>
    </div>

    <!-- Curated Recommended Products -->
    <div class="mt-20 border-t border-[#DDD7CE] pt-16">
      <span class="text-xs uppercase tracking-widest text-[#7A7265] font-semibold block mb-2">{{ section.settings.rec_tag | default: "Bestseller In Evidenza" }}</span>
      <h2 class="text-2xl sm:text-3xl font-serif text-[#1A1A1A] mb-10">{{ section.settings.rec_title | default: "Formule Botaniche Più Amate" }}</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-5xl mx-auto text-left">
        <!-- Product 1 -->
        <div class="bg-white border border-[#DDD7CE] overflow-hidden shadow-xs flex flex-col justify-between group hover:shadow-lg transition-shadow">
          <div class="relative overflow-hidden aspect-square bg-[#F5F2EB]">
            <img src="https://images.unsplash.com/photo-1608248597359-54876b0521e4?auto=format&fit=crop&w=600&q=80" 
                 onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
                 alt="Olio Corpo Botanico Elisir Dorato" class="w-full h-full object-cover transition-transform duration-500">
          </div>
          <div class="p-5 flex flex-col flex-1 justify-between">
            <div>
              <div class="text-[10px] uppercase tracking-wider text-[#C8A878] font-semibold">Dr Joseph &bull; Bestseller</div>
              <h3 class="font-serif text-base text-[#1A1A1A] mt-1"><a href="/products/golden-glow-body-oil" class="hover:text-[#C8A878]">Olio Corpo Botanico Elisir Dorato</a></h3>
              <p class="text-xs text-[#7A7265] mt-1">Con micro-particelle dorate minerali ed estratti di calendula selvatica.</p>
            </div>
            <div class="mt-5 pt-4 border-t border-[#F5F2EB] flex items-center justify-between">
              <span class="text-sm font-semibold text-[#1A1A1A] font-mono">€ 76,00</span>
              <button type="button" onclick="if(window.addShopifyCartItem){window.addShopifyCartItem('1', 1, {id: 1, title: 'Olio Corpo Botanico Elisir Dorato', price: 76.00, volume: '100 ml', qty: 1, image: 'https://images.unsplash.com/photo-1608248597359-54876b0521e4?auto=format&fit=crop&w=300&q=80'});} else if(window.addToCart){addToCart({id: 1, title: 'Olio Corpo Botanico Elisir Dorato', price: 76.00, volume: '100 ml', qty: 1, image: 'https://images.unsplash.com/photo-1608248597359-54876b0521e4?auto=format&fit=crop&w=300&q=80'});}" class="px-4 py-2 bg-[#1A1A1A] hover:bg-[#5C6B56] text-white text-xs uppercase tracking-wider font-medium transition-colors">
                + Aggiungi
              </button>
            </div>
          </div>
        </div>

        <!-- Product 2 -->
        <div class="bg-white border border-[#DDD7CE] overflow-hidden shadow-xs flex flex-col justify-between group hover:shadow-lg transition-shadow">
          <div class="relative overflow-hidden aspect-square bg-[#F5F2EB]">
            <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=600&q=80" 
                 onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
                 alt="Elisir Riparatore Cellulare Alpino" class="w-full h-full object-cover transition-transform duration-500">
          </div>
          <div class="p-5 flex flex-col flex-1 justify-between">
            <div>
              <div class="text-[10px] uppercase tracking-wider text-[#C8A878] font-semibold">Rigenerazione Notte</div>
              <h3 class="font-serif text-base text-[#1A1A1A] mt-1"><a href="/products/golden-glow-body-oil" class="hover:text-[#C8A878]">Elisir Riparatore Cellulare Alpino</a></h3>
              <p class="text-xs text-[#7A7265] mt-1">Acido ialuronico multi-molecolare e fitosomi di Stella Alpina bio.</p>
            </div>
            <div class="mt-5 pt-4 border-t border-[#F5F2EB] flex items-center justify-between">
              <span class="text-sm font-semibold text-[#1A1A1A] font-mono">€ 88,00</span>
              <button type="button" onclick="if(window.addShopifyCartItem){window.addShopifyCartItem('2', 1, {id: 2, title: 'Elisir Riparatore Cellulare Alpino', price: 88.00, volume: '30 ml', qty: 1, image: 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=300&q=80'});} else if(window.addToCart){addToCart({id: 2, title: 'Elisir Riparatore Cellulare Alpino', price: 88.00, volume: '30 ml', qty: 1, image: 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=300&q=80'});}" class="px-4 py-2 bg-[#1A1A1A] hover:bg-[#5C6B56] text-white text-xs uppercase tracking-wider font-medium transition-colors">
                + Aggiungi
              </button>
            </div>
          </div>
        </div>

        <!-- Product 3 -->
        <div class="bg-white border border-[#DDD7CE] overflow-hidden shadow-xs flex flex-col justify-between group hover:shadow-lg transition-shadow">
          <div class="relative overflow-hidden aspect-square bg-[#F5F2EB]">
            <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80" 
                 onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
                 alt="Crema Riparatrice Cellulare Suprema" class="w-full h-full object-cover transition-transform duration-500">
          </div>
          <div class="p-5 flex flex-col flex-1 justify-between">
            <div>
              <div class="text-[10px] uppercase tracking-wider text-[#C8A878] font-semibold">Trattamento Barriera</div>
              <h3 class="font-serif text-base text-[#1A1A1A] mt-1"><a href="/products/golden-glow-body-oil" class="hover:text-[#C8A878]">Crema Riparatrice Cellulare Suprema</a></h3>
              <p class="text-xs text-[#7A7265] mt-1">Lipidi biomimetici da cera d'api alpina ed estratti floreali puri.</p>
            </div>
            <div class="mt-5 pt-4 border-t border-[#F5F2EB] flex items-center justify-between">
              <span class="text-sm font-semibold text-[#1A1A1A] font-mono">€ 84,00</span>
              <button type="button" onclick="if(window.addShopifyCartItem){window.addShopifyCartItem('3', 1, {id: 3, title: 'Crema Riparatrice Cellulare Suprema', price: 84.00, volume: '50 ml', qty: 1, image: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=300&q=80'});} else if(window.addToCart){addToCart({id: 3, title: 'Crema Riparatrice Cellulare Suprema', price: 84.00, volume: '50 ml', qty: 1, image: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=300&q=80'});}" class="px-4 py-2 bg-[#1A1A1A] hover:bg-[#5C6B56] text-white text-xs uppercase tracking-wider font-medium transition-colors">
                + Aggiungi
              </button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>
</div>
</div>

<div id="dynamic-account-404-view" class="hidden">
  {% render 'account-dashboard-view' %}
</div>

<div id="dynamic-chisono-404-view" class="hidden">
  {% render 'chi-sono-view' %}
</div>

<script>
  (function() {
    var path = window.location.pathname.toLowerCase();
    if (path.indexOf('/pages/account') !== -1 || path.indexOf('/pages/profilo') !== -1 || path.indexOf('/pages/club-mile') !== -1 || path.indexOf('/pages/accedi') !== -1) {
      var stdView = document.getElementById('standard-404-view');
      var accView = document.getElementById('dynamic-account-404-view');
      if (stdView && accView) {
        stdView.style.display = 'none';
        accView.classList.remove('hidden');
        document.title = "Club Mile • Il Tuo Account | MileBioLab";
        if (typeof window.renderCustomerAuthState === 'function') {
          window.renderCustomerAuthState();
        }
      }
    } else if (path.indexOf('/pages/chi-sono') !== -1 || path.indexOf('/pages/chi-siamo') !== -1 || path.indexOf('/pages/mile') !== -1 || path.indexOf('/pages/about') !== -1) {
      var stdView = document.getElementById('standard-404-view');
      var chiView = document.getElementById('dynamic-chisono-404-view');
      if (stdView && chiView) {
        stdView.style.display = 'none';
        chiView.classList.remove('hidden');
        document.title = "Chi Sono • MileBioLab & Lebestetik Verona";
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Main 404 Mile",
  "settings": [
    {
      "type": "header",
      "content": "Intestazione Errore"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sottotitolo / Badge",
      "default": "Errore 404 • Pagina Non Trovata"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo Principale",
      "default": "Un sentiero inesplorato tra le erbe alpine"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Descrizione",
      "default": "La pagina o il trattamento che stai cercando potrebbe essere stato spostato o riformulato per un'esperienza ancora più sublime."
    },
    {
      "type": "header",
      "content": "Barra di Ricerca"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder Ricerca",
      "default": "Cerca un ingrediente, formula o trattamento..."
    },
    {
      "type": "text",
      "id": "search_btn_text",
      "label": "Testo Bottone Ricerca",
      "default": "Cerca"
    },
    {
      "type": "header",
      "content": "Pulsanti di Navigazione Rapida"
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Pulsante 1 - Testo",
      "default": "Torna alla Home"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Pulsante 1 - Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Pulsante 2 - Testo",
      "default": "Esplora il Catalogo"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Pulsante 2 - Link"
    },
    {
      "type": "text",
      "id": "btn3_text",
      "label": "Pulsante 3 - Testo",
      "default": "Ritiro a Verona"
    },
    {
      "type": "url",
      "id": "btn3_url",
      "label": "Pulsante 3 - Link"
    },
    {
      "type": "header",
      "content": "Sezione Prodotti Consigliati"
    },
    {
      "type": "text",
      "id": "rec_tag",
      "label": "Tag Sezione Consigliati",
      "default": "Bestseller In Evidenza"
    },
    {
      "type": "text",
      "id": "rec_title",
      "label": "Titolo Sezione Consigliati",
      "default": "Formule Botaniche Più Amate"
    }
  ]
}
{% endschema %}
