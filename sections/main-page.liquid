{%- liquid
  assign t_suffix = template.suffix | default: '' | downcase
  assign handle_downcase = page.handle | default: '' | downcase
  assign title_downcase = page.title | default: '' | downcase

  assign is_terms = false
  if t_suffix contains 'termini' or t_suffix contains 'terms' or t_suffix contains 'condizioni' or handle_downcase contains 'termini' or handle_downcase contains 'terms' or title_downcase contains 'termini' or title_downcase contains 'terms' or handle_downcase contains 'condizioni'
    assign is_terms = true
  endif

  assign is_shipping = false
  if t_suffix contains 'spedizion' or t_suffix contains 'shipping' or t_suffix contains 'consegna' or handle_downcase contains 'spedizion' or handle_downcase contains 'shipping' or title_downcase contains 'spedizion' or title_downcase contains 'shipping' or handle_downcase contains 'consegna'
    assign is_shipping = true
  endif

  assign is_cookie = false
  if t_suffix contains 'cookie' or handle_downcase contains 'cookie' or title_downcase contains 'cookie'
    assign is_cookie = true
  endif

  assign is_chi_sono = false
  if is_terms == false and is_shipping == false and is_cookie == false
    if t_suffix contains 'chi-sono' or t_suffix contains 'chi-siamo' or handle_downcase contains 'chi-sono' or handle_downcase contains 'chi-siamo' or title_downcase contains 'chi sono' or title_downcase contains 'chi siamo'
      assign is_chi_sono = true
    endif
  endif

  assign is_contact = false
  if is_terms == false and is_shipping == false and is_cookie == false and is_chi_sono == false
    if t_suffix contains 'contatt' or t_suffix contains 'contact' or handle_downcase contains 'contatt' or handle_downcase contains 'contact' or title_downcase contains 'contatt' or title_downcase contains 'contact'
      assign is_contact = true
    endif
  endif

  assign is_custom_view = false
  if is_chi_sono or is_contact or is_terms or is_shipping or is_cookie
    assign is_custom_view = true
  endif
-%}

<div class="py-10 sm:py-14 lg:py-18 bg-[#F5F2EB] text-[#1A1A1A]">
  <div class="{% if is_custom_view %}max-w-6xl{% elsif section.settings.page_width == 'narrow' %}max-w-3xl{% elsif section.settings.page_width == 'wide' %}max-w-6xl{% else %}max-w-4xl{% endif %} mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumbs -->
    {% if section.settings.show_breadcrumbs and is_custom_view == false %}
      <nav class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-widest text-[#7A7265] mb-8" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}" class="hover:text-[#1A1A1A] transition-colors">Home</a>
        <span class="text-[#DDD7CE]">/</span>
        <span class="text-[#1A1A1A] font-semibold truncate">{{ page.title }}</span>
      </nav>
    {% endif %}

    <!-- Page Header -->
    {% if section.settings.show_title and is_custom_view == false %}
      <header class="text-center mb-12 sm:mb-16">
        <span class="inline-block text-[#C8A878] font-mono text-xs tracking-widest uppercase font-semibold mb-3">
          {{ section.settings.eyebrow | default: 'Istituto MileBioLab • Verona' }}
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-[#1A1A1A] tracking-tight leading-tight">
          {{ page.title }}
        </h1>
        <div class="w-16 h-0.5 bg-[#C8A878] mx-auto mt-6"></div>
      </header>
    {% endif %}

    <!-- Page Content Area / Smart Policy, Chi-Sono & Contact Check -->
    {% if is_shipping %}
      {% render 'policy-shipping-view', settings: section.settings, blocks: section.blocks %}
    {% elsif is_terms %}
      {% render 'policy-terms-view', settings: section.settings, blocks: section.blocks %}
    {% elsif is_cookie %}
      {% render 'policy-cookie-view', settings: section.settings, blocks: section.blocks %}
    {% elsif is_chi_sono %}
      {% render 'chi-sono-view' %}
      {% if page.content != blank %}
        <article class="bg-white border border-[#DDD7CE] p-6 sm:p-12 lg:p-16 shadow-xs relative mt-8" style="border: 3px double #EDE5DB;">
          <div class="rte prose max-w-none text-[#1A1A1A] text-sm sm:text-base leading-relaxed font-light space-y-6">
            {{ page.content }}
          </div>
        </article>
      {% endif %}
    {% elsif is_contact %}
      {% render 'contact-view' %}
      {% if page.content != blank %}
        <article class="bg-white border border-[#DDD7CE] p-6 sm:p-12 lg:p-16 shadow-xs relative mt-8" style="border: 3px double #EDE5DB;">
          <div class="rte prose max-w-none text-[#1A1A1A] text-sm sm:text-base leading-relaxed font-light space-y-6">
            {{ page.content }}
          </div>
        </article>
      {% endif %}
    {% else %}
      <article class="bg-white border border-[#DDD7CE] p-6 sm:p-12 lg:p-16 shadow-xs relative" style="border: 3px double #EDE5DB;">
        <div class="rte prose max-w-none text-[#1A1A1A] text-sm sm:text-base leading-relaxed font-light space-y-6">
          {{ page.content }}
        </div>
      </article>
    {% endif %}

    <!-- Optional Verona Boutique Banner -->
    {% if section.settings.show_verona_banner and is_custom_view == false %}
      <div class="mt-12 bg-[#FAF8F5] border border-[#DDD7CE] p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="text-center sm:text-left">
          <span class="text-[10px] font-mono uppercase tracking-widest text-[#C8A878] font-semibold block mb-1">
            {{ section.settings.verona_banner_eyebrow | default: "Boutique & Cabina Esclusiva" }}
          </span>
          <h3 class="font-serif text-xl text-[#1A1A1A]">
            {{ section.settings.verona_banner_title | default: "Desideri una consulenza vis-à-vis a Verona?" }}
          </h3>
          <p class="text-xs text-[#7A7265] mt-1">
            {{ section.settings.verona_banner_text | default: "Presso la nostra sede di Via Torricelle 2c in Lebestetik puoi ritirare i tuoi ordini o prenotare un trattamento dermo-specialistico." }}
          </p>
        </div>
        <a href="#istituto-verona" onclick="if(window.openVeronaModal) openVeronaModal();" class="px-6 py-3 bg-[#1A1A1A] hover:bg-[#5C6B56] text-white text-xs uppercase tracking-widest font-semibold transition-colors shrink-0 text-center">
          {{ section.settings.verona_banner_btn_text | default: "Info Ritiro in Sede" }}
        </a>
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Main Page Mile",
  "settings": [
    {
      "type": "header",
      "content": "Intestazione Pagina"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sottotitolo / Eyebrow",
      "default": "Istituto MileBioLab • Verona"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Mostra titolo pagina",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Mostra breadcrumb",
      "default": true
    },
    {
      "type": "select",
      "id": "page_width",
      "label": "Larghezza Contenuto",
      "options": [
        { "value": "narrow", "label": "Stretta (Max 3xl)" },
        { "value": "medium", "label": "Media (Max 4xl)" },
        { "value": "wide", "label": "Larga (Max 6xl)" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Banner Flagship Verona"
    },
    {
      "type": "checkbox",
      "id": "show_verona_banner",
      "label": "Mostra box Sede Verona",
      "default": true
    },
    {
      "type": "text",
      "id": "verona_banner_eyebrow",
      "label": "Eyebrow Banner Verona",
      "default": "Boutique & Cabina Esclusiva"
    },
    {
      "type": "text",
      "id": "verona_banner_title",
      "label": "Titolo Banner Verona",
      "default": "Desideri una consulenza vis-à-vis a Verona?"
    },
    {
      "type": "textarea",
      "id": "verona_banner_text",
      "label": "Testo Banner Verona",
      "default": "Presso la nostra sede di Via Torricelle 2c in Lebestetik puoi ritirare i tuoi ordini o prenotare un trattamento dermo-specialistico."
    },
    {
      "type": "text",
      "id": "verona_banner_btn_text",
      "label": "Testo Bottone Banner Verona",
      "default": "Info Ritiro in Sede"
    }
  ]
}
{% endschema %}
