            {%- assign reviews_items = raw_reviews | strip | split: '~~~' -%}
            {%- assign pool_size = reviews_items.size -%}
            {%- assign offset = product.id | modulo: pool_size -%}
            {%- assign rotated_reviews = '' -%}
            {%- for i in (0..pool_size) -%}
              {%- if i < pool_size -%}
                {%- assign actual_i = i | plus: offset | modulo: pool_size -%}
                {%- assign item = reviews_items[actual_i] -%}
                {%- if forloop.first -%}
                  {%- assign rotated_reviews = item -%}
                {%- else -%}
                  {%- assign rotated_reviews = rotated_reviews | append: '~~~' | append: item -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- assign final_reviews = rotated_reviews | split: '~~~' -%}
        {%- endif -%}

        <!-- Reviews Grid -->
        <div id="reviews-grid-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {%- assign rendered_count = 0 -%}

            {%- if use_targeted_blocks -%}
                {%- for block in section.blocks -%}
                  {%- if block.settings.target_product != blank and block.settings.target_product.id == product.id -%}
                    {%- assign rendered_count = rendered_count | plus: 1 -%}
                    <div class="bg-linen p-6 border border-borderLinen flex flex-col justify-between transition-all duration-500 {% if rendered_count > 6 %}review-card-hidden hidden opacity-0 translate-y-2{% else %}flex{% endif %}" {{ block.shopify_attributes }}>
                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <div class="text-amber text-xs tracking-wider">
                                    {%- for i in (1..block.settings.rating) -%}&starf;{%- endfor -%}
                                    {%- if block.settings.rating < 5 -%}
                                        {%- assign empty_stars = 5 | minus: block.settings.rating -%}
                                        {%- for i in (1..empty_stars) -%}<span class="text-ash/40">&starf;</span>{%- endfor -%}
                                    {%- endif -%}
                                </div>
                                <span class="text-[10px] text-ash">{{ block.settings.date }}</span>
                            </div>
                            <h4 class="font-serif text-base font-semibold text-ink mb-2">{{ block.settings.title }}</h4>
