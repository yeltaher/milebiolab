                            </div>
                        {% endif %}
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] uppercase tracking-wider text-ash mb-1">Titolo</label>
                                <input type="text" name="contact[title]" class="w-full border border-borderLinen bg-white px-3 py-2 text-xs focus:outline-none focus:border-ink" required>
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase tracking-wider text-ash mb-1">Valutazione (1-5)</label>
                                <select name="contact[rating]" class="w-full border border-borderLinen bg-white px-3 py-2 text-xs focus:outline-none focus:border-ink" required>
                                    <option value="5">5 Stelle</option>
                                    <option value="4">4 Stelle</option>
                                    <option value="3">3 Stelle</option>
                                    <option value="2">2 Stelle</option>
                                    <option value="1">1 Stella</option>
                                </select>
                            </div>
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-wider text-ash mb-1">Recensione</label>
                            <textarea name="contact[body]" rows="4" class="w-full border border-borderLinen bg-white px-3 py-2 text-xs focus:outline-none focus:border-ink" required></textarea>
                        </div>
                        <div class="text-center mt-6">
                            <button type="submit" class="bg-black text-white px-8 py-3 text-[10px] uppercase tracking-[0.2em] hover:bg-[#222222] transition-colors luxury-interactive">Invia Recensione</button>
                        </div>
                    {% endform %}
                {% else %}
                    <div class="bg-linen p-8 border border-borderLinen text-center">
                        <p class="text-xs text-ash mb-4">Accedi per condividere la tua esperienza con le altre clienti.</p>
                        <a href="/pages/accedi" onclick="if(window.openAccountDrawer){openAccountDrawer(); return false;}" class="inline-block border border-ink text-ink px-8 py-3 text-[10px] uppercase tracking-[0.2em] hover:bg-ink hover:text-white transition-colors luxury-interactive">Accedi o Registrati</a>
                    </div>
                {% endif %}
            </div>
        </div>

    </div>
</section>

<script>
function showMoreReviews(btn) {
    var container = document.getElementById('reviews-grid-container');
    if (!container) return;
    var hiddenCards = container.querySelectorAll('.review-card-hidden');
    var batchSize = 6;
    
    for (var i = 0; i < hiddenCards.length && i < batchSize; i++) {
        var card = hiddenCards[i];
        card.classList.remove('hidden', 'review-card-hidden');
        card.classList.add('flex');
        (function(c) {
            requestAnimationFrame(function() {
                setTimeout(function() {
                    c.classList.remove('opacity-0', 'translate-y-2');
                    c.classList.add('opacity-100', 'translate-y-0');
                }, 30);
            });
        })(card);
    }
    
    var remaining = container.querySelectorAll('.review-card-hidden').length;
    var wrap = document.getElementById('show-more-reviews-wrap');
    if (remaining === 0) {
        if (wrap) {
            wrap.innerHTML = '<span class="text-xs text-ash uppercase tracking-widest font-light">Tutte le recensioni visualizzate</span>';
        }
    } else if (btn) {
        btn.textContent = 'Mostra Altre Recensioni (+' + Math.min(batchSize, remaining) + ')';
    }
}
</script>

