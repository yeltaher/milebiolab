<section id="reviews" class="py-20 bg-white border-y border-borderLinen">
    <!-- Hidden Judge.me Headless Bridge for 1-Click Moderation (Approva/Rifiuta) -->
    <div id="judgeme-headless-bridge" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;" aria-hidden="true">
      {% render 'judgeme_widgets', widget_type: 'judgeme_review_widget', product: product %}
    </div>
    <style>
      #judgeme-headless-bridge,
      #judgeme-headless-bridge * {
        max-height: 0 !important;
        opacity: 0 !important;
      }
      .jdgm-notification,
      .jdgm-modal-overlay,
      .jdgm-write-rev-modal {
        position: fixed !important;
        top: -9999px !important;
        left: -9999px !important;
        width: 1px !important;
        height: 1px !important;
        opacity: 0 !important;
        pointer-events: none !important;
        z-index: -9999 !important;
      }
    </style>

    <div class="max-w-7xl mx-auto px-6 lg:px-12">
        
        <div id="botanical-fallback-reviews">
        
        {%- comment -%}
          MILEBIOLAB STRICT PRODUCT REVIEWS SELECTION
          Reviews are strictly rendered ONLY if:
          1. Explicitly assigned via block.settings.target_product == product.handle / product.id
          2. Explicitly assigned via product.metafields.custom.reviews
          3. Submitted by verified clients via review form (stored locally in client session)
          NO generic category fallback is permitted under any circumstances.
        {%- endcomment -%}

        {%- assign targeted_blocks_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.target_product != blank -%}
            {%- if block.settings.target_product == product.handle or block.settings.target_product.id == product.id or block.settings.target_product.handle == product.handle -%}
              {%- assign targeted_blocks_count = targeted_blocks_count | plus: 1 -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign has_metafield_reviews = false -%}
        {%- if product.metafields.custom.reviews != blank -%}
          {%- assign has_metafield_reviews = true -%}
          {%- if product.metafields.custom.reviews contains '~~~' -%}
            {%- assign custom_reviews_list = product.metafields.custom.reviews | strip | split: '~~~' -%}
          {%- else -%}
            {%- assign custom_reviews_list = product.metafields.custom.reviews | newline_to_br | split: '<br />' -%}
          {%- endif -%}
        {%- endif -%}

        {%- assign use_targeted_blocks = false -%}
        {%- assign use_metafield_reviews = false -%}

        {%- if targeted_blocks_count > 0 -%}
          {%- assign use_targeted_blocks = true -%}
        {%- elsif has_metafield_reviews -%}
          {%- assign use_metafield_reviews = true -%}
        {%- endif -%}

        {%- comment -%} Real Mathematical Calculation of Review Statistics {%- endcomment -%}
        {%- assign c_5 = 0 -%}
        {%- assign c_4 = 0 -%}
        {%- assign c_3 = 0 -%}
        {%- assign c_2 = 0 -%}
        {%- assign c_1 = 0 -%}

        {%- if use_targeted_blocks -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.target_product != blank -%}
                {%- if block.settings.target_product == product.handle or block.settings.target_product.id == product.id or block.settings.target_product.handle == product.handle -%}
                  {%- assign r_val = block.settings.rating | plus: 0 -%}
                  {%- if r_val >= 5 -%}{%- assign c_5 = c_5 | plus: 1 -%}
                  {%- elsif r_val == 4 -%}{%- assign c_4 = c_4 | plus: 1 -%}
                  {%- elsif r_val == 3 -%}{%- assign c_3 = c_3 | plus: 1 -%}
                  {%- elsif r_val == 2 -%}{%- assign c_2 = c_2 | plus: 1 -%}
                  {%- elsif r_val <= 1 -%}{%- assign c_1 = c_1 | plus: 1 -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
        {%- elsif use_metafield_reviews -%}
            {%- for item in custom_reviews_list -%}
              {%- assign parts = item | split: '|' -%}
              {%- if parts.size >= 4 -%}
                {%- assign r_val = parts[0] | strip | plus: 0 -%}
                {%- if r_val >= 5 -%}{%- assign c_5 = c_5 | plus: 1 -%}
                {%- elsif r_val == 4 -%}{%- assign c_4 = c_4 | plus: 1 -%}
                {%- elsif r_val == 3 -%}{%- assign c_3 = c_3 | plus: 1 -%}
                {%- elsif r_val == 2 -%}{%- assign c_2 = c_2 | plus: 1 -%}
                {%- elsif r_val <= 1 -%}{%- assign c_1 = c_1 | plus: 1 -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
        {%- endif -%}

        {%- assign real_total = c_5 | plus: c_4 | plus: c_3 | plus: c_2 | plus: c_1 -%}

        {%- if real_total > 0 -%}
            {%- assign sum_5 = c_5 | times: 5 -%}
            {%- assign sum_4 = c_4 | times: 4 -%}
            {%- assign sum_3 = c_3 | times: 3 -%}
            {%- assign sum_2 = c_2 | times: 2 -%}
            {%- assign sum_1 = c_1 | times: 1 -%}
            {%- assign sum_ratings = sum_5 | plus: sum_4 | plus: sum_3 | plus: sum_2 | plus: sum_1 -%}

            {%- assign score_x10 = sum_ratings | times: 100 | divided_by: real_total | plus: 5 | divided_by: 10 -%}
            {%- assign score_int = score_x10 | divided_by: 10 -%}
            {%- assign score_dec = score_x10 | modulo: 10 -%}
            {%- assign overall_score_val = score_int | append: '.' | append: score_dec -%}

            {%- assign pct_5_val = c_5 | times: 1000 | divided_by: real_total | plus: 5 | divided_by: 10 -%}
            {%- assign pct_4_val = c_4 | times: 1000 | divided_by: real_total | plus: 5 | divided_by: 10 -%}
            {%- assign pct_3_val = c_3 | times: 1000 | divided_by: real_total | plus: 5 | divided_by: 10 -%}
            {%- assign pct_2_val = c_2 | times: 1000 | divided_by: real_total | plus: 5 | divided_by: 10 -%}
            {%- assign pct_1_val = c_1 | times: 1000 | divided_by: real_total | plus: 5 | divided_by: 10 -%}

            {%- assign positive_count = c_5 | plus: c_4 -%}
            {%- assign repurchase_rate = positive_count | times: 1000 | divided_by: real_total | plus: 5 | divided_by: 10 -%}
            {%- if repurchase_rate > 100 -%}
              {%- assign repurchase_rate = 100 -%}
            {%- endif -%}
            {%- assign repurchase_badge_val = repurchase_rate | append: '% delle clienti consiglia o riacquista questo rituale' -%}
            {%- assign total_reviews_val = real_total -%}
        {%- else -%}
            {%- assign overall_score_val = "0.0" -%}
            {%- assign total_reviews_val = 0 -%}
            {%- assign repurchase_badge_val = "" -%}
            {%- assign pct_5_val = 0 -%}
            {%- assign pct_4_val = 0 -%}
            {%- assign pct_3_val = 0 -%}
            {%- assign pct_2_val = 0 -%}
            {%- assign pct_1_val = 0 -%}
        {%- endif -%}

        <!-- Overall Rating Score Box -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16 pb-12 border-b border-borderLinen">
            
            <div class="lg:col-span-4 text-center lg:text-left lg:border-r border-borderLinen lg:pr-12">
                <span class="text-xs uppercase tracking-[0.25em] text-amber font-semibold block mb-2">{{ section.settings.eyebrow | default: "OPINIONI VERIFICATE • CLUB MILE" }}</span>
                {%- if real_total > 0 -%}
                  <div id="reviews-overall-score-display" data-base-score="{{ overall_score_val }}" class="font-serif text-6xl text-ink font-normal leading-none mb-3">{{ overall_score_val }}</div>
                  <div id="reviews-stars-display" class="text-amber text-lg tracking-wider mb-2">&starf;&starf;&starf;&starf;&starf;</div>
                  <p id="reviews-total-count-display" data-base-count="{{ real_total }}" class="text-xs text-ash">
                    {%- if real_total == 1 -%}
                      Basato su 1 recensione certificata da acquirente reale
                    {%- else -%}
                      Basato su {{ real_total }} recensioni certificate da acquirenti reali
                    {%- endif -%}
                  </p>
                  {%- if repurchase_badge_val != blank -%}
                  <div class="mt-4 inline-block bg-linen px-3 py-1.5 text-xs text-sage font-medium border border-borderLinen">
                      {{ repurchase_badge_val }}
                  </div>
                  {%- endif -%}
                {%- else -%}
                  <div id="reviews-overall-score-display" data-base-score="0" class="font-serif text-2xl sm:text-3xl text-ink font-normal leading-tight mb-3">Nessuna recensione ancora presente</div>
                  <div id="reviews-stars-display" class="text-ash/30 text-lg tracking-wider mb-2">&starf;&starf;&starf;&starf;&starf;</div>
                  <p id="reviews-total-count-display" data-base-count="0" class="text-xs text-ash">
                    Nessuna recensione ancora presente
                  </p>
                {%- endif -%}
            </div>

            <!-- Star Distribution Bars -->
            <div class="lg:col-span-8 space-y-2 text-xs">
                
                <div class="flex items-center gap-4">
                    <span class="w-16 text-ash">5 Stelle</span>
                    <div class="flex-1 h-2.5 bg-linen rounded-full overflow-hidden">
                        <div class="bg-ink h-full rounded-full transition-all duration-500" style="width: {{ pct_5_val }}%;"></div>
                    </div>
                    <span class="w-12 text-right font-medium text-ink">{{ pct_5_val }}%</span>
                </div>

                <div class="flex items-center gap-4">
                    <span class="w-16 text-ash">4 Stelle</span>
                    <div class="flex-1 h-2.5 bg-linen rounded-full overflow-hidden">
                        <div class="bg-ink/60 h-full rounded-full transition-all duration-500" style="width: {{ pct_4_val }}%;"></div>
                    </div>
                    <span class="w-12 text-right font-medium text-ink">{{ pct_4_val }}%</span>
                </div>

                <div class="flex items-center gap-4">
                    <span class="w-16 text-ash">3 Stelle</span>
                    <div class="flex-1 h-2.5 bg-linen rounded-full overflow-hidden">
                        <div class="bg-ink/40 h-full rounded-full transition-all duration-500" style="width: {{ pct_3_val }}%;"></div>
                    </div>
                    <span class="w-12 text-right font-medium text-ink">{{ pct_3_val }}%</span>
                </div>

                <div class="flex items-center gap-4">
                    <span class="w-16 text-ash">2 Stelle</span>
                    <div class="flex-1 h-2.5 bg-linen rounded-full overflow-hidden">
                        <div class="bg-ink/20 h-full rounded-full transition-all duration-500" style="width: {{ pct_2_val }}%;"></div>
                    </div>
                    <span class="w-12 text-right font-medium text-ink">{{ pct_2_val }}%</span>
                </div>

                <div class="flex items-center gap-4">
                    <span class="w-16 text-ash">1 Stella</span>
                    <div class="flex-1 h-2.5 bg-linen rounded-full overflow-hidden">
                        <div class="bg-ink/20 h-full rounded-full transition-all duration-500" style="width: {{ pct_1_val }}%;"></div>
                    </div>
                    <span class="w-12 text-right font-medium text-ink">{{ pct_1_val }}%</span>
                </div>

            </div>

        </div>

        <!-- Reviews Grid -->
        <div id="reviews-grid-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {%- assign rendered_count = 0 -%}

            {%- if use_targeted_blocks -%}
                {%- for block in section.blocks -%}
                  {%- if block.settings.target_product != blank -%}
                    {%- if block.settings.target_product == product.handle or block.settings.target_product.id == product.id or block.settings.target_product.handle == product.handle -%}
                      {%- assign rendered_count = rendered_count | plus: 1 -%}
                      <div class="bg-linen p-6 border border-borderLinen flex flex-col justify-between transition-all duration-500 {% if rendered_count > 6 %}review-card-hidden hidden opacity-0 translate-y-2{% else %}flex{% endif %}" {{ block.shopify_attributes }}>
                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <div class="text-amber text-xs tracking-wider">
                                    {%- for i in (1..block.settings.rating) -%}&starf;{%- endfor -%}
                                    {%- if block.settings.rating < 5 -%}
                                        {%- assign empty_stars = 5 | minus: block.settings.rating -%}
                                        {%- for i in (1..empty_stars) -%}<span class="text-ash/40">&starf;</span>{%- endfor -%}
                                    {%- endif -%}
                                </div>
                                <span class="text-[10px] text-ash">{{ block.settings.date }}</span>
                            </div>
                            <h4 class="font-serif text-base font-semibold text-ink mb-2">{{ block.settings.title }}</h4>
                            <p class="text-xs text-ash leading-relaxed font-light">
                                &ldquo;{{ block.settings.text }}&rdquo;
                            </p>
                        </div>
                        <div class="pt-4 mt-6 border-t border-borderLinen flex items-center justify-between text-xs">
                            {%- assign raw_b_author = block.settings.author | default: 'Cliente M. • Verona' -%}
                            {%- assign clean_b_author = raw_b_author | replace: '&bull;', ' • ' | replace: '  ', ' ' | strip -%}
                            {%- if clean_b_author contains '•' -%}
                              {%- assign b_parts = clean_b_author | split: '•' -%}
                              {%- assign b_name = b_parts[0] | strip -%}
                              {%- assign b_city = b_parts[1] | strip | default: 'Verona' -%}
                            {%- elsif clean_b_author contains ' Verona' -%}
                              {%- assign b_name = clean_b_author | remove: ' Verona' | strip -%}
                              {%- assign b_city = 'Verona' -%}
                            {%- else -%}
                              {%- assign b_name = clean_b_author | strip -%}
                              {%- assign b_city = 'Verona' -%}
                            {%- endif -%}
                            {%- assign last_char = b_name | slice: -1, 1 -%}
                            {%- if last_char != '.' and last_char != ' ' -%}
                              {%- assign name_words = b_name | split: ' ' -%}
                              {%- assign last_word = name_words | last -%}
                              {%- if last_word.size == 1 -%}
                                {%- assign b_name = b_name | append: '.' -%}
                              {%- elsif name_words.size > 1 -%}
                                {%- assign first_toks = '' -%}
                                {%- for w in name_words -%}
                                  {%- unless forloop.last -%}
                                    {%- assign first_toks = first_toks | append: w | append: ' ' -%}
                                  {%- endunless -%}
                                {%- endfor -%}
                                {%- assign initial_char = last_word | slice: 0, 1 -%}
                                {%- assign b_name = first_toks | append: initial_char | append: '.' -%}
                              {%- endif -%}
                            {%- endif -%}
                            <span class="font-medium text-ink">{{ b_name }} &bull; {{ b_city }}</span>
                            <span class="text-sage text-[10px] font-semibold flex items-center gap-1">&check; Acquisto Verificato</span>
                        </div>
                    </div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
            {%- elsif use_metafield_reviews -%}
                {%- for item in custom_reviews_list -%}
                    {%- assign parts = item | split: '|' -%}
                    {%- if parts.size >= 4 -%}
                        {%- assign rendered_count = rendered_count | plus: 1 -%}
                        {%- assign r_rating = parts[0] | strip | plus: 0 -%}
                        {%- assign r_date = parts[1] | strip -%}
                        {%- assign r_title = parts[2] | strip -%}
                        {%- assign r_text = parts[3] | strip -%}
                        {%- assign r_author = parts[4] | strip | default: 'Cliente Verificata' -%}
                        {%- assign r_city = parts[5] | strip -%}
                        <div class="bg-linen p-6 border border-borderLinen flex flex-col justify-between transition-all duration-500 {% if rendered_count > 6 %}review-card-hidden hidden opacity-0 translate-y-2{% else %}flex{% endif %}">
                            <div>
                                <div class="flex justify-between items-center mb-3">
                                    <div class="text-amber text-xs tracking-wider">
                                        {%- for i in (1..r_rating) -%}&starf;{%- endfor -%}
                                        {%- if r_rating < 5 -%}
                                            {%- assign empty_stars = 5 | minus: r_rating -%}
                                            {%- for i in (1..empty_stars) -%}<span class="text-ash/40">&starf;</span>{%- endfor -%}
                                        {%- endif -%}
                                    </div>
                                    <span class="text-[10px] text-ash">{{ r_date }}</span>
                                </div>
                                <h4 class="font-serif text-base font-semibold text-ink mb-2">{{ r_title }}</h4>
                                <p class="text-xs text-ash leading-relaxed font-light">
                                    &ldquo;{{ r_text }}&rdquo;
                                </p>
                            </div>
                            <div class="pt-4 mt-6 border-t border-borderLinen flex items-center justify-between text-xs">
                                <span class="font-medium text-ink">{{ r_author }}{% if r_city != blank %} &bull; {{ r_city }}{% endif %}</span>
                                <span class="text-sage text-[10px] font-semibold flex items-center gap-1">&check; Acquisto Verificato</span>
                            </div>
                        </div>
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}
        </div>

        <!-- Empty State Container -->
        <div id="reviews-empty-state" class="{% if rendered_count > 0 %}hidden{% endif %} text-center py-12 px-6 bg-[#FAF8F5] border border-borderLinen my-4">
            <div class="text-[#C8A878] text-sm mb-3">★★★★★</div>
            <h3 class="font-serif text-lg text-ink font-medium mb-2">Nessuna recensione ancora presente</h3>
            <p class="text-xs text-ash max-w-md mx-auto mb-6 font-light leading-relaxed">
                Nessuna recensione ancora presente. Hai provato questo rituale/prodotto? Condividi la tua esperienza e aiuta altre clienti a scoprire la sua efficacia.
            </p>
            <a href="#ProductReviewForm" onclick="var f=document.getElementById('ProductReviewForm'); if(f){f.scrollIntoView({behavior:'smooth'});}" class="inline-flex items-center justify-center px-6 py-2.5 border border-ink text-ink text-[11px] uppercase tracking-[0.2em] font-medium hover:bg-ink hover:text-white transition-all duration-300">
                Scrivi la prima recensione
            </a>
        </div>

        {%- if rendered_count > 6 -%}
            <div class="mt-12 text-center" id="show-more-reviews-wrap">
                <button type="button" onclick="showMoreReviews(this)" class="inline-flex items-center justify-center px-8 py-3.5 border border-ink text-ink text-xs uppercase tracking-[0.2em] font-medium bg-transparent hover:bg-ink hover:text-white transition-all duration-300 shadow-xs luxury-interactive cursor-pointer">
                    Mostra Altre Recensioni (+)
                </button>
            </div>
        {%- endif -%}

        <!-- Leave a Review Form -->
        <div class="mt-16 pt-12 border-t border-borderLinen">
            <div class="max-w-2xl mx-auto text-center">
                <span class="text-xs uppercase tracking-[0.25em] text-ink font-semibold block mb-4">Lascia una recensione</span>
                
                <div id="ReviewFormSuccessMessage" class="hidden bg-[#FAF8F5] text-[#5C6B56] border border-[#5C6B56]/30 p-4 text-xs text-center mb-6 shadow-xs rounded-xs font-medium">
                    ✨ Grazie per la tua recensione! È stata registrata e inviata a info@miledermocosmesi.it per la moderazione del nostro team. Verrà pubblicata a seguito della verifica.
                </div>
                
                {% form 'contact', id: 'ProductReviewForm', class: 'space-y-4 text-left' %}
                    <input type="hidden" name="contact[type]" value="review">
                    <input type="hidden" name="contact[product]" value="{{ product.title | escape }}">
                    <input type="hidden" name="contact[recipient]" value="info@miledermocosmesi.it">
                    <input type="hidden" name="contact[subject]" value="[Nuova Recensione Club Mile - info@miledermocosmesi.it] {{ product.title | escape }}">
                    <input type="hidden" name="contact[moderazione]" value="Per approvare o rifiutare questa recensione usa i tasti Approva/Rifiuta nell'email di Judge.me oppure visita: https://admin.shopify.com/store/mile/apps/judge-me/reviews">
                    {{ form.errors | default_errors }}
                    
                    {% if form.posted_successfully? %}
                        <div class="bg-sage/10 text-sage p-4 text-xs text-center border border-sage/20 mb-4">
                            Grazie per la tua recensione! È stata inviata al nostro team (info@miledermocosmesi.it) per la moderazione e verrà pubblicata a seguito della verifica.
                        </div>
                    {% endif %}
                    
                    {% if customer %}
                        {%- assign cust_first = customer.first_name | default: 'Cliente' -%}
                        {%- assign cust_initial = customer.last_name | slice: 0 | default: 'M' -%}
                        {%- assign cust_city = customer.default_address.city | default: 'Verona' -%}
                        <input type="hidden" name="contact[email]" value="{{ customer.email }}">
                        <input type="hidden" name="contact[name]" id="ReviewCustomerFormattedName" value="{{ cust_first }} {{ cust_initial }}. • {{ cust_city }}">
                        <div class="p-3 bg-linen border border-borderLinen text-xs flex items-center justify-between text-ink mb-3">
                            <span>✨ Recensione a nome di: <strong><span id="ReviewCustomerPreviewName">{{ cust_first }} {{ cust_initial }}.</span> &bull; <span id="ReviewCustomerPreviewCity">{{ cust_city }}</span></strong></span>
                            <span class="text-[10px] text-sage font-medium tracking-wider uppercase">&check; Membro Club Mile</span>
                        </div>
                        <div class="mb-4 max-w-xs">
                            <label for="ReviewCustomerCityInput" class="block text-[10px] uppercase tracking-wider text-ash mb-1">La Tua Citt&agrave; *</label>
                            <input type="text" id="ReviewCustomerCityInput" name="contact[city]" value="{{ cust_city }}" class="w-full border border-borderLinen bg-white px-3 py-2 text-xs focus:outline-none focus:border-ink" required>
                        </div>
                    {% else %}
                        <div id="ReviewUserGreetingBadge" class="hidden p-3 bg-linen border border-borderLinen text-xs items-center justify-between text-ink mb-2">
                            <span>✨ Recensione a nome di: <strong id="ReviewUserGreetingName"></strong></span>
                            <span class="text-[10px] text-sage font-medium tracking-wider uppercase">&check; Membro Club Mile</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label for="ReviewAuthorNameInput" class="block text-[10px] uppercase tracking-wider text-ash mb-1">Nome e Cognome / Iniziali *</label>
                                <input type="text" id="ReviewAuthorNameInput" name="contact[name]" placeholder="Es. Beatrice F." class="w-full border border-borderLinen bg-white px-3 py-2 text-xs focus:outline-none focus:border-ink" required>
                            </div>
                            <div>
                                <label for="ReviewAuthorEmailInput" class="block text-[10px] uppercase tracking-wider text-ash mb-1">Email *</label>
                                <input type="email" id="ReviewAuthorEmailInput" name="contact[email]" placeholder="tua@email.it" class="w-full border border-borderLinen bg-white px-3 py-2 text-xs focus:outline-none focus:border-ink" required>
                            </div>
                            <div>
                                <label for="ReviewAuthorCityInput" class="block text-[10px] uppercase tracking-wider text-ash mb-1">La Tua Citt&agrave; *</label>
                                <input type="text" id="ReviewAuthorCityInput" name="contact[city]" placeholder="Es. Verona" value="Verona" class="w-full border border-borderLinen bg-white px-3 py-2 text-xs focus:outline-none focus:border-ink" required>
                            </div>
                        </div>
                        <p class="text-[11px] text-ash mt-1">Sei già registrata al Beauty Club? <a href="/pages/accedi" onclick="if(window.openAccountDrawer){openAccountDrawer(); return false;}" class="underline text-ink hover:text-amber font-medium">Accedi qui</a> per collegare il tuo profilo.</p>
                    {% endif %}
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] uppercase tracking-wider text-ash mb-1">Titolo</label>
                            <input type="text" name="contact[title]" placeholder="Es. Risultati visibili fin da subito" class="w-full border border-borderLinen bg-white px-3 py-2 text-xs focus:outline-none focus:border-ink" required>
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-wider text-ash mb-1">Valutazione (1-5)</label>
                            <select name="contact[rating]" class="w-full border border-borderLinen bg-white px-3 py-2 text-xs focus:outline-none focus:border-ink" required>
                                <option value="5" selected>5 Stelle</option>
                                <option value="4">4 Stelle</option>
                                <option value="3">3 Stelle</option>
                                <option value="2">2 Stelle</option>
                                <option value="1">1 Stella</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase tracking-wider text-ash mb-1">Recensione</label>
                        <textarea name="contact[body]" rows="4" placeholder="Condividi le tue impressioni su texture, profumazione e benefici sulla pelle..." class="w-full border border-borderLinen bg-white px-3 py-2 text-xs focus:outline-none focus:border-ink" required></textarea>
                    </div>
                    <div class="text-center mt-6">
                        <button type="submit" class="bg-black text-white px-8 py-3 text-[10px] uppercase tracking-[0.2em] hover:bg-[#222222] transition-colors luxury-interactive">Invia Recensione</button>
                    </div>
                {% endform %}
            </div>
        </div>
        </div>
    </div>
</section>

<script>
(function() {
  function syncTopReviews() {
    var topReviewsText = document.getElementById('pdp-top-reviews-summary');
    if (topReviewsText) {
      var count = {{ total_reviews_val }};
      var score = "{{ overall_score_val }}";
      if (count > 0) {
        var countLabel = count === 1 ? '1 recensione' : count + ' recensioni';
        topReviewsText.innerHTML = score + '/5 &middot; ' + countLabel;
      } else {
        topReviewsText.innerHTML = 'Nessuna recensione';
      }
    }
  }
  syncTopReviews();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncTopReviews);
  }
})();

// Real-time Local Reviews & Form Submission Handler
(function() {
  var prodId = "{{ product.id }}";

  // Pre-populate user info from localStorage if client logged in via drawer
  function initReviewUserAuth() {
    {% if customer %}
      var custCityInput = document.getElementById('ReviewCustomerCityInput');
      var custPreviewCity = document.getElementById('ReviewCustomerPreviewCity');
      var custHiddenName = document.getElementById('ReviewCustomerFormattedName');
      if (custCityInput) {
        custCityInput.addEventListener('input', function() {
          var cVal = custCityInput.value.trim() || 'Verona';
          if (custPreviewCity) custPreviewCity.textContent = cVal;
          if (custHiddenName && typeof window.formatReviewAuthor === 'function') {
            custHiddenName.value = window.formatReviewAuthor("{{ customer.first_name | default: 'Cliente' }} {{ customer.last_name | slice: 0 | default: 'M' }}.", cVal);
          }
        });
      }
      return;
    {% else %}
      try {
        var raw = localStorage.getItem('mile_customer');
        if (!raw) return;
        var cust = JSON.parse(raw);
        if (!cust) return;

        var firstName = cust.first_name || '';
        var lastName = cust.last_name || '';
        var fullName = (firstName + ' ' + lastName).trim();
        if (!fullName && cust.name) fullName = cust.name.trim();
        var email = cust.email || '';
        var city = cust.city || (cust.default_address && cust.default_address.city) || 'Verona';

        var nameInput = document.getElementById('ReviewAuthorNameInput');
        var emailInput = document.getElementById('ReviewAuthorEmailInput');
        var cityInput = document.getElementById('ReviewAuthorCityInput');

        if (nameInput && !nameInput.value && fullName) {
          nameInput.value = fullName;
        }
        if (emailInput && !emailInput.value && email) {
          emailInput.value = email;
        }
        if (cityInput && (!cityInput.value || cityInput.value === 'Verona') && city) {
          cityInput.value = city;
        }

        var badge = document.getElementById('ReviewUserGreetingBadge');
        var greetingName = document.getElementById('ReviewUserGreetingName');
        if (badge && (fullName || email)) {
          if (greetingName) {
            var formattedPreview = typeof window.formatReviewAuthor === 'function'
              ? window.formatReviewAuthor(fullName || email, city)
              : (fullName || email);
            greetingName.textContent = formattedPreview;
          }
          badge.classList.remove('hidden');
          badge.classList.add('flex');
        }
      } catch (e) {
        console.warn('Could not read mile_customer for reviews:', e);
      }
    {% endif %}
  }

  initReviewUserAuth();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReviewUserAuth);
  }

  // Hook into auth state changes if account drawer is used
  var origRenderAuth = window.renderCustomerAuthState;
  window.renderCustomerAuthState = function() {
    if (typeof origRenderAuth === 'function') {
      try { origRenderAuth(); } catch(e) {}
    }
    initReviewUserAuth();
  };
  
  // Ensure formatReviewAuthor is available immediately
  window.formatReviewAuthor = window.formatReviewAuthor || function(rawName, city) {
    if (!rawName) return 'Cliente Verificata • ' + (city || 'Verona');
    var cityStr = city || 'Verona';
    if (rawName.indexOf('•') !== -1) return rawName;
    var clean = rawName.replace(/•/g, '').trim();
    var tokens = clean.split(/\s+/).filter(Boolean);
    if (tokens.length <= 1) {
      return clean + ' • ' + cityStr;
    }
    var firstPart = tokens.slice(0, -1).map(function(t) {
      return t.charAt(0).toUpperCase() + t.slice(1).toLowerCase();
    }).join(' ');
    var lastPart = tokens[tokens.length - 1].charAt(0).toUpperCase() + '.';
    return firstPart + ' ' + lastPart + ' • ' + cityStr;
  };

  var prodId = "{{ product.id }}";
  var prodHandle = "{{ product.handle }}";

  function getMergedUserReviews(id, handle) {
    var pId = id || prodId;
    var pHandle = handle || prodHandle;
    var list = [];
    var seen = {};

    function addKey(storageKey) {
      if (!storageKey) return;
      try {
        var raw = localStorage.getItem(storageKey);
        if (raw) {
          var arr = JSON.parse(raw);
          if (Array.isArray(arr)) {
            arr.forEach(function(item) {
              var dedupeKey = (item.title || '') + '|' + (item.body || '') + '|' + (item.author || '');
              if (!seen[dedupeKey]) {
                seen[dedupeKey] = true;
                list.push(item);
              }
            });
          }
        }
      } catch(e) {}
    }

    if (pId) addKey('mile_user_reviews_' + pId);
    if (pHandle && pHandle !== pId) addKey('mile_user_reviews_' + pHandle);

    return list;
  }

  function renderUserReviews(targetId, targetHandle) {
    var pId = targetId || prodId;
    var pHandle = targetHandle || prodHandle;
    var userReviews = getMergedUserReviews(pId, pHandle);

    var container = document.getElementById('reviews-grid-container');
    if (!container) return;

    // Clean up previous user-local-review-card elements to prevent duplicates
    var oldCards = container.querySelectorAll('.user-local-review-card');
    oldCards.forEach(function(c) { c.remove(); });

    var baseCount = {{ real_total }};
    var totalCountEl = document.getElementById('reviews-total-count-display');
    if (totalCountEl) {
      var rawBase = totalCountEl.getAttribute('data-base-count');
      if (rawBase !== null && rawBase !== '') {
        baseCount = parseInt(rawBase, 10) || 0;
      }
    }
    var finalTotal = baseCount + (userReviews ? userReviews.length : 0);

    // Toggle empty state visibility
    var emptyState = document.getElementById('reviews-empty-state');
    if (emptyState) {
      if (finalTotal > 0) {
        emptyState.classList.add('hidden');
      } else {
        emptyState.classList.remove('hidden');
      }
    }

    if (userReviews && userReviews.length > 0) {
      // Insert cards in reverse chronological order (newest first)
      userReviews.slice().reverse().forEach(function(rev) {
        var card = document.createElement('div');
        card.className = 'user-local-review-card bg-[#FAF8F5] p-6 border border-[#5C6B56]/50 flex flex-col justify-between transition-all duration-500 shadow-xs mb-4';

        var ratingNum = parseInt(rev.rating, 10) || 5;
        var starsHtml = '';
        for (var i = 1; i <= ratingNum; i++) starsHtml += '&starf;';
        for (var j = ratingNum + 1; j <= 5; j++) starsHtml += '<span class="text-[#7A7265]/40">&starf;</span>';

        function escapeHtml(str) {
          if (!str) return '';
          return String(str).replace(/[&<>"']/g, function(m) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m];
          });
        }

        var authorDisplay = escapeHtml(window.formatReviewAuthor(rev.author));

        card.innerHTML = `
          <div>
            <div class="flex flex-wrap justify-between items-center gap-2 mb-3">
              <div class="text-[#C8A878] text-xs tracking-wider">${starsHtml}</div>
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1 text-[9px] uppercase tracking-wider font-semibold text-white bg-[#5C6B56] px-2 py-0.5 rounded-xs">
                  &bull; La tua recensione &bull; In approvazione
                </span>
                <span class="text-[10px] text-[#7A7265]">${escapeHtml(rev.date)}</span>
              </div>
            </div>
            <h4 class="font-serif text-base font-semibold text-[#1A1A1A] mb-2">${escapeHtml(rev.title)}</h4>
            <p class="text-xs text-[#7A7265] leading-relaxed font-light">
              &ldquo;${escapeHtml(rev.body)}&rdquo;
            </p>
          </div>
          <div class="pt-4 mt-6 border-t border-[#E5E0D8] flex items-center justify-between text-xs">
            <span class="font-medium text-[#1A1A1A]">${authorDisplay}</span>
            <span class="text-[#5C6B56] text-[10px] font-semibold flex items-center gap-1">&check; Verifica Acquirente Club Mile</span>
          </div>
        `;

        container.insertBefore(card, container.firstChild);
      });
    }

    // Recalculate totals and average score
    if (totalCountEl) {
      totalCountEl.textContent = finalTotal === 0 ? 'Nessuna recensione ancora presente' : (finalTotal === 1 ? 'Basato su 1 recensione certificata da acquirente reale' : 'Basato su ' + finalTotal + ' recensioni certificate da acquirenti reali');
    }

    var scoreDisplayEl = document.getElementById('reviews-overall-score-display');
    var starsDisplayEl = document.getElementById('reviews-stars-display');
    var baseScore = parseFloat("{{ overall_score_val }}") || 0.0;
    if (scoreDisplayEl) {
      var rawBaseScore = scoreDisplayEl.getAttribute('data-base-score');
      if (rawBaseScore !== null && rawBaseScore !== '') {
        baseScore = parseFloat(rawBaseScore) || baseScore;
      }
    }

    var sumUserRatings = userReviews ? userReviews.reduce(function(acc, r) {
      return acc + (parseFloat(r.rating) || 5);
    }, 0) : 0;

    if (finalTotal > 0) {
      var newAvgScore = baseCount > 0 
        ? ((baseScore * baseCount + sumUserRatings) / finalTotal).toFixed(1)
        : (sumUserRatings / userReviews.length).toFixed(1);

      if (scoreDisplayEl) {
        scoreDisplayEl.className = 'font-serif text-6xl text-ink font-normal leading-none mb-3';
        scoreDisplayEl.textContent = newAvgScore;
      }
      if (starsDisplayEl) {
        starsDisplayEl.className = 'text-amber text-lg tracking-wider mb-2';
      }
    } else {
      if (scoreDisplayEl) {
        scoreDisplayEl.className = 'font-serif text-2xl sm:text-3xl text-ink font-normal leading-tight mb-3';
        scoreDisplayEl.textContent = 'Nessuna recensione ancora presente';
      }
      if (starsDisplayEl) {
        starsDisplayEl.className = 'text-ash/30 text-lg tracking-wider mb-2';
      }
    }

    var topReviewsText = document.getElementById('pdp-top-reviews-summary');
    if (topReviewsText) {
      if (finalTotal > 0) {
        var countLabel = finalTotal === 1 ? '1 recensione' : finalTotal + ' recensioni';
        topReviewsText.innerHTML = newAvgScore + '/5 &middot; ' + countLabel;
      } else {
        topReviewsText.innerHTML = 'Nessuna recensione';
      }
    }
  }

  window.renderUserReviews = renderUserReviews;

  var form = document.getElementById('ProductReviewForm');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      try {
        var titleInput = form.querySelector('[name="contact[title]"]');
        var ratingInput = form.querySelector('[name="contact[rating]"]');
        var bodyInput = form.querySelector('[name="contact[body]"]');

        var nameInput = document.getElementById('ReviewAuthorNameInput') || form.querySelector('[name="contact[name]"]');
        var emailInput = document.getElementById('ReviewAuthorEmailInput') || form.querySelector('[name="contact[email]"]');
        var cityInput = document.getElementById('ReviewCustomerCityInput') || document.getElementById('ReviewAuthorCityInput') || form.querySelector('[name="contact[city]"]');

        var rawAuthor = '';
        if (nameInput && nameInput.value && nameInput.value.trim()) {
          rawAuthor = nameInput.value.trim();
        }

        {% if customer %}
          if (!rawAuthor || rawAuthor.indexOf('•') === -1) {
            rawAuthor = "{{ customer.first_name | default: 'Cliente' }} {{ customer.last_name | slice: 0 | default: 'M' }}.";
          }
        {% endif %}

        if (!rawAuthor) {
          try {
            var localCust = JSON.parse(localStorage.getItem('mile_customer'));
            if (localCust) {
              var fName = localCust.first_name || '';
              var lName = localCust.last_name || '';
              rawAuthor = (fName + ' ' + lName).trim() || localCust.name || '';
            }
          } catch (e) {}
        }

        if (!rawAuthor) {
          rawAuthor = 'Cliente Verificata';
        }

        var cityVal = cityInput && cityInput.value ? cityInput.value.trim() : 'Verona';

        var formattedAuthor = window.formatReviewAuthor(rawAuthor, cityVal);

        if (nameInput) {
          nameInput.value = formattedAuthor;
        }
        
        var now = new Date();
        var months = ['Gennaio', 'Febbraio', 'Marzo', 'Aprile', 'Maggio', 'Giugno', 'Luglio', 'Agosto', 'Settembre', 'Ottobre', 'Novembre', 'Dicembre'];
        var dateFormatted = now.getDate() + ' ' + months[now.getMonth()] + ' ' + now.getFullYear();
        
        var newReview = {
          rating: ratingInput ? ratingInput.value : '5',
          title: titleInput && titleInput.value ? titleInput.value.trim() : 'Esperienza eccellente',
          body: bodyInput ? bodyInput.value.trim() : '',
          author: formattedAuthor,
          date: dateFormatted,
          timestamp: Date.now()
        };

        if (!newReview.body) {
          alert('Per favore inserisci il testo della tua recensione.');
          return;
        }

        function saveToStorage(key) {
          if (!key) return;
          var existing = [];
          try {
            var raw = localStorage.getItem(key);
            if (raw) existing = JSON.parse(raw);
          } catch (err) {}
          if (!Array.isArray(existing)) existing = [];
          var isDup = existing.some(function(r) {
            return r.title === newReview.title && r.body === newReview.body && r.author === newReview.author;
          });
          if (!isDup) {
            existing.push(newReview);
            localStorage.setItem(key, JSON.stringify(existing));
          }
        }

        if (prodId) saveToStorage('mile_user_reviews_' + prodId);
        if (prodHandle && prodHandle !== prodId) saveToStorage('mile_user_reviews_' + prodHandle);

        // Submit form asynchronously in background so Shopify receives contact form notification
        try {
          fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json, text/javascript, */*' }
          }).catch(function(err) {
            console.log('Background Shopify contact notification completed');
          });
        } catch (postErr) {}

        // Headless Judge.me Bridge Synchronization for 1-Click Moderation (Approva/Rifiuta)
        try {
          var jdgmBridge = document.getElementById('judgeme-headless-bridge');
          if (jdgmBridge) {
            var writeBtn = jdgmBridge.querySelector('.jdgm-write-rev-link, [data-action="write-review"], .jdgm-widget-actions-wrapper a');
            if (writeBtn) writeBtn.click();
            setTimeout(function() {
              var jName = jdgmBridge.querySelector('input[name="reviewer_name"], input[name="name"], .jdgm-form__reviewer-name-input');
              var jEmail = jdgmBridge.querySelector('input[name="reviewer_email"], input[name="email"], .jdgm-form__reviewer-email-input');
              var jTitle = jdgmBridge.querySelector('input[name="title"], .jdgm-form__title-input');
              var jBody = jdgmBridge.querySelector('textarea[name="body"], .jdgm-form__body-input');
              
              if (jName) jName.value = newReview.author;
              if (jEmail && emailInput && emailInput.value) jEmail.value = emailInput.value.trim();
              if (jTitle) jTitle.value = newReview.title;
              if (jBody) jBody.value = newReview.body;
              
              var targetRating = parseInt(newReview.rating, 10) || 5;
              var stars = jdgmBridge.querySelectorAll('.jdgm-form__rating .jdgm-star, .jdgm-write-rev-modal .jdgm-star');
              if (stars && stars.length >= targetRating) {
                var starEl = stars[targetRating - 1];
                if (starEl) starEl.click();
              }
              
              var jSubmit = jdgmBridge.querySelector('.jdgm-submit-rev, input[type="submit"], button[type="submit"]');
              if (jSubmit) {
                jSubmit.click();
                console.log('Recensione sincronizzata con Judge.me per moderazione Approva/Rifiuta');
              }
            }, 350);
          }
        } catch (jdgmErr) {
          console.log('Judge.me bridge notice:', jdgmErr);
        }

        // Show banner of success in-place
        var successMsg = document.getElementById('ReviewFormSuccessMessage');
        if (successMsg) {
          successMsg.classList.remove('hidden');
          successMsg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        // Reset inputs (preserve author name & city)
        if (titleInput) titleInput.value = '';
        if (bodyInput) bodyInput.value = '';

        // Immediately inject and render review card
        renderUserReviews(prodId, prodHandle);

        if (typeof window.showToast === 'function') {
          window.showToast('✨ Grazie per la tua recensione! È stata registrata.');
        }
      } catch (e) {
        console.warn('Could not save user review to localStorage:', e);
      }
    });
  }

  // Execution triggers:
  // 1. Immediately
  renderUserReviews(prodId, prodHandle);

  // 2. DOMContentLoaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      renderUserReviews(prodId, prodHandle);
    });
  } else {
    renderUserReviews(prodId, prodHandle);
  }

  // 3. Safety timeout at 300ms
  setTimeout(function() {
    renderUserReviews(prodId, prodHandle);
  }, 300);

  // 4. On Shopify theme section load event
  document.addEventListener('shopify:section:load', function() {
    renderUserReviews(prodId, prodHandle);
  });
})();

function showMoreReviews(btn) {
    var container = document.getElementById('reviews-grid-container');
    if (!container) return;
    var hiddenCards = container.querySelectorAll('.review-card-hidden');
    var batchSize = 6;
    
    for (var i = 0; i < hiddenCards.length && i < batchSize; i++) {
        var card = hiddenCards[i];
        card.classList.remove('hidden', 'review-card-hidden');
        card.classList.add('flex');
        (function(c) {
            requestAnimationFrame(function() {
                setTimeout(function() {
                    c.classList.remove('opacity-0', 'translate-y-2');
                    c.classList.add('opacity-100', 'translate-y-0');
                }, 30);
            });
        })(card);
    }
    
    var remaining = container.querySelectorAll('.review-card-hidden').length;
    var wrap = document.getElementById('show-more-reviews-wrap');
    if (remaining === 0) {
        if (wrap) {
            wrap.innerHTML = '<span class="text-xs text-ash uppercase tracking-widest font-light">Tutte le recensioni visualizzate</span>';
        }
    } else if (btn) {
        btn.textContent = 'Mostra Altre Recensioni (+' + Math.min(batchSize, remaining) + ')';
    }
}
</script>

