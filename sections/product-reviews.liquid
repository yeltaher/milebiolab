        <!-- Reviews Grid -->
        <div id="reviews-grid-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {%- if section.blocks.size > 0 -%}
                {%- for block in section.blocks -%}
                <div class="bg-linen p-6 border border-borderLinen flex flex-col justify-between transition-all duration-500 {% if forloop.index > 6 %}review-card-hidden hidden opacity-0 translate-y-2{% else %}flex{% endif %}" {{ block.shopify_attributes }}>
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <div class="text-amber text-xs tracking-wider">
                                {%- for i in (1..block.settings.rating) -%}&starf;{%- endfor -%}
                                {%- if block.settings.rating < 5 -%}
                                    {%- assign empty_stars = 5 | minus: block.settings.rating -%}
                                    {%- for i in (1..empty_stars) -%}<span class="text-ash/40">&starf;</span>{%- endfor -%}
                                {%- endif -%}
                            </div>
                            <span class="text-[10px] text-ash">{{ block.settings.date }}</span>
                        </div>
                        <h4 class="font-serif text-base font-semibold text-ink mb-2">{{ block.settings.title }}</h4>
                        <p class="text-xs text-ash leading-relaxed font-light">
                            &ldquo;{{ block.settings.text }}&rdquo;
                        </p>
                    </div>
                    <div class="pt-4 mt-6 border-t border-borderLinen flex items-center justify-between text-xs">
                        <span class="font-medium text-ink">{{ block.settings.author }}</span>
                        <span class="text-sage text-[10px] font-semibold flex items-center gap-1">&check; Acquisto Verificato</span>
                    </div>
                </div>
                {%- endfor -%}
            {%- else -%}
                {%- for item in reviews_items -%}
                    {%- assign parts = item | split: '|' -%}
                    {%- assign r_rating = parts[0] | strip | plus: 0 -%}
                    {%- assign r_date = parts[1] | strip -%}
                    {%- assign r_title = parts[2] | strip -%}
                    {%- assign r_text = parts[3] | strip -%}
                    {%- assign r_author = parts[4] | strip -%}
                    {%- assign r_city = parts[5] | strip -%}
