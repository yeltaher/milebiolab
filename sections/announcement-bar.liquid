{% if section.settings.show_announcement %}
<!-- MILE TOP ROTATING ANNOUNCEMENT BAR -->
<div class="announcement-carousel-bar" role="region" aria-label="Annunci del negozio">
  {% if section.settings.show_arrows != false %}
    <button type="button" class="announcement-arrow-btn" onclick="prevAnnouncement()" aria-label="Messaggio precedente">&#8249;</button>
  {% endif %}
  
  <div class="announcement-carousel-inner" id="announcement-carousel-container">
    <div class="announcement-slide active">
      <span class="magnetic-glow-pulse-badge">{{ section.settings.badge_1 | default: "PROMOZIONE" }}</span>
      <span>{{ section.settings.message_1 }}</span>
    </div>
    <div class="announcement-slide">
      <span class="magnetic-glow-pulse-badge">{{ section.settings.badge_2 | default: "FLAGSHIP VERONA" }}</span>
      <span>{{ section.settings.message_2 }}</span>
    </div>
    <div class="announcement-slide">
      <span class="magnetic-glow-pulse-badge">{{ section.settings.badge_3 | default: "CERTIFICAZIONE" }}</span>
      <span>{{ section.settings.message_3 }}</span>
    </div>
  </div>

  {% if section.settings.show_arrows != false %}
    <button type="button" class="announcement-arrow-btn" onclick="nextAnnouncement()" aria-label="Messaggio successivo">&#8250;</button>
  {% endif %}
</div>

<!-- MILE UTILITY SUPPORT BAR -->
<div class="splendor-utility-bar">
  <div class="splendor-utility-inner">
    <div class="utility-info-group">
      <span class="utility-item">
        <span>📍</span>
        <span>Istituto Verona: <strong>{{ section.settings.boutique_address }}</strong></span>
      </span>
      <span class="utility-item">
        <span>🕒</span>
        <span>{{ section.settings.boutique_hours }}</span>
      </span>
      <span class="utility-item">
        <span>📞</span>
        <a href="tel:{{ section.settings.boutique_phone | replace: ' ', '' }}"><strong>{{ section.settings.boutique_phone }}</strong></a>
      </span>
    </div>

    <div class="utility-actions-group">
      <a href="#istituto-verona" onclick="if(window.openVeronaModal) openVeronaModal();" style="color: var(--color-accent-olive); font-weight: 600;">{{ section.settings.action_text | default: "Prenota Trattamento Cabina &rarr;" }}</a>
      <div class="currency-lang-switcher">
        <span>🌐 EUR (€) / IT</span>
      </div>
    </div>
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "header",
      "content": "Configurazione Generale"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Mostra Barra Annunci a Carosello",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostra frecce di scorrimento annunci",
      "default": true
    },
    {
      "type": "header",
      "content": "Annuncio 1"
    },
    {
      "type": "text",
      "id": "badge_1",
      "label": "Badge Annuncio 1",
      "default": "PROMOZIONE"
    },
    {
      "type": "text",
      "id": "message_1",
      "label": "Messaggio 1",
      "default": "✦ SPEDIZIONE GRATUITA DA €60 IN TUTTA ITALIA • 3 CAMPIONCINI OMAGGIO CON OGNI ORDINE"
    },
    {
      "type": "header",
      "content": "Annuncio 2"
    },
    {
      "type": "text",
      "id": "badge_2",
      "label": "Badge Annuncio 2",
      "default": "FLAGSHIP VERONA"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Messaggio 2",
      "default": "📍 RITIRO GRATUITO ALL'ISTITUTO DI VERONA IN 2 ORE CON CHECK-UP PELLE VISIA"
    },
    {
      "type": "header",
      "content": "Annuncio 3"
    },
    {
      "type": "text",
      "id": "badge_3",
      "label": "Badge Annuncio 3",
      "default": "CERTIFICAZIONE"
    },
    {
      "type": "text",
      "id": "message_3",
      "label": "Messaggio 3",
      "default": "🌿 100% ALTA COSMECEUTICA BOTANICA BIOCERTIFICATA TEAM DR JOSEPH & BIOTECNOLOGIA ALPINA"
    },
    {
      "type": "header",
      "content": "Barra Servizi & Concierge"
    },
    {
      "type": "text",
      "id": "boutique_address",
      "label": "Indirizzo Flagship",
      "default": "Corso Cavour 18, 37121 Verona"
    },
    {
      "type": "text",
      "id": "boutique_hours",
      "label": "Orari Real-Time",
      "default": "Aperto oggi 09:30 - 19:30"
    },
    {
      "type": "text",
      "id": "boutique_phone",
      "label": "Telefono",
      "default": "+39 045 800 1234"
    },
    {
      "type": "text",
      "id": "action_text",
      "label": "Testo Link Prenotazione",
      "default": "Prenota Trattamento Cabina →"
    }
  ]
}
{% endschema %}
