  <script>
    (function() {
      function slideFeatured(sectionId, direction) {
        var slider = document.getElementById('featured-slider-' + sectionId);
        if (!slider) return;
        var card = slider.querySelector('[data-product-id]');
        var cardWidth = card ? card.offsetWidth : 320;
        var scrollAmount = cardWidth + 24; // card width + gap-6 (24px)
        
        if (direction === 1) {
          // Se lo slider è già alla fine o vicino alla fine, torna fluidamente all'inizio (loop continuo)
          if (slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 16) {
            slider.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
          }
        } else if (direction === -1) {
          // Se lo slider è all'inizio, scorre fluidamente alla fine (loop continuo)
          if (slider.scrollLeft <= 16) {
            slider.scrollTo({ left: slider.scrollWidth, behavior: 'smooth' });
          } else {
            slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
          }
        }
      }
      window.slideFeaturedProducts = slideFeatured;

      // Le frecce rimangono SEMPRE attive e cliccabili per consentire navigazione continua ad anello
      function initFeaturedArrows(sectionId) {
        var slider = document.getElementById('featured-slider-' + sectionId);
        if (!slider) return;

        var prevBtn = document.getElementById('featured-prev-' + sectionId);
        var nextBtn = document.getElementById('featured-next-' + sectionId);
        var colPrevBtn = document.getElementById('featured-col-prev-' + sectionId);
        var colNextBtn = document.getElementById('featured-col-next-' + sectionId);

        if (prevBtn) prevBtn.disabled = false;
        if (nextBtn) nextBtn.disabled = false;
        if (colPrevBtn) colPrevBtn.disabled = false;
        if (colNextBtn) colNextBtn.disabled = false;
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          initFeaturedArrows('{{ section.id }}');
        });
      } else {
        initFeaturedArrows('{{ section.id }}');
      }

      document.addEventListener('shopify:section:load', function(e) {
        if (e.target && e.target.querySelector('#featured-slider-{{ section.id }}')) {
          initFeaturedArrows('{{ section.id }}');
        }
      });
    })();
  </script>
</section>

