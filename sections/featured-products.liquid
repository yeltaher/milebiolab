<section class="py-24 px-6 lg:px-16 bg-[#F5F2EB] border-b border-[#DDD7CE]/50 featured-products-section" id="featured-products-{{ section.id }}">
  {%- liquid
    assign show_arrows = true
    if section.settings.show_arrows == false
      assign show_arrows = false
    endif
    assign show_slider_arrows = true
    if section.settings.show_slider_arrows == false
      assign show_slider_arrows = false
    endif
    assign show_column_arrows = true
    if section.settings.show_column_arrows == false
      assign show_column_arrows = false
    endif
  -%}
  <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-12 lg:gap-16">

    <!-- Sticky Left Column -->
    <div class="w-full lg:w-1/3 lg:sticky lg:top-36 h-max">
      {% if section.settings.tag != blank %}
      <span class="text-xs uppercase tracking-[0.25em] text-[#5C6B56] font-medium block mb-2">{{ section.settings.tag }}</span>
      {% endif %}
      <h2 class="font-serif text-4xl lg:text-5xl text-[#1A1A1A] mb-4 leading-tight">{{ section.settings.title }}</h2>
      <p class="text-[#7A7265] text-sm leading-relaxed mb-8 font-light">
        {{ section.settings.subtitle }}
      </p>
      {% if section.settings.link_text != blank %}
      <a href="{{ section.settings.link_url | default: '/collections/all' }}" class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-[#1A1A1A] border-b-2 border-[#1A1A1A] pb-1.5 hover:text-[#C8A878] hover:border-[#C8A878] transition-colors">
        <span>{{ section.settings.link_text }}</span>
        <span>→</span>
      </a>
      {% endif %}

      {% if show_arrows and show_column_arrows %}
      <!-- Slider Navigation Controls (Left Sticky Column) -->
      <div class="flex items-center gap-3 mt-8 pt-4 border-t border-[#DDD7CE]/50">
        <button
          type="button"
          onclick="slideFeaturedProducts('{{ section.id }}', -1)"
          id="featured-col-prev-{{ section.id }}"
          aria-label="Prodotti precedenti"
          class="w-11 h-11 rounded-full border-2 border-[#1A1A1A] bg-white text-[#1A1A1A] hover:bg-[#5C6B56] hover:text-white hover:border-[#5C6B56] transition-all duration-300 flex items-center justify-center shadow-md cursor-pointer active:scale-95 group"
        >
          <svg class="w-5 h-5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          type="button"
          onclick="slideFeaturedProducts('{{ section.id }}', 1)"
          id="featured-col-next-{{ section.id }}"
          aria-label="Prodotti successivi"
          class="w-11 h-11 rounded-full border-2 border-[#1A1A1A] bg-white text-[#1A1A1A] hover:bg-[#5C6B56] hover:text-white hover:border-[#5C6B56] transition-all duration-300 flex items-center justify-center shadow-md cursor-pointer active:scale-95 group"
        >
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
        <span class="text-xs uppercase tracking-widest text-[#7A7265] font-semibold">Scorri Bestseller</span>
      </div>
      {% endif %}
    </div>

    <!-- Products Slider / Grid -->
    <div class="w-full lg:w-2/3 relative group/slider">
      {% if show_arrows %}
      <!-- Controlli Superiori / Header Slider Haute Couture (Sempre Visibili su Mobile & Desktop) -->
      <div class="flex items-center justify-between pb-4 mb-3 border-b border-[#DDD7CE]/50">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-[#5C6B56]"></span>
          <span class="text-xs uppercase tracking-widest text-[#7A7265] font-semibold">Scorri Bestseller (← / →)</span>
        </div>
        <div class="flex items-center gap-3">
          <button
            type="button"
            onclick="slideFeaturedProducts('{{ section.id }}', -1)"
            aria-label="Scorri bestseller precedenti"
            class="w-11 h-11 rounded-full border-2 border-[#1A1A1A] bg-white text-[#1A1A1A] hover:bg-[#5C6B56] hover:text-white hover:border-[#5C6B56] transition-all duration-300 flex items-center justify-center shadow-lg cursor-pointer group active:scale-95"
          >
            <svg class="w-5 h-5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            type="button"
            onclick="slideFeaturedProducts('{{ section.id }}', 1)"
            aria-label="Scorri bestseller successivi"
            class="w-11 h-11 rounded-full border-2 border-[#1A1A1A] bg-white text-[#1A1A1A] hover:bg-[#5C6B56] hover:text-white hover:border-[#5C6B56] transition-all duration-300 flex items-center justify-center shadow-lg cursor-pointer group active:scale-95"
          >
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
      {% endif %}

      {% if show_arrows and show_slider_arrows %}
      <!-- Freccia Sinistra Floating Inset (Prev) -->
      <button
        type="button"
        id="featured-prev-{{ section.id }}"
        onclick="slideFeaturedProducts('{{ section.id }}', -1)"
        aria-label="Scorri prodotti precedenti"
        class="flex absolute left-1 sm:left-2 top-1/2 -translate-y-1/2 z-30 w-12 h-12 rounded-full bg-white border-2 border-[#1A1A1A] text-[#1A1A1A] shadow-xl items-center justify-center transition-all duration-300 cursor-pointer hover:bg-[#5C6B56] hover:text-white hover:border-[#5C6B56] hover:scale-105 active:scale-95 group"
      >
        <svg class="w-5 h-5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Freccia Destra Floating Inset (Next) -->
      <button
        type="button"
        id="featured-next-{{ section.id }}"
        onclick="slideFeaturedProducts('{{ section.id }}', 1)"
        aria-label="Scorri prodotti successivi"
        class="flex absolute right-1 sm:right-2 top-1/2 -translate-y-1/2 z-30 w-12 h-12 rounded-full bg-white border-2 border-[#1A1A1A] text-[#1A1A1A] shadow-xl items-center justify-center transition-all duration-300 cursor-pointer hover:bg-[#5C6B56] hover:text-white hover:border-[#5C6B56] hover:scale-105 active:scale-95 group"
      >
        <svg class="w-5 h-5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
      {% endif %}

      {%- liquid
        assign aspect_ratio_class = 'aspect-[4/5]'
        if section.settings.card_aspect_ratio == '1/1'
          assign aspect_ratio_class = 'aspect-square'
        elsif section.settings.card_aspect_ratio == '3/4'
          assign aspect_ratio_class = 'aspect-[3/4]'
        endif

        assign image_fit_class = 'object-contain'
        assign image_padding_class = 'p-2'
        if section.settings.image_fit == 'cover'
          assign image_fit_class = 'object-cover'
          assign image_padding_class = ''
        endif
      -%}

      <div id="featured-slider-{{ section.id }}" class="flex gap-6 overflow-x-auto slider-no-scrollbar scroll-smooth pb-6 pt-1">

        {% assign feat_collection = collections[section.settings.collection] %}
        {% if feat_collection != blank and feat_collection.products.size > 0 %}
          {% assign feat_products_limit = section.settings.products_to_show | default: 8 %}
          {% for product in feat_collection.products limit: feat_products_limit %}
            {%- assign card_variant_id = product.selected_or_first_available_variant.id | default: product.first_available_variant.id | default: product.variants.first.id | default: product.id -%}
            <div class="min-w-[300px] w-[300px] sm:min-w-[320px] sm:w-[320px] flex-shrink-0 group bg-white p-4 sm:p-5 border border-[#E5E0D8] hover:border-[#C8A878]/60 hover:shadow-xl transition-all duration-300 flex flex-col justify-between relative" data-product-id="{{ product.id }}">
              <div>
                <div class="relative mb-4">
                  <a href="{{ product.url }}" class="block relative {{ aspect_ratio_class }} overflow-hidden bg-[#FAF8F5] border border-[#E5E0D8]/40">
                    <img src="{{ product.featured_image | image_url: width: 800 }}"
                         onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
                         class="w-full h-full {{ image_fit_class }} {{ image_padding_class }} transition-transform duration-700 group-hover:scale-105"
                         alt="{{ product.title | escape }}"
                         loading="lazy">
                  </a>
                  <div class="absolute inset-x-0 bottom-0 p-3 bg-gradient-to-t from-black/50 via-black/20 to-transparent opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-all duration-300 transform translate-y-0 flex justify-center z-10 pointer-events-auto">
                    <button type="button"
                            onclick="quickAddProduct(this, event)"
                            data-variant-id="{{ card_variant_id }}"
                            data-product-title="{{ product.title | escape }}"
                            data-product-price="{{ product.price | divided_by: 100.0 | default: 75.00 }}"
                            data-product-volume="{{ product.variants.first.title | escape | default: '50 ml' }}"
                            data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 400 }}{% endif %}"
                            class="text-[10px] uppercase tracking-[0.15em] bg-white text-[#1A1A1A] px-4 py-2.5 font-semibold hover:bg-[#C8A878] hover:text-white transition-all duration-300 w-full text-center shadow-md cursor-pointer">
                      {{ section.settings.quick_add_text | default: "Acquisto Rapido" }}
                    </button>
                  </div>
                  <button type="button"
                    onclick="toggleWishlistBtn(this, event)"
                    data-wishlist-id="{{ product.id }}"
                    data-product-title="{{ product.title | escape }}"
                    data-product-price="{{ product.price | divided_by: 100.0 }}"
                    data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 300 }}{% endif %}"
                    data-product-volume="{{ product.variants.first.title | escape | default: '50 ml' }}"
                    class="card-wishlist-btn absolute top-2 right-2 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm border border-[#E5E0D8] flex items-center justify-center text-[#1A1A1A] hover:text-red-600 hover:scale-110 transition-all z-20 cursor-pointer shadow-xs"
                    aria-label="Salva nei preferiti">
                    <svg class="w-4 h-4 wishlist-card-svg transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                  </button>
                </div>
                <div class="flex justify-between items-start mb-1 gap-2">
                  <h3 class="font-serif text-lg text-[#1A1A1A] font-medium leading-snug">
                    <a href="{{ product.url }}" class="hover:text-[#C8A878] transition-colors line-clamp-2">{{ product.title }}</a>
                  </h3>
                  <span class="text-sm font-semibold text-[#1A1A1A] whitespace-nowrap">{{ product.price | money }}</span>
                </div>
                {%- if product.type != blank and product.type != 'Trattamento Biomimetico' -%}
                  <p class="text-xs text-[#7A7265] mb-2 italic">{{ product.type }}</p>
                {%- endif -%}
                {%- assign p_title_lower = product.title | downcase -%}
                {%- assign p_handle_lower = product.handle | downcase -%}
                <div class="flex items-center gap-1.5 text-xs text-[#C8A878] mb-2">
                  <span>★★★★★</span>
                  {%- if p_title_lower contains 'unicho' or p_handle_lower contains 'unicho' or p_title_lower contains 'burro primordiale' -%}
                    <span class="text-[#7A7265] font-sans text-[11px]">(4.9/5 &bull; 28 recensioni)</span>
                  {%- else -%}
                    <span class="text-[#7A7265] font-sans text-[11px]">(4.9/5 &bull; 14 recensioni)</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <!-- Product 1: Olio Corpo Botanico Elisir Dorato -->
          <div class="min-w-[300px] w-[300px] sm:min-w-[320px] sm:w-[320px] flex-shrink-0 group bg-white p-4 sm:p-5 border border-[#E5E0D8] hover:border-[#C8A878]/60 hover:shadow-xl transition-all duration-300 flex flex-col justify-between relative" data-product-id="feat-fallback-1">
            <div>
              <div class="relative mb-4">
                <a href="/products/golden-glow-body-oil" class="block relative {{ aspect_ratio_class }} overflow-hidden bg-[#FAF8F5] border border-[#E5E0D8]/40">
                  <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=1200&q=80"
                       onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
                       class="w-full h-full {{ image_fit_class }} {{ image_padding_class }} transition-transform duration-700 group-hover:scale-105"
                       alt="Olio Corpo Botanico Elisir Dorato"
                       loading="lazy">
                </a>
                <div class="absolute inset-x-0 bottom-0 p-3 bg-gradient-to-t from-black/50 via-black/20 to-transparent opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-all duration-300 transform translate-y-0 flex justify-center z-10 pointer-events-auto">
                  <button type="button"
                          onclick="quickAddProduct(this, event)"
                          data-variant-id="1"
                          data-product-title="Olio Corpo Botanico Elisir Dorato"
                          data-product-price="76.00"
                          data-product-volume="100 ml"
                          data-product-image="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=400&q=80"
                          class="text-[10px] uppercase tracking-[0.15em] bg-white text-[#1A1A1A] px-4 py-2.5 font-semibold hover:bg-[#C8A878] hover:text-white transition-all duration-300 w-full text-center shadow-md cursor-pointer">
                    {{ section.settings.quick_add_text | default: "Acquisto Rapido" }}
                  </button>
                </div>
                <button type="button"
                  onclick="toggleWishlistBtn(this, event)"
                  data-wishlist-id="feat-fallback-1"
                  data-product-title="Olio Corpo Botanico Elisir Dorato"
                  data-product-price="76.00"
                  data-product-volume="100 ml"
                  data-product-image="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=400&q=80"
                  class="card-wishlist-btn absolute top-2 right-2 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm border border-[#E5E0D8] flex items-center justify-center text-[#1A1A1A] hover:text-red-600 hover:scale-110 transition-all z-20 cursor-pointer shadow-xs"
                  aria-label="Salva nei preferiti">
                  <svg class="w-4 h-4 wishlist-card-svg transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                </button>
              </div>
              <div class="flex justify-between items-start mb-1 gap-2">
                <h3 class="font-serif text-lg text-[#1A1A1A] font-medium leading-snug">
                  <a href="/products/golden-glow-body-oil" class="hover:text-[#C8A878] transition-colors">Olio Corpo Botanico Elisir Dorato</a>
                </h3>
                <span class="text-sm font-semibold text-[#1A1A1A] whitespace-nowrap">€ 76,00</span>
              </div>
              <p class="text-xs text-[#7A7265] mb-2 italic">Balsamo-olio trasformante con fito-lipidi rigeneranti</p>
              <div class="flex items-center gap-1.5 text-xs text-[#C8A878] mb-3">
                <span>★★★★★</span>
                <span class="text-[#7A7265] font-sans text-[11px]">(4.9/5 &bull; 14 recensioni)</span>
              </div>
            </div>
            <div class="flex items-center justify-between pt-2.5 border-t border-[#F5F2EB]">
              <span class="text-[10px] text-[#5C6B56] font-medium uppercase tracking-wider">100 ml / Botanico</span>
              <div class="w-3.5 h-3.5 rounded-full bg-[#C8A878] border border-[#DDD7CE]" title="Oro Ambrato"></div>
            </div>
          </div>

          <!-- Product 2: Crema Rigenerante -->
          <div class="min-w-[300px] w-[300px] sm:min-w-[320px] sm:w-[320px] flex-shrink-0 group bg-white p-4 sm:p-5 border border-[#E5E0D8] hover:border-[#C8A878]/60 hover:shadow-xl transition-all duration-300 flex flex-col justify-between relative" data-product-id="feat-fallback-2">
            <div>
              <div class="relative mb-4">
                <a href="/products/golden-glow-body-oil" class="block relative {{ aspect_ratio_class }} overflow-hidden bg-[#FAF8F5] border border-[#E5E0D8]/40">
                  <img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?auto=format&fit=crop&w=1200&q=80"
                       onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
                       class="w-full h-full {{ image_fit_class }} {{ image_padding_class }} transition-transform duration-700 group-hover:scale-105"
                       alt="Crema Rigenerante Cellulare"
                       loading="lazy">
                </a>
                <div class="absolute inset-x-0 bottom-0 p-3 bg-gradient-to-t from-black/50 via-black/20 to-transparent opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-all duration-300 transform translate-y-0 flex justify-center z-10 pointer-events-auto">
                  <button type="button"
                          onclick="quickAddProduct(this, event)"
                          data-variant-id="2"
                          data-product-title="Crema Rigenerante Supreme"
                          data-product-price="84.00"
                          data-product-volume="50 ml"
                          data-product-image="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?auto=format&fit=crop&w=400&q=80"
                          class="text-[10px] uppercase tracking-[0.15em] bg-white text-[#1A1A1A] px-4 py-2.5 font-semibold hover:bg-[#C8A878] hover:text-white transition-all duration-300 w-full text-center shadow-md cursor-pointer">
                    {{ section.settings.quick_add_text | default: "Acquisto Rapido" }}
                  </button>
                </div>
                <button type="button"
                  onclick="toggleWishlistBtn(this, event)"
                  data-wishlist-id="feat-fallback-2"
                  data-product-title="Crema Rigenerante Supreme"
                  data-product-price="84.00"
                  data-product-volume="50 ml"
                  data-product-image="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?auto=format&fit=crop&w=400&q=80"
                  class="card-wishlist-btn absolute top-2 right-2 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm border border-[#E5E0D8] flex items-center justify-center text-[#1A1A1A] hover:text-red-600 hover:scale-110 transition-all z-20 cursor-pointer shadow-xs"
                  aria-label="Salva nei preferiti">
                  <svg class="w-4 h-4 wishlist-card-svg transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                </button>
              </div>
              <div class="flex justify-between items-start mb-1 gap-2">
                <h3 class="font-serif text-lg text-[#1A1A1A] font-medium leading-snug">
                  <a href="/products/golden-glow-body-oil" class="hover:text-[#C8A878] transition-colors">Crema Rigenerante</a>
                </h3>
                <span class="text-sm font-semibold text-[#1A1A1A] whitespace-nowrap">€ 84,00</span>
              </div>
              <p class="text-xs text-[#7A7265] mb-2 italic">Emulsione idratante rigenerante</p>
              <div class="flex items-center gap-1.5 text-xs text-[#C8A878] mb-3">
                <span>★★★★★</span>
                <span class="text-[#7A7265] font-sans text-[11px]">(4.9/5 &bull; 14 recensioni)</span>
              </div>
            </div>
            <div class="flex items-center justify-between pt-2.5 border-t border-[#F5F2EB]">
              <span class="text-[10px] text-[#5C6B56] font-medium uppercase tracking-wider">50 ml / Rigenerante</span>
              <div class="w-3.5 h-3.5 rounded-full bg-[#F3EDE4] border border-[#DDD7CE]" title="Crema Seta"></div>
            </div>
          </div>

          <!-- Product 3: Siero Botanico Notte -->
          <div class="min-w-[300px] w-[300px] sm:min-w-[320px] sm:w-[320px] flex-shrink-0 group bg-white p-4 sm:p-5 border border-[#E5E0D8] hover:border-[#C8A878]/60 hover:shadow-xl transition-all duration-300 flex flex-col justify-between relative" data-product-id="feat-fallback-3">
            <div>
              <div class="relative mb-4">
                <a href="/products/golden-glow-body-oil" class="block relative {{ aspect_ratio_class }} overflow-hidden bg-[#FAF8F5] border border-[#E5E0D8]/40">
                  <img src="https://images.unsplash.com/photo-1617897903246-719242758050?auto=format&fit=crop&w=1200&q=80"
                       onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
                       class="w-full h-full {{ image_fit_class }} {{ image_padding_class }} transition-transform duration-700 group-hover:scale-105"
                       alt="Siero Botanico Notte"
                       loading="lazy">
                </a>
                <div class="absolute inset-x-0 bottom-0 p-3 bg-gradient-to-t from-black/50 via-black/20 to-transparent opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-all duration-300 transform translate-y-0 flex justify-center z-10 pointer-events-auto">
                  <button type="button"
                          onclick="quickAddProduct(this, event)"
                          data-variant-id="3"
                          data-product-title="Siero Botanico Notte"
                          data-product-price="110.00"
                          data-product-volume="30 ml"
                          data-product-image="https://images.unsplash.com/photo-1617897903246-719242758050?auto=format&fit=crop&w=400&q=80"
