<div class="py-24 bg-linen border-b border-borderLinen">
    <div class="max-w-5xl mx-auto px-6 grid grid-cols-1 md:grid-cols-12 gap-10 items-center">

        <div class="md:col-span-5">
            <div class="aspect-[4/5] bg-white border border-borderLinen shadow-xl overflow-hidden">
                {%- if section.settings.founder_image != blank -%}
                    {%- assign founder_img_url = section.settings.founder_image | img_url: '1000x' -%}
                {%- else -%}
                    {%- assign founder_img_url = 'milena-tacchella.jpg' | asset_url -%}
                {%- endif -%}
                <img src="{{ founder_img_url }}"
                     onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=80'"
                     alt="{{ section.settings.founder_name | default: 'Milena Tacchella' | escape }} - {{ section.settings.founder_role | default: 'Fondatrice & Dermo-Specialista • Mile Dermocosmesi Verona' | escape }}"
                     class="w-full h-full object-cover object-[center_20%]">
            </div>
        </div>

        <div class="md:col-span-7 space-y-4">
            {%- assign founder_tag = section.settings.founder_tag | default: 'FILOSOFIA MILE' -%}
            {%- if founder_tag != blank -%}
                <span class="text-xs uppercase tracking-[0.25em] text-sage font-semibold block">{{ founder_tag }}</span>
            {%- endif -%}
            {%- assign founder_quote = section.settings.founder_quote | default: "Scegliere la Natura come alleata è un gesto d'amore verso se stessi" -%}
            {%- if founder_quote != blank -%}
                <blockquote class="font-serif italic text-2xl sm:text-3xl text-ink leading-snug">
                    &ldquo;{{ founder_quote }}&rdquo;
                </blockquote>
            {%- endif -%}
            {%- assign founder_text = section.settings.founder_text | default: "Eliminare il superfluo per affidarvi alla Natura, nostra migliora alleata, da tempi immemori. Niente ingredienti inutili, solo formule pulite e delicate che capiscono i bisogni della tua pelle e la coccolano esattamente come merita. Semplice, Vera, Vicina a Te." -%}
            {%- if founder_text != blank -%}
                <p class="text-xs text-ash leading-relaxed font-light">
                    {{ founder_text }}
                </p>
            {%- endif -%}
            {%- assign founder_name = section.settings.founder_name | default: 'Milena Tacchella' -%}
            {%- assign founder_role = section.settings.founder_role | default: 'Fondatrice & Dermo-Specialista • Mile Dermocosmesi Verona' -%}
            {%- if founder_name != blank or founder_role != blank -%}
                <div class="pt-2">
                    {%- if founder_name != blank -%}
                        <span class="font-serif text-lg font-semibold text-ink block">{{ founder_name }}</span>
                    {%- endif -%}
                    {%- if founder_role != blank -%}
                        <span class="text-[10px] uppercase tracking-widest text-ash">{{ founder_role }}</span>
                    {%- endif -%}
                </div>
            {%- endif -%} 
        </div>

    </div>
</div>

{% schema %}
{
  "name": "Filosofia Fondatrice",
  "tag": "section",
  "class": "section-product-founder",
  "settings": [
    {
      "type": "image_picker",
      "id": "founder_image",
      "label": "Foto Fondatrice"
    },
    {
      "type": "text",
      "id": "founder_tag",
      "label": "Tag Superiore",
      "default": "FILOSOFIA MILE"
    },
    {
      "type": "textarea",
      "id": "founder_quote",
      "label": "Citazione Ispiratrice",
      "default": "Scegliere la Natura come alleata è un gesto d'amore verso se stessi"
    },
    {
      "type": "textarea",
      "id": "founder_text",
      "label": "Testo Descrittivo",
      "default": "Eliminare il superfluo per affidarvi alla Natura, nostra migliora alleata, da tempi immemori. Niente ingredienti inutili, solo formule pulite e delicate che capiscono i bisogni della tua pelle e la coccolano esattamente come merita. Semplice, Vera, Vicina a Te."
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Nome Fondatrice",
      "default": "Milena Tacchella"
    },
    {
      "type": "text",
      "id": "founder_role",
      "label": "Ruolo / Titolo",
      "default": "Fondatrice & Dermo-Specialista • Mile Dermocosmesi Verona"
    }
  ],
  "presets": [
    {
      "name": "Filosofia Fondatrice"
    }
  ]
}
{% endschema %}
