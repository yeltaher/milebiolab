  "name": "FAQ Prodotto",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "CHIAREZZA E TRASPARENZA"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo",
      "default": "Domande Frequenti"
