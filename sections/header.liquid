<!-- Top Announcement Bar -->
<div class="bg-[#1A1A1A] text-white text-center py-2.5 px-4 text-xs tracking-wider uppercase flex items-center justify-center gap-2">
  <span>{{ section.settings.announcement_text }}</span>
  <span class="opacity-40">•</span>
  <a href="/collections/all" class="underline underline-offset-4 hover:text-[#C8A878] transition-colors font-medium">Acquista Ora</a>
</div>

<!-- Services Bar -->
<div class="hidden md:flex justify-between items-center px-8 lg:px-16 py-2 border-b border-[#E5E0D8] text-xs tracking-widest uppercase text-[#7A7265] bg-white/70 backdrop-blur-sm">
  <div class="flex gap-6 items-center">
    <a href="/pages/traccia-ordine" class="hover:text-[#1A1A1A] transition-colors flex items-center gap-1.5">
      <span class="text-[#5C6B56]">●</span> Traccia ordine
    </a>
    <span class="text-[#DDD7CE]">|</span>
    <a href="/pages/community" class="hover:text-[#1A1A1A] transition-colors">Community</a>
    <span class="text-[#DDD7CE]">|</span>
    <span class="text-[#1A1A1A] font-medium flex items-center gap-1 cursor-pointer" onclick="if(window.openVeronaModal) openVeronaModal();">
      <svg class="w-3.5 h-3.5 text-[#5C6B56]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
      Ritiro in sede Verona — Corso Cavour 18 (Pronto in 2h)
    </span>
  </div>
  <div class="flex gap-6 items-center">
    <button type="button" onclick="if(window.openWishlistDrawer) openWishlistDrawer();" class="hover:text-[#1A1A1A] transition-colors bg-transparent border-0 cursor-pointer text-xs uppercase tracking-widest text-[#7A7265]">Lista Desideri</button>
    <span class="text-[#DDD7CE]">|</span>
    <a href="/account" class="hover:text-[#1A1A1A] transition-colors">Accedi</a>
    <span class="text-[#DDD7CE]">|</span>
    <button type="button" onclick="if(window.openCartDrawer) openCartDrawer();" class="hover:text-[#1A1A1A] font-semibold flex items-center gap-1.5 text-[#1A1A1A] bg-transparent border-0 cursor-pointer text-xs tracking-widest uppercase relative">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
      <span>Carrello</span>
      <span class="cart-count-badge bg-[#1A1A1A] text-white text-[9px] w-[18px] h-[18px] rounded-full flex items-center justify-center -ml-0.5 mt-[-1px]">{{ cart.item_count }}</span>
    </button>
  </div>
</div>

<!-- Header Sticky with 5-Column Mega Menu -->
<header class="sticky top-0 z-50 bg-[#F5F2EB]/95 backdrop-blur-md border-b border-[#E5E0D8]" id="site-header-{{ section.id }}">
  <div class="max-w-7xl mx-auto flex justify-between items-center px-6 lg:px-12 py-4">
    
    <!-- Left Navigation Menu -->
    <nav class="flex-1 hidden lg:flex items-center gap-8 text-xs uppercase tracking-widest font-medium">
      
      <!-- Links from Shopify linklist with fallback -->
      {% assign menu_handle = section.settings.menu | default: 'main-menu' %}
      {% assign nav_menu = linklists[menu_handle] %}
      {% if nav_menu.links.size > 0 %}
        {% for link in nav_menu.links %}
          <a href="{{ link.url }}" class="hover:text-[#C8A878] transition-colors text-[#1A1A1A]">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="/pages/about" class="hover:text-[#C8A878] transition-colors text-[#1A1A1A]">Il Brand</a>
        <a href="/blogs/journal" class="hover:text-[#C8A878] transition-colors text-[#1A1A1A]">Journal Clinico</a>
        <a href="/collections/all" class="hover:text-[#C8A878] transition-colors text-[#5C6B56] font-semibold">Bestseller</a>
      {% endif %}
    </nav>

    <!-- Logo Center -->
    <div class="text-center">
      <a href="{{ routes.root_url }}" class="font-serif text-3xl md:text-4xl tracking-[0.25em] uppercase text-[#1A1A1A] font-semibold">
        {{ section.settings.brand_name }}
      </a>
      <span class="block text-[9px] uppercase tracking-[0.35em] text-[#7A7265] mt-0.5">{{ section.settings.brand_payoff }}</span>
    </div>

    <!-- Right Actions -->
    <div class="flex-1 flex justify-end items-center gap-6">
      <a href="{{ routes.search_url }}" onclick="if(window.openSearchModal){openSearchModal(); return false;}" aria-label="Cerca nel catalogo" class="text-[#1A1A1A] hover:text-[#C8A878] transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </a>
      <div class="hidden lg:block text-right border-l border-[#E5E0D8] pl-5 cursor-pointer" onclick="if(window.openVeronaModal) openVeronaModal();">
        <div class="text-[11px] font-semibold text-[#1A1A1A] uppercase tracking-wider flex items-center gap-1 justify-end">
          <span class="w-2 h-2 rounded-full bg-emerald-600 inline-block animate-pulse"></span>
          Ritiro in sede 2h
        </div>
        <div class="text-[10px] text-[#7A7265] tracking-wide">{{ section.settings.verona_pickup }}</div>
      </div>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header Mile Mega Menu",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu di Navigazione"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Testo Barra Annunci",
      "default": "Ottieni il 15% di sconto sul tuo primo ordine con codice MILE15 • Spedizione gratuita sopra € 50"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Nome Brand",
      "default": "MILE"
    },
    {
      "type": "text",
      "id": "brand_payoff",
      "label": "Payoff Brand",
      "default": "HAUTE COSMÉTIQUE • VERONA"
    },
    {
      "type": "text",
      "id": "verona_pickup",
      "label": "Didascalia Ritiro Verona",
      "default": "Verona, Corso Cavour 18"
    }
  ]
}
{% endschema %}
