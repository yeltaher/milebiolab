<div class="bg-[#F5F2EB] text-[#1A1A1A] min-h-screen py-10">
 <!-- Hero Category Header -->
 <header class="max-w-7xl mx-auto px-4 sm:px-8 pb-8 pt-4">
  <div class="text-xs tracking-widest uppercase text-[#7A7265] mb-2 flex items-center gap-2">
   <a href="/" class="hover:text-[#1A1A1A]">Home</a>
   <span>/</span>
   <span class="text-[#1A1A1A] font-medium">{{ collection.title | default: 'Tutte le Formule' }}</span>
  </div>
  <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 border-b border-[#DDD7CE] pb-6">
   <div>
    <h1 class="font-serif text-4xl sm:text-5xl text-[#1A1A1A] font-normal leading-tight">
     {{ collection.title | default: 'Formule di Precisione Botanica' }}
    </h1>
    <p class="text-xs sm:text-sm text-[#7A7265] mt-2 max-w-xl font-light">
     {{ collection.description | default: "Trattamenti cosmeceutici d'eccellenza formulati per rigenerare la barriera cutanea e donare un finish radioso." }}
    </p>
   </div>
   <div class="text-xs text-[#7A7265]">
    <span class="font-medium text-[#1A1A1A]">{{ collection.products_count | default: 12 }}</span> Trattamenti Disponibili
   </div>
  </div>
 </header>

 <!-- Collection Product Grid -->
 <main class="max-w-7xl mx-auto px-4 sm:px-8 pb-16">
  {% paginate collection.products by section.settings.products_per_page %}
   <div id="catalog-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 transition-all duration-300">
    {% if collection.products.size > 0 %}
     {% for product in collection.products %}
      <div class="product-item bg-white border border-[#E5E0D8] p-4 flex flex-col justify-between group hover:shadow-xl transition-all">
       <div>
        <a href="{{ product.url }}" class="aspect-square bg-[#F5F2EB] border border-[#E5E0D8] mb-3 p-4 flex items-center justify-center overflow-hidden relative group/img block">
         <img src="{{ product.featured_image | image_url: width: 600 }}" 
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
            alt="{{ product.title | escape }}" class="h-full w-full object-contain transition-opacity duration-500">
         {% if product.tags contains 'Bestseller' or forloop.first %}
          <span class="absolute top-2 left-2 bg-[#1A1A1A] text-white px-2 py-0.5 text-[9px] uppercase tracking-wider font-semibold shadow-xs">Iconico ★</span>
         {% endif %}
        </a>
        <span class="text-[9px] uppercase tracking-widest text-[#5C6B56] font-bold block">{{ product.type | default: 'Trattamento Viso' }}</span>
        <a href="{{ product.url }}" class="font-serif text-lg text-[#1A1A1A] font-medium hover:text-[#C8A878] transition-colors block mt-0.5">
         {{ product.title }}
        </a>
        <div class="flex items-center gap-1.5 mt-1 text-[11px]">
         <span class="text-[#C8A878]">★★★★★</span>
         <span class="text-[#7A7265] text-[10px] font-light">(4.9/5 &bull; {{ forloop.index | times: 45 | plus: 80 }} recensioni)</span>
        </div>
        <p class="text-xs text-[#7A7265] mt-1 font-light">{{ product.vendor | default: 'Team Dr Joseph &bull; Verona' }}</p>
       </div>
       <div class="mt-4 pt-3 border-t border-[#E5E0D8] flex items-center justify-between">
        <span class="font-serif text-lg font-semibold text-[#555E6B]">{{ product.price | money }}</span>
        <button type="button" onclick="if(window.addShopifyCartItem){window.addShopifyCartItem('{{ product.selected_or_first_available_variant.id }}', 1);} else if(window.addToCart){addToCart({id: '{{ product.id }}', title: '{{ product.title | escape }}', price: {{ product.price | divided_by: 100.0 }}, volume: 'Standard', qty: 1, image: '{{ product.featured_image | image_url: width: 300 }}'});}" class="bg-[#1A1A1A] text-white px-4 py-2 text-[10px] uppercase tracking-widest font-semibold hover:bg-[#5C6B56] transition-colors luxury-interactive cursor-pointer">
         + Quick Add
        </button>
       </div>
      </div>
     {% endfor %}
    {% else %}
     <!-- 4 Bespoke Mile Products Fallback -->
     <div class="product-item bg-white border border-[#E5E0D8] p-4 flex flex-col justify-between group hover:shadow-xl transition-all">
      <div>
       <a href="/products/golden-glow-body-oil" class="aspect-square bg-[#F5F2EB] border border-[#E5E0D8] mb-3 p-4 flex items-center justify-center overflow-hidden relative group/img block">
        <img src="https://images.unsplash.com/photo-1608248597359-58d4a974b6c3?auto=format&fit=crop&w=500&q=80" 
           onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
           alt="Golden Glow Body Oil" class="h-full w-full object-contain">
        <span class="absolute top-2 left-2 bg-[#1A1A1A] text-white px-2 py-0.5 text-[9px] uppercase tracking-wider font-semibold shadow-xs">Iconico ★</span>
       </a>
       <span class="text-[9px] uppercase tracking-widest text-[#5C6B56] font-bold block">Corpo &bull; Olio Pregiato</span>
       <a href="/products/golden-glow-body-oil" class="font-serif text-lg text-[#1A1A1A] font-medium hover:text-[#C8A878] transition-colors block mt-0.5">Golden Glow Body Oil</a>
       <div class="flex items-center gap-1.5 mt-1 text-[11px]">
        <span class="text-[#C8A878]">★★★★★</span>
        <span class="text-[#7A7265] text-[10px] font-light">(4.9/5 &bull; 940 recensioni)</span>
       </div>
       <p class="text-xs text-[#7A7265] mt-1 font-light">100 ml &bull; Vetro Miron con pipetta</p>
      </div>
      <div class="mt-4 pt-3 border-t border-[#E5E0D8] flex items-center justify-between">
       <span class="font-serif text-lg font-semibold text-[#555E6B]">€ 76,00</span>
       <button type="button" onclick="if(window.addShopifyCartItem){window.addShopifyCartItem('1', 1);} else if(window.addToCart){addToCart({id: 1, title: 'Golden Glow Body Oil', price: 76.00, volume: '100 ml', qty: 1, image: 'https://images.unsplash.com/photo-1608248597359-58d4a974b6c3?auto=format&fit=crop&w=300&q=80'});}" class="bg-[#1A1A1A] text-white px-4 py-2 text-[10px] uppercase tracking-widest font-semibold hover:bg-[#5C6B56] transition-colors luxury-interactive cursor-pointer">
        + Quick Add
       </button>
      </div>
     </div>

     <div class="product-item bg-white border border-[#E5E0D8] p-4 flex flex-col justify-between group hover:shadow-xl transition-all">
      <div>
       <a href="/products/golden-glow-body-oil" class="aspect-square bg-[#F5F2EB] border border-[#E5E0D8] mb-3 p-4 flex items-center justify-center overflow-hidden relative group/img block">
        <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=500&q=80" 
           onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
           alt="Supreme Youth Bio-Serum" class="h-full w-full object-contain">
        <span class="absolute top-2 left-2 bg-[#C8A878] text-white px-2 py-0.5 text-[9px] uppercase tracking-wider font-semibold shadow-xs">Clinico</span>
       </a>
       <span class="text-[9px] uppercase tracking-widest text-[#5C6B56] font-bold block">Viso &bull; Siero Attivo</span>
       <a href="/products/golden-glow-body-oil" class="font-serif text-lg text-[#1A1A1A] font-medium hover:text-[#C8A878] transition-colors block mt-0.5">Supreme Youth Bio-Serum</a>
       <div class="flex items-center gap-1.5 mt-1 text-[11px]">
        <span class="text-[#C8A878]">★★★★★</span>
        <span class="text-[#7A7265] text-[10px] font-light">(5.0/5 &bull; 612 recensioni)</span>
       </div>
       <p class="text-xs text-[#7A7265] mt-1 font-light">30 ml &bull; Concentrato di Bakuchiol ed Edelweiss</p>
      </div>
      <div class="mt-4 pt-3 border-t border-[#E5E0D8] flex items-center justify-between">
       <span class="font-serif text-lg font-semibold text-[#555E6B]">€ 88,00</span>
       <button type="button" onclick="if(window.addShopifyCartItem){window.addShopifyCartItem('2', 1);} else if(window.addToCart){addToCart({id: 2, title: 'Supreme Youth Bio-Serum', price: 88.00, volume: '30 ml', qty: 1, image: 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=300&q=80'});}" class="bg-[#1A1A1A] text-white px-4 py-2 text-[10px] uppercase tracking-widest font-semibold hover:bg-[#5C6B56] transition-colors luxury-interactive cursor-pointer">
        + Quick Add
       </button>
      </div>
     </div>

     <div class="product-item bg-white border border-[#E5E0D8] p-4 flex flex-col justify-between group hover:shadow-xl transition-all">
      <div>
       <a href="/products/golden-glow-body-oil" class="aspect-square bg-[#F5F2EB] border border-[#E5E0D8] mb-3 p-4 flex items-center justify-center overflow-hidden relative group/img block">
        <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=500&q=80" 
           onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
           alt="Balancing Cleanser" class="h-full w-full object-contain">
        <span class="absolute top-2 left-2 bg-[#5C6B56] text-white px-2 py-0.5 text-[9px] uppercase tracking-wider font-semibold shadow-xs">Biomimetico</span>
       </a>
       <span class="text-[9px] uppercase tracking-widest text-[#5C6B56] font-bold block">Viso &bull; Detersione Fisiologica</span>
       <a href="/products/golden-glow-body-oil" class="font-serif text-lg text-[#1A1A1A] font-medium hover:text-[#C8A878] transition-colors block mt-0.5">Balancing Cleanser</a>
       <div class="flex items-center gap-1.5 mt-1 text-[11px]">
        <span class="text-[#C8A878]">★★★★★</span>
        <span class="text-[#7A7265] text-[10px] font-light">(4.9/5 &bull; 430 recensioni)</span>
       </div>
       <p class="text-xs text-[#7A7265] mt-1 font-light">150 ml &bull; Con camomilla e fiordaliso alpino</p>
      </div>
      <div class="mt-4 pt-3 border-t border-[#E5E0D8] flex items-center justify-between">
       <span class="font-serif text-lg font-semibold text-[#555E6B]">€ 48,00</span>
       <button type="button" onclick="if(window.addShopifyCartItem){window.addShopifyCartItem('3', 1);} else if(window.addToCart){addToCart({id: 3, title: 'Balancing Cleanser', price: 48.00, volume: '150 ml', qty: 1, image: 'https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=300&q=80'});}" class="bg-[#1A1A1A] text-white px-4 py-2 text-[10px] uppercase tracking-widest font-semibold hover:bg-[#5C6B56] transition-colors luxury-interactive cursor-pointer">
        + Quick Add
       </button>
      </div>
     </div>

     <div class="product-item bg-white border border-[#E5E0D8] p-4 flex flex-col justify-between group hover:shadow-xl transition-all">
      <div>
       <a href="/products/golden-glow-body-oil" class="aspect-square bg-[#F5F2EB] border border-[#E5E0D8] mb-3 p-4 flex items-center justify-center overflow-hidden relative group/img block">
        <img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&w=500&q=80" 
           onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
           alt="Barrier Velvet Cream" class="h-full w-full object-contain">
        <span class="absolute top-2 left-2 bg-emerald-700 text-white px-2 py-0.5 text-[9px] uppercase tracking-wider font-semibold shadow-xs">B-Corp Cosmos</span>
       </a>
       <span class="text-[9px] uppercase tracking-widest text-[#5C6B56] font-bold block">Viso &bull; Crema Barriera</span>
       <a href="/products/golden-glow-body-oil" class="font-serif text-lg text-[#1A1A1A] font-medium hover:text-[#C8A878] transition-colors block mt-0.5">Barrier Velvet Cream 48h</a>
       <div class="flex items-center gap-1.5 mt-1 text-[11px]">
        <span class="text-[#C8A878]">★★★★★</span>
        <span class="text-[#7A7265] text-[10px] font-light">(4.8/5 &bull; 510 recensioni)</span>
       </div>
       <p class="text-xs text-[#7A7265] mt-1 font-light">50 ml &bull; Lipidi biomimetici e ceramidi pure</p>
      </div>
      <div class="mt-4 pt-3 border-t border-[#E5E0D8] flex items-center justify-between">
       <span class="font-serif text-lg font-semibold text-[#555E6B]">€ 72,00</span>
       <button type="button" onclick="if(window.addShopifyCartItem){window.addShopifyCartItem('4', 1);} else if(window.addToCart){addToCart({id: 4, title: 'Barrier Velvet Cream 48h', price: 72.00, volume: '50 ml', qty: 1, image: 'https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&w=300&q=80'});}" class="bg-[#1A1A1A] text-white px-4 py-2 text-[10px] uppercase tracking-widest font-semibold hover:bg-[#5C6B56] transition-colors luxury-interactive cursor-pointer">
        + Quick Add
       </button>
      </div>
     </div>
    {% endif %}
   </div>

   {% if paginate.pages > 1 %}
    <div class="mt-12 flex justify-center gap-2">
     {{ paginate | default_pagination }}
    </div>
   {% endif %}
  {% endpaginate %}
 </main>
</div>

{% schema %}
{
 "name": "Main Collection Mile",
 "settings": [
  {
   "type": "range",
   "id": "products_per_page",
   "label": "Prodotti per pagina",
   "min": 4,
   "max": 24,
   "step": 4,
   "default": 12
  }
 ]
}
{% endschema %}
