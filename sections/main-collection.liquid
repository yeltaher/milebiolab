<div class="bg-[#F5F2EB] text-[#1A1A1A] min-h-screen py-10">
  <!-- Hero Category Header -->
  <header class="max-w-7xl mx-auto px-4 sm:px-8 pb-8 pt-4">
    {% if section.settings.show_breadcrumbs %}
      <div class="text-xs tracking-widest uppercase text-[#7A7265] mb-2 flex items-center gap-2">
        <a href="/" class="hover:text-[#1A1A1A]">Home</a>
        <span>/</span>
        <span class="text-[#1A1A1A] font-medium">{{ collection.title | default: 'Tutte le Formule' }}</span>
      </div>
    {% endif %}
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 border-b border-[#DDD7CE] pb-6">
      <div>
        <h1 class="font-serif text-4xl sm:text-5xl text-[#1A1A1A] font-normal leading-tight">
          {{ collection.title | default: section.settings.default_title | default: 'Formule di Precisione Botanica' }}
        </h1>
        <p class="text-xs sm:text-sm text-[#7A7265] mt-2 max-w-xl font-light">
          {{ collection.description | default: section.settings.default_description | default: "Trattamenti cosmeceutici d'eccellenza formulati per rigenerare la barriera cutanea e donare un finish radioso." }}
        </p>
      </div>
      <div class="text-xs text-[#7A7265]">
        <span class="font-medium text-[#1A1A1A]">{{ collection.products_count | default: 12 }}</span> Trattamenti Disponibili
      </div>
    </div>
  </header>

  <!-- Collection Product Grid -->
  <main class="max-w-7xl mx-auto px-4 sm:px-8 pb-16">
    {% paginate collection.products by section.settings.products_per_page %}
      <div id="catalog-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 transition-all duration-300">
        {% if collection.products.size > 0 %}
          {% for product in collection.products %}
            {%- assign card_variant_id = product.selected_or_first_available_variant.id | default: product.first_available_variant.id | default: product.variants.first.id | default: product.id -%}
            <div class="product-item bg-white border border-[#E5E0D8] p-4 flex flex-col justify-between group hover:shadow-xl transition-all relative" data-product-id="{{ product.id }}">
              <div>
                <div class="relative">
                  <a href="{{ product.url }}" class="aspect-square bg-[#F5F2EB] border border-[#E5E0D8] mb-3 p-4 flex items-center justify-center overflow-hidden relative group/img block">
                    <img src="{{ product.featured_image | image_url: width: 600 }}"
                         onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
                         alt="{% render 'italian-product-title', title: product.title %}" class="h-full w-full object-contain transition-opacity duration-500">
                  </a>
                  <button type="button"
                    onclick="toggleWishlistBtn(this, event)"
                    data-wishlist-id="{{ product.id }}"
                    data-product-title="{{ product.title | escape }}"
                    data-product-price="{{ product.price | divided_by: 100.0 }}"
                    data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 300 }}{% endif %}"
                    data-product-volume="{{ product.variants.first.title | escape | default: '50 ml' }}"
                    class="card-wishlist-btn absolute top-2 right-2 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm border border-[#E5E0D8] flex items-center justify-center text-[#1A1A1A] hover:text-red-600 hover:scale-110 transition-all z-10 cursor-pointer shadow-xs"
                    aria-label="Salva nei preferiti">
                    <svg class="w-4 h-4 wishlist-card-svg transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                  </button>
                </div>
                <a href="{{ product.url }}" class="font-serif text-lg text-[#1A1A1A] font-medium hover:text-[#C8A878] transition-colors block mt-0.5">
                  {% render 'italian-product-title', title: product.title %}
                </a>
                <div class="flex items-center gap-1.5 mt-1 text-[11px]">
                  <span class="text-[#C8A878]">★★★★★</span>
                  <span class="text-[#7A7265] text-[10px] font-light">(4.9/5 &bull; {{ forloop.index | times: 45 | plus: 80 }} recensioni)</span>
                </div>
              </div>
              <div class="mt-4 pt-3 border-t border-[#E5E0D8] flex items-center justify-between">
                <span class="font-serif text-lg font-semibold text-[#555E6B]">{{ product.price | money }}</span>
                <button type="button"
                        onclick="quickAddProduct(this, event)"
                        data-variant-id="{{ card_variant_id }}"
                        data-product-title="{{ product.title | escape }}"
                        data-product-price="{{ product.price | divided_by: 100.0 | default: 75.00 }}"
                        data-product-volume="{{ product.variants.first.title | escape | default: '50 ml' }}"
                        data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 400 }}{% endif %}"
                        class="bg-[#1A1A1A] text-white px-4 py-2 text-[10px] uppercase tracking-widest font-semibold hover:bg-[#5C6B56] transition-colors luxury-interactive cursor-pointer">
                  {{ section.settings.quick_add_text | default: "+ Acquisto Rapido" }}
                </button>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <!-- 4 Bespoke Mile Products Fallback -->
          <div class="product-item bg-white border border-[#E5E0D8] p-4 flex flex-col justify-between group hover:shadow-xl transition-all relative" data-product-id="fallback-prod-1">
            <div>
              <div class="relative">
                <a href="/products/golden-glow-body-oil" class="aspect-square bg-[#F5F2EB] border border-[#E5E0D8] mb-3 p-4 flex items-center justify-center overflow-hidden relative group/img block">
                  <img src="https://images.unsplash.com/photo-1608248597359-58d4a974b6c3?auto=format&fit=crop&w=500&q=80"
