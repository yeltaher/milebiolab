<div class="bg-[#F5F2EB] text-[#1A1A1A] min-h-screen py-16">
  <div class="max-w-5xl mx-auto px-6 lg:px-12">
    {% unless section.settings.show_header == false %}
    <div class="text-center mb-10">
      {% unless section.settings.show_eyebrow == false %}
      <span class="text-xs uppercase tracking-[0.25em] text-[#5C6B56] font-semibold block mb-2">{{ section.settings.eyebrow | default: "MILEBIOLAB HAUTE COSMÉTIQUE" }}</span>
      {% endunless %}
      <h1 class="font-serif text-4xl sm:text-5xl text-[#1A1A1A]">{{ section.settings.title | default: "Il Tuo Rituale di Bellezza" }}</h1>
    </div>
    {% endunless %}

    {% unless section.settings.show_progress_bar == false %}
    <!-- Free Shipping & Samples Progress Bar -->
    <div class="bg-white border border-[#E5E0D8] p-5 mb-8 shadow-xs">
      <div id="cart-progress-text" class="text-xs text-[#1A1A1A] font-medium mb-2.5">
        {{ section.settings.progress_text | default: "🌿 Aggiungi ancora per sbloccare la Spedizione Gratuita e il Cofanetto 3 Campioncini Deluxe Omaggio!" }}
      </div>
      <div class="w-full bg-[#E5E0D8] h-2 rounded-full overflow-hidden">
        <div class="bg-[#5C6B56] h-full transition-all duration-500 rounded-full" id="cart-progress-fill" style="width: 70%;"></div>
      </div>
    </div>
    {% endunless %}

    {% if section.settings.show_progress_bar == false %}
      <style id="hide-shipping-bar-style">
        .shipping-bar-container,
        #drawer-shipping-bar,
        [data-shipping-bar-container] {
          display: none !important;
        }
      </style>
      <script>
        try {
          localStorage.setItem('mile_hide_shipping_bar', 'true');
        } catch(e) {}
        window.mileHideShippingBar = true;
      </script>
    {% else %}
      <script>
        try {
          localStorage.removeItem('mile_hide_shipping_bar');
        } catch(e) {}
        window.mileHideShippingBar = false;
      </script>
    {% endif %}

    <!-- Cart Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Items List -->
      <div class="lg:col-span-7 bg-white border border-[#E5E0D8] p-6 shadow-xs">
        <h3 class="font-serif text-xl mb-4 border-b border-[#E5E0D8] pb-3 text-[#1A1A1A]">{{ section.settings.heading_items | default: "Formule Selezionate" }}</h3>
        
        <div class="space-y-6" id="cart-page-items-list">
          {% if cart.items.size > 0 %}
            {% for item in cart.items %}
              <div class="flex gap-4 items-center pb-5 border-b border-[#E5E0D8]">
                <a href="{{ item.url }}" class="flex-shrink-0">
                  {%- assign item_image = item.image | default: item.product.featured_image | default: item.product.images.first -%}
                  {% if item_image %}
                    <img src="{{ item_image | image_url: width: 240 }}" 
                         alt="{{ item.product.title | escape }}" 
                         class="w-16 h-16 sm:w-20 sm:h-20 object-cover bg-[#F5F2EB] border border-[#E5E0D8] p-1 flex-shrink-0 hover:opacity-90 transition-opacity"
                         loading="lazy"
                         onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=300&q=80';">
                  {% else %}
                    <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=300&q=80" 
                         alt="{{ item.product.title | escape }}" 
                         class="w-16 h-16 sm:w-20 sm:h-20 object-cover bg-[#F5F2EB] border border-[#E5E0D8] p-1 flex-shrink-0 hover:opacity-90 transition-opacity"
                         loading="lazy">
                  {% endif %}
                </a>
                <div class="flex-1 min-w-0 pr-2">
                  <h4 class="font-serif text-base font-medium text-[#1A1A1A]">
                    <a href="{{ item.url }}" class="hover:text-[#C8A878] transition-colors">{{ item.product.title }}</a>
                  </h4>
                  {% unless item.variant.title contains 'Default' %}
                    <div class="text-xs text-[#7A7265] mt-0.5">{{ item.variant.title }} &bull; Milebiolab Haute Couture</div>
                  {% endunless %}
                  {%- assign item_compare_at = item.variant.compare_at_price | default: 0 -%}
                  {%- if item_compare_at == 0 and item.properties['_compare_at_price'] -%}
                    {%- assign item_compare_at = item.properties['_compare_at_price'] | times: 100 -%}
                  {%- endif -%}
                  {%- assign is_routine_bundle = false -%}
                  {%- if item.properties['_bundle'] == 'routine_15' or item.properties['bundle'] == 'routine_15' -%}
                    {%- assign is_routine_bundle = true -%}
                    {%- if item_compare_at == 0 or item_compare_at <= item.final_price -%}
                      {%- assign item_compare_at = item.final_price -%}
                    {%- endif -%}
                    {%- assign display_unit_price = item.final_price | times: 0.85 | round -%}
                    {%- assign display_line_price = item.final_line_price | times: 0.85 | round -%}
                  {%- else -%}
                    {%- assign display_unit_price = item.final_price -%}
                    {%- assign display_line_price = item.final_line_price | default: item.line_price -%}
                  {%- endif -%}

                  <div class="text-xs font-semibold text-[#1A1A1A] mt-1 flex items-baseline gap-1.5">
                    <span>{{ display_unit_price | money }}</span>
                    {% if item_compare_at > display_unit_price %}
                      <span class="line-through text-[#7A7265] text-xs font-normal ml-1.5">{{ item_compare_at | money }}</span>
                    {% endif %}
                    {% if is_routine_bundle %}
                      <span class="text-[10px] bg-[#5C6B56]/10 text-[#5C6B56] px-1.5 py-0.5 rounded font-mono font-medium ml-1">-15% Routine</span>
                    {% endif %}
                  </div>
                </div>
                <div class="flex flex-col items-end gap-2 shrink-0">
                  <!-- Prezzo Totale Riga -->
                  <div class="text-xs font-semibold text-[#1A1A1A] flex items-baseline justify-end gap-1.5">
                    <span>{{ display_line_price | money }}</span>
                    {% if item_compare_at > display_unit_price %}
                      {% assign line_compare_at = item_compare_at | times: item.quantity %}
                      <span class="line-through text-[#7A7265] text-xs font-normal ml-1.5">{{ line_compare_at | money }}</span>
                    {% endif %}
                  </div>

                  <!-- Selettore Quantità (- / Qty / +) -->
                  <div class="flex items-center border border-[#E5E0D8] bg-[#FAF8F5]">
                    <button
                      type="button"
                      onclick="updateCartPageQty('{{ item.key }}', {{ item.quantity | minus: 1 }})"
                      class="w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center text-sm font-semibold text-[#1A1A1A] hover:bg-[#5C6B56] hover:text-white transition-colors cursor-pointer"
                      aria-label="Riduci quantità di {{ item.product.title | escape }}"
                    >
                      &minus;
                    </button>
                    <input
                      type="number"
                      name="updates[]"
                      id="updates_{{ item.key }}"
                      value="{{ item.quantity }}"
                      min="0"
                      onchange="updateCartPageQty('{{ item.key }}', this.value)"
                      class="w-9 h-7 sm:w-10 sm:h-8 text-center text-xs font-medium text-[#1A1A1A] bg-white border-x border-[#E5E0D8] focus:outline-none focus:bg-[#FAF8F5] [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                      aria-label="Quantità per {{ item.product.title | escape }}"
                    >
                    <button
                      type="button"
                      onclick="updateCartPageQty('{{ item.key }}', {{ item.quantity | plus: 1 }})"
                      class="w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center text-sm font-semibold text-[#1A1A1A] hover:bg-[#5C6B56] hover:text-white transition-colors cursor-pointer"
                      aria-label="Aumenta quantità di {{ item.product.title | escape }}"
                    >
                      &#43;
                    </button>
                  </div>

                  <!-- Link Rimuovi -->
                  <button
                    type="button"
                    onclick="updateCartPageQty('{{ item.key }}', 0)"
                    class="text-[11px] text-[#7A7265] hover:text-red-700 underline transition-colors cursor-pointer"
                    title="Rimuovi prodotto dal carrello"
                  >
                    Rimuovi
                  </button>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <!-- Stato Carrello Vuoto Elegante -->
            <div class="py-12 text-center text-[#7A7265] space-y-4">
              <span class="text-4xl block mb-2">🌿</span>
              <p class="font-serif text-xl text-[#1A1A1A]">Il tuo carrello è attualmente vuoto.</p>
              <p class="text-xs text-[#7A7265] max-w-sm mx-auto">Esplora le nostre formulazioni d'eccellenza e componi la tua routine su misura.</p>
              <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="inline-block mt-2 px-8 py-3 bg-[#1A1A1A] text-white text-xs uppercase tracking-[0.2em] font-semibold hover:bg-[#5C6B56] transition-colors luxury-interactive shadow-sm">
                Scopri i Trattamenti
              </a>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Summary & Checkout Box -->
      <div class="lg:col-span-5 bg-white border border-[#E5E0D8] p-6 shadow-xs sticky top-28">
        <h3 class="font-serif text-xl mb-4 border-b border-[#E5E0D8] pb-3 text-[#1A1A1A]">{{ section.settings.heading_summary | default: "Riepilogo Ordine" }}</h3>
        
        {%- assign cart_calc_total = 0 -%}
        {%- assign has_bundle_cart = false -%}
        {%- for cart_item in cart.items -%}
          {%- if cart_item.properties['_bundle'] == 'routine_15' or cart_item.properties['bundle'] == 'routine_15' -%}
            {%- assign has_bundle_cart = true -%}
            {%- assign discounted_line = cart_item.final_line_price | times: 0.85 | round -%}
            {%- assign cart_calc_total = cart_calc_total | plus: discounted_line -%}
          {%- else -%}
            {%- assign cart_calc_total = cart_calc_total | plus: cart_item.final_line_price -%}
          {%- endif -%}
        {%- endfor -%}

        <div class="space-y-3 text-xs mb-6">
          <div class="flex justify-between">
            <span class="text-[#7A7265]">Subtotale</span>
            <span class="font-semibold text-[#1A1A1A]" id="cart-summary-subtotal">{% if has_bundle_cart %}{{ cart_calc_total | money }}{% else %}{{ cart.total_price | money | default: '€ 170,00' }}{% endif %}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-[#7A7265]">Spedizione espressa / Ritiro Verona</span>
            <span class="text-[#5C6B56] font-semibold">Gratuita</span>
          </div>
          <div class="flex justify-between border-t border-[#E5E0D8] pt-3 text-sm font-semibold">
            <span>Totale (IVA inclusa)</span>
            <span class="text-[#1A1A1A]" id="cart-summary-total">{% if has_bundle_cart %}{{ cart_calc_total | money }}{% else %}{{ cart.total_price | money | default: '€ 170,00' }}{% endif %}</span>
          </div>
        </div>

        <!-- BEAUTY CLUB MILE LOYALTY WIDGET -->
        <div class="loyalty-cart-widget p-4 mb-4 bg-[#FAF8F5] border border-[#E5E0D8] text-xs">
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="font-mono text-[10px] uppercase tracking-wider text-[#C8A878] font-semibold flex items-center gap-1.5">
              <span>💖</span> Beauty Club Mile
            </span>
            <a href="/pages/programma-fedelta" class="text-[10px] text-[#7A7265] underline hover:text-[#1A1A1A]">Regolamento</a>
          </div>

          {% if customer %}
            {% assign customer_points = customer.total_spent | divided_by: 100 | plus: 20 %}
            <div class="flex items-center justify-between text-xs text-[#1A1A1A] font-medium">
              <span>Il tuo saldo punti:</span>
              <span class="font-bold text-[#5C6B56] font-mono text-sm">{{ customer_points }} Beauty Punti</span>
            </div>

            {% if customer_points >= 100 %}
              <div class="mt-3 pt-2.5 border-t border-[#E5E0D8]/60 space-y-2">
                <p class="text-xs text-[#5C6B56] leading-relaxed">
                  🎉 <strong>Hai sbloccato 5 € di sconto!</strong> Puoi riscattare 100 punti subito per questo ordine.
                </p>
                <a href="{{ routes.cart_url }}/checkout?discount=BEAUTYCLUB5" class="w-full py-2.5 px-4 bg-[#5C6B56] hover:bg-[#1A1A1A] text-white text-xs uppercase tracking-wider font-semibold text-center block transition-colors shadow-xs">
                  Usa i Miei Punti (-5 € al Checkout)
                </a>
              </div>
            {% else %}
              {% assign points_needed = 100 | minus: customer_points %}
              <div class="mt-2.5 space-y-1.5">
                <div class="flex justify-between text-[11px] text-[#7A7265]">
                  <span>Soglia riscatto 5 € (100 pt)</span>
                  <span>Mancano {{ points_needed }} pt</span>
                </div>
                <div class="w-full h-2 bg-[#E5E0D8] rounded-full overflow-hidden">
                  <div class="h-full bg-[#C8A878] rounded-full transition-all duration-500" style="width: {{ customer_points }}%;"></div>
                </div>
                <p class="text-[11px] text-[#7A7265] leading-relaxed">
                  Ti mancano <strong>{{ points_needed }} punti</strong> per sbloccare 5 € di sconto immediato.
                </p>
              </div>
            {% endif %}
          {% else %}
            <div class="text-xs text-[#1A1A1A] leading-relaxed">
              <p>
                ✨ Con questo ordine accumulerai <strong class="text-[#5C6B56] font-mono">+{{ cart.total_price | divided_by: 100 }} Beauty Punti</strong>.
              </p>
              <p class="mt-1 text-[#7A7265]">
                <a href="/pages/accedi#register" class="text-[#1A1A1A] underline font-semibold hover:text-[#C8A878]">Accedi o Registrati</a> per ricevere <strong>20 punti di benvenuto subito</strong>!
              </p>
            </div>
          {% endif %}
        </div>

        <a href="{{ routes.cart_url }}/checkout{% if has_bundle_cart %}?discount=ROUTINE15{% endif %}" id="cart-page-checkout-btn" class="w-full bg-[#1A1A1A] text-white py-4 px-6 text-xs uppercase tracking-[0.22em] font-semibold hover:bg-[#5C6B56] transition-all text-center flex items-center justify-center luxury-interactive shadow-md mb-4">
          {{ section.settings.checkout_btn_text | default: "Procedi al Checkout Sicuro" }}
        </a>

        <div class="bg-[#FAF8F5] border border-[#E5E0D8] p-3 text-[11px] text-[#7A7265] space-y-1">
          <div>
            {% assign pickup_text = section.settings.notice_pickup | default: "📍 Ritiro in sede disponibile: Verona, Via Torricelle 2c." %}
            {% if pickup_text contains "Ritiro in sede disponibile:" %}
              {{ pickup_text | replace: "Ritiro in sede disponibile:", "<strong>Ritiro in sede disponibile:</strong>" }}
            {% elsif pickup_text contains "Ritiro gratuito disponibile:" %}
              {{ pickup_text | replace: "Ritiro gratuito disponibile:", "<strong>Ritiro gratuito disponibile:</strong>" }}
            {% else %}
              {{ pickup_text }}
            {% endif %}
          </div>
          <div>
            {% assign samples_text = section.settings.notice_samples | default: "🌿 Omaggi inclusi: 3 campioncini deluxe e packaging regalo riciclabile." %}
            {% if samples_text contains "Omaggi inclusi:" %}
              {{ samples_text | replace: "Omaggi inclusi:", "<strong>Omaggi inclusi:</strong>" }}
            {% else %}
              {{ samples_text }}
            {% endif %}
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  async function updateCartPageQty(itemKey, newQty) {
    newQty = parseInt(newQty, 10);
    if (isNaN(newQty) || newQty < 0) newQty = 0;

    const itemsList = document.getElementById('cart-page-items-list');
    if (itemsList) {
      itemsList.style.pointerEvents = 'none';
      itemsList.style.opacity = '0.5';
    }

    try {
      const res = await fetch((window.routes && window.routes.cart_change_url) || '/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          id: itemKey,
          quantity: newQty
        })
      });

      if (window.fetchShopifyCart) {
        try {
          await window.fetchShopifyCart();
        } catch(e) {}
      }

      window.location.reload();
    } catch (err) {
      console.error('Errore aggiornamento carrello:', err);
      window.location.reload();
    }
  }
</script>

{% schema %}
{
  "name": "Main Cart Page Mile",
  "settings": [
    {
      "type": "header",
      "content": "Intestazione Carrello"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Mostra Intestazione Carrello",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Mostra Sottotitolo Superiore (Eyebrow)",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sottotitolo / Eyebrow",
      "default": "MILEBIOLAB HAUTE COSMÉTIQUE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo Carrello",
      "default": "Il Tuo Rituale di Bellezza"
    },
    {
      "type": "header",
      "content": "Barra Progresso Omaggi & Spedizione"
    },
    {
      "type": "checkbox",
      "id": "show_progress_bar",
      "label": "Mostra Barra Spedizione & Omaggi (Carrello e Carrello Laterale)",
      "info": "Se disattivato, nasconde la barra di avanzamento sia in questa pagina che nel carrello laterale.",
      "default": true
    },
    {
      "type": "textarea",
      "id": "progress_text",
      "label": "Messaggio Soglia Spedizione & Omaggi",
      "default": "🌿 Aggiungi ancora per sbloccare la Spedizione Gratuita e il Cofanetto 3 Campioncini Deluxe Omaggio!"
    },
    {
      "type": "header",
      "content": "Titoli & Checkout"
    },
    {
      "type": "text",
      "id": "heading_items",
      "label": "Titolo Sezione Articoli",
      "default": "Formule Selezionate"
    },
    {
      "type": "text",
      "id": "heading_summary",
      "label": "Titolo Riepilogo Ordine",
      "default": "Riepilogo Ordine"
    },
    {
      "type": "text",
      "id": "checkout_btn_text",
      "label": "Testo Bottone Checkout",
      "default": "Procedi al Checkout Sicuro"
    },
    {
      "type": "header",
      "content": "Avvisi Informativi Ritiro & Omaggi"
    },
    {
      "type": "textarea",
      "id": "notice_pickup",
      "label": "Avviso Ritiro in Sede Verona",
      "default": "📍 Ritiro in sede disponibile: Verona, Via Torricelle 2c."
    },
    {
      "type": "textarea",
      "id": "notice_samples",
      "label": "Avviso Omaggi Inclusi",
      "default": "🌿 Omaggi inclusi: 3 campioncini deluxe e packaging regalo riciclabile."
    }
  ]
}
{% endschema %}
