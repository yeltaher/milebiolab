{% comment %}
  MILEBIOLAB - TEMPLATE CUSTOMER REGISTRATION
  Bespoke Haute Couture / Splendor Palette (#F5F2EB, #FAF8F5, #E5E0D8, #5C6B56, #C8A878, #1A1A1A)
{% endcomment %}

<div class="customer-auth-wrapper min-h-[75vh] py-12 md:py-16 px-4 sm:px-6 lg:px-8 bg-linen">
  <div class="max-w-6xl mx-auto">
    <!-- Breadcrumb & Top Indicator -->
    <nav class="mb-8 flex items-center gap-2 text-xs uppercase tracking-widest text-ash">
      <a href="{{ routes.root_url }}" class="hover:text-ink transition-colors">Home</a>
      <span class="text-sand">/</span>
      <span class="text-ink font-semibold">Club Mile &bull; Registrazione</span>
    </nav>

    <!-- Main 2-Column Luxury Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
      
      <!-- LEFT COLUMN: Brand Privilege Card & Club Mile Benefits -->
      <div class="lg:col-span-5 bg-[#FAF8F5] border border-borderLinen p-8 sm:p-10 flex flex-col justify-between relative overflow-hidden shadow-sm">
        <div class="absolute -right-20 -top-20 w-64 h-64 bg-amber/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-sage/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-white border border-borderLinen text-[11px] font-mono tracking-wider uppercase text-amber mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-amber"></span>
            {{ section.settings.privilege_badge | default: "Nuova Iscrizione • Club Mile" }}
          </div>

          <h2 class="font-serif text-3xl sm:text-4xl text-ink font-normal leading-tight mb-4">
            {{ section.settings.privilege_title | default: "Unisciti al Rituale Botanico <br><span class='italic text-sage'>di Haute Couture</span>" }}
          </h2>

          <p class="text-sm text-ash leading-relaxed mb-8">
            {{ section.settings.privilege_description | default: "Registrandoti al Club Mile ricevi immediatamente il tuo codice di benvenuto per un'esperienza dermocosmetica personalizzata, creata con le formule bio-tecnologiche Team Dr Joseph." }}
          </p>

          <!-- Benefits List -->
          <ul class="space-y-4 mb-8 text-xs sm:text-sm text-ink/90">
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-full bg-amber/20 text-amber flex items-center justify-center shrink-0 mt-0.5 font-serif font-bold text-xs">✓</span>
              <div>
                <strong class="font-semibold block text-ink">{{ section.settings.benefit_1_title | default: "10% di Sconto Immediato" }}</strong>
                <span class="text-ash text-xs">{{ section.settings.benefit_1_desc | default: "Ricevi il codice promozionale via email subito dopo la registrazione." }}</span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-full bg-sage/20 text-sage flex items-center justify-center shrink-0 mt-0.5 font-serif font-bold text-xs">✓</span>
              <div>
                <strong class="font-semibold block text-ink">{{ section.settings.benefit_2_title | default: "Ritiro Esclusivo a Verona in 2 Ore" }}</strong>
                <span class="text-ash text-xs">{{ section.settings.benefit_2_desc | default: "Possibilità di ritirare gratuitamente i tuoi acquisti nella nostra boutique di Corso Cavour 18." }}</span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-full bg-amber/20 text-amber flex items-center justify-center shrink-0 mt-0.5 font-serif font-bold text-xs">✓</span>
              <div>
                <strong class="font-semibold block text-ink">{{ section.settings.benefit_3_title | default: "Campioni Deluxe Su Misura" }}</strong>
                <span class="text-ash text-xs">{{ section.settings.benefit_3_desc | default: "Omaggi calibrati sulle esigenze uniche della tua pelle inclusi in ogni spedizione." }}</span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-full bg-sage/20 text-sage flex items-center justify-center shrink-0 mt-0.5 font-serif font-bold text-xs">✓</span>
              <div>
                <strong class="font-semibold block text-ink">{{ section.settings.benefit_4_title | default: "Anteprima Lanci & Masterclass" }}</strong>
                <span class="text-ash text-xs">{{ section.settings.benefit_4_desc | default: "Accesso prioritario alle nuove formule e inviti a eventi di bellezza esclusivi." }}</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- Verona Flagship Reference -->
        <div class="relative z-10 pt-6 border-t border-borderLinen flex items-center justify-between text-xs text-ash">
          <span class="flex items-center gap-1.5 font-medium text-ink">
            <svg class="w-4 h-4 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            {{ section.settings.boutique_title | default: "Boutique &amp; Istituto &bull; Verona" }}
          </span>
          {% if section.settings.boutique_url != blank %}
            <a href="{{ section.settings.boutique_url }}" class="font-mono text-[11px] text-amber uppercase font-semibold hover:underline">
              {{ section.settings.boutique_details | default: "Corso Cavour 18" }}
            </a>
          {% else %}
            <span class="font-mono text-[11px] text-amber uppercase font-semibold">{{ section.settings.boutique_details | default: "Corso Cavour 18" }}</span>
          {% endif %}
        </div>
      </div>

      <!-- RIGHT COLUMN: Customer Registration Form -->
      <div class="lg:col-span-7 bg-white border border-borderLinen p-8 sm:p-12 shadow-sm flex flex-col justify-center">
        <div class="w-full">
          
          <div id="MainRegisterHeaderBlock" class="mb-8">
            <span class="text-[11px] font-mono tracking-widest uppercase text-ash block mb-1">{{ section.settings.form_eyebrow | default: "Crea il Tuo Profilo Personale" }}</span>
            <h1 class="font-serif text-3xl sm:text-4xl text-ink font-normal">{{ section.settings.form_title | default: "Registrazione Club Mile" }}</h1>
            <p class="text-xs sm:text-sm text-ash mt-2">
              {{ section.settings.form_subtitle | default: "Compila i campi sottostanti per creare il tuo account riservato ed entrare a far parte della nostra community." }}
            </p>
          </div>

          <!-- Modulo Registrazione Cliente Shopify Nativo -->
          {% form 'create_customer', id: 'MainRegisterCustomerForm', class: 'space-y-5', novalidate: 'novalidate' %}
            <input type="hidden" name="return_to" value="/pages/account">
            <input type="hidden" name="customer[tags]" value="club_mile, welcome_20, beauty_club, cliente_registrato">
            <input type="hidden" name="customer[accepts_marketing]" value="true">
            <input type="hidden" name="customer[password]" id="RegisterPassword" value="">

            {% if form.errors %}
              <div class="p-4 bg-[#FFF5F5] border border-[#E5A8A8] text-[#9E2A2B] text-xs sm:text-sm">
                <strong class="block font-medium mb-1">Si &egrave; verificato un errore durante la registrazione:</strong>
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <!-- First Name & Last Name Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="RegisterFirstName" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1.5">
                  Nome <span class="text-sage">*</span>
                </label>
                <input
                  type="text"
                  name="customer[first_name]"
                  id="RegisterFirstName"
                  autocomplete="given-name"
                  required
                  placeholder="Maria"
                  class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink placeholder-ash/50 focus:bg-white focus:border-sage focus:outline-none transition-colors"
                >
              </div>

              <div>
                <label for="RegisterLastName" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1.5">
                  Cognome <span class="text-sage">*</span>
                </label>
                <input
                  type="text"
                  name="customer[last_name]"
                  id="RegisterLastName"
                  autocomplete="family-name"
                  required
                  placeholder="Rossi"
                  class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink placeholder-ash/50 focus:bg-white focus:border-sage focus:outline-none transition-colors"
                >
              </div>
            </div>

            <!-- Email Field -->
            <div>
              <label for="RegisterEmail" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1.5">
                Indirizzo Email <span class="text-sage">*</span>
              </label>
              <input
                type="email"
                name="customer[email]"
                id="RegisterEmail"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                placeholder="es. maria.rossi@email.com"
                class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink placeholder-ash/50 focus:bg-white focus:border-sage focus:outline-none transition-colors"
              >
            </div>

            <!-- Birthdate Field (Opzionale con omaggio 50 punti) -->
            <div>
              <label for="RegisterBirthdate" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1.5 flex items-center justify-between">
                <span>Data di Nascita <span class="text-ash font-normal text-[10px]">(Opzionale)</span></span>
                <span class="text-[#C8A878] font-normal text-[11px] lowercase tracking-normal">🎂 +50 punti in omaggio al compleanno!</span>
              </label>
              <input
                type="date"
                name="customer[note][Data di Nascita]"
                id="RegisterBirthdate"
                class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink focus:bg-white focus:border-sage focus:outline-none transition-colors"
              >
              <p class="text-[11px] text-ash mt-1">
                Inserisci la tua data di nascita per ricevere automaticamente 50 Beauty Punti in omaggio nel giorno del tuo compleanno!
              </p>
            </div>

            <!-- Privacy & Terms Checkbox -->
            <div class="pt-2">
              <label class="flex items-start gap-2.5 text-xs text-ash cursor-pointer">
                <input
                  type="checkbox"
                  id="RegisterPrivacyCheckbox"
                  required
                  class="mt-0.5 accent-[#5C6B56] cursor-pointer"
                  checked
                >
                <span>
                  {{ section.settings.privacy_text | default: "Accetto l'informativa sulla <a href='/pages/privacy-policy' class='underline text-ink hover:text-amber'>Privacy Policy</a> e desidero ricevere vantaggi esclusivi, codici sconto e aggiornamenti sui rituali botanici MileBioLab." }}
                </span>
              </label>
            </div>

            <!-- Submit Button -->
            <div class="pt-2">
              <button
                type="submit"
                id="RegisterSubmitBtn"
                class="w-full bg-ink hover:bg-sage text-white py-4 px-6 text-xs uppercase tracking-widest font-semibold transition-all duration-300 shadow-sm cursor-pointer flex items-center justify-center gap-2"
              >
                <span id="RegisterSubmitBtnText">{{ section.settings.submit_btn_text | default: "Crea Account Club Mile (-10%)" }}</span>
                <span class="text-amber">&rarr;</span>
              </button>
              <p class="text-[11px] text-ash text-center mt-2">
                Attivazione immediata &bull; 20 Beauty Punti &amp; 10% di sconto accreditati subito.
              </p>
            </div>
          {% endform %}

          <!-- Vista di conferma Registrazione On-Site Immediata (Celebrazione Splendor) -->
          <div id="MainRegisterSuccessView" class="hidden space-y-6 py-6 text-center">
            <div class="w-20 h-20 mx-auto rounded-full bg-[#FAF8F5] border border-[#C8A878] flex items-center justify-center text-4xl shadow-sm text-[#5C6B56]">
              ✨
            </div>
            <span class="inline-block px-3 py-1 bg-[#FAF8F5] border border-[#5C6B56]/30 text-[10px] font-mono tracking-wider uppercase text-[#5C6B56] font-semibold">
              Profilo Attivo &bull; Club Mile
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl text-[#1A1A1A] font-normal leading-tight">
              Benvenuto nel Club Mile!
            </h2>
            <p class="text-sm text-[#7A7265] leading-relaxed max-w-md mx-auto">
              Il tuo profilo &egrave; attivo con successo. Ti abbiamo accreditato <strong class="text-[#1A1A1A]">20 Beauty Punti di benvenuto</strong> e il tuo codice sconto riservato <strong class="text-[#1A1A1A]">MILE10</strong>.
            </p>

            <!-- Box di Riepilogo Profilo & Punti -->
            <div class="bg-[#FAF8F5] border border-[#E5E0D8] p-6 max-w-md mx-auto space-y-3.5 text-left">
              <div class="flex items-center justify-between pb-2.5 border-b border-[#E5E0D8] text-xs">
                <span class="text-[#7A7265]">Membro:</span>
                <strong id="MainRegisterCustomerName" class="text-[#1A1A1A] font-medium">-</strong>
              </div>
              <div class="flex items-center justify-between pb-2.5 border-b border-[#E5E0D8] text-xs">
                <span class="text-[#7A7265]">Email:</span>
                <span id="MainRegisterSentEmail" class="text-[#1A1A1A] font-mono text-xs">-</span>
              </div>
              <div class="flex items-center justify-between pb-2.5 border-b border-[#E5E0D8] text-xs">
                <span class="text-[#7A7265]">Saldo Punti di Benvenuto:</span>
                <span class="text-sm font-serif font-bold text-[#5C6B56]">20 Beauty Punti Attivi</span>
              </div>

              <!-- Codice Sconto Riservato -->
              <div class="pt-1 space-y-2">
                <span class="text-[10px] font-mono uppercase tracking-widest text-[#7A7265] block font-semibold">Codice Sconto Riservato (-10%):</span>
                <div class="flex items-center justify-between gap-3">
                  <span id="MainRegisterDiscountCode" class="font-mono text-base font-bold tracking-widest text-[#1A1A1A] bg-white px-4 py-2 border border-[#E5E0D8] flex-1 text-center">
                    MILE10
                  </span>
                  <button
                    type="button"
                    onclick="copyDiscountCode('MainRegisterDiscountCode', this)"
                    class="px-4 py-2 bg-[#1A1A1A] hover:bg-[#5C6B56] text-white text-xs uppercase tracking-wider font-semibold transition-colors cursor-pointer"
                  >
                    Copia
                  </button>
                </div>
              </div>
            </div>

            <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center max-w-md mx-auto">
              <a
                href="/pages/account"
                class="flex-1 py-3.5 px-6 bg-[#1A1A1A] hover:bg-[#5C6B56] text-white text-xs uppercase tracking-widest font-semibold transition-colors text-center cursor-pointer shadow-sm"
              >
                Vai al Tuo Profilo Personale &rarr;
              </a>
              <a
                href="{{ routes.root_url }}"
                class="flex-1 py-3.5 px-6 border border-[#1A1A1A] text-[#1A1A1A] hover:bg-[#FAF8F5] text-xs uppercase tracking-widest font-semibold transition-colors text-center"
              >
                Continua lo Shopping
              </a>
            </div>
          </div>

          <!-- Switch to Login Link -->
          <div id="MainRegisterLoginPrompt" class="mt-8 pt-6 border-t border-borderLinen text-center">
            <p class="text-xs sm:text-sm text-ash mb-3">
              {{ section.settings.login_prompt_text | default: "Possiedi già un profilo Club Mile attivo?" }}
            </p>
            <a
              href="/pages/account"
              onclick="if(window.openAccountDrawer){ openAccountDrawer(); switchAccountDrawerTab('login'); return false; }"
              class="inline-block px-6 py-3 border border-ink text-ink hover:bg-ink hover:text-white transition-colors text-xs uppercase tracking-widest font-semibold cursor-pointer"
            >
              {{ section.settings.login_link_text | default: "Accedi al Tuo Profilo →" }}
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

<script>
  window.handleMainRegister = function(e) {
    if (e) {
      if (typeof e.preventDefault === 'function') e.preventDefault();
      if (typeof e.stopPropagation === 'function') e.stopPropagation();
    }

    var form = document.getElementById('MainRegisterCustomerForm');
    var firstNameInput = document.getElementById('RegisterFirstName');
    var lastNameInput = document.getElementById('RegisterLastName');
    var emailInput = document.getElementById('RegisterEmail');
    var passwordInput = document.getElementById('RegisterPassword');
    var privacyCheckbox = document.getElementById('RegisterPrivacyCheckbox');
    var submitBtn = document.getElementById('RegisterSubmitBtn');
    var submitBtnText = document.getElementById('RegisterSubmitBtnText');

    var firstName = firstNameInput ? firstNameInput.value.trim() : '';
    var lastName = lastNameInput ? lastNameInput.value.trim() : '';
    var email = emailInput ? emailInput.value.trim() : '';

    if (!firstName || !lastName || !email) {
      alert('Compila tutti i campi obbligatori per procedere.');
      return false;
    }
    if (privacyCheckbox && !privacyCheckbox.checked) {
      alert('Accetta la privacy policy per completare la registrazione.');
      return false;
    }

    // Auto-generazione password robusta per Shopify (registrazione senza password visibile)
    var autoPass = 'MbL_' + Math.random().toString(36).substring(2, 10) + Math.random().toString(36).substring(2, 10).toUpperCase() + '!9';
    if (passwordInput) {
      passwordInput.value = autoPass;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      if (submitBtnText) submitBtnText.innerText = 'Creazione account in corso...';
    }

    // Salvataggio dati profilo in localStorage
    try {
      localStorage.removeItem('mile_pending_activation_email');
      localStorage.setItem('mile_customer_logged_in', 'true');
      var profileData = {
        first_name: firstName,
        last_name: lastName,
        email: email,
        points: 20
      };
      localStorage.setItem('mile_customer_profile', JSON.stringify(profileData));
      localStorage.setItem('mile_customer', JSON.stringify(profileData));
    } catch (err) {}

    // Sincronizza subito i dati utente
    if (typeof window.syncCustomerNameAndInitials === 'function') {
      window.syncCustomerNameAndInitials();
    }

    // Invio nativo a Shopify
    if (form) {
      if (typeof HTMLFormElement.prototype.submit === 'function') {
        HTMLFormElement.prototype.submit.call(form);
      } else {
        form.submit();
      }
    }

    return true;
  };

  (function() {
    function initMainRegisterForm() {
      var form = document.getElementById('MainRegisterCustomerForm');
      if (!form) return;
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        window.handleMainRegister(e);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMainRegisterForm);
    } else {
      initMainRegisterForm();
    }
  })();

  function copyDiscountCode(elementId, btn) {
    var codeEl = document.getElementById(elementId);
    var code = codeEl ? codeEl.innerText.trim() : 'MILE10';
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(code).then(function() {
        var oldText = btn.innerText;
        btn.innerText = 'Copiato!';
        btn.classList.add('bg-sage');
        setTimeout(function() {
          btn.innerText = oldText;
          btn.classList.remove('bg-sage');
        }, 2000);
      });
    } else {
      var temp = document.createElement('input');
      temp.value = code;
      document.body.appendChild(temp);
      temp.select();
      document.execCommand('copy');
      document.body.removeChild(temp);
      var oldText = btn.innerText;
      btn.innerText = 'Copiato!';
      setTimeout(function() {
        btn.innerText = oldText;
      }, 2000);
    }
  }
  window.copyDiscountCode = copyDiscountCode;

</script>

