{% comment %}
  MILEBIOLAB - TEMPLATE CUSTOMER ADDRESSES MANAGEMENT
  Bespoke Haute Couture / Splendor Palette (#F5F2EB, #FAF8F5, #E5E0D8, #5C6B56, #C8A878, #1A1A1A)
{% endcomment %}

<div class="customer-addresses-wrapper min-h-[75vh] py-10 md:py-14 px-4 sm:px-6 lg:px-8 bg-linen">
  <div class="max-w-6xl mx-auto">
    
    <!-- Top Breadcrumb & Back Link -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <nav class="flex items-center gap-2 text-xs uppercase tracking-widest text-ash">
        <a href="{{ routes.root_url }}" class="hover:text-ink transition-colors">Home</a>
        <span class="text-sand">/</span>
        <a href="{{ routes.account_url }}" class="hover:text-ink transition-colors">Club Mile</a>
        <span class="text-sand">/</span>
        <span class="text-ink font-semibold">Rubrica Indirizzi</span>
      </nav>

      <a
        href="{{ routes.account_url }}"
        class="inline-flex items-center gap-1.5 text-xs uppercase tracking-widest text-ash hover:text-ink transition-colors font-semibold"
      >
        <span>&larr; Torna alla Dashboard Account</span>
      </a>
    </div>

    <!-- Page Title & Add New Address Trigger -->
    <div class="bg-white border border-borderLinen p-6 sm:p-8 mb-8 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div>
        <span class="text-[11px] font-mono tracking-widest uppercase text-sage block mb-1">Spedizioni &bull; Ritiro</span>
        <h1 class="font-serif text-3xl sm:text-4xl text-ink font-normal">I Tuoi Indirizzi</h1>
        <p class="text-xs sm:text-sm text-ash mt-1">
          Gestisci gli indirizzi di spedizione per le consegne a domicilio e la fatturazione.
        </p>
      </div>

      <button
        type="button"
        onclick="toggleAddressNewForm()"
        class="bg-ink hover:bg-sage text-white py-3.5 px-6 text-xs uppercase tracking-widest font-semibold transition-all duration-300 shadow-sm cursor-pointer shrink-0 flex items-center justify-center gap-2"
      >
        <span>+ Aggiungi Nuovo Indirizzo</span>
      </button>
    </div>

    <!-- ============================================== -->
    <!-- NEW ADDRESS FORM (Collapsible)                 -->
    <!-- ============================================== -->
    <div id="AddAddressWrapper" class="hidden mb-10 bg-white border border-borderLinen p-6 sm:p-10 shadow-sm">
      <div class="border-b border-borderLinen pb-4 mb-6 flex items-center justify-between">
        <div>
          <h2 class="font-serif text-2xl text-ink font-normal">Aggiungi Nuovo Indirizzo</h2>
          <p class="text-xs text-ash mt-0.5">Inserisci i dettagli per salvare un nuovo recapito di consegna.</p>
        </div>
        <button
          type="button"
          onclick="toggleAddressNewForm()"
          class="text-ash hover:text-ink text-xl font-mono px-2 cursor-pointer"
          aria-label="Chiudi form"
        >
          &times;
        </button>
      </div>

      {% form 'customer_address', customer.new_address, class: 'space-y-5', novalidate: 'novalidate' %}
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="AddressFirstNameNew" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1">Nome *</label>
            <input type="text" name="address[first_name]" id="AddressFirstNameNew" value="{{ form.first_name }}" autocomplete="given-name" required class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink focus:bg-white focus:border-sage focus:outline-none">
          </div>
          <div>
            <label for="AddressLastNameNew" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1">Cognome *</label>
            <input type="text" name="address[last_name]" id="AddressLastNameNew" value="{{ form.last_name }}" autocomplete="family-name" required class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink focus:bg-white focus:border-sage focus:outline-none">
          </div>
        </div>

        <div>
          <label for="AddressCompanyNew" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1">Azienda (Opzionale)</label>
          <input type="text" name="address[company]" id="AddressCompanyNew" value="{{ form.company }}" autocomplete="organization" class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink focus:bg-white focus:border-sage focus:outline-none">
        </div>

        <div>
          <label for="AddressAddress1New" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1">Indirizzo e Numero Civico *</label>
          <input type="text" name="address[address1]" id="AddressAddress1New" value="{{ form.address1 }}" autocomplete="address-line1" required placeholder="es. Corso Cavour 18" class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink focus:bg-white focus:border-sage focus:outline-none">
        </div>

        <div>
          <label for="AddressAddress2New" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1">Scala / Interno / Dettagli Aggiuntivi (Opzionale)</label>
          <input type="text" name="address[address2]" id="AddressAddress2New" value="{{ form.address2 }}" autocomplete="address-line2" placeholder="es. Scala B, Interno 4" class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink focus:bg-white focus:border-sage focus:outline-none">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="AddressCityNew" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1">Citt&agrave; *</label>
            <input type="text" name="address[city]" id="AddressCityNew" value="{{ form.city }}" autocomplete="address-level2" required placeholder="Verona" class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink focus:bg-white focus:border-sage focus:outline-none">
          </div>
          <div>
            <label for="AddressCountryNew" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1">Paese *</label>
            <select name="address[country]" id="AddressCountryNew" data-default="{{ form.country | default: 'Italy' }}" autocomplete="country" class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink focus:bg-white focus:border-sage focus:outline-none">
              {{ all_country_option_tags }}
            </select>
          </div>
          <div>
            <label for="AddressZipNew" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1">CAP *</label>
            <input type="text" name="address[zip]" id="AddressZipNew" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" required placeholder="37121" class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink focus:bg-white focus:border-sage focus:outline-none">
          </div>
        </div>

        <div>
          <label for="AddressPhoneNew" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1">Telefono per la consegna</label>
          <input type="tel" name="address[phone]" id="AddressPhoneNew" value="{{ form.phone }}" autocomplete="tel" placeholder="+39 340 1234567" class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink focus:bg-white focus:border-sage focus:outline-none">
        </div>

        <!-- Default Address Checkbox -->
        <div class="pt-2">
          <label class="flex items-center gap-2 text-xs text-ink cursor-pointer">
            <input type="checkbox" id="address_default_address_new" name="address[default]" value="1" class="accent-[#5C6B56]">
            <span>Imposta questo recapito come indirizzo predefinito</span>
          </label>
        </div>

        <!-- Actions -->
        <div class="pt-4 flex flex-wrap items-center gap-4">
          <button
            type="submit"
            class="bg-ink hover:bg-sage text-white py-3.5 px-6 text-xs uppercase tracking-widest font-semibold transition-colors cursor-pointer"
          >
            Salva Indirizzo
          </button>
          <button
            type="button"
            onclick="toggleAddressNewForm()"
            class="py-3.5 px-6 border border-borderLinen text-ash hover:text-ink text-xs uppercase tracking-widest transition-colors cursor-pointer"
          >
            Annulla
          </button>
        </div>

      {% endform %}
    </div>

    <!-- ============================================== -->
    <!-- EXISTING ADDRESSES LIST                        -->
    <!-- ============================================== -->
    {% paginate customer.addresses by 6 %}
      {% if customer.addresses.size > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {% for address in customer.addresses %}
            <div class="bg-white border {% if address == customer.default_address %}border-sage shadow-md{% else %}border-borderLinen shadow-sm{% endif %} p-6 flex flex-col justify-between relative">
              
              <div>
                <!-- Default Tag -->
                {% if address == customer.default_address %}
                  <div class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-[#FAF8F5] border border-sage/40 text-sage text-[10px] font-mono tracking-wider uppercase font-semibold mb-4">
                    <span class="w-1.5 h-1.5 rounded-full bg-sage"></span>
                    Indirizzo Predefinito
                  </div>
                {% endif %}

                <h3 class="font-serif text-xl text-ink font-normal mb-2">
                  {{ address.first_name }} {{ address.last_name }}
                </h3>

                <div class="text-xs sm:text-sm text-ash leading-relaxed space-y-1 mb-6">
                  {% if address.company != blank %}
                    <p class="font-medium text-ink">{{ address.company }}</p>
                  {% endif %}
                  <p>{{ address.address1 }}</p>
                  {% if address.address2 != blank %}
                    <p>{{ address.address2 }}</p>
                  {% endif %}
                  <p>{{ address.city }}, {{ address.zip }}</p>
                  <p>{{ address.country }}</p>
                  {% if address.phone != blank %}
                    <p class="pt-1 text-ink font-mono">{{ address.phone }}</p>
                  {% endif %}
                </div>
              </div>

              <!-- Actions Buttons -->
              <div class="pt-4 border-t border-borderLinen flex items-center justify-between text-xs">
                <button
                  type="button"
                  onclick="toggleEditAddress('{{ address.id }}')"
                  class="text-ink font-semibold hover:text-amber transition-colors uppercase tracking-wider underline underline-offset-4 cursor-pointer"
                >
                  Modifica
                </button>

                <form
                  method="post"
                  action="/account/addresses/{{ address.id }}"
                  onsubmit="return confirm('Sei sicuro di voler eliminare questo indirizzo?');"
                >
                  <input type="hidden" name="_method" value="delete">
                  <button
                    type="submit"
                    class="text-ash hover:text-[#9E2A2B] transition-colors uppercase tracking-wider cursor-pointer"
                  >
                    Elimina
                  </button>
                </form>
              </div>

              <!-- ============================================== -->
              <!-- EDIT ADDRESS FORM (Collapsible per address)    -->
              <!-- ============================================== -->
              <div id="EditAddressWrapper_{{ address.id }}" class="hidden mt-6 pt-6 border-t border-borderLinen">
                <h4 class="font-serif text-lg text-ink mb-4">Modifica Indirizzo</h4>

                {% form 'customer_address', address, class: 'space-y-4', novalidate: 'novalidate' %}
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-[11px] uppercase tracking-wider font-semibold text-ink mb-1">Nome *</label>
                      <input type="text" name="address[first_name]" value="{{ form.first_name }}" required class="w-full px-3 py-2 bg-[#FAF8F5] border border-borderLinen text-xs text-ink focus:bg-white focus:border-sage focus:outline-none">
                    </div>
                    <div>
                      <label class="block text-[11px] uppercase tracking-wider font-semibold text-ink mb-1">Cognome *</label>
                      <input type="text" name="address[last_name]" value="{{ form.last_name }}" required class="w-full px-3 py-2 bg-[#FAF8F5] border border-borderLinen text-xs text-ink focus:bg-white focus:border-sage focus:outline-none">
                    </div>
                  </div>

                  <div>
                    <label class="block text-[11px] uppercase tracking-wider font-semibold text-ink mb-1">Azienda</label>
                    <input type="text" name="address[company]" value="{{ form.company }}" class="w-full px-3 py-2 bg-[#FAF8F5] border border-borderLinen text-xs text-ink focus:bg-white focus:border-sage focus:outline-none">
                  </div>

                  <div>
                    <label class="block text-[11px] uppercase tracking-wider font-semibold text-ink mb-1">Indirizzo *</label>
                    <input type="text" name="address[address1]" value="{{ form.address1 }}" required class="w-full px-3 py-2 bg-[#FAF8F5] border border-borderLinen text-xs text-ink focus:bg-white focus:border-sage focus:outline-none">
                  </div>

                  <div>
                    <label class="block text-[11px] uppercase tracking-wider font-semibold text-ink mb-1">Scala / Interno</label>
                    <input type="text" name="address[address2]" value="{{ form.address2 }}" class="w-full px-3 py-2 bg-[#FAF8F5] border border-borderLinen text-xs text-ink focus:bg-white focus:border-sage focus:outline-none">
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                      <label class="block text-[11px] uppercase tracking-wider font-semibold text-ink mb-1">Citt&agrave; *</label>
                      <input type="text" name="address[city]" value="{{ form.city }}" required class="w-full px-3 py-2 bg-[#FAF8F5] border border-borderLinen text-xs text-ink focus:bg-white focus:border-sage focus:outline-none">
                    </div>
                    <div>
                      <label class="block text-[11px] uppercase tracking-wider font-semibold text-ink mb-1">Paese *</label>
                      <select name="address[country]" data-default="{{ form.country }}" class="w-full px-3 py-2 bg-[#FAF8F5] border border-borderLinen text-xs text-ink focus:bg-white focus:border-sage focus:outline-none">
                        {{ all_country_option_tags }}
                      </select>
                    </div>
                    <div>
                      <label class="block text-[11px] uppercase tracking-wider font-semibold text-ink mb-1">CAP *</label>
                      <input type="text" name="address[zip]" value="{{ form.zip }}" required class="w-full px-3 py-2 bg-[#FAF8F5] border border-borderLinen text-xs text-ink focus:bg-white focus:border-sage focus:outline-none">
                    </div>
                  </div>

                  <div>
                    <label class="block text-[11px] uppercase tracking-wider font-semibold text-ink mb-1">Telefono</label>
                    <input type="tel" name="address[phone]" value="{{ form.phone }}" class="w-full px-3 py-2 bg-[#FAF8F5] border border-borderLinen text-xs text-ink focus:bg-white focus:border-sage focus:outline-none">
                  </div>

                  <div class="pt-1">
                    <label class="flex items-center gap-2 text-xs text-ink cursor-pointer">
                      <input type="checkbox" name="address[default]" value="1" {% if address == customer.default_address %}checked{% endif %} class="accent-[#5C6B56]">
                      <span>Imposta come predefinito</span>
                    </label>
                  </div>

                  <div class="pt-2 flex items-center gap-3">
                    <button type="submit" class="bg-ink hover:bg-sage text-white py-2.5 px-4 text-xs uppercase tracking-widest font-semibold transition-colors cursor-pointer">
                      Aggiorna
                    </button>
                    <button type="button" onclick="toggleEditAddress('{{ address.id }}')" class="py-2.5 px-4 border border-borderLinen text-ash hover:text-ink text-xs uppercase tracking-widest cursor-pointer">
                      Chiudi
                    </button>
                  </div>
                {% endform %}
              </div>

            </div>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="mt-8 pt-6 border-t border-borderLinen flex items-center justify-center gap-2 text-xs">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" class="px-3 py-1.5 border border-borderLinen text-ink hover:bg-linen">&larr; Precedente</a>
            {% endif %}
            <span class="px-3 py-1.5 text-ash">Pagina {{ paginate.current_page }} di {{ paginate.pages }}</span>
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" class="px-3 py-1.5 border border-borderLinen text-ink hover:bg-linen">Successiva &rarr;</a>
            {% endif %}
          </div>
        {% endif %}

      {% else %}
        <div class="bg-white border border-dashed border-borderLinen p-12 text-center">
          <p class="text-sm text-ash mb-4">Non hai ancora inserito alcun indirizzo nella tua rubrica.</p>
          <button
            type="button"
            onclick="toggleAddressNewForm()"
            class="bg-ink hover:bg-sage text-white py-3 px-6 text-xs uppercase tracking-widest font-semibold transition-colors cursor-pointer"
          >
            Aggiungi il tuo primo indirizzo
          </button>
        </div>
      {% endif %}
    {% endpaginate %}

  </div>
</div>

<script>
  function toggleAddressNewForm() {
    var wrapper = document.getElementById('AddAddressWrapper');
    if (wrapper) {
      wrapper.classList.toggle('hidden');
      if (!wrapper.classList.contains('hidden')) {
        wrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  }

  function toggleEditAddress(addressId) {
    var wrapper = document.getElementById('EditAddressWrapper_' + addressId);
    if (wrapper) {
      wrapper.classList.toggle('hidden');
    }
  }
</script>


{% schema %}
{
  "name": "Indirizzi Cliente",
  "settings": []
}
{% endschema %}