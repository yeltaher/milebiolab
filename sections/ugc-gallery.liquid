<section class="py-20 bg-white border-b border-[#DDD7CE]/50 ugc-splendor-section" id="ugc-gallery-{{ section.id }}">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    
    <div class="text-center mb-12">
      {% if section.settings.tag != blank %}
      <span class="text-xs uppercase tracking-[0.25em] text-[#5C6B56] font-medium block mb-2">{{ section.settings.tag }}</span>
      {% endif %}
      <h2 class="font-serif italic text-3xl sm:text-4xl text-[#1A1A1A] leading-tight mb-3">
        {{ section.settings.title }}
      </h2>
      <p class="text-xs uppercase tracking-[0.25em] text-[#7A7265] font-medium">
        {{ section.settings.hashtags }}
      </p>
    </div>

    <!-- 5 Portraits Horizontal Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
      {% for block in section.blocks limit: 5 %}
      <div class="bg-[#F5F2EB] p-3 border border-[#DDD7CE]/60 flex flex-col group hover:shadow-md transition-shadow" {{ block.shopify_attributes }}>
        <div class="aspect-[3/4] overflow-hidden mb-3 bg-white">
          <img src="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 500 }}{% else %}https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=500&q=80{% endif %}" 
               onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
               class="w-full h-full object-cover transition-transform duration-500" alt="{{ block.settings.author | default: 'UGC' | escape }}">
        </div>
        <div class="text-[#C8A878] text-xs mb-1">★★★★★</div>
        <p class="text-[11px] text-[#1A1A1A] font-medium leading-tight mb-1">"{{ block.settings.review | default: 'La luminosità sul viso dopo soli 5 giorni è sorprendente.' }}"</p>
        <span class="text-[10px] text-[#7A7265] tracking-wider uppercase mt-auto">{{ block.settings.author | default: '@elena.glow &bull; Verona' }}</span>
      </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "UGC Gallery Mile",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag Sezione",
      "default": "COMMUNITY & RISULTATI REALI"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo",
      "default": "Pelle reale. Risultati reali. Amato da migliaia."
    },
    {
      "type": "text",
      "id": "hashtags",
      "label": "Hashtags Ufficiali",
      "default": "#MySkinRoutine • #GlowDaily • Verona & International"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Foto UGC",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Immagine"
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Recensione"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Autore e Luogo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC Gallery Mile",
      "category": "Social Proof",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
