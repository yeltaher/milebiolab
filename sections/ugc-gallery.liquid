<section class="py-20 bg-white border-b border-[#DDD7CE]/50 ugc-splendor-section" id="ugc-gallery-{{ section.id }}">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    
    <div class="text-center mb-12">
      {% if section.settings.tag != blank %}
      <span class="text-xs uppercase tracking-[0.25em] text-[#5C6B56] font-medium block mb-2">{{ section.settings.tag }}</span>
      {% endif %}
      <h2 class="font-serif italic text-3xl sm:text-4xl text-[#1A1A1A] leading-tight mb-3">
        {{ section.settings.title }}
      </h2>
      <p class="text-xs uppercase tracking-[0.25em] text-[#7A7265] font-medium">
        {{ section.settings.hashtags }}
      </p>
    </div>

    <!-- 5 Portraits Horizontal Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
      
      <!-- Portrait 1 -->
      <div class="bg-[#F5F2EB] p-3 border border-[#DDD7CE]/60 flex flex-col group hover:shadow-md transition-shadow">
        <div class="aspect-[3/4] overflow-hidden mb-3 bg-white">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=500&q=80" 
               onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Elena M.">
        </div>
        <div class="text-[#C8A878] text-xs mb-1">★★★★★</div>
        <p class="text-[11px] text-[#1A1A1A] font-medium leading-tight mb-1">"La luminosità sul viso dopo soli 5 giorni è sorprendente."</p>
        <span class="text-[10px] text-[#7A7265] tracking-wider uppercase mt-auto">@elena.glow &bull; Verona</span>
      </div>

      <!-- Portrait 2 -->
      <div class="bg-[#F5F2EB] p-3 border border-[#DDD7CE]/60 flex flex-col group hover:shadow-md transition-shadow">
        <div class="aspect-[3/4] overflow-hidden mb-3 bg-white">
          <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=500&q=80" 
               onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Giulia F.">
        </div>
        <div class="text-[#C8A878] text-xs mb-1">★★★★★</div>
        <p class="text-[11px] text-[#1A1A1A] font-medium leading-tight mb-1">"Il Golden Glow Body Oil non unge affatto e idrata tutto il giorno."</p>
        <span class="text-[10px] text-[#7A7265] tracking-wider uppercase mt-auto">@giulia_m &bull; Milano</span>
      </div>

      <!-- Portrait 3 -->
      <div class="bg-[#F5F2EB] p-3 border border-[#DDD7CE]/60 flex flex-col group hover:shadow-md transition-shadow">
        <div class="aspect-[3/4] overflow-hidden mb-3 bg-white">
          <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=500&q=80" 
               onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Sofia L.">
        </div>
        <div class="text-[#C8A878] text-xs mb-1">★★★★★</div>
        <p class="text-[11px] text-[#1A1A1A] font-medium leading-tight mb-1">"Adoro il ritiro in sede a Verona in 2h. Servizio impeccabile!"</p>
        <span class="text-[10px] text-[#7A7265] tracking-wider uppercase mt-auto">@sofia_skincare &bull; Verona</span>
      </div>

      <!-- Portrait 4 -->
      <div class="bg-[#F5F2EB] p-3 border border-[#DDD7CE]/60 flex flex-col group hover:shadow-md transition-shadow">
        <div class="aspect-[3/4] overflow-hidden mb-3 bg-white">
          <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=500&q=80" 
               onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Valentina C.">
        </div>
        <div class="text-[#C8A878] text-xs mb-1">★★★★★</div>
        <p class="text-[11px] text-[#1A1A1A] font-medium leading-tight mb-1">"Texture impalpabile che sembra seta sulla pelle sensibile."</p>
        <span class="text-[10px] text-[#7A7265] tracking-wider uppercase mt-auto">@valentina_v &bull; Bologna</span>
      </div>

      <!-- Portrait 5 -->
      <div class="bg-[#F5F2EB] p-3 border border-[#DDD7CE]/60 flex flex-col group hover:shadow-md transition-shadow">
        <div class="aspect-[3/4] overflow-hidden mb-3 bg-white">
          <img src="https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=500&q=80" 
               onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Camilla R.">
        </div>
        <div class="text-[#C8A878] text-xs mb-1">★★★★★</div>
        <p class="text-[11px] text-[#1A1A1A] font-medium leading-tight mb-1">"Balsamo miracoloso. La mia barriera cutanea è finalmente guarita."</p>
        <span class="text-[10px] text-[#7A7265] tracking-wider uppercase mt-auto">@camilla_wellness &bull; Roma</span>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "UGC Gallery Splendor",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag Sezione",
      "default": "COMMUNITY & RISULTATI REALI"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo",
      "default": "Pelle reale. Risultati reali. Amato da migliaia."
    },
    {
      "type": "text",
      "id": "hashtags",
      "label": "Hashtags Ufficiali",
      "default": "#MySkinRoutine • #GlowDaily • Verona & International"
    }
  ],
  "presets": [
    {
      "name": "UGC Gallery Splendor",
      "category": "Social Proof"
    }
  ]
}
{% endschema %}
