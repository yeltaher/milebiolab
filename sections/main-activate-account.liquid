{% comment %}
  MILEBIOLAB - TEMPLATE CUSTOMER ACTIVATE ACCOUNT
  Bespoke Haute Couture / Splendor Palette (#F5F2EB, #FAF8F5, #E5E0D8, #5C6B56, #C8A878, #1A1A1A)
{% endcomment %}

<div class="customer-activate-wrapper min-h-[70vh] py-16 px-4 sm:px-6 lg:px-8 bg-linen flex items-center justify-center">
  <div class="max-w-md w-full bg-white border border-borderLinen p-8 sm:p-10 shadow-sm">
    
    <div class="text-center mb-8">
      <span class="text-[11px] font-mono tracking-widest uppercase text-sage block mb-2">Benvenuto nel Club Mile</span>
      <h1 class="font-serif text-3xl text-ink font-normal">Attiva il Tuo Account</h1>
      <p class="text-xs sm:text-sm text-ash mt-2 leading-relaxed">
        Crea la tua password per completare l'attivazione del tuo profilo e sbloccare i tuoi privilegi esclusivi.
      </p>
    </div>

    {% form 'activate_customer_password', class: 'space-y-5', novalidate: 'novalidate' %}
      {% if form.errors %}
        <div class="p-4 bg-[#FFF5F5] border border-[#E5A8A8] text-[#9E2A2B] text-xs">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div>
        <label for="ActivatePassword" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1.5">
          Password <span class="text-sage">*</span>
        </label>
        <input
          type="password"
          name="customer[password]"
          id="ActivatePassword"
          autocomplete="new-password"
          required
          placeholder="Almeno 6 caratteri"
          class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink placeholder-ash/50 focus:bg-white focus:border-sage focus:outline-none transition-colors"
          {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}
        >
      </div>

      <div>
        <label for="ActivatePasswordConfirmation" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1.5">
          Conferma Password <span class="text-sage">*</span>
        </label>
        <input
          type="password"
          name="customer[password_confirmation]"
          id="ActivatePasswordConfirmation"
          autocomplete="new-password"
          required
          placeholder="Ripeti la password"
          class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink placeholder-ash/50 focus:bg-white focus:border-sage focus:outline-none transition-colors"
          {% if form.errors contains 'password_confirmation' %}aria-invalid="true"{% endif %}
        >
      </div>

      <div class="pt-2 space-y-3">
        <button
          type="submit"
          class="w-full bg-ink hover:bg-sage text-white py-4 px-6 text-xs uppercase tracking-widest font-semibold transition-all duration-300 shadow-sm cursor-pointer flex items-center justify-center gap-2"
        >
          <span>Attiva il Tuo Account</span>
          <span class="text-amber">&rarr;</span>
        </button>

        <button
          type="submit"
          name="decline"
          class="w-full py-3 text-xs uppercase tracking-widest text-ash hover:text-[#9E2A2B] transition-colors cursor-pointer text-center"
        >
          Rifiuta Invito
        </button>
      </div>
    {% endform %}

  </div>
</div>


{% schema %}
{
  "name": "Attiva Account",
  "settings": []
}
{% endschema %}