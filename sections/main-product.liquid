<!-- 3. Breadcrumbs -->
<div class="max-w-7xl mx-auto px-6 lg:px-12 py-3 text-[11px] tracking-wider uppercase text-ash flex items-center gap-2">
    <a href="/" class="hover:text-ink transition-colors">Home</a>
    <span>/</span>
    {%- assign product_collection = collection -%}
    {%- if product_collection == blank and product.collections.size > 0 -%}
      {%- for c in product.collections -%}
        {%- unless c.handle == 'all' or c.handle == 'frontpage' -%}
          {%- assign product_collection = c -%}
          {%- break -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- if product_collection == blank -%}
        {%- assign product_collection = product.collections.first -%}
      {%- endif -%}
    {%- endif -%}
    {%- if product_collection -%}
      <a href="{{ product_collection.url }}" class="hover:text-ink transition-colors">{{ product_collection.title }}</a>
    {%- else -%}
      <a href="{{ routes.all_products_collection_url }}" class="hover:text-ink transition-colors">Trattamenti</a>
    {%- endif -%}
    <span>/</span>
    <span class="text-ink font-medium">{{ product.title | default: section.settings.product_title }}</span>
</div>

    <!-- 4. Above-the-Fold Product Section (100% Faithful to Reference) -->
    <section id="pdp-hero" class="max-w-7xl mx-auto px-6 lg:px-12 pb-20 pt-2 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

        <!-- Left: Gallery with Thumbnails & Pointer Callouts & Certification Seals (Col 7) -->
        <div class="lg:col-span-7 flex flex-col-reverse md:flex-row gap-4 sm:gap-6 items-start w-full">

            <!-- 5 Vertical Thumbnails (Gallery on Desktop, Horizontal Scroll on Mobile) -->
            <div class="flex md:flex-col gap-2 overflow-x-auto md:overflow-visible w-full md:w-20 flex-shrink-0 slider-no-scrollbar py-1">
                {% for media in product.media %}
                    <button type="button" onclick="changeMainImage('{{ media | image_url: width: 1200 }}', this, {{ forloop.index0 }})"
                            class="thumb-btn {% if forloop.first %}thumb-active border-2 border-ink{% else %}border border-borderLinen opacity-70 hover:opacity-100{% endif %} aspect-square w-14 sm:w-16 md:w-20 overflow-hidden bg-white p-1 transition-all flex-shrink-0 luxury-interactive"
                            aria-label="{{ media.alt | escape }}">
                        {{ media | image_url: width: 400 | image_tag: class: 'w-full h-full object-cover', alt: media.alt }}
                    </button>
                {% endfor %}
            </div>

            <!-- Main Big Image Container with Callouts & Badges -->
            <div class="w-full flex flex-col">
                <div id="pdp-main-gallery-box" class="relative w-full aspect-[4/5] sm:aspect-square bg-white border border-borderLinen shadow-md overflow-hidden flex items-center justify-center p-2 sm:p-4 select-none touch-pan-y">

                    <!-- 4 Circular Line-Art Certification Seals Top Right (Responsive Sizes) -->
                    <div class="absolute top-3 right-3 sm:top-4 sm:right-4 z-20 flex gap-1.5 sm:gap-2">

                        <!-- Seal 1: Cruelty free (Bunny) -->
                        <div class="w-8 h-8 sm:w-10 sm:h-10 md:w-11 md:h-11 rounded-full border border-[#7A7265]/40 bg-[#F5F2EB]/95 backdrop-blur-sm flex items-center justify-center shadow-xs transition-transform" title="Cruelty Free Approved">
                            <svg class="w-4 h-4 sm:w-5 sm:h-5 md:w-6 md:h-6 text-[#1A1A1A]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 23C16.8 18 13.5 9 16.5 6.5C19.5 4 22.5 12 22.5 19.5" />
                                <path d="M29 23C31.2 18 34.5 9 31.5 6.5C28.5 4 25.5 12 25.5 19.5" />
                                <path d="M15 22.5C12 26 12 33 16.5 37.5C21 42 27 42 31.5 37.5C36 33 36 26 33 22.5" />
                                <circle cx="18.5" cy="27" r="1.2" fill="currentColor" stroke="none" />
                                <circle cx="29.5" cy="27" r="1.2" fill="currentColor" stroke="none" />
                                <path d="M22.5 30.5L24 32L25.5 30.5Z" fill="currentColor" />
                                <line x1="11" y1="30" x2="15" y2="30.5" stroke-width="1.1" />
                                <line x1="11" y1="33" x2="15" y2="33" stroke-width="1.1" />
                                <line x1="37" y1="30" x2="33" y2="30.5" stroke-width="1.1" />
                                <line x1="37" y1="33" x2="33" y2="33" stroke-width="1.1" />
                            </svg>
                        </div>

                        <!-- Seal 2: Organic (Botanical Leaves) -->
                        <div class="w-8 h-8 sm:w-10 sm:h-10 md:w-11 md:h-11 rounded-full border border-[#7A7265]/40 bg-[#F5F2EB]/95 backdrop-blur-sm flex items-center justify-center shadow-xs transition-transform" title="100% Certified Organic">
                            <svg class="w-4 h-4 sm:w-5 sm:h-5 md:w-6 md:h-6 text-[#1A1A1A]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M23 38C23 38 13.5 31.5 12.5 18.5C17 15 26.5 19.5 27.5 31.5" />
                                <path d="M12.5 18.5C18 23 22.5 28.5 24.5 36" stroke-width="1.1" />
                                <path d="M15.5 21.5L19 24.5" stroke-width="0.9" />
                                <path d="M25 32.5C27.5 28 34 26 37 19.5C35 28.5 30.5 33 25 35" />
                                <path d="M37 19.5C33.5 23 30 27.5 26 32.5" stroke-width="1.1" />
                            </svg>
                        </div>

                        <!-- Seal 3: Vegan (Twin Leaves Stem) -->
                        <div class="w-8 h-8 sm:w-10 sm:h-10 md:w-11 md:h-11 rounded-full border border-[#7A7265]/40 bg-[#F5F2EB]/95 backdrop-blur-sm flex items-center justify-center shadow-xs transition-transform" title="100% Vegan Formulation">
                            <svg class="w-4 h-4 sm:w-5 sm:h-5 md:w-6 md:h-6 text-[#1A1A1A]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 39C22 32 23 23 24 14" />
                                <path d="M22 31C18 28 15 19 18 11.5C21.5 15.5 23 22 23 27" />
                                <path d="M23.5 24C26.5 21 35.5 15.5 36.5 11C37.5 17.5 32 27 24 28" />
                                <path d="M25 22C28.5 18.5 33 15 35.5 12" stroke-width="1.1" />
                            </svg>
                        </div>

                        <!-- Seal 4: No additives (Lab Flask) -->
                        <div class="w-8 h-8 sm:w-10 sm:h-10 md:w-11 md:h-11 rounded-full border border-[#7A7265]/40 bg-[#F5F2EB]/95 backdrop-blur-sm flex items-center justify-center shadow-xs transition-transform" title="No Additives / Pure Biomimetic">
                            <svg class="w-4 h-4 sm:w-5 sm:h-5 md:w-6 md:h-6 text-[#1A1A1A]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19.5 11.5H28.5" />
                                <path d="M21.5 11.5V16.5L13 33.5C12 35.5 13 37 15.5 37H32.5C35 37 36 35.5 35 33.5L26.5 16.5V11.5" />
                                <path d="M17 27.5H31" stroke-dasharray="2 1.5" stroke-width="1" />
                                <circle cx="23.5" cy="32.5" r="1.3" fill="none" stroke-width="1.1" />
                                <line x1="10" y1="38" x2="38" y2="10" stroke-width="1.3" />
                            </svg>
                        </div>

                    </div>

                    <!-- Main Image (Base Layer) -->
                    <img id="main-product-img"
                         src="{{ product.featured_media | image_url: width: 1200 }}"
                         alt="{{ product.featured_media.alt | escape }}"
                         class="w-full h-full object-cover">

                    <!-- Smooth Crossfade Incoming Layer -->
                    <img id="main-product-img-fade"
                         src="{{ product.featured_media | image_url: width: 1200 }}"
                         alt="{{ product.featured_media.alt | escape }}"
                         class="absolute inset-0 w-full h-full object-cover p-2 sm:p-4 opacity-0 pointer-events-none"
                         aria-hidden="true">

                    <!-- Dedicated PDP Callouts Overlay (Belongs exclusively to Slide 1 - Jar/Bottle) -->
                    <div id="pdp-callouts" class="absolute inset-0 pointer-events-none transition-all duration-300 ease-out opacity-100 visible z-20">

                        {% for block in section.blocks %}
                            {% if block.type == 'hotspot' %}
                                <div class="callout-wrapper absolute flex items-center gap-1.5 sm:gap-3 pointer-events-auto transition-transform duration-300" style="top: {{ block.settings.top_position }}%; left: {{ block.settings.left_position }}%;">
                                    <div class="bg-white/95 backdrop-blur-md border border-borderLinen py-1 px-2 sm:py-1.5 sm:px-3 shadow-xs rounded-xs max-w-[125px] sm:max-w-none">
                                        <span class="text-[8px] sm:text-[10px] uppercase tracking-wider font-semibold text-ink block leading-tight">{{ block.settings.title }}</span>
                                        <span class="text-[7.5px] sm:text-[9px] text-ash block leading-tight mt-0.5">{{ block.settings.subtitle }}</span>
                                    </div>
                                    <div class="w-4 sm:w-8 h-px bg-ink/60"></div>
                                    <div class="callout-dot -ml-1" title="{{ block.settings.title | escape }}"></div>
                                </div>
                            {% endif %}
                        {% endfor %}

                    </div>

                </div>

                <!-- Mobile Gallery Pagination Dots -->
                <div class="flex md:hidden justify-center items-center gap-1.5 mt-3" id="pdp-dots">
                    {% for media in product.media %}
                        <button type="button" onclick="selectSlideByIndex({{ forloop.index0 }})" class="pdp-dot {% if forloop.first %}w-6 bg-ink{% else %}w-2 bg-borderLinen{% endif %} h-1 rounded-full transition-all" aria-label="Immagine {{ forloop.index }}"></button>
                    {% endfor %}
                </div>
            </div>

        </div>

        <!-- Right: Sticky Product Purchase & Information Column (Col 5) - Haute Couture Buy Box -->
        <div class="lg:col-span-5 lg:sticky lg:top-24 space-y-5">
            {%- assign clean_pdp_title = product.title | default: section.settings.product_title | default: "Crema Riparatrice Cellulare Suprema" -%}
            {%- form 'product', product, id: 'product_form', class: 'product-form' -%}
            <input type="hidden" name="id" id="selected-variant-id" value="{{ product.selected_or_first_available_variant.id | default: 1 }}">
            {%- for block in section.blocks -%}
                {%- case block.type -%}
                    {%- when '@app' -%}
                        <div class="product-block-app" {{ block.shopify_attributes }}>
                            {% render block %}
                        </div>

                    {%- when 'title' -%}
                        <div class="pt-1" {{ block.shopify_attributes }}>
                            <div class="flex items-center justify-between mb-2">
                                <a href="#reviews" class="flex items-center gap-2 group">
                                    <div class="flex items-center text-[#706E6B] text-[13px] tracking-[-1px]">
                                        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                                    </div>
                                    <span id="pdp-top-reviews-summary" class="text-xs text-[#706E6B] font-sans font-normal tracking-tight group-hover:text-ink transition-colors">
                                        {%- assign p_title_low = product.title | default: section.settings.product_title | downcase -%}
                                        {%- assign p_handle_low = product.handle | downcase -%}
                                        {%- if p_handle_low contains 'unicho' or p_title_low contains 'unicho' or p_title_low contains 'burro primordiale' -%}
                                            4.9/5 &middot; 28 recensioni
                                        {%- else -%}
                                            4.9/5 &middot; 14 recensioni
                                        {%- endif -%}
                                    </span>
                                </a>
                                <div class="border border-black px-3 py-0.5 text-[11px] uppercase tracking-wider font-medium text-black">
                                    NOVITÀ
                                </div>
                            </div>
                            {%- assign clean_pdp_title = product.title | default: section.settings.product_title | default: "Crema Riparatrice Cellulare Suprema" -%}
                            <h1 class="font-sans font-bold text-xl sm:text-2xl md:text-[28px] tracking-tight text-ink uppercase leading-none">
                                {{ clean_pdp_title }}
                            </h1>
                        </div>

                    {%- when 'subtitle' -%}
                        {%- assign display_subtitle = '' -%}
                        {%- if product.metafields.custom.subtitle != blank -%}
                            {%- assign display_subtitle = product.metafields.custom.subtitle -%}
                        {%- elsif product.type != blank and product.type != 'Default' and product.type != 'Trattamento Biomimetico' -%}
                            {%- assign display_subtitle = product.type -%}
                        {%- elsif block.settings.text != blank and block.settings.text != 'Balsamo-Olio Rigenerante' -%}
                            {%- assign display_subtitle = block.settings.text -%}
                        {%- endif -%}
                        {%- if display_subtitle != blank -%}
                        <p class="font-sans text-xs tracking-wider text-[#7A7265] mt-2 font-normal" {{ block.shopify_attributes }}>
                            {{ display_subtitle }}
                        </p>
                        {%- endif -%}

                    {%- when 'price' -%}
                        <div class="flex items-center justify-between pt-2 mb-4" {{ block.shopify_attributes }}>
                            <div class="flex items-center gap-2 sm:gap-2.5">
                                {% unless product.has_only_default_variant %}
                                    {% for variant in product.variants %}
                                        <button type="button"
                                                onclick="selectFormat('{{ variant.id }}', {{ variant.price | divided_by: 100.0 }}, '{{ variant.title | escape }}', this, '{{ variant.price | money }}', '+{{ variant.price | divided_by: 100 }}', '{{ variant.id }}')"
                                                class="format-pill {% if variant.id == product.selected_or_first_available_variant.id %}bg-black text-white{% else %}border border-black/40 text-black hover:border-black bg-transparent{% endif %} min-h-[42px] px-3.5 py-1.5 text-xs font-bold tracking-wider transition-all luxury-interactive flex items-center justify-center">
                                            {{ variant.title }}
                                        </button>
                                    {% endfor %}
                                {% endunless %}

                                <button id="wishlist-btn" type="button"
                                        onclick="togglePdpWishlist(this)"
                                        data-product-id="{{ product.id }}"
                                        data-product-title="{{ clean_pdp_title | default: product.title | default: section.settings.product_title | escape }}"
                                        data-product-price="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 | default: 84.00 }}"
                                        data-product-image="{{ product.featured_media | image_url: width: 300 }}"
                                        class="min-h-[42px] min-w-[42px] flex items-center justify-center p-1.5 text-black hover:opacity-70 transition-transform active:scale-90 ml-1 luxury-interactive"
                                        aria-label="Aggiungi alla lista desideri">
                                    <svg id="wishlist-svg" class="w-5 h-5 transition-colors" fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                                    </svg>
                                </button>
                            </div>
                            <div class="text-right flex items-center justify-end">
                                <span id="product-price" class="text-[13px] sm:text-sm font-normal tracking-normal text-[#555E6B] select-none">
                                    {% if product.selected_or_first_available_variant.price %}
                                        {{ product.selected_or_first_available_variant.price | money }}
                                    {% else %}
                                        76,00 &euro;
                                    {% endif %}
                                </span>
                            </div>
                        </div>

                    {%- when 'bullet_list' -%}
                        {%- assign desc_check = product.description | downcase -%}
                        {%- assign natural_badge = '' -%}
                        {%- assign nat_pct = '' -%}
                        {%- if desc_check contains '100%' or desc_check contains '100 %' -%}
                            {%- assign nat_pct = '100%' -%}
                        {%- elsif desc_check contains '99%' or desc_check contains '99 %' -%}
                            {%- assign nat_pct = '99%' -%}
                        {%- elsif desc_check contains '98%' or desc_check contains '98 %' -%}
                            {%- assign nat_pct = '98%' -%}
                        {%- elsif desc_check contains '97%' or desc_check contains '97 %' -%}
                            {%- assign nat_pct = '97%' -%}
                        {%- elsif desc_check contains '96%' or desc_check contains '96 %' -%}
                            {%- assign nat_pct = '96%' -%}
                        {%- elsif desc_check contains '95%' or desc_check contains '95 %' -%}
                            {%- assign nat_pct = '95%' -%}
                        {%- elsif desc_check contains '94%' or desc_check contains '94 %' -%}
                            {%- assign nat_pct = '94%' -%}
                        {%- elsif desc_check contains '93%' or desc_check contains '93 %' -%}
                            {%- assign nat_pct = '93%' -%}
                        {%- elsif desc_check contains '92%' or desc_check contains '92 %' -%}
                            {%- assign nat_pct = '92%' -%}
                        {%- elsif desc_check contains '91%' or desc_check contains '91 %' -%}
                            {%- assign nat_pct = '91%' -%}
                        {%- elsif desc_check contains '90%' or desc_check contains '90 %' -%}
                            {%- assign nat_pct = '90%' -%}
                        {%- elsif desc_check contains '85%' or desc_check contains '85 %' -%}
                            {%- assign nat_pct = '85%' -%}
                        {%- endif -%}

                        {%- assign is_certified = false -%}
                        {%- if desc_check contains 'ecocert' or desc_check contains 'cosmos' -%}
                            {%- assign is_certified = true -%}
                        {%- endif -%}

                        {%- if nat_pct != blank -%}
                            {%- if is_certified -%}
                                {%- assign natural_badge = nat_pct | append: ' Naturale (Certificato ECOCERT COSMOS)' -%}
                            {%- else -%}
                                {%- assign natural_badge = nat_pct | append: " d'Origine Naturale Certificata" -%}
                            {%- endif -%}
                        {%- elsif is_certified -%}
                            {%- assign natural_badge = '100% Naturale (Certificato ECOCERT COSMOS)' -%}
                        {%- endif -%}

                        <div id="pdp-bullet-list" class="space-y-2 mb-4" {{ block.shopify_attributes }}>
                            {%- if natural_badge != blank -%}
                            <div class="pdp-auto-natural-badge flex items-center gap-2 bg-white/95 rounded-xs p-2 shadow-xs border border-borderLinen">
                                <span class="text-sage font-bold">✓</span><span class="text-xs text-ink font-medium">{{ natural_badge }}</span>
                            </div>
                            {%- endif -%}
                            {%- if block.settings.point_1 != blank -%}
                            <div class="flex items-center gap-2 bg-white/95 rounded-xs p-2 shadow-xs border border-borderLinen">
                                <span class="text-sage font-bold">✓</span><span class="text-xs text-ink">{{ block.settings.point_1 }}</span>
                            </div>
                            {%- endif -%}
                            {%- if block.settings.point_2 != blank -%}
                            <div class="flex items-center gap-2 bg-white/95 rounded-xs p-2 shadow-xs border border-borderLinen">
                                <span class="text-sage font-bold">✓</span><span class="text-xs text-ink">{{ block.settings.point_2 }}</span>
                            </div>
                            {%- endif -%}
                            {%- if block.settings.point_3 != blank -%}
                            <div class="flex items-center gap-2 bg-white/95 rounded-xs p-2 shadow-xs border border-borderLinen">
                                <span class="text-sage font-bold">✓</span><span class="text-xs text-ink">{{ block.settings.point_3 }}</span>
                            </div>
                            {%- endif -%}
                            {%- if block.settings.point_4 != blank -%}
                            <div class="flex items-center gap-2 bg-white/95 rounded-xs p-2 shadow-xs border border-borderLinen">
                                <span class="text-sage font-bold">✓</span><span class="text-xs text-ink">{{ block.settings.point_4 }}</span>
                            </div>
                            {%- endif -%}
                        </div>

                    {%- when 'description' -%}
                        <div id="product-desc-{{ block.id }}" class="product-description-container space-y-2 py-1 text-xs text-[#1A1A1A] mb-4" {{ block.shopify_attributes }}>
                            <div class="raw-description hidden">{{ product.description }}</div>
                            <div class="rendered-description"></div>
                            <script>
                                (function() {
                                    var c = document.getElementById('product-desc-{{ block.id }}');
                                    if (c && typeof window.renderAccordionDescription === 'function') {
                                        window.renderAccordionDescription(c);
                                    }
                                })();
                            </script>
                        </div>
                    {%- when 'loyalty_points' -%}
                        <div class="flex items-center justify-between text-xs text-[#1A1A1A] pt-1 mb-2" {{ block.shopify_attributes }}>
                            <div class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-ink flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="9.5" stroke-width="1.3" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3" d="M8.5 12.5l2.5 2.5 5-5" />
                                </svg>
                                <span class="font-normal text-[11px] sm:text-xs">Oltre 900 clienti soddisfatti</span>
                            </div>
                            <div id="loyalty-points" class="font-medium text-[11px] sm:text-xs text-[#1A1A1A]">
                                {{ block.settings.text }} <a href="/pages/programma-fedelta" class="underline text-[#7A7265] hover:text-[#C8A878] ml-1 text-[10px]">Info Beauty Club</a>
                            </div>
                        </div>

                    {%- when 'pickup' -%}
                        <div class="flex items-center justify-between text-[9px] sm:text-[10px] uppercase tracking-wider text-[#7A7265] pt-0.5 leading-tight mb-2" {{ block.shopify_attributes }}>
                            <div>
                                DISPONIBILE &middot; PREZZO INCL. IVA &middot; {{ block.settings.text }}
                            </div>
                            <div id="unit-price-display" class="font-mono text-right flex-shrink-0 ml-2">
                                SC061 760,00 &euro; / 1 L
                            </div>
                        </div>

                    {%- when 'buy_buttons' -%}
                        <div class="mb-4" {{ block.shopify_attributes }}>
                            <button id="add-to-cart-btn"
                                    type="submit"
                                    class="w-full bg-black text-white py-4 px-6 min-h-[50px] rounded-none text-xs uppercase tracking-[0.22em] font-semibold hover:bg-[#222222] active:bg-[#333333] transition-all text-center flex items-center justify-center luxury-interactive">
                                AGGIUNGI AL CARRELLO
                            </button>
                            <div class="grid grid-cols-4 gap-2 pt-3">
                                <div class="h-8 bg-[#ECE8E1] rounded-md flex items-center justify-center border border-black/5 hover:border-black/20 transition-all shadow-2xs">
                                    <svg class="h-3.5 w-auto" viewBox="0 0 74 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M7.4 3.2H2.6C2.3 3.2 2 3.4 1.9 3.8L0 16.2C0 16.4 0.2 16.6 0.4 16.6H2.8C3.1 16.6 3.4 16.4 3.5 16L4.3 10.9C4.4 10.6 4.7 10.4 5 10.4H6.5C9.7 10.4 12.1 9.1 12.7 5.3C13 3.4 11.5 3.2 7.4 3.2Z" fill="#003087"/>
                                        <path d="M19.4 3.2H14.6C14.3 3.2 14 3.4 13.9 3.8L12 16.2C12 16.4 12.2 16.6 12.4 16.6H15.1C15.4 16.6 15.6 16.4 15.7 16.1L16.3 12.3C16.4 12 16.7 11.8 17 11.8H18.5C21.7 11.8 24.1 10.5 24.7 6.7C25 4.8 23.5 3.2 19.4 3.2Z" fill="#0079C1"/>
                                        <path d="M19.4 8.2C18.9 10.9 16.9 10.9 14.8 10.9H13.6L14.4 5.9C14.4 5.7 14.6 5.5 14.8 5.5H16.3C18.6 5.5 19.8 6.2 19.4 8.2Z" fill="#00457C"/>
                                        <text x="27" y="14" font-family="'Inter', sans-serif" font-weight="bold" font-size="12" fill="#003087">PayPal</text>
                                    </svg>
                                </div>
                                <div class="h-8 bg-[#ECE8E1] rounded-md flex items-center justify-center border border-black/5 hover:border-black/20 transition-all shadow-2xs">
                                    <span class="font-sans font-bold text-xs tracking-tight text-black flex items-center">
                                        Klarna<span class="text-black font-black text-sm">.</span>
                                    </span>
                                </div>
                                <div class="h-8 bg-[#ECE8E1] rounded-md flex items-center justify-center border border-black/5 hover:border-black/20 transition-all shadow-2xs">
                                    <span class="font-sans font-black italic text-xs tracking-wider text-[#1A1F71]">VISA</span>
                                </div>
                                <div class="h-8 bg-[#ECE8E1] rounded-md flex items-center justify-center border border-black/5 hover:border-black/20 transition-all shadow-2xs">
                                    <div class="flex items-center gap-0.5 text-black">
                                        <svg class="h-3.5 w-auto" viewBox="0 0 170 170" fill="currentColor">
                                            <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.69-3.08-7.77-7.97-12.24-14.68-7.05-10.63-12.59-22.75-16.63-36.37-4.04-13.62-6.07-26.25-6.07-37.89 0-14.28 3.51-26.04 10.53-35.29 7.02-9.25 15.75-13.98 26.2-14.19 4.35 0 9.24 1.16 14.68 3.48 5.43 2.32 9.21 3.53 11.34 3.63 2.45-.1 6.38-1.36 11.79-3.77 5.41-2.41 10.08-3.55 14.01-3.41 11.31.62 20.31 4.78 27 12.48-9.84 5.98-14.65 14.44-14.42 25.39.23 8.52 3.48 15.7 9.76 21.54 6.28 5.84 13.84 9.17 22.68 9.99-2.12 6.4-4.56 12.5-7.32 18.3zM119.22 33.04c0-7.37 2.66-14.37 7.97-21.01 5.31-6.64 11.88-10.87 19.7-12.69 1.13 6.94-.48 13.78-4.84 20.52-4.36 6.74-10.69 11.14-18.99 13.18-.75-1.52-1.84-3.42-3.84-5.71z"/>
                                        </svg>
                                        <span class="font-sans font-semibold text-xs tracking-tight">Pay</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                {%- endcase -%}
            {%- endfor -%}
            {%- endform -%}
        </div>
    </section>


    <!-- 7. Fascia Stampa Editoriale -->
    {%- if section.settings.show_press -%}
    <div class="py-12 bg-white border-b border-borderLinen">
        <div class="max-w-7xl mx-auto px-6 text-center">
            {%- if section.settings.press_tag != blank -%}
                <span class="text-[10px] uppercase tracking-[0.3em] text-ash block mb-6 font-medium">{{ section.settings.press_tag }}</span>
            {%- endif -%}
            {%- if section.settings.press_items != blank -%}
                {%- assign press_items_array = section.settings.press_items | split: ',' -%}
                <div class="flex flex-wrap items-center justify-center gap-12 sm:gap-20 text-ink/70 font-serif text-xl sm:text-2xl tracking-widest uppercase">
                    {%- for item in press_items_array -%}
                        {%- assign clean_item = item | strip -%}
                        {%- if clean_item != blank -%}
                            <span>{{ clean_item }}</span>
                            {%- unless forloop.last -%}
                                <span class="text-sand text-sm">&bull;</span>
                            {%- endunless -%}
                        {%- endif -%}
                    {%- endfor -%}
                </div>
            {%- endif -%}
            {%- if section.settings.press_quote != blank or section.settings.press_source != blank -%}
                <p class="font-serif italic text-ash text-sm mt-6 max-w-xl mx-auto font-light">
                    {%- if section.settings.press_quote != blank -%}&ldquo;{{ section.settings.press_quote }}&rdquo;{%- endif -%}
                    {%- if section.settings.press_source != blank %} &mdash; {{ section.settings.press_source }}{%- endif -%}
                </p>
            {%- endif -%}
        </div>
    </div>
    {%- endif -%}

    <!-- 10. Citazione & Foto Fondatrice Milena Tacchella -->
    {%- if section.settings.show_founder -%}
    <section class="py-24 bg-linen border-b border-borderLinen">
        <div class="max-w-5xl mx-auto px-6 grid grid-cols-1 md:grid-cols-12 gap-10 items-center">

            <div class="md:col-span-5">
                <div class="aspect-[4/5] bg-white border border-borderLinen shadow-xl overflow-hidden">
                    {%- if section.settings.founder_image != blank -%}
                        {%- assign founder_img_url = section.settings.founder_image | img_url: '1000x' -%}
                    {%- else -%}
                        {%- assign founder_img_url = 'milena-tacchella.jpg' | asset_url -%}
                    {%- endif -%}
                    <img src="{{ founder_img_url }}"
                         onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=80'"
                         alt="{{ section.settings.founder_name | default: 'Milena Tacchella' | escape }} - {{ section.settings.founder_role | default: 'Fondatrice & Dermo-Specialista • Mile Dermocosmesi Verona' | escape }}"
                         class="w-full h-full object-cover object-[center_20%]">
                </div>
            </div>

            <div class="md:col-span-7 space-y-4">
                {%- assign founder_tag = section.settings.founder_tag | default: 'FILOSOFIA DELLA FONDATRICE' -%}
                {%- if founder_tag != blank -%}
                    <span class="text-xs uppercase tracking-[0.25em] text-sage font-semibold block">{{ founder_tag }}</span>
                {%- endif -%}
                {%- assign founder_quote = section.settings.founder_quote | default: "La nostra missione a Verona è unire la potenza dei fitocomplessi puri alla precisione dell'analisi dermocosmetica personalizzata." -%}
                {%- if founder_quote != blank -%}
                    <blockquote class="font-serif italic text-2xl sm:text-3xl text-ink leading-snug">
                        &ldquo;{{ founder_quote }}&rdquo;
                    </blockquote>
                {%- endif -%}
                {%- assign founder_text = section.settings.founder_text | default: "Guidiamo la fitocosmesi ad alte prestazioni attraverso una rigorosa ricerca botanica ed evidenze scientifiche. Ogni nostro lotto è calibrato con precisione sartoriale per rigenerare la fisiologia cutanea nella nostra boutique e cabina dermo-specialistica di Verona in Via Torricelle, 2c in Lebestetik Beauty & Spa." -%}
                {%- if founder_text != blank -%}
                    <p class="text-xs text-ash leading-relaxed font-light">
                        {{ founder_text }}
                    </p>
                {%- endif -%}
                {%- assign founder_name = section.settings.founder_name | default: 'Milena Tacchella' -%}
                {%- assign founder_role = section.settings.founder_role | default: 'Fondatrice & Dermo-Specialista • Mile Dermocosmesi Verona' -%}
                {%- if founder_name != blank or founder_role != blank -%}
                    <div class="pt-2">
                        {%- if founder_name != blank -%}
                            <span class="font-serif text-lg font-semibold text-ink block">{{ founder_name }}</span>
                        {%- endif -%}
                        {%- if founder_role != blank -%}
                            <span class="text-[10px] uppercase tracking-widest text-ash">{{ founder_role }}</span>
                        {%- endif -%}
                    </div>
                {%- endif -%} 
            </div>

        </div>
    </section>
    {%- endif -%}

    <!-- 11. Sezione Cross-Sell "IDEAL FOR YOUR SKIN / ROUTINE COMPLETA" -->
    {%- if section.settings.show_routine -%}
    {%- assign current_tags_str = product.tags | join: ' ' | downcase -%}
    {%- assign current_text = product.title | append: ' ' | append: product.type | append: ' ' | append: current_tags_str | downcase -%}
    {%- assign current_dept = 'face' -%}
    {%- if current_text contains 'hair' or current_text contains 'capell' or current_text contains 'shampoo' or current_text contains 'scalp' -%}
      {%- assign current_dept = 'hair' -%}
    {%- elsif current_text contains 'body wash' or current_text contains 'bagnodoccia' or current_text contains 'bagnoschiuma' or current_text contains 'olio corpo' or current_text contains 'body oil' or current_text contains 'corpo' or current_text contains 'body' -%}
      {%- assign current_dept = 'body' -%}
    {%- endif -%}

    {%- assign is_cleanser = false -%}
    {%- if current_text contains 'detergente' or current_text contains 'cleanser' or current_text contains 'latte' or current_text contains 'oil-to-milk' or current_text contains 'tonico' or current_text contains 'mousse' -%}
      {%- assign is_cleanser = true -%}
    {%- endif -%}

    {%- assign is_serum = false -%}
    {%- if current_text contains 'siero' or current_text contains 'serum' or current_text contains 'booster' or current_text contains 'boost' or current_text contains 'ialuronico' or current_text contains 'gel ha' -%}
      {%- assign is_serum = true -%}
    {%- endif -%}

    {%- assign is_cream = false -%}
    {%- if current_text contains 'crema' or current_text contains 'cream' or current_text contains 'unicho' or current_text contains 'burro' or current_text contains 'lifting' or current_text contains 'repair' -%}
      {%- assign is_cream = true -%}
    {%- endif -%}

    {%- assign is_peeling = false -%}
    {%- if current_text contains 'peeling' or current_text contains 'esfolia' or current_text contains 'scrub' or current_text contains 'radiance reset' -%}
      {%- assign is_peeling = true -%}
    {%- endif -%}

    {%- assign routine_blocks = section.blocks | where: 'type', 'routine_card' -%}

    {%- comment -%} Priorita 1: Blocchi Manuali Mirati nel Theme Editor {%- endcomment -%}
    {%- assign targeted_routine_count = 0 -%}
    {%- for b in routine_blocks -%}
      {%- if b.settings.target_product != blank and b.settings.target_product.id == product.id -%}
        {%- assign targeted_routine_count = targeted_routine_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} Priorita 2: Metafields Personalizzati del Prodotto {%- endcomment -%}
    {%- assign meta_routine_prods = product.metafields.custom.routine_products.value | default: product.metafields.custom.routine_products | default: product.metafields.shopify--discovery--product_recommendation.complementary_products.value | default: product.metafields.shopify--discovery--product_recommendation.complementary_products | default: product.metafields.custom.routine.value | default: product.metafields.custom.routine -%}
    {%- assign has_meta_routine = false -%}
    {%- if meta_routine_prods != blank -%}
      {%- if meta_routine_prods.count > 0 or meta_routine_prods.size > 0 -%}
        {%- assign has_meta_routine = true -%}
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Identifica Collezione Primaria per Risoluzione Dinamica {%- endcomment -%}
    {%- assign target_col = product.collections.first -%}
    {%- for col in product.collections -%}
      {%- if col.handle != 'all' and col.handle != 'frontpage' -%}
        {%- assign target_col = col -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if target_col == blank and collections.all != blank -%}
      {%- assign target_col = collections.all -%}
    {%- endif -%}

    <section class="py-24 bg-white border-b border-borderLinen">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">

            <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-4">
                <div>
                    {%- if section.settings.routine_tag != blank -%}
                        <span class="text-xs uppercase tracking-[0.25em] text-amber font-semibold block mb-1">{{ section.settings.routine_tag }}</span>
                    {%- endif -%}
                    {%- if section.settings.routine_title != blank -%}
                        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-ink">{{ section.settings.routine_title }}</h2>
                    {%- endif -%}
                </div>
                {%- if section.settings.routine_subtitle != blank -%}
                    <p class="text-xs text-ash max-w-md font-light">{{ section.settings.routine_subtitle }}</p>
                {%- endif -%} 
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {%- assign routine_rendered_count = 0 -%}

            {%- if targeted_routine_count > 0 -%}
                {%- for block in routine_blocks -%}
                  {%- if block.settings.target_product != blank and block.settings.target_product.id == product.id and routine_rendered_count < 3 -%}
                    {%- assign routine_rendered_count = routine_rendered_count | plus: 1 -%}
                    {%- assign block_prod = block.settings.product -%}
                    {%- if block_prod != blank -%}
                      {%- assign card_title = block.settings.title | default: block_prod.title -%}
                      {%- assign card_sub = block.settings.subtitle | default: block_prod.metafields.custom.subtitle.value | default: block_prod.metafields.custom.subtitle | default: block_prod.type | default: 'Trattamento Sinergico Consigliato' -%}
                      {%- if block.settings.image != blank -%}
                        {%- assign card_img = block.settings.image | image_url: width: 800 -%}
                      {%- elsif block_prod.featured_image != blank -%}
                        {%- assign card_img = block_prod.featured_image | image_url: width: 800 -%}
                      {%- else -%}
                        {%- assign card_img = 'https://images.unsplash.com/photo-1552046122-03184de85e08?auto=format&fit=crop&w=800&q=80' -%}
                      {%- endif -%}
                      {%- if block.settings.price != blank -%}
                        {%- assign card_price_val = block.settings.price -%}
                        {%- assign card_price_html = '&euro; ' | append: card_price_val -%}
                        {%- assign card_price_num = block.settings.price | replace: ',', '.' | remove: '€' | strip -%}
                      {%- else -%}
                        {%- assign card_price_html = block_prod.price | money -%}
                        {%- assign card_price_num = block_prod.price | divided_by: 100.0 -%}
                      {%- endif -%}
                      {%- assign card_url = block_prod.url -%}
                      {%- assign card_variant_id = block_prod.selected_or_first_available_variant.id | default: block_prod.variants.first.id -%}
                    {%- else -%}
                      {%- assign card_title = block.settings.title | default: 'Trattamento Botanico Consigliato' -%}
                      {%- assign card_sub = block.settings.subtitle | default: 'Formula sinergica per la tua pelle' -%}
                      {%- if block.settings.image != blank -%}
                        {%- assign card_img = block.settings.image | image_url: width: 800 -%}
                      {%- else -%}
                        {%- assign card_img = 'https://images.unsplash.com/photo-1552046122-03184de85e08?auto=format&fit=crop&w=800&q=80' -%}
                      {%- endif -%}
                      {%- assign card_price_val = block.settings.price | default: '42,00' -%}
                      {%- assign card_price_html = '&euro; ' | append: card_price_val -%}
                      {%- assign card_price_num = card_price_val | replace: ',', '.' | remove: '€' | strip -%}
                      {%- assign card_url = '#' -%}
                      {%- assign card_variant_id = '1' -%}
                    {%- endif -%}
                    {%- case routine_rendered_count -%}
                      {%- when 1 -%}{%- assign def_step = 'STEP 01 • PREPARAZIONE & DETERSIONE' -%}
                      {%- when 2 -%}{%- assign def_step = 'STEP 02 • TRATTAMENTO & BOOSTER' -%}
                      {%- else -%}{%- assign def_step = 'STEP 03 • BARRIERA CELLULARE & COMFORT' -%}
                    {%- endcase -%}
                    {%- assign card_step = block.settings.step | default: def_step -%}

                    <div class="bg-linen p-5 border border-borderLinen flex flex-col justify-between hover:shadow-lg transition-shadow" {{ block.shopify_attributes }}>
                      <div>
                        <div class="aspect-square bg-white mb-4 overflow-hidden border border-borderLinen flex items-center justify-center p-2">
                          <a href="{{ card_url }}" class="w-full h-full block">
                            <img src="{{ card_img }}" alt="{{ card_title | escape }}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy">
                          </a>
                        </div>
                        <span class="text-[9px] uppercase tracking-wider text-amber font-semibold block mb-1">{{ card_step }}</span>
                        <h4 class="font-serif text-lg font-normal text-ink mb-1">
                          <a href="{{ card_url }}" class="hover:text-amber transition-colors">{{ card_title }}</a>
                        </h4>
                        <p class="text-xs text-ash mb-3">{{ card_sub }}</p>
                      </div>
                      <div class="flex items-center justify-between pt-4 border-t border-borderLinen mt-auto">
                        <span class="font-serif text-base text-ink">{{ card_price_html }}</span>
                        <button type="button"
                                onclick="quickAddProduct(this, event)"
                                data-variant-id="{{ card_variant_id }}"
                                data-product-title="{{ card_title | escape }}"
                                data-product-price="{{ card_price_num }}"
                                data-product-volume="{{ card_sub | escape }}"
                                data-product-image="{{ card_img }}"
                                data-product-step="{{ card_step | escape }}"
                                class="bg-ink text-white px-3 py-1.5 text-[9px] uppercase tracking-widest hover:bg-amber transition-colors font-semibold luxury-interactive">
                          + AGGIUNGI
                        </button>
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}

            {%- elsif has_meta_routine -%}
                {%- for meta_prod in meta_routine_prods limit: 3 -%}
                  {%- if meta_prod != blank and meta_prod.id != blank -%}
                    {%- assign routine_rendered_count = routine_rendered_count | plus: 1 -%}
                    {%- case routine_rendered_count -%}
                      {%- when 1 -%}{%- assign meta_step = 'STEP 01 • PREPARAZIONE & DETERSIONE' -%}
                      {%- when 2 -%}{%- assign meta_step = 'STEP 02 • TRATTAMENTO & BOOSTER' -%}
                      {%- else -%}{%- assign meta_step = 'STEP 03 • BARRIERA CELLULARE & COMFORT' -%}
                    {%- endcase -%}
                    {%- assign card_title = meta_prod.title -%}
                    {%- assign card_sub = meta_prod.metafields.custom.subtitle.value | default: meta_prod.metafields.custom.subtitle | default: meta_prod.type | default: 'Trattamento Sinergico Consigliato' -%}
                    {%- if meta_prod.featured_image != blank -%}
                      {%- assign card_img = meta_prod.featured_image | image_url: width: 800 -%}
                    {%- else -%}
                      {%- assign card_img = 'https://images.unsplash.com/photo-1552046122-03184de85e08?auto=format&fit=crop&w=800&q=80' -%}
                    {%- endif -%}
                    {%- assign card_price_html = meta_prod.price | money -%}
                    {%- assign card_price_num = meta_prod.price | divided_by: 100.0 -%}
                    {%- assign card_url = meta_prod.url -%}
                    {%- assign card_variant_id = meta_prod.selected_or_first_available_variant.id | default: meta_prod.variants.first.id | default: meta_prod.id -%}
                    {%- assign card_step = meta_step -%}

                    <div class="bg-linen p-5 border border-borderLinen flex flex-col justify-between hover:shadow-lg transition-shadow">
                      <div>
                        <div class="aspect-square bg-white mb-4 overflow-hidden border border-borderLinen flex items-center justify-center p-2">
                          <a href="{{ card_url }}" class="w-full h-full block">
                            <img src="{{ card_img }}" alt="{{ card_title | escape }}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy">
                          </a>
                        </div>
                        <span class="text-[9px] uppercase tracking-wider text-amber font-semibold block mb-1">{{ card_step }}</span>
                        <h4 class="font-serif text-lg font-normal text-ink mb-1">
                          <a href="{{ card_url }}" class="hover:text-amber transition-colors">{{ card_title }}</a>
                        </h4>
                        <p class="text-xs text-ash mb-3">{{ card_sub }}</p>
                      </div>
                      <div class="flex items-center justify-between pt-4 border-t border-borderLinen mt-auto">
                        <span class="font-serif text-base text-ink">{{ card_price_html }}</span>
                        <button type="button"
                                onclick="quickAddProduct(this, event)"
                                data-variant-id="{{ card_variant_id }}"
                                data-product-title="{{ card_title | escape }}"
                                data-product-price="{{ card_price_num }}"
                                data-product-volume="{{ card_sub | escape }}"
                                data-product-image="{{ card_img }}"
                                data-product-step="{{ card_step | escape }}"
                                class="bg-ink text-white px-3 py-1.5 text-[9px] uppercase tracking-widest hover:bg-amber transition-colors font-semibold luxury-interactive">
                          + AGGIUNGI
                        </button>
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}

            {%- else -%}
                {%- comment -%} Priorita 3: Fallback Dinamico Intelligente per Reparto e Sinergia Cosmetica {%- endcomment -%}
                {%- assign slot_1_prod = nil -%}
                {%- assign slot_2_prod = nil -%}
                {%- assign slot_3_prod = nil -%}

                {%- comment -%} Step Labels appropriati per Reparto e Ruolo Cosmetico {%- endcomment -%}
                {%- if current_dept == 'hair' -%}
                  {%- assign slot_1_step = 'STEP 01 • DETERSIONE CAPILLARE' -%}
                  {%- assign slot_2_step = 'STEP 02 • TRATTAMENTO & MASCHERA' -%}
                  {%- assign slot_3_step = 'STEP 03 • FINISHING & PROTEZIONE' -%}
                {%- elsif current_dept == 'body' -%}
                  {%- assign slot_1_step = 'STEP 01 • DETERSIONE CORPO' -%}
                  {%- assign slot_2_step = 'STEP 02 • ESFOLIAZIONE CORPO' -%}
                  {%- assign slot_3_step = 'STEP 03 • IDRATAZIONE & ELASTICITÀ' -%}
                {%- else -%}
                  {%- if is_cleanser -%}
                    {%- assign slot_1_step = 'STEP 01 • ESFOLIAZIONE & RINNOVAMENTO' -%}
                  {%- else -%}
                    {%- assign slot_1_step = 'STEP 01 • PREPARAZIONE & DETERSIONE' -%}
                  {%- endif -%}
                  {%- if is_serum -%}
                    {%- assign slot_2_step = 'STEP 02 • POTENZIAMENTO ATTIVO' -%}
                  {%- else -%}
                    {%- assign slot_2_step = 'STEP 02 • TRATTAMENTO & BOOSTER' -%}
                  {%- endif -%}
                  {%- if is_cream -%}
