                    {%- elsif section.settings.product_2_image != blank -%}
                        {%- assign card_2_img = section.settings.product_2_image | image_url: width: 800 -%}
                    {%- else -%}
                        {%- assign card_2_img = 'https://images.unsplash.com/photo-1617897903246-719242758050?auto=format&fit=crop&w=800&q=80' -%}
                    {%- endif -%}
                    {%- assign card_2_price_html = p2.price | money -%}
                    {%- assign card_2_price_num = p2.price | divided_by: 100.0 -%}
                    {%- assign card_2_url = p2.url -%}
                    {%- assign card_2_variant_id = p2.selected_or_first_available_variant.id | default: p2.variants.first.id -%}
                {%- else -%}
                    {%- assign card_2_title = section.settings.product_2_title | default: 'Siero Rigenerante Notturno' -%}
                    {%- assign card_2_sub = section.settings.product_2_subtitle | default: '30 ml • Concentrato molecolare di bio-peptidi' -%}
                    {%- if section.settings.product_2_image != blank -%}
                        {%- assign card_2_img = section.settings.product_2_image | image_url: width: 800 -%}
                    {%- else -%}
                        {%- assign card_2_img = 'https://images.unsplash.com/photo-1617897903246-719242758050?auto=format&fit=crop&w=800&q=80' -%}
                    {%- endif -%}
                    {%- assign card_2_price_val = section.settings.product_2_price | default: '94,00' -%}
                    {%- assign card_2_price_html = '&euro; ' | append: card_2_price_val -%}
                    {%- assign card_2_price_num = section.settings.product_2_price | replace: ',', '.' | remove: '€' | strip | default: '94.00' -%}
                    {%- assign card_2_url = '#' -%}
                    {%- assign card_2_variant_id = '2' -%}
                {%- endif -%}
                {%- assign card_2_step = section.settings.product_2_step | default: 'STEP 02 • BOOSTER ATTIVO' -%}

                <div class="bg-linen p-5 border border-borderLinen flex flex-col justify-between hover:shadow-lg transition-shadow">
