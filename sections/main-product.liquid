<script>
  // PDP Gallery Data & Controls
  const galleryImages = [
    {% for media in product.media %}
      "{{ media | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  let currentSlideIndex = 0;
  let galleryTransitionToken = 0;
  let galleryFadeTimer = null;

  function selectSlideByIndex(index) {
    if (index < 0) index = 0;
    if (index >= galleryImages.length) index = galleryImages.length - 1;

    // Instant UI updates for active thumbnail and pagination dots
    const thumbs = Array.from(document.querySelectorAll('.thumb-btn'));
    const dots = Array.from(document.querySelectorAll('.pdp-dot'));
    const callouts = document.getElementById('pdp-callouts');

    thumbs.forEach((t, i) => {
      if (i === index) {
        t.classList.add('thumb-active', 'border-2', 'border-ink');
        t.classList.remove('border-borderLinen', 'opacity-70');
      } else {
        t.classList.remove('thumb-active', 'border-2', 'border-ink');
        t.classList.add('border', 'border-borderLinen', 'opacity-70');
      }
    });

    if (thumbs[index]) {
      thumbs[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }

    dots.forEach((d, i) => {
      if (i === index) {
        d.classList.remove('w-2', 'bg-borderLinen');
        d.classList.add('w-6', 'bg-ink');
      } else {
        d.classList.remove('w-6', 'bg-ink');
        d.classList.add('w-2', 'bg-borderLinen');
      }
    });

    if (callouts) {
      if (index === 0) {
        callouts.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
        callouts.classList.add('opacity-100', 'visible');
      } else {
        callouts.classList.remove('opacity-100', 'visible');
        callouts.classList.add('opacity-0', 'invisible', 'pointer-events-none');
      }
    }

    if (index === currentSlideIndex) return;
    currentSlideIndex = index;

    const mainImg = document.getElementById('main-product-img');
    const fadeImg = document.getElementById('main-product-img-fade');
    const targetSrc = galleryImages[index];

    if (!mainImg || !targetSrc) return;

    if (!fadeImg) {
      mainImg.src = targetSrc;
      return;
    }

    // Cancel any ongoing transition timer and commit previous fade image to base layer
    if (galleryFadeTimer) {
      clearTimeout(galleryFadeTimer);
      galleryFadeTimer = null;
      if (fadeImg.src) {
        mainImg.src = fadeImg.src;
      }
      mainImg.style.transition = 'none';
      mainImg.style.opacity = '1';
      fadeImg.style.transition = 'none';
      fadeImg.style.opacity = '0';
      fadeImg.src = '';
    }
    const token = ++galleryTransitionToken;

    // Smooth Dual-Layer Symmetric Crossfade:
    // fadeImg fades from 0 to 1 while mainImg simultaneously fades from 1 to 0 towards the clean white container background.
    // This completely eliminates any ghost overlay through transparent packshots (Slide 0).
    const preloader = new Image();
    let isApplied = false;

    const applyFadeTransition = () => {
      if (isApplied) return;
      isApplied = true;

      if (token !== galleryTransitionToken) return;

      fadeImg.src = targetSrc;
      fadeImg.style.transition = 'none';
      fadeImg.style.opacity = '0';
      mainImg.style.transition = 'none';
      mainImg.style.opacity = '1';
      void fadeImg.offsetWidth; // Force synchronous reflow

      const duration = 240;
      const easing = 'cubic-bezier(0.25, 1, 0.5, 1)';
      fadeImg.style.transition = `opacity ${duration}ms ${easing}`;
      mainImg.style.transition = `opacity ${duration}ms ${easing}`;
      fadeImg.style.opacity = '1';
      mainImg.style.opacity = '0';

      galleryFadeTimer = setTimeout(() => {
        if (token !== galleryTransitionToken) return;

        mainImg.src = targetSrc;
        mainImg.style.transition = 'none';
        mainImg.style.opacity = '1';
        fadeImg.style.transition = 'none';
        fadeImg.style.opacity = '0';
        fadeImg.src = '';
        galleryFadeTimer = null;
      }, duration + 15);
    };

    preloader.onload = applyFadeTransition;
    preloader.onerror = () => {
      if (token !== galleryTransitionToken) return;
      mainImg.src = targetSrc;
      mainImg.style.transition = 'none';
      mainImg.style.opacity = '1';
      fadeImg.style.transition = 'none';
      fadeImg.style.opacity = '0';
      fadeImg.src = '';
      galleryFadeTimer = null;
    };
    preloader.src = targetSrc;

    if (preloader.complete) {
      applyFadeTransition();
    }
  }

  function changeMainImage(imgUrl, thumbEl, slideIndex) {
    let index = (typeof slideIndex === 'number') ? slideIndex : galleryImages.indexOf(imgUrl);
    if (index === -1) index = 0;
    selectSlideByIndex(index);
  }

  // Mobile Touch Swipe Gesture Handler for PDP Gallery
  (function initGalleryTouchSwipe() {
    const box = document.getElementById('pdp-main-gallery-box');
    if (!box) return;

    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;
    const minSwipeDistance = 35;

    box.addEventListener('touchstart', function(e) {
      if (e.touches && e.touches.length === 1) {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchEndX = touchStartX;
        touchEndY = touchStartY;
      }
    }, { passive: true });

    box.addEventListener('touchmove', function(e) {
      if (e.touches && e.touches.length === 1) {
        touchEndX = e.touches[0].clientX;
        touchEndY = e.touches[0].clientY;
      }
    }, { passive: true });

    box.addEventListener('touchend', function(e) {
      if (e && e.changedTouches && e.changedTouches.length === 1) {
        touchEndX = e.changedTouches[0].clientX;
        touchEndY = e.changedTouches[0].clientY;
      }
      const deltaX = touchEndX - touchStartX;
      const deltaY = touchEndY - touchStartY;

      if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) >= minSwipeDistance) {
        if (!galleryImages || galleryImages.length <= 1) return;
        if (deltaX < 0) {
          const nextIndex = (currentSlideIndex + 1) % galleryImages.length;
          selectSlideByIndex(nextIndex);
        } else {
          const prevIndex = (currentSlideIndex - 1 + galleryImages.length) % galleryImages.length;
          selectSlideByIndex(prevIndex);
        }
      }
      touchStartX = 0;
      touchEndX = 0;
      touchStartY = 0;
      touchEndY = 0;
    }, { passive: true });
  })();

  // Formats Data & State
  let currentPrice = {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | default: 0 }};
  let currentFormat = '{{ product.selected_or_first_available_variant.id | default: "default" }}';
  let currentFormatLabel = '{{ product.selected_or_first_available_variant.title | escape | default: "Default Title" }}';

  function selectFormat(formatId, price, label, el, unitPrice, loyaltyPts, variantId) {
    currentPrice = price;
    currentFormat = formatId;
    currentFormatLabel = label;

    if (variantId) {
      const varInput = document.getElementById('selected-variant-id');
      if (varInput) varInput.value = variantId;
    }

    const prodPriceEl = document.getElementById('product-price');
    if (prodPriceEl) {
      prodPriceEl.innerHTML = (typeof price === 'number') ? price.toFixed(2).replace('.', ',') + ' &euro;' : price;
    }

    const unitPriceEl = document.getElementById('unit-price-display');
    if (unitPriceEl && unitPrice) {
      unitPriceEl.innerHTML = 'SC061 ' + unitPrice;
    }

    const loyaltyEl = document.getElementById('loyalty-points');
    if (loyaltyEl && loyaltyPts) {
      loyaltyEl.innerHTML = loyaltyPts + ' Beauty Punti (1€ = 1 Punto) <a href="/pages/programma-fedelta" class="underline text-[#7A7265] hover:text-[#C8A878] ml-1 text-[10px]">Info Beauty Club</a>';
    }

    const pills = document.querySelectorAll('.format-pill');
    pills.forEach(pill => {
      pill.classList.remove('bg-black', 'text-white');
      pill.classList.add('border', 'border-black/40', 'text-black', 'hover:border-black', 'bg-transparent');
    });

    if (el) {
      el.classList.remove('border', 'border-black/40', 'hover:border-black', 'bg-transparent');
      el.classList.add('bg-black', 'text-white');
    }
  }

  // Wishlist Heart
  function toggleWishlist() {
    const btn = document.getElementById('wishlist-btn');
    if (typeof window.togglePdpWishlist === 'function') {
      window.togglePdpWishlist(btn);
    }
  }

  // Buybox CSS Grid Accordions
  function toggleBuyboxAccordion(id) {
    const content = document.getElementById('buybox-content-' + id);
    const arrow = document.getElementById('buybox-arrow-' + id);
    if (!content || !arrow) return;

    const isOpen = content.classList.contains('open');
    if (isOpen) {
      content.classList.remove('open');
      arrow.style.transform = 'rotate(0deg)';
    } else {
      content.classList.add('open');
      arrow.style.transform = 'rotate(90deg)';
    }
  }

  // 50/50 Section Accordions
  function toggleAccordion(id) {
    const content = document.getElementById('accordion-content-' + id);
    const icon = document.getElementById('accordion-icon-' + id);
    if (!content) return;

    const isOpen = content.classList.contains('open');
    if (isOpen) {
      content.classList.remove('open');
      if (icon) icon.innerHTML = '&plus;';
    } else {
      content.classList.add('open');
      if (icon) icon.innerHTML = '&times;';
    }
  }

  // Intercept native product form submission for Shopify AJAX Cart
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('product_form');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        const variantId = document.getElementById('selected-variant-id').value;
        const btn = document.getElementById('add-to-cart-btn');
        const originalText = btn ? btn.innerText : '';
        if (btn) {
          btn.innerText = 'AGGIUNTO ✓';
          btn.classList.add('bg-[#5C6B56]');
        }

        if (typeof window.addShopifyCartItem === 'function') {
          window.addShopifyCartItem(variantId, 1);
        } else if (typeof addToCart === 'function') {
          addToCart({
            id: variantId,
            title: {{ clean_pdp_title | default: product.title | default: section.settings.product_title | json }},
            price: currentPrice,
            volume: currentFormatLabel,
            qty: 1,
            image: '{{ product.featured_media | image_url: width: 300 }}'
          });
        }

        setTimeout(() => {
          if (btn) {
            btn.innerText = originalText || 'AGGIUNGI AL CARRELLO';
            btn.classList.remove('bg-[#5C6B56]');
          }
        }, 2000);
      });
    }
  });
</script>

