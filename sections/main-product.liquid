                        <div class="aspect-square bg-white mb-4 overflow-hidden border border-borderLinen">
                            <img src="{{ card_2_img }}"
                                 onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
                                 alt="{{ card_2_title | escape }}" class="w-full h-full object-cover transition-transform duration-500">
                        </div>
                        <div class="text-amber text-xs mb-1">&starf;&starf;&starf;&starf;&starf; <span class="text-ash text-[10px]">(115)</span></div>
                        <h4 class="font-serif text-lg font-semibold text-ink"><a href="{{ card_2_url }}" class="hover:text-amber transition-colors">{{ card_2_title }}</a></h4>
                        <p class="text-xs text-ash mt-1">{{ card_2_sub }}</p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-borderLinen flex items-center justify-between">
                        <span class="font-semibold text-ink text-sm">{{ card_2_price_html }}</span>
                        <button type="button"
                                onclick="quickAddProduct(this, event)"
                                data-variant-id="{{ card_2_variant_id }}"
