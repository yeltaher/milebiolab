        </div>
    </section>
    {%- endif -%}

    <!-- 11. Sezione Cross-Sell "IDEAL FOR YOUR SKIN..." -->
    {%- if section.settings.show_routine -%}
    {%- comment -%}
      Risoluzione Intelligente Prodotti Routine (3 Priorità):
      1. Metafield di prodotto (custom.routine, custom.complementary_products, o Shopify Search & Discovery)
      2. Prodotti correlati dalla collezione (stessa collection, escludendo il prodotto corrente)
      3. Fallback impostazioni Theme Editor (section.settings.routine_products)
    {%- endcomment -%}

    {%- assign routine_source = nil -%}
    {%- if product.metafields.custom.routine.value != blank -%}
        {%- assign routine_source = product.metafields.custom.routine.value -%}
    {%- elsif product.metafields.custom.complementary_products.value != blank -%}
        {%- assign routine_source = product.metafields.custom.complementary_products.value -%}
    {%- elsif product.metafields.shopify--discovery--product_recommendation.complementary_products.value != blank -%}
        {%- assign routine_source = product.metafields.shopify--discovery--product_recommendation.complementary_products.value -%}
    {%- elsif product.metafields.custom.routine != blank -%}
        {%- assign routine_source = product.metafields.custom.routine -%}
    {%- elsif product.metafields.custom.complementary_products != blank -%}
        {%- assign routine_source = product.metafields.custom.complementary_products -%}
    {%- endif -%}

    {%- assign routine_count = 0 -%}
    {%- assign p1 = nil -%}
    {%- assign p2 = nil -%}
    {%- assign p3 = nil -%}

    {%- if routine_source != blank -%}
        {%- for item in routine_source -%}
            {%- if item.id != product.id -%}
                {%- if routine_count == 0 -%}
                    {%- assign p1 = item -%}
                    {%- assign routine_count = 1 -%}
                {%- elsif routine_count == 1 -%}
                    {%- assign p2 = item -%}
                    {%- assign routine_count = 2 -%}
                {%- elsif routine_count == 2 -%}
                    {%- assign p3 = item -%}
                    {%- assign routine_count = 3 -%}
                    {%- break -%}
                {%- endif -%}
            {%- endif -%}
        {%- endfor -%}
    {%- endif -%}

    {%- if routine_count < 3 and product.collections.size > 0 -%}
        {%- for col in product.collections -%}
            {%- if col.handle != 'all' and col.handle != 'frontpage' -%}
                {%- for col_prod in col.products -%}
                    {%- if col_prod.id != product.id -%}
                        {%- assign already_in_routine = false -%}
                        {%- if p1 != blank and col_prod.id == p1.id -%}{%- assign already_in_routine = true -%}{%- endif -%}
                        {%- if p2 != blank and col_prod.id == p2.id -%}{%- assign already_in_routine = true -%}{%- endif -%}
                        {%- unless already_in_routine -%}
                            {%- if routine_count == 0 -%}
                                {%- assign p1 = col_prod -%}
                                {%- assign routine_count = 1 -%}
                            {%- elsif routine_count == 1 -%}
                                {%- assign p2 = col_prod -%}
                                {%- assign routine_count = 2 -%}
                            {%- elsif routine_count == 2 -%}
                                {%- assign p3 = col_prod -%}
                                {%- assign routine_count = 3 -%}
                                {%- break -%}
                            {%- endif -%}
                        {%- endunless -%}
                    {%- endif -%}
                {%- endfor -%}
                {%- if routine_count >= 3 -%}{%- break -%}{%- endif -%}
            {%- endif -%}
        {%- endfor -%}
        {%- if routine_count < 3 and product.collections.first != blank -%}
            {%- for col_prod in product.collections.first.products -%}
                {%- if col_prod.id != product.id -%}
                    {%- assign already_in_routine = false -%}
                    {%- if p1 != blank and col_prod.id == p1.id -%}{%- assign already_in_routine = true -%}{%- endif -%}
                    {%- if p2 != blank and col_prod.id == p2.id -%}{%- assign already_in_routine = true -%}{%- endif -%}
                    {%- unless already_in_routine -%}
                        {%- if routine_count == 0 -%}
                            {%- assign p1 = col_prod -%}
                            {%- assign routine_count = 1 -%}
                        {%- elsif routine_count == 1 -%}
                            {%- assign p2 = col_prod -%}
                            {%- assign routine_count = 2 -%}
                        {%- elsif routine_count == 2 -%}
                            {%- assign p3 = col_prod -%}
                            {%- assign routine_count = 3 -%}
                            {%- break -%}
                        {%- endif -%}
                    {%- endunless -%}
                {%- endif -%}
            {%- endfor -%}
        {%- endif -%}
    {%- endif -%}

    {%- if p1 == nil or p1.title == blank -%}
        {%- assign p1 = section.settings.routine_products[0] -%}
    {%- endif -%}
    {%- if p2 == nil or p2.title == blank -%}
        {%- assign p2 = section.settings.routine_products[1] -%}
    {%- endif -%}
    {%- if p3 == nil or p3.title == blank -%}
        {%- assign p3 = section.settings.routine_products[2] -%}
    {%- endif -%}

    <section class="py-24 bg-white border-b border-borderLinen">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">

            <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-4">
                <div>
                    {%- if section.settings.routine_tag != blank -%}
                        <span class="text-xs uppercase tracking-[0.25em] text-amber font-semibold block mb-1">{{ section.settings.routine_tag }}</span>
                    {%- endif -%}
                    {%- if section.settings.routine_title != blank -%}
                        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-ink">{{ section.settings.routine_title }}</h2>
                    {%- endif -%}
                </div>
                {%- if section.settings.routine_subtitle != blank -%}
                    <p class="text-xs text-ash max-w-md font-light">{{ section.settings.routine_subtitle }}</p>
                {%- endif -%} 
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

                <!-- Product 1 Card -->
                {%- if p1 != blank and p1.title != blank -%}
                    {%- assign card_1_title = p1.title -%}
                    {%- if section.settings.product_1_title != blank and section.settings.product_1_title != 'Detergente Lipofilo Purificante' -%}
                        {%- assign card_1_title = section.settings.product_1_title -%}
                    {%- endif -%}
                    {%- if p1.metafields.custom.subtitle != blank -%}
                        {%- assign card_1_sub = p1.metafields.custom.subtitle -%}
                    {%- elsif p1.variants.first.title != blank and p1.variants.first.title != 'Default Title' -%}
                        {%- assign card_1_sub = p1.variants.first.title -%}
                    {%- elsif p1.type != blank and p1.type != 'Default' -%}
                        {%- assign card_1_sub = p1.type -%}
                    {%- elsif section.settings.product_1_subtitle != blank and section.settings.product_1_subtitle != '150 ml • Rispetta la barriera idrolipidica' -%}
