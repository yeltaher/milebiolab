                    onclick="selectFormat('{{ variant.id }}', {{ variant.price | divided_by: 100.0 }}, '{{ variant.title | escape }}', this, '{{ variant.price | money }}', '+{{ variant.price | divided_by: 20 }}', '{{ variant.id }}')" 
