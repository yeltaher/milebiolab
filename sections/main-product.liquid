                    {%- else -%}
                        {%- assign card_1_img = 'https://images.unsplash.com/photo-1552046122-03184de85e08?auto=format&fit=crop&w=800&q=80' -%}
                    {%- endif -%}
                    {%- assign card_1_price_html = p1.price | money -%}
                    {%- assign card_1_price_num = p1.price | divided_by: 100.0 -%}
                    {%- assign card_1_url = p1.url -%}
                    {%- assign card_1_variant_id = p1.selected_or_first_available_variant.id | default: p1.variants.first.id -%}
                {%- else -%}
                    {%- assign card_1_title = section.settings.product_1_title | default: 'Detergente Lipofilo Purificante' -%}
                    {%- assign card_1_sub = section.settings.product_1_subtitle | default: '150 ml • Rispetta la barriera idrolipidica' -%}
                    {%- if section.settings.product_1_image != blank -%}
                        {%- assign card_1_img = section.settings.product_1_image | image_url: width: 800 -%}
                    {%- else -%}
                        {%- assign card_1_img = 'https://images.unsplash.com/photo-1552046122-03184de85e08?auto=format&fit=crop&w=800&q=80' -%}
                    {%- endif -%}
                    {%- assign card_1_price_val = section.settings.product_1_price | default: '42,00' -%}
                    {%- assign card_1_price_html = '&euro; ' | append: card_1_price_val -%}
                    {%- assign card_1_price_num = section.settings.product_1_price | replace: ',', '.' | remove: '€' | strip | default: '42.00' -%}
                    {%- assign card_1_url = '#' -%}
                    {%- assign card_1_variant_id = '1' -%}
                {%- endif -%}
                {%- assign card_1_step = section.settings.product_1_step | default: 'STEP 01 • DETERSIONE PURIFICANTE' -%}

                <div class="bg-linen p-5 border border-borderLinen flex flex-col justify-between hover:shadow-lg transition-shadow">
                    <div>
                        <div class="aspect-square bg-white mb-4 overflow-hidden border border-borderLinen">
                            <img src="{{ card_1_img }}"
                                 onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80'"
                                 alt="{{ card_1_title | escape }}" class="w-full h-full object-cover transition-transform duration-500">
                        </div>
                        <div class="text-amber text-xs mb-1">&starf;&starf;&starf;&starf;&starf; <span class="text-ash text-[10px]">(89)</span></div>
                        <h4 class="font-serif text-lg font-semibold text-ink"><a href="{{ card_1_url }}" class="hover:text-amber transition-colors">{{ card_1_title }}</a></h4>
                        <p class="text-xs text-ash mt-1">{{ card_1_sub }}</p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-borderLinen flex items-center justify-between">
                        <span class="font-semibold text-ink text-sm">{{ card_1_price_html }}</span>
                        <button type="button"
                                onclick="quickAddProduct(this, event)"
                                data-variant-id="{{ card_1_variant_id }}"
                                data-product-title="{{ card_1_title | escape }}"
                                data-product-price="{{ card_1_price_num }}"
                                data-product-volume="{{ card_1_sub | escape }}"
                                data-product-image="{{ card_1_img }}"
                                data-product-step="{{ card_1_step | escape }}"
                                class="bg-ink text-white px-4 py-2 text-[10px] uppercase tracking-widest hover:bg-sage transition-colors cursor-pointer luxury-interactive">
                            + Aggiungi
                        </button>
                    </div>
                </div>

                <!-- Product 2 Card -->
                {%- if p2 != blank and p2.title != blank -%}
                    {%- assign card_2_title = p2.title -%}
                    {%- if section.settings.product_2_title != blank and section.settings.product_2_title != 'Siero Rigenerante Notturno' -%}
                        {%- assign card_2_title = section.settings.product_2_title -%}
                    {%- endif -%}
                    {%- if p2.metafields.custom.subtitle != blank -%}
                        {%- assign card_2_sub = p2.metafields.custom.subtitle -%}
                    {%- elsif p2.variants.first.title != blank and p2.variants.first.title != 'Default Title' -%}
                        {%- assign card_2_sub = p2.variants.first.title -%}
                    {%- elsif p2.type != blank and p2.type != 'Default' -%}
                        {%- assign card_2_sub = p2.type -%}
                    {%- elsif section.settings.product_2_subtitle != blank and section.settings.product_2_subtitle != '30 ml • Concentrato molecolare di bio-peptidi' -%}
                        {%- assign card_2_sub = section.settings.product_2_subtitle -%}
                    {%- else -%}
                        {%- assign card_2_sub = 'Trattamento Sinergico Consigliato' -%}
                    {%- endif -%}
                    {%- if p2.featured_image != blank -%}
