    <!-- 10. Citazione & Foto Fondatrice Milena Tacchella -->
    {%- if section.settings.show_founder -%}
    <section class="py-24 bg-linen border-b border-borderLinen">
        <div class="max-w-5xl mx-auto px-6 grid grid-cols-1 md:grid-cols-12 gap-10 items-center">

            <div class="md:col-span-5">
                <div class="aspect-[4/5] bg-white border border-borderLinen shadow-xl overflow-hidden">
                    {%- if section.settings.founder_image != blank -%}
                        {%- assign founder_img_url = section.settings.founder_image | img_url: '1000x' -%}
                    {%- else -%}
                        {%- assign founder_img_url = 'milena-tacchella.jpg' | asset_url -%}
                    {%- endif -%}
