{% schema %}
{
  "name": "Completa la tua Routine",
  "tag": "section",
  "class": "section-product-routine",
  "settings": [
    {
      "type": "text",
      "id": "routine_tag",
      "label": "Tag Superiore",
      "default": "RITUALE COMPLETO SINERGICO"
