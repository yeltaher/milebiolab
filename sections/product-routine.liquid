        {
          "type": "image_picker",
          "id": "image",
          "label": "Immagine Personalizzata (Opzionale)",
          "info": "Lascia vuoto per usare la foto del prodotto collegato"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Completa la tua Routine",
      "blocks": [
        {
          "type": "routine_card"
        },
        {
          "type": "routine_card"
        },
        {
          "type": "routine_card"
        }
      ]
    }
  ]
}
