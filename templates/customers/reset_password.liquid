{% comment %}
  MILEBIOLAB - TEMPLATE CUSTOMER RESET PASSWORD
  Bespoke Haute Couture / Splendor Palette (#F5F2EB, #FAF8F5, #E5E0D8, #5C6B56, #C8A878, #1A1A1A)
{% endcomment %}

<div class="customer-reset-wrapper min-h-[70vh] py-16 px-4 sm:px-6 lg:px-8 bg-linen flex items-center justify-center">
  <div class="max-w-md w-full bg-white border border-borderLinen p-8 sm:p-10 shadow-sm">
    
    <div class="text-center mb-8">
      <span class="text-[11px] font-mono tracking-widest uppercase text-amber block mb-2">Sicurezza Account</span>
      <h1 class="font-serif text-3xl text-ink font-normal">Reimposta Password</h1>
      <p class="text-xs sm:text-sm text-ash mt-2 leading-relaxed">
        Inserisci la nuova password per il tuo profilo Club Mile.
      </p>
    </div>

    {% form 'reset_customer_password', class: 'space-y-5', novalidate: 'novalidate' %}
      {% if form.errors %}
        <div class="p-4 bg-[#FFF5F5] border border-[#E5A8A8] text-[#9E2A2B] text-xs">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div>
        <label for="ResetPassword" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1.5">
          Nuova Password <span class="text-sage">*</span>
        </label>
        <input
          type="password"
          name="customer[password]"
          id="ResetPassword"
          autocomplete="new-password"
          required
          placeholder="Almeno 6 caratteri"
          class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink placeholder-ash/50 focus:bg-white focus:border-sage focus:outline-none transition-colors"
          {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}
        >
      </div>

      <div>
        <label for="ResetPasswordConfirmation" class="block text-xs uppercase tracking-wider font-semibold text-ink mb-1.5">
          Conferma Nuova Password <span class="text-sage">*</span>
        </label>
        <input
          type="password"
          name="customer[password_confirmation]"
          id="ResetPasswordConfirmation"
          autocomplete="new-password"
          required
          placeholder="Ripeti la nuova password"
          class="w-full px-4 py-3 bg-[#FAF8F5] border border-borderLinen text-sm text-ink placeholder-ash/50 focus:bg-white focus:border-sage focus:outline-none transition-colors"
          {% if form.errors contains 'password_confirmation' %}aria-invalid="true"{% endif %}
        >
      </div>

      <div class="pt-2">
        <button
          type="submit"
          class="w-full bg-ink hover:bg-sage text-white py-4 px-6 text-xs uppercase tracking-widest font-semibold transition-all duration-300 shadow-sm cursor-pointer flex items-center justify-center gap-2"
        >
          <span>Salva Nuova Password</span>
          <span class="text-amber">&rarr;</span>
        </button>
      </div>
    {% endform %}

    <div class="mt-8 pt-6 border-t border-borderLinen text-center">
      <a href="{{ routes.account_login_url }}" class="text-xs uppercase tracking-wider text-ash hover:text-ink transition-colors">
        &larr; Torna alla pagina di Login
      </a>
    </div>

  </div>
</div>
