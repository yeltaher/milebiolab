{% doc %}
  @prompt
    crea una stiscia sottile per la promozione "BLACK FRIDAY MILE -20% al Check-Out per tutti i prodotti - dal 22 al 27 novembre", creala elegante naturale che attiri il cliente
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-black-friday-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
  }

  .ai-black-friday-{{ ai_gen_id }}__inner {
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    border-top: 1px solid {{ block.settings.border_color }};
    border-bottom: 1px solid {{ block.settings.border_color }};
    font-family: inherit;
  }

  .ai-black-friday-{{ ai_gen_id }}__label {
    margin: 0;
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.35;
    letter-spacing: 0.045em;
  }

  .ai-black-friday-{{ ai_gen_id }}__label strong {
    color: {{ block.settings.accent_color }};
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .ai-black-friday-{{ ai_gen_id }}__divider {
    width: 1px;
    height: 17px;
    flex: 0 0 1px;
    background: {{ block.settings.border_color }};
  }

  @media screen and (max-width: 600px) {
    .ai-black-friday-{{ ai_gen_id }}__inner {
      gap: 8px;
      padding-right: 10px;
      padding-left: 10px;
    }

    .ai-black-friday-{{ ai_gen_id }}__label {
      font-size: {{ block.settings.mobile_font_size }}px;
    }

    .ai-black-friday-{{ ai_gen_id }}__divider {
      height: 14px;
    }
  }
{% endstyle %}

<div class="ai-black-friday-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-black-friday-{{ ai_gen_id }}__inner">
    <p class="ai-black-friday-{{ ai_gen_id }}__label"><strong>{{ block.settings.promo_title | escape }}</strong></p>
    <span class="ai-black-friday-{{ ai_gen_id }}__divider" aria-hidden="true"></span>
    <p class="ai-black-friday-{{ ai_gen_id }}__label">{{ block.settings.promo_details | escape }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Black Friday strip",
  "settings": [
    {
      "type": "text",
      "id": "promo_title",
      "label": "Promo title",
      "default": "BLACK FRIDAY MILE"
    },
    {
      "type": "text",
      "id": "promo_details",
      "label": "Promo details",
      "default": "-20% al Check-Out per tutti i prodotti • dal 22 al 27 novembre"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop text size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile text size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7F5F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#4A5340"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#EDE5DB"
    }
  ],
  "presets": [
    {
      "name": "Black Friday strip"
    }
  ],
  "tag": null,
  "class": "black-friday-strip"
}
{% endschema %}