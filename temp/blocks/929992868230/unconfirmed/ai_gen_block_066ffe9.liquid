{% doc %}
  @prompt
    vorrei inserire una scriscia divisa in 3 partri ugali con foto collezione dettagli e tasto scopri collezione
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-trio-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #1A1A1A;
  }

  .ai-collection-trio__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-collection-trio__card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: #F7F5F0;
    border: 1px solid #EDE5DB;
  }

  .ai-collection-trio__media-{{ ai_gen_id }} {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #FAF8F5;
  }

  .ai-collection-trio__media-{{ ai_gen_id }} img,
  .ai-collection-trio__media-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-trio__content-{{ ai_gen_id }} {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-collection-trio__title-{{ ai_gen_id }} {
    margin: 0 0 10px;
    color: #1A1A1A;
    font-size: 20px;
    line-height: 1.25;
  }

  .ai-collection-trio__description-{{ ai_gen_id }} {
    margin: 0 0 20px;
    color: #1A1A1A;
    font-size: 14px;
    line-height: 1.6;
  }

  .ai-collection-trio__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: auto;
    padding: 10px 18px;
    border: 1px solid #4A5340;
    background: #4A5340;
    color: #FFFFFF;
    font-size: 14px;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .ai-collection-trio__button-{{ ai_gen_id }}:hover {
    background: #F7F5F0;
    color: #4A5340;
  }

  .ai-collection-trio__button-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid #1A1A1A;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-trio__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap | divided_by: 2 }}px;
    }

    .ai-collection-trio__card-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: 40% minmax(0, 1fr);
    }

    .ai-collection-trio__media-{{ ai_gen_id }} {
      height: 100%;
      min-height: 150px;
      aspect-ratio: auto;
    }

    .ai-collection-trio__content-{{ ai_gen_id }} {
      padding: 16px;
    }

    .ai-collection-trio__title-{{ ai_gen_id }} {
      font-size: 17px;
      margin-bottom: 6px;
    }

    .ai-collection-trio__description-{{ ai_gen_id }} {
      margin-bottom: 12px;
      font-size: 13px;
    }

    .ai-collection-trio__button-{{ ai_gen_id }} {
      min-height: 40px;
      padding: 8px 12px;
      font-size: 13px;
    }
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .ai-collection-trio__button-{{ ai_gen_id }} {
      transition: none;
    }
  }
{% endstyle %}

<div class="ai-collection-trio-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-trio__grid-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}
      <article class="ai-collection-trio__card-{{ ai_gen_id }}">
        <a class="ai-collection-trio__media-{{ ai_gen_id }}" href="{% if collection != blank %}{{ collection.url }}{% else %}#{% endif %}" aria-label="{% if collection != blank %}{{ collection.title | escape }}{% else %}Seleziona una collezione{% endif %}">
          {% if collection != blank and collection.featured_image %}
            {{ collection.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '300, 500, 750, 1000', sizes: '(min-width: 750px) 33vw, 40vw', alt: collection.title }}
          {% else %}
            <div class="ai-collection-trio__placeholder-{{ ai_gen_id }}">
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </a>
        <div class="ai-collection-trio__content-{{ ai_gen_id }}">
          <h2 class="ai-collection-trio__title-{{ ai_gen_id }}">
            {% if collection != blank %}{{ collection.title | escape }}{% else %}Collezione {{ i }}{% endif %}
          </h2>
          {% if collection != blank and collection.description != blank %}
            <div class="ai-collection-trio__description-{{ ai_gen_id }}">{{ collection.description | strip_html | truncate: 120 | escape }}</div>
          {% else %}
            <p class="ai-collection-trio__description-{{ ai_gen_id }}">{% if collection == blank %}Scegli una collezione nelle impostazioni del blocco.{% else %}Scopri i prodotti di questa collezione.{% endif %}</p>
          {% endif %}
          {% if collection != blank %}
            <a class="ai-collection-trio__button-{{ ai_gen_id }}" href="{{ collection.url }}">{{ block.settings.button_label | escape }}</a>
          {% else %}
            <span class="ai-collection-trio__button-{{ ai_gen_id }}">{{ block.settings.button_label | escape }}</span>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collezioni in evidenza",
  "settings": [
    {
      "type": "header",
      "content": "Contenuto"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collezione 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collezione 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collezione 3"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo del pulsante",
      "default": "Scopri la collezione"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Larghezza desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Spazio tra le schede",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Spazio interno",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Collezioni in evidenza"
    }
  ],
  "tag": null,
  "class": "collection-trio-block"
}
{% endschema %}