{% doc %}
  @prompt
    puoi creare una sezione decorativa
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-decorative-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_vertical }}px 24px;
    background: {{ block.settings.background }};
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.alignment }};
  }
  .ai-decorative-{{ ai_gen_id }}__inner { width: 100%; max-width: {{ block.settings.content_width }}px; margin: 0 auto; }
  .ai-decorative-{{ ai_gen_id }}__ornament { display: flex; align-items: center; justify-content: center; gap: 14px; margin-bottom: 12px; color: {{ block.settings.accent_color }}; }
  .ai-decorative-{{ ai_gen_id }}__line { width: {{ block.settings.line_width }}px; max-width: 30%; height: 1px; background: currentColor; opacity: .75; }
  .ai-decorative-{{ ai_gen_id }}__mark { font-size: 18px; line-height: 1; }
  .ai-decorative-{{ ai_gen_id }}__eyebrow { margin: 0 0 8px; color: {{ block.settings.accent_color }}; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; }
  .ai-decorative-{{ ai_gen_id }}__heading { margin: 0; font-family: inherit; font-size: clamp(22px, 3vw, {{ block.settings.heading_size }}px); line-height: 1.2; font-weight: 500; }
  .ai-decorative-{{ ai_gen_id }}__text { margin: 10px 0 0; font-size: 15px; line-height: 1.6; }
  .ai-decorative-{{ ai_gen_id }}__text p { margin: 0; }
  @media screen and (max-width: 749px) { .ai-decorative-{{ ai_gen_id }} { padding: {{ block.settings.padding_mobile }}px 16px; } }
{% endstyle %}
<div class="ai-decorative-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-decorative-{{ ai_gen_id }}__inner">
    {% if block.settings.show_ornament %}<div class="ai-decorative-{{ ai_gen_id }}__ornament" aria-hidden="true"><span class="ai-decorative-{{ ai_gen_id }}__line"></span><span class="ai-decorative-{{ ai_gen_id }}__mark">{{ block.settings.ornament_character | escape }}</span><span class="ai-decorative-{{ ai_gen_id }}__line"></span></div>{% endif %}
    {% if block.settings.eyebrow != blank %}<p class="ai-decorative-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
    {% if block.settings.heading != blank %}<h2 class="ai-decorative-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.body != blank %}<div class="ai-decorative-{{ ai_gen_id }}__text">{{ block.settings.body }}</div>{% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Decoro raffinato",
  "settings": [
    { "type": "checkbox", "id": "show_ornament", "label": "Mostra ornamento", "default": true },
    { "type": "text", "id": "ornament_character", "label": "Simbolo decorativo", "default": "✦" },
    { "type": "text", "id": "eyebrow", "label": "Sopratitolo", "default": "Il rituale della cura" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Bellezza essenziale, con intenzione" },
    { "type": "richtext", "id": "body", "label": "Testo", "default": "<p>Un momento per ritrovare equilibrio, luminosità e benessere.</p>" },
    { "type": "header", "content": "Aspetto" },
    { "type": "range", "id": "desktop_width_percent", "label": "Larghezza desktop", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "content_width", "label": "Larghezza contenuto", "min": 400, "max": 1200, "step": 50, "unit": "px", "default": 800 },
    { "type": "range", "id": "heading_size", "label": "Dimensione titolo", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "line_width", "label": "Lunghezza linee", "min": 20, "max": 100, "step": 10, "unit": "px", "default": 50 },
    { "type": "range", "id": "padding_vertical", "label": "Spazio verticale desktop", "min": 10, "max": 80, "step": 5, "unit": "px", "default": 35 },
    { "type": "range", "id": "padding_mobile", "label": "Spazio verticale mobile", "min": 10, "max": 50, "step": 5, "unit": "px", "default": 25 },
    { "type": "select", "id": "alignment", "label": "Allineamento", "options": [{ "value": "left", "label": "Sinistra" }, { "value": "center", "label": "Centro" }, { "value": "right", "label": "Destra" }], "default": "center" },
    { "type": "color", "id": "background", "label": "Sfondo", "default": "#F7F5F0" },
    { "type": "color", "id": "text_color", "label": "Testo", "default": "#1A1A1A" },
    { "type": "color", "id": "accent_color", "label": "Accento", "default": "#4A5340" }
  ],
  "presets": [{ "name": "Decoro raffinato" }],
  "tag": null,
  "class": "decorative-divider"
}
{% endschema %}