{% doc %}
  @prompt
    Crea un conto alla rovescia con giorni, ore, minuti e secondi. Data e ora di scadenza, testo e colori devono essere modificabili. Alla scadenza nascondi il contatore. Adatta lo stile al tema e rendilo leggibile su mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-countdown-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 20px;
    text-align: center;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
  }
  .ai-countdown-{{ ai_gen_id }}[hidden] { display: none; }
  .ai-countdown-{{ ai_gen_id }}__heading { margin: 0 0 14px; color: inherit; font-size: clamp(18px, 3vw, 24px); line-height: 1.3; }
  .ai-countdown-{{ ai_gen_id }}__units { display: flex; justify-content: center; gap: clamp(8px, 3vw, 24px); }
  .ai-countdown-{{ ai_gen_id }}__unit { min-width: 52px; }
  .ai-countdown-{{ ai_gen_id }}__value { display: block; color: {{ block.settings.accent_color }}; font-size: clamp(24px, 6vw, 40px); font-variant-numeric: tabular-nums; font-weight: 600; line-height: 1.1; }
  .ai-countdown-{{ ai_gen_id }}__label { display: block; margin-top: 6px; font-size: clamp(11px, 2.5vw, 14px); }
  @media screen and (max-width: 480px) {
    .ai-countdown-{{ ai_gen_id }} { padding: 16px 10px; }
    .ai-countdown-{{ ai_gen_id }}__units { gap: 8px; }
    .ai-countdown-{{ ai_gen_id }}__unit { min-width: 0; flex: 1; }
  }
{% endstyle %}

<countdown-timer-{{ ai_gen_id }} class="ai-countdown-{{ ai_gen_id }}" data-deadline="{{ block.settings.deadline | escape }}" {{ block.shopify_attributes }}>
  <div class="ai-countdown-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</div>
  <div class="ai-countdown-{{ ai_gen_id }}__units" role="timer" aria-live="off" aria-label="{{ block.settings.heading | escape }}">
    <div class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__value" data-days>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">{{ block.settings.days_label | escape }}</span></div>
    <div class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__value" data-hours>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">{{ block.settings.hours_label | escape }}</span></div>
    <div class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__value" data-minutes>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">{{ block.settings.minutes_label | escape }}</span></div>
    <div class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__value" data-seconds>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">{{ block.settings.seconds_label | escape }}</span></div>
  </div>
</countdown-timer-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'countdown-timer-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class CountdownTimer extends HTMLElement {
      connectedCallback() {
        const deadline = new Date(this.dataset.deadline).getTime();
        if (!Number.isFinite(deadline)) { this.hidden = true; return; }
        const update = () => {
          const remaining = deadline - Date.now();
          if (remaining <= 0) { this.hidden = true; clearInterval(this.timer); return; }
          const days = Math.floor(remaining / 86400000);
          const hours = Math.floor((remaining % 86400000) / 3600000);
          const minutes = Math.floor((remaining % 3600000) / 60000);
          const seconds = Math.floor((remaining % 60000) / 1000);
          this.querySelector('[data-days]').textContent = String(days).padStart(2, '0');
          this.querySelector('[data-hours]').textContent = String(hours).padStart(2, '0');
          this.querySelector('[data-minutes]').textContent = String(minutes).padStart(2, '0');
          this.querySelector('[data-seconds]').textContent = String(seconds).padStart(2, '0');
        };
        update();
        this.timer = window.setInterval(update, 1000);
      }
      disconnectedCallback() { if (this.timer) clearInterval(this.timer); }
    }
    customElements.define(tagName, CountdownTimer);
  })();
</script>

{% schema %}
{
  "name": "Conto alla rovescia",
  "settings": [
    { "type": "text", "id": "deadline", "label": "Scadenza (ISO 8601)", "default": "2027-12-31T23:59:59+01:00" },
    { "type": "text", "id": "heading", "label": "Testo", "default": "L'offerta termina tra" },
    { "type": "text", "id": "days_label", "label": "Etichetta giorni", "default": "Giorni" },
    { "type": "text", "id": "hours_label", "label": "Etichetta ore", "default": "Ore" },
    { "type": "text", "id": "minutes_label", "label": "Etichetta minuti", "default": "Minuti" },
    { "type": "text", "id": "seconds_label", "label": "Etichetta secondi", "default": "Secondi" },
    { "type": "range", "id": "desktop_width_percent", "label": "Larghezza desktop", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Colori" },
    { "type": "color", "id": "background_color", "label": "Sfondo", "default": "#F7F5F0" },
    { "type": "color", "id": "text_color", "label": "Testo", "default": "#1A1A1A" },
    { "type": "color", "id": "accent_color", "label": "Numeri", "default": "#4A5340" },
    { "type": "color", "id": "border_color", "label": "Bordo", "default": "#EDE5DB" }
  ],
  "presets": [{ "name": "Conto alla rovescia" }],
  "tag": null,
  "class": "countdown-block"
}
{% endschema %}