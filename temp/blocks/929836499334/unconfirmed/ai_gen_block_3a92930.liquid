{% doc %}
  @prompt
    crea una striscia per un prodotto in promozione scontato , una parte deve contenere 3 immagini del prodotto di cui una piu grande e 2 piccole, il testo con il presso del prodotto scontato e tasto aggiungi al carrello con presso scontato
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-strip-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 24px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 12px;
  }
  .ai-promo-strip-{{ ai_gen_id }} * { box-sizing: border-box; }
  .ai-promo-strip-{{ ai_gen_id }}__layout {
    display: grid;
    grid-template-columns: minmax(180px, 0.9fr) minmax(0, 1.4fr) auto;
    align-items: center;
    gap: 28px;
  }
  .ai-promo-strip-{{ ai_gen_id }}__gallery {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    grid-template-rows: repeat(2, minmax(70px, 1fr));
    gap: 8px;
    min-width: 0;
  }
  .ai-promo-strip-{{ ai_gen_id }}__image,
  .ai-promo-strip-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 70px;
    object-fit: cover;
    border-radius: 8px;
    background: {{ block.settings.background_color }};
  }
  .ai-promo-strip-{{ ai_gen_id }}__gallery > :first-child {
    grid-row: 1 / 3;
    min-height: 150px;
  }
  .ai-promo-strip-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; object-fit: cover; }
  .ai-promo-strip-{{ ai_gen_id }}__copy { min-width: 0; }
  .ai-promo-strip-{{ ai_gen_id }}__eyebrow {
    display: inline-block;
    margin: 0 0 8px;
    color: {{ block.settings.badge_text_color }};
    background: {{ block.settings.badge_color }};
    border-radius: 999px;
    padding: 5px 11px;
    font-size: 12px;
    letter-spacing: .04em;
  }
  .ai-promo-strip-{{ ai_gen_id }}__title { margin: 0 0 8px; color: inherit; font-size: 24px; line-height: 1.25; }
  .ai-promo-strip-{{ ai_gen_id }}__description { margin: 0 0 12px; line-height: 1.5; }
  .ai-promo-strip-{{ ai_gen_id }}__prices { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; }
  .ai-promo-strip-{{ ai_gen_id }}__sale-price { font-size: 22px; font-weight: 700; }
  .ai-promo-strip-{{ ai_gen_id }}__compare-price { font-size: 15px; opacity: .75; text-decoration: line-through; }
  .ai-promo-strip-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 20px;
    border: 0;
    border-radius: 6px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font: inherit;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }
  .ai-promo-strip-{{ ai_gen_id }}__button:hover { filter: brightness(.92); }
  .ai-promo-strip-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid {{ block.settings.text_color }}; outline-offset: 3px; }
  .ai-promo-strip-{{ ai_gen_id }}__button[disabled] { opacity: .6; cursor: not-allowed; }
  .ai-promo-strip-{{ ai_gen_id }}__status { margin: 10px 0 0; font-size: 14px; }
  @media screen and (max-width: 749px) {
    .ai-promo-strip-{{ ai_gen_id }} { width: 100%; padding: 18px; }
    .ai-promo-strip-{{ ai_gen_id }}__layout { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .ai-promo-strip-{{ ai_gen_id }}__gallery { max-height: 250px; }
    .ai-promo-strip-{{ ai_gen_id }}__button { width: 100%; }
    .ai-promo-strip-{{ ai_gen_id }}__title { font-size: 21px; }
  }
{% endstyle %}

<div class="ai-promo-strip-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% assign promo_product = block.settings.product %}
  {% if promo_product != blank %}
    {% assign promo_variant = promo_product.selected_or_first_available_variant %}
    <div class="ai-promo-strip-{{ ai_gen_id }}__layout">
      <div class="ai-promo-strip-{{ ai_gen_id }}__gallery" aria-label="Immagini del prodotto">
        {% if block.settings.image_main != blank %}
          <img class="ai-promo-strip-{{ ai_gen_id }}__image" src="{{ block.settings.image_main | image_url: width: 800 }}" alt="{{ block.settings.image_main.alt | default: promo_product.title | escape }}" loading="lazy" width="{{ block.settings.image_main.width }}" height="{{ block.settings.image_main.height }}">
        {% elsif promo_product.featured_image %}
          <img class="ai-promo-strip-{{ ai_gen_id }}__image" src="{{ promo_product.featured_image | image_url: width: 800 }}" alt="{{ promo_product.featured_image.alt | default: promo_product.title | escape }}" loading="lazy" width="{{ promo_product.featured_image.width }}" height="{{ promo_product.featured_image.height }}">
        {% else %}
          <div class="ai-promo-strip-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
        {% endif %}
        {% if block.settings.image_small_1 != blank %}
          <img class="ai-promo-strip-{{ ai_gen_id }}__image" src="{{ block.settings.image_small_1 | image_url: width: 400 }}" alt="{{ block.settings.image_small_1.alt | default: promo_product.title | escape }}" loading="lazy" width="{{ block.settings.image_small_1.width }}" height="{{ block.settings.image_small_1.height }}">
        {% else %}
          <div class="ai-promo-strip-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
        {% endif %}
        {% if block.settings.image_small_2 != blank %}
          <img class="ai-promo-strip-{{ ai_gen_id }}__image" src="{{ block.settings.image_small_2 | image_url: width: 400 }}" alt="{{ block.settings.image_small_2.alt | default: promo_product.title | escape }}" loading="lazy" width="{{ block.settings.image_small_2.width }}" height="{{ block.settings.image_small_2.height }}">
        {% else %}
          <div class="ai-promo-strip-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
        {% endif %}
      </div>
      <div class="ai-promo-strip-{{ ai_gen_id }}__copy">
        {% if block.settings.promo_label != blank %}<p class="ai-promo-strip-{{ ai_gen_id }}__eyebrow">{{ block.settings.promo_label | escape }}</p>{% endif %}
        <h2 class="ai-promo-strip-{{ ai_gen_id }}__title">{{ block.settings.heading | default: promo_product.title | escape }}</h2>
        {% if block.settings.description != blank %}<div class="ai-promo-strip-{{ ai_gen_id }}__description">{{ block.settings.description | escape }}</div>{% endif %}
        <div class="ai-promo-strip-{{ ai_gen_id }}__prices">
          <span class="ai-promo-strip-{{ ai_gen_id }}__sale-price">{{ promo_variant.price | money }}</span>
          {% if promo_variant.compare_at_price > promo_variant.price %}<s class="ai-promo-strip-{{ ai_gen_id }}__compare-price">{{ promo_variant.compare_at_price | money }}</s>{% endif %}
        </div>
      </div>
      <div>
        {% if promo_variant.available %}
          <form action="{{ routes.cart_add_url }}" method="post">
            <input type="hidden" name="id" value="{{ promo_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button class="ai-promo-strip-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label | escape }} · {{ promo_variant.price | money }}</button>
          </form>
        {% else %}
          <button class="ai-promo-strip-{{ ai_gen_id }}__button" type="button" disabled>{{ block.settings.sold_out_label | escape }}</button>
        {% endif %}
      </div>
    </div>
  {% else %}
    <div class="ai-promo-strip-{{ ai_gen_id }}__layout">
      <div class="ai-promo-strip-{{ ai_gen_id }}__gallery"><div class="ai-promo-strip-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div><div class="ai-promo-strip-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div><div class="ai-promo-strip-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div></div>
      <div class="ai-promo-strip-{{ ai_gen_id }}__copy"><h2 class="ai-promo-strip-{{ ai_gen_id }}__title">Seleziona un prodotto promozionale</h2><p class="ai-promo-strip-{{ ai_gen_id }}__description">Scegli un prodotto nelle impostazioni del blocco per mostrare immagini e prezzo aggiornati.</p></div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Striscia promozionale",
  "settings": [
    { "type": "product", "id": "product", "label": "Prodotto" },
    { "type": "image_picker", "id": "image_main", "label": "Immagine principale" },
    { "type": "image_picker", "id": "image_small_1", "label": "Immagine piccola 1" },
    { "type": "image_picker", "id": "image_small_2", "label": "Immagine piccola 2" },
    { "type": "text", "id": "promo_label", "label": "Etichetta promozione", "default": "Offerta speciale" },
    { "type": "text", "id": "heading", "label": "Titolo personalizzato" },
    { "type": "textarea", "id": "description", "label": "Descrizione breve" },
    { "type": "text", "id": "button_label", "label": "Testo pulsante", "default": "Aggiungi al carrello" },
    { "type": "text", "id": "sold_out_label", "label": "Testo non disponibile", "default": "Non disponibile" },
    { "type": "range", "id": "desktop_width_percent", "label": "Larghezza desktop", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Sfondo", "default": "#F7F5F0" },
    { "type": "color", "id": "text_color", "label": "Testo", "default": "#1A1A1A" },
    { "type": "color", "id": "border_color", "label": "Bordo", "default": "#EDE5DB" },
    { "type": "color", "id": "badge_color", "label": "Sfondo etichetta", "default": "#4A5340" },
    { "type": "color", "id": "badge_text_color", "label": "Testo etichetta", "default": "#FFFFFF" },
    { "type": "color", "id": "button_color", "label": "Sfondo pulsante", "default": "#4A5340" },
    { "type": "color", "id": "button_text_color", "label": "Testo pulsante", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Striscia promozionale" }],
  "tag": null,
  "class": "promo-strip-block"
}
{% endschema %}