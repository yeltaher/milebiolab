{% doc %}
  @prompt
    crea una stiscia sottile per la promozione "BLACK FRIDAY MILE -20% al Check-Out per tutti i prodotti - dal 22 al 27 novembre", creala elegante naturale che attiri il cliente, puoi aggiungere qualche decorazione naturale?
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-black-friday-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 9px 16px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border-top: 1px solid {{ block.settings.border_color }};
    border-bottom: 1px solid {{ block.settings.border_color }};
    text-align: center;
    font-family: inherit;
  }

  .ai-black-friday-{{ ai_gen_id }}__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 7px 12px;
    line-height: 1.35;
  }

  .ai-black-friday-{{ ai_gen_id }}__leaf {
    color: {{ block.settings.decoration_color }};
    font-size: 16px;
    line-height: 1;
    flex: 0 0 auto;
  }

  .ai-black-friday-{{ ai_gen_id }}__copy {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
  }

  .ai-black-friday-{{ ai_gen_id }}__title {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ai-black-friday-{{ ai_gen_id }}__offer {
    font-weight: 600;
    color: {{ block.settings.offer_color }};
  }

  @media screen and (max-width: 600px) {
    .ai-black-friday-{{ ai_gen_id }} {
      padding: 8px 10px;
    }
    .ai-black-friday-{{ ai_gen_id }}__inner {
      gap: 5px 8px;
    }
    .ai-black-friday-{{ ai_gen_id }}__copy {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<div class="ai-black-friday-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-black-friday-{{ ai_gen_id }}__inner">
    <span class="ai-black-friday-{{ ai_gen_id }}__leaf" aria-hidden="true">✦</span>
    <p class="ai-black-friday-{{ ai_gen_id }}__copy">
      <span class="ai-black-friday-{{ ai_gen_id }}__title">{{ block.settings.promo_title | escape }}</span>
      <span aria-hidden="true"> · </span>
      <span class="ai-black-friday-{{ ai_gen_id }}__offer">{{ block.settings.promo_offer | escape }}</span>
      <span> {{ block.settings.promo_details | escape }}</span>
    </p>
    <span class="ai-black-friday-{{ ai_gen_id }}__leaf" aria-hidden="true">✦</span>
  </div>
</div>

{% schema %}
{
  "name": "Fascia Black Friday",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Larghezza desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Promozione"
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "Titolo",
      "default": "Black Friday MILE"
    },
    {
      "type": "text",
      "id": "promo_offer",
      "label": "Sconto",
      "default": "-20% al check-out"
    },
    {
      "type": "text",
      "id": "promo_details",
      "label": "Dettagli e date",
      "default": "su tutti i prodotti · dal 22 al 27 novembre"
    },
    {
      "type": "header",
      "content": "Stile"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Sfondo",
      "default": "#F7F5F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Testo",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "offer_color",
      "label": "Accento sconto",
      "default": "#4A5340"
    },
    {
      "type": "color",
      "id": "decoration_color",
      "label": "Decorazioni",
      "default": "#6B7565"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Dimensione testo desktop",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Dimensione testo mobile",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Fascia Black Friday"
    }
  ],
  "tag": null,
  "class": "mile-black-friday-strip"
}
{% endschema %}