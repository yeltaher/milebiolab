{% doc %}
  @prompt
    crea una striscia per 3 immagini, elimina la tera immagine
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-strip-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-image-strip-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-image-strip-{{ ai_gen_id }}__item {
    display: block;
    overflow: hidden;
    background: #F7F5F0;
    aspect-ratio: {% if block.settings.image_ratio == 'square' %}1 / 1{% elsif block.settings.image_ratio == 'portrait' %}4 / 5{% else %}auto{% endif %};
  }

  .ai-image-strip-{{ ai_gen_id }}__item img {
    display: block;
    width: 100%;
    height: 100%;
    {% if block.settings.image_ratio == 'natural' %}
      height: auto;
    {% else %}
      object-fit: cover;
    {% endif %}
  }

  .ai-image-strip-{{ ai_gen_id }}__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 160px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #4A5340;
    background: #F7F5F0;
    text-align: center;
    padding: 16px;
  }

  .ai-image-strip-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 240px;
    color: #6B7565;
  }

  .ai-image-strip-{{ ai_gen_id }}__placeholder span {
    font-size: 13px;
    line-height: 1.4;
  }

  .ai-image-strip-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid #4A5340;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-image-strip-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-image-strip-{{ ai_gen_id }}__grid {
      gap: {{ block.settings.gap | times: 0.6 }}px;
    }
  }
{% endstyle %}

<div class="ai-image-strip-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-strip-{{ ai_gen_id }}__grid">
    {% for i in (1..2) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign link_key = 'link_' | append: i
        assign image = block.settings[image_key]
        assign image_link = block.settings[link_key]
      %}
      {% if image_link != blank %}<a class="ai-image-strip-{{ ai_gen_id }}__item ai-image-strip-{{ ai_gen_id }}__link" href="{{ image_link }}" aria-label="{{ image.alt | default: 'Scopri l’immagine' | escape }}">{% else %}<div class="ai-image-strip-{{ ai_gen_id }}__item">{% endif %}
        {% if image != blank %}
          <img src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">
        {% else %}
          <div class="ai-image-strip-{{ ai_gen_id }}__placeholder">
            {{ 'image' | placeholder_svg_tag }}
            <span>Aggiungi l’immagine {{ i }} nelle impostazioni del blocco</span>
          </div>
        {% endif %}
      {% if image_link != blank %}</a>{% else %}</div>{% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Striscia di immagini",
  "settings": [
    {
      "type": "header",
      "content": "Immagini"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Immagine 1"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Link immagine 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Immagine 2"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link immagine 2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Larghezza desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Formato immagini",
      "options": [
        { "value": "natural", "label": "Originale" },
        { "value": "square", "label": "Quadrato" },
        { "value": "portrait", "label": "Verticale" }
      ],
      "default": "natural"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Spazio tra le immagini",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Striscia di immagini"
    }
  ],
  "tag": null,
  "class": "image-strip-block"
}
{% endschema %}