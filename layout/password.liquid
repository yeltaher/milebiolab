<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
 <head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#4A5340">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS with Bespoke MILE & Dr Joseph Palette -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
   tailwind.config = {
    theme: {
     extend: {
      colors: {
       linen: '#F5F2EB',
       ink: '#1A1A1A',
       sand: '#DDD7CE',
       borderLinen: '#E5E0D8',
       ash: '#7A7265',
       sage: '#5C6B56',
       amber: '#C8A878',
       slatePrice: '#555E6B'
      },
      fontFamily: {
       serif: ['"Cormorant Garamond"', 'serif'],
       sans: ['Inter', 'sans-serif'],
      }
     }
    }
   }
  </script>
  
  <title>
   {{ shop.name }} &ndash; {{ 'general.password_page.login_form_heading' | t | default: 'Accesso Riservato' }}
  </title>

  {% if page_description %}
   <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <style>
   :root {
    --ease-luxury: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-smooth: cubic-bezier(0.25, 0.1, 0.25, 1);
   }
   body {
    background-color: #F5F2EB;
    color: #1A1A1A;
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
   }
   .visually-hidden {
    position: absolute !important;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    word-wrap: normal !important;
   }
  </style>

  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
 </head>

 <body class="template-password theme-MILE-bespoke bg-linen text-ink font-sans antialiased min-h-screen flex flex-col justify-between">
  <a class="skip-to-content-link visually-hidden" href="#MainContent">
   Vai al contenuto principale
  </a>

  <main id="MainContent" class="main-content focus-none flex-1 flex flex-col justify-between" role="main" tabindex="-1">
   {{ content_for_layout }}
  </main>

  {{ 'theme.js' | asset_url | script_tag }}
 </body>
</html>
